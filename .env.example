PUBLIC_BRAND_NAME=Relifish
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
PLATFORM_WHATSAPP=919999999999
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid
PUBLIC_VAPID_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Subject for webPush.setVapidDetails (mailto: or https:)
VAPID_CONTACT=mailto:you@example.com
# Razorpay — set true to activate. Keep false to use UPI screenshot flow.
# Get both values from Razorpay Dashboard → Settings → API Keys
PUBLIC_ENABLE_RAZORPAY=false
PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# MSG91 for OTP
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-flow-template-id
MSG91_SENDER_ID=RELFSH

# Cron Job Security
CRON_SECRET=your-cron-secret

# MSG91 for Cron Reminders
MSG91_REMINDER_TEMPLATE_ID=your-msg91-reminder-template-id
