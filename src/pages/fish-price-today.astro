---
// /fish-price-today: today's fish rates per kg from live seller listings (Thane, South Mumbai, Navi Mumbai).
// Targets "fish price today mumbai/thane", "fish rate today". Numbers come only from live listings.
export const prerender = false;

import AppShell from "../components/ui/AppShell.astro";
import SeoLinks from "../components/ui/molecules/SeoLinks.astro";
import { supabase } from "../lib/supabase";
import { SPECIES } from "../lib/species";
import { SITE_URL, canonicalFor } from "../lib/brand";
import { hubRows, type HubRow } from "../lib/fish-hub";

let unavailable = false;
let bySpecies: { species: string; local: string; english: string; rows: HubRow[] }[] = [];
try {
  const [sRes, lRes] = await Promise.all([
    supabase.from("sellers").select("id, name, location_name, lat, lng, is_test").eq("is_active", true),
    supabase.from("fish_listings").select("seller_id, species, is_available, is_preorder_enabled, is_order_paused, weight_avail, pricing_options"),
  ]);
  if (sRes.error || lRes.error) throw sRes.error || lRes.error;
  const sellers = (sRes.data ?? []).filter((s: any) => !s.is_test);
  const species = [...new Set((lRes.data ?? []).map((l: any) => String(l.species).toLowerCase()))].filter((sp) => Object.hasOwn(SPECIES, sp));
  bySpecies = species
    .map((sp) => ({
      species: sp,
      local: sp.charAt(0).toUpperCase() + sp.slice(1),
      english: SPECIES[sp].english.match(/\(([^)]+)\)/)?.[1] || SPECIES[sp].english,
      rows: hubRows(sellers, (lRes.data ?? []) as any, sp),
    }))
    .filter((x) => x.rows.length > 0)
    .sort((a, b) => b.rows.length - a.rows.length || a.local.localeCompare(b.local));
} catch {
  unavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "120");
}

const today = new Date().toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata", day: "numeric", month: "long", year: "numeric" });
const updatedAt = new Date().toLocaleTimeString("en-IN", { timeZone: "Asia/Kolkata", hour: "2-digit", minute: "2-digit" });
const kg = (r: HubRow) => (r.perKg ? (r.perKg.low === r.perKg.high ? `₹${r.perKg.low}/kg` : `₹${r.perKg.low}–${r.perKg.high}/kg`) : `₹${r.offer.lowPrice}${r.offer.highPrice !== r.offer.lowPrice ? `–${r.offer.highPrice}` : ""} / pack`);
const range = (rows: HubRow[]) => {
  const k = rows.filter((r) => r.perKg);
  if (!k.length) return null;
  const lo = Math.min(...k.map((r) => r.perKg!.low)), hi = Math.max(...k.map((r) => r.perKg!.high));
  return lo === hi ? `₹${lo}/kg` : `₹${lo}–₹${hi}/kg`;
};
const statusText = { InStock: "Today", PreOrder: "Pre-order", OutOfStock: "Not today" } as const;
const url = canonicalFor("/fish-price-today");
const summary = bySpecies.slice(0, 4).map((s) => `${s.local} ${range(s.rows) ?? kg(s.rows[0])}`).join(", ");
---
<AppShell
  title="Fish Price Today in Thane & Mumbai: Live Rates per kg | Relifish"
  description={`Today's fish rates (${today}) from local sellers in Thane, South Mumbai and Navi Mumbai${summary ? `: ${summary}` : ""}. Updated live from each seller's listing.`}
  canonical={url}
  noindex={unavailable || bySpecies.length === 0}
  header={{ variant: "page", backHref: "/shop", title: "Relifish" }}
  nav={{ active: "shop" }}
  jsonLd={bySpecies.length ? {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ItemList",
        "name": `Fish price today in Thane & Mumbai (${today})`,
        "itemListElement": bySpecies.map((s, i) => ({ "@type": "ListItem", "position": i + 1, "name": `${s.local} price today`, "url": `${SITE_URL}/fish/${s.species}` })),
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
          { "@type": "ListItem", "position": 2, "name": "Fish price today", "item": url },
        ],
      },
    ],
  } : undefined}
>
  <article style="padding:16px;display:flex;flex-direction:column;gap:16px;">
    <header>
      <h1 style="font:800 22px/1.3 Inter;margin:0 0 6px;">Fish price today in Thane &amp; Mumbai</h1>
      <p style="font:400 14px/1.6 Inter;margin:0;color:var(--v2-ink-2);">
        {unavailable
          ? "We couldn't load today's rates. Please try again in a minute."
          : `Rates for ${today}, updated ${updatedAt} IST, taken live from the listings of local fish sellers on Relifish in Thane, South Mumbai (Tardeo) and Kamothe. Prices are per kg where the fish is sold by weight; fish sold by the piece shows the pack price. Each seller sets their own price, and prices change daily with the catch.`}
      </p>
    </header>

    {bySpecies.length > 0 && (
      <section>
        <h2 style="font:700 16px Inter;margin:0 0 8px;">Today's rates at a glance</h2>
        <table style="width:100%;border-collapse:collapse;font:400 13px Inter;">
          <thead><tr style="text-align:left;color:var(--v2-ink-3);"><th style="padding:6px 4px;">Fish</th><th style="padding:6px 4px;">Price today</th><th style="padding:6px 4px;">Sellers</th></tr></thead>
          <tbody>
            {bySpecies.map((s) => (
              <tr style="border-top:1px solid var(--v2-border);">
                <td style="padding:8px 4px;"><a href={`/fish/${s.species}`} style="font-weight:700;color:var(--v2-brand);">{s.local}</a>{s.english.toLowerCase() !== s.local.toLowerCase() && <div style="color:var(--v2-ink-3);font-size:12px;">{s.english}</div>}</td>
                <td style="padding:8px 4px;white-space:nowrap;">{range(s.rows) ?? kg(s.rows[0])}</td>
                <td style="padding:8px 4px;">{s.rows.length}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    {bySpecies.map((s) => (
      <section>
        <h2 style="font:700 15px Inter;margin:0 0 6px;"><a href={`/fish/${s.species}`} style="color:inherit;">{s.local} price today</a></h2>
        <table style="width:100%;border-collapse:collapse;font:400 13px Inter;">
          <tbody>
            {s.rows.map((r) => (
              <tr style="border-top:1px solid var(--v2-border);">
                <td style="padding:6px 4px;"><a href={r.href} style="color:var(--v2-brand);font-weight:600;">{r.seller}</a>{r.area && <span style="color:var(--v2-ink-3);"> · {r.area}</span>}</td>
                <td style="padding:6px 4px;">{statusText[r.offer.availability]}</td>
                <td style="padding:6px 4px;white-space:nowrap;">{kg(r)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}

    <section>
      <h2 style="font:700 16px Inter;margin:0 0 8px;">Why fish prices change every day</h2>
      <p style="font:400 14px/1.7 Inter;margin:0;color:var(--v2-ink-2);">The day's catch, sea conditions, the landing auction, season and demand all move the price. During Maharashtra's monsoon fishing ban (from June 1; extended to August 15 in 2026) sea fish is scarce and costs more. <a href="/blog/why-fish-prices-change-daily-thane-mumbai-get-fair-rate">Read more</a>.</p>
    </section>
  </article>
  <SeoLinks />
</AppShell>
