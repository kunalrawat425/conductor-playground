---
// /fish-price-today: today's fish rates per kg from live seller listings.
// Targets "fish price today mumbai/thane", "fish rate today". Numbers come only from live listings.
export const prerender = false;

import AppShell from "../components/ui/AppShell.astro";
import SeoLinks from "../components/ui/molecules/SeoLinks.astro";
import { SELLER_PUBLIC_COLUMNS, supabase } from "../lib/supabase";
import { SPECIES } from "../lib/species";
import { SITE_URL, canonicalFor } from "../lib/brand";
import { hubPlace, hubPriceRange, hubPriceText, hubRangeRows, hubRowPriceText, hubRows, type HubRow } from "../lib/fish-hub";

let unavailable = false;
let bySpecies: { species: string; local: string; english: string; rows: HubRow[] }[] = [];
try {
  const [sRes, lRes] = await Promise.all([
    // Seller hours too: availability is the same rule as the feed and the seller's pages.
    supabase.from("sellers").select(SELLER_PUBLIC_COLUMNS).eq("is_active", true),
    supabase.from("fish_listings").select("seller_id, species, size_label, is_available, is_preorder_enabled, is_order_paused, weight_avail, pricing_options").is("deleted_at", null),
  ]);
  if (sRes.error || lRes.error) throw sRes.error || lRes.error;
  const sellers = (sRes.data ?? []).filter((s: any) => !s.is_test);
  const species = [...new Set((lRes.data ?? []).map((l: any) => String(l.species).toLowerCase()))].filter((sp) => Object.hasOwn(SPECIES, sp));
  bySpecies = species
    .map((sp) => ({
      species: sp,
      local: sp.charAt(0).toUpperCase() + sp.slice(1),
      english: SPECIES[sp].english.match(/\(([^)]+)\)/)?.[1] || SPECIES[sp].english,
      rows: hubRows(sellers as any, (lRes.data ?? []) as any, sp),
    }))
    .filter((x) => x.rows.length > 0)
    .sort((a, b) => b.rows.length - a.rows.length || a.local.localeCompare(b.local));
} catch {
  unavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "120");
}

const today = new Date().toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata", day: "numeric", month: "long", year: "numeric" });
const shortDate = new Date().toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata", day: "numeric", month: "short" });
const updatedAt = new Date().toLocaleTimeString("en-IN", { timeZone: "Asia/Kolkata", hour: "2-digit", minute: "2-digit" });
// Today's range: only sellers with the fish in stock today (live listing). Pack sellers next to a ₹/kg range keep their pack price.
const range = (rows: HubRow[]) => {
  const inStock = rows.filter((x) => x.offer.availability === "InStock");
  const r = hubPriceRange(inStock);
  if (!r) return null;
  const packs = inStock.filter((x) => !hubRangeRows(inStock).includes(x));
  return hubPriceText(r) + (packs.length ? ` · packs from ₹${Math.min(...packs.map((x) => x.offer.lowPrice))}` : "");
};
const statusText = { InStock: "Today", PreOrder: "Pre-order", OutOfStock: "Not in stock today" } as const;
// Where the listed sellers actually are (shop location), e.g. "Thane".
const areas = hubPlace(bySpecies.flatMap((s) => s.rows));
const url = canonicalFor("/fish-price-today");
// Say "Mumbai" only when a listed seller is outside Thane (today every row may be Thane).
const place = bySpecies.every((s) => s.rows.every((r) => r.area === "Thane")) ? "Thane" : "Thane & Mumbai";
const title = place === "Thane"
  ? `Fish Price Today in Thane (${shortDate}): Rates per kg | Relifish`
  : `Fish Price Today in Thane & Mumbai (${shortDate}) per kg | Relifish`;
// Meta ≤155 chars: fish names from today's live listings, as many as fit.
const metaHead = `Today's fish rates per kg from verified sellers delivering in ${place}`;
const metaTail = ". Compare sellers, then order.";
let names: string[] = [];
for (const s of bySpecies) {
  const next = [...names, s.local.toLowerCase()];
  if ((`${metaHead}: ${next.join(", ")} and more${metaTail}`).length > 155) break;
  names = next;
}
const description = metaHead + (names.length ? `: ${names.join(", ")}${names.length < bySpecies.length ? " and more" : ""}` : "") + metaTail;
---
<AppShell
  title={title}
  description={description}
  canonical={url}
  noindex={unavailable || bySpecies.length === 0}
  header={{ variant: "page", backHref: "/shop", title: "Relifish" }}
  nav={{ active: "shop" }}
  jsonLd={bySpecies.length ? {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ItemList",
        "name": `Fish price today in ${place} (${today})`,
        "itemListElement": bySpecies.map((s, i) => ({ "@type": "ListItem", "position": i + 1, "name": `${s.local} price today`, "url": `${SITE_URL}/fish/${s.species}` })),
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
          { "@type": "ListItem", "position": 2, "name": "Fish price today", "item": url },
        ],
      },
    ],
  } : undefined}
>
  <article style="padding:16px;display:flex;flex-direction:column;gap:16px;">
    <header>
      <h1 style="font:800 22px/1.3 Inter;margin:0 0 6px;">Fish price today in {place} ({today})</h1>
      <p style="font:400 14px/1.6 Inter;margin:0;color:var(--v2-ink-2);">
        {unavailable
          ? "We couldn't load today's rates. Please try again in a minute."
          : `Rates for ${today}, updated ${updatedAt} IST, taken live from the listings of verified fish sellers on Relifish${areas ? ` in ${areas}` : ""}. Prices are per kg where the fish is sold by weight; fish sold by the piece or pack shows the pack price and weight. When a seller is out of stock, the last listed price is shown for reference. Each seller sets their own price, and prices change daily with the catch.`}
      </p>
    </header>

    {bySpecies.length > 0 && (
      <section>
        <h2 style="font:700 16px Inter;margin:0 0 8px;">Today's rates at a glance</h2>
        <table style="width:100%;border-collapse:collapse;font:400 13px Inter;">
          <thead><tr style="text-align:left;color:var(--v2-ink-3);"><th style="padding:6px 4px;">Fish</th><th style="padding:6px 4px;">Price today</th><th style="padding:6px 4px;">Sellers</th></tr></thead>
          <tbody>
            {bySpecies.map((s) => (
              <tr style="border-top:1px solid var(--v2-border);">
                <td style="padding:8px 4px;"><a href={`/fish/${s.species}`} style="font-weight:700;color:var(--v2-brand);">{s.local}</a>{s.english.toLowerCase() !== s.local.toLowerCase() && <div style="color:var(--v2-ink-3);font-size:12px;">{s.english}</div>}</td>
                <td style="padding:8px 4px;">{range(s.rows) ?? (s.rows.some((r) => r.offer.availability === "PreOrder") ? "Pre-order only" : "Not in stock today")}</td>
                <td style="padding:8px 4px;">{s.rows.length}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    {bySpecies.map((s) => (
      <section>
        <h2 style="font:700 15px Inter;margin:0 0 6px;"><a href={`/fish/${s.species}`} style="color:inherit;">{s.local} price today</a></h2>
        <table style="width:100%;border-collapse:collapse;font:400 13px Inter;">
          <tbody>
            {s.rows.map((r) => (
              <tr style="border-top:1px solid var(--v2-border);">
                <td style="padding:6px 4px;"><a href={r.href} style="color:var(--v2-brand);font-weight:600;">{r.seller}</a>{r.area && <span style="color:var(--v2-ink-3);"> · {r.area}</span>}</td>
                <td style="padding:6px 4px;">{statusText[r.offer.availability]}</td>
                <td style="padding:6px 4px;">{r.offer.availability === "OutOfStock" ? `Last listed ${hubRowPriceText(r)}` : hubRowPriceText(r)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}

    <section>
      <h2 style="font:700 16px Inter;margin:0 0 8px;">Why fish prices change every day</h2>
      <p style="font:400 14px/1.7 Inter;margin:0;color:var(--v2-ink-2);">The day's catch, sea conditions, the landing auction, season and demand all move the price. During Maharashtra's monsoon fishing ban (from June 1; extended to August 15 in 2026) sea fish is scarce and costs more. <a href="/blog/why-fish-prices-change-daily-thane-mumbai-get-fair-rate">Read more</a>.</p>
    </section>
  </article>
  <SeoLinks />
</AppShell>
