---
export const prerender = false;
import AppShellV2 from "../../../../components/v2/AppShellV2.astro";
import Toast from "../../../../components/v2/atoms/Toast.astro";
import EmptyState from "../../../../components/v2/molecules/EmptyState.astro";
---
<AppShellV2
  title="Orders · Seller Dashboard"
  description="Manage today's orders"
  hideHeader={true}
  nav={{ active: "orders", mode: "seller" }}
>
  <Toast />

  <div id="v2-dash-content" style="display:none;">
    <!-- Hero with toggleable stats -->
    <div class="v2-dash-hero">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <div>
          <div class="v2-dash-greet">Good day, <span id="v2-dash-name">seller</span></div>
          <div class="v2-dash-title">Today's pipeline</div>
        </div>
        <button id="v2-stats-toggle" type="button" style="background:rgba(255,255,255,.2);border:none;color:#fff;font:600 11px Inter;padding:6px 12px;border-radius:20px;cursor:pointer;">Stats ▼</button>
      </div>
      <div id="v2-dash-stats-panel" style="display:none;">
        <div class="v2-dash-stats" style="margin-top:12px;">
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-pending">—</div><div class="v2-dash-l">New</div></div>
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-inprogress">—</div><div class="v2-dash-l">In Progress</div></div>
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-gmv">₹0</div><div class="v2-dash-l">Today GMV</div></div>
        </div>
        <div class="v2-dash-stats" style="margin-top:8px;">
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-preorders">—</div><div class="v2-dash-l">Pre-orders</div></div>
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-completed">—</div><div class="v2-dash-l">Completed</div></div>
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-declined">—</div><div class="v2-dash-l">Declined</div></div>
        </div>
      </div>
    </div>

    <!-- Action row removed — use Listings tab and per-order actions instead -->

    <!-- Tabs -->
    <div class="v2-dash-tabs">
      <button class="v2-dash-tab v2-dash-tab-active" data-tab="pending">New <span class="v2-dash-tab-count" id="v2-tab-pending-count">0</span></button>
      <button class="v2-dash-tab" data-tab="accepted">In Progress <span class="v2-dash-tab-count" id="v2-tab-accepted-count" style="display:none;">0</span></button>
      <button class="v2-dash-tab" data-tab="completed">History <span class="v2-dash-tab-count" id="v2-tab-completed-count" style="display:none;">0</span></button>
    </div>

    <!-- Search + Date filter + export -->
    <div style="padding:8px 16px;background:var(--v2-bg);border-bottom:1px solid var(--v2-border);">
      <input id="v2-dash-search" type="text" placeholder="Search by order ID or phone..." style="width:100%;padding:8px 12px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 13px Inter;color:var(--v2-ink);background:var(--v2-bg-2);outline:none;box-sizing:border-box;" />
    </div>
    <div class="v2-dash-filterbar">
      <label class="v2-dash-filter-lbl">Range:</label>
      <select id="v2-dash-range" class="v2-dash-select">
        <option value="today">Today</option>
        <option value="7d">Last 7 days</option>
        <option value="30d" selected>Last 30 days</option>
        <option value="all">All time</option>
      </select>
      <a id="v2-dash-export" href="#" class="v2-dash-export-link" title="Download orders as CSV">⬇ CSV</a>
      <span style="flex:1;"></span>
      <span id="v2-orders-count" class="v2-dash-filter-lbl"></span>
    </div>

    <div id="v2-orders-list">
      <div style="text-align:center;padding:24px;color:var(--v2-ink-3);font:500 12px Inter;">
        <span class="v2-spinner v2-spinner-md"></span><div style="margin-top:8px;">Loading orders...</div>
      </div>
    </div>
  </div>

  <div id="v2-dash-not-active" style="display:none;padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Account pending activation"
      description="Your seller account is awaiting admin approval. We'll notify you when activated."
      ctaText="Refresh status"
      ghostCtaText="Sign out"
    />
  </div>

  <div id="v2-dash-no-auth" style="display:none;padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Sign in required"
      description="Please sign in to access your seller dashboard."
      ctaText="Sign in"
      ctaHref="/v2/dashboard/login"
    />
  </div>
</AppShellV2>

<style is:global>
  .v2-dash-hero {
    background: linear-gradient(135deg, var(--v2-green), #10B981);
    padding: 16px;
    color: #fff;
  }
  .v2-dash-greet { font: 400 12px Inter; opacity: .9; }
  .v2-dash-title { font: 800 20px Inter; margin-top: 2px; }
  .v2-dash-stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 8px; margin-top: 16px;
  }
  .v2-dash-stat {
    background: rgba(255, 255, 255, .15);
    border-radius: 10px;
    padding: 10px;
    text-align: center;
    backdrop-filter: blur(10px);
  }
  .v2-dash-v { font: 800 18px Inter; color: #fff; }
  .v2-dash-l { font: 500 10px Inter; color: rgba(255, 255, 255, .9); margin-top: 1px; }
  .v2-dash-actions {
    display: flex; gap: 8px;
    padding: 16px;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
  }
  .v2-dash-actions .v2-btn { flex: 1; }
  .v2-dash-tabs {
    display: flex;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .v2-dash-tabs::-webkit-scrollbar { display: none; }
  .v2-dash-tab {
    flex: 1; padding: 12px;
    font: 600 12px Inter;
    color: var(--v2-ink-3);
    text-align: center;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    white-space: nowrap;
    min-width: 100px;
  }
  .v2-dash-tab-active { color: var(--v2-brand); }
  .v2-dash-tab-active::after {
    content: '';
    position: absolute; bottom: 0; left: 16px; right: 16px;
    height: 2px;
    background: var(--v2-brand);
  }
  .v2-dash-tab-count {
    font-size: 10px;
    margin-left: 4px;
    background: var(--v2-red); color: #fff;
    padding: 1px 6px;
    border-radius: 9999px;
  }
  .v2-dash-filterbar {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
  }
  .v2-dash-filter-lbl {
    font: 600 11px Inter; color: var(--v2-ink-3);
  }
  .v2-dash-select {
    background: var(--v2-bg-2);
    border: 1px solid var(--v2-border);
    color: var(--v2-ink);
    font: 600 12px Inter;
    padding: 6px 10px;
    border-radius: var(--v2-radius-sm);
    cursor: pointer;
  }
  .v2-dash-export-link {
    font: 600 12px Inter;
    color: var(--v2-brand);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: var(--v2-radius-sm);
    border: 1px solid var(--v2-border);
    background: var(--v2-bg-2);
  }
  .v2-dash-export-link:hover { background: var(--v2-brand-l); }
  .v2-pagination {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px;
    gap: 8px;
  }
  .v2-pg-btn {
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    color: var(--v2-ink);
    font: 600 12px Inter;
    padding: 8px 14px;
    border-radius: var(--v2-radius-sm);
    cursor: pointer;
  }
  .v2-pg-btn:disabled { opacity: .4; cursor: not-allowed; }
  .v2-pg-info { font: 500 12px Inter; color: var(--v2-ink-3); }
</style>

<script>
  import { supabase } from "../../../../lib/supabase";

  let sellerId: string | null = null;
  let sellerData: any = null;
  let currentTab: "pending" | "accepted" | "completed" = "pending";
  let currentRange = "30d";
  let currentPage = 1;
  let searchQuery = "";
  const PAGE_SIZE = 10;
  let pollTimer: any;

  const STATUS_BY_TAB: Record<string, string[]> = {
    pending: ["pending", "pending_payment", "pre_order", "scheduled"],
    accepted: ["confirmed", "paid", "payment_required", "ready_for_pickup", "out_for_delivery"],
    completed: ["picked_up", "completed", "declined", "cancelled", "refunded"],
  };

  function rangeToDate(r: string): Date | null {
    const now = new Date();
    if (r === "today") { const d = new Date(); d.setHours(0,0,0,0); return d; }
    if (r === "7d") return new Date(now.getTime() - 7 * 86400000);
    if (r === "30d") return new Date(now.getTime() - 30 * 86400000);
    return null;
  }

  function getSellerId() {
    try { return localStorage.getItem("zepto_seller_id"); } catch { return null; }
  }

  function escape(s: string) {
    return String(s || "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!));
  }

  async function init() {
    sellerId = getSellerId();
    if (!sellerId) {
      document.getElementById("v2-dash-no-auth")!.style.display = "block";
      return;
    }
    try {
      const { data } = await supabase.from("sellers").select("*").eq("id", sellerId).single();
      sellerData = data;
      if (!sellerData?.is_active) {
        document.getElementById("v2-dash-not-active")!.style.display = "block";
        return;
      }
      document.getElementById("v2-dash-content")!.style.display = "block";
      document.getElementById("v2-dash-name")!.textContent = sellerData.name || "seller";
      await loadOrders();

      // Supabase Realtime: listen for new/updated orders for this seller's listings
      const { data: myListings } = await supabase.from("fish_listings").select("id").eq("seller_id", sellerId);
      const myListingIds = new Set((myListings || []).map((l: any) => l.id));

      supabase
        .channel("seller-orders-" + sellerId)
        .on("postgres_changes", {
          event: "*",
          schema: "public",
          table: "orders",
        }, (payload: any) => {
          // Only reload if order belongs to this seller's listings
          const lid = payload.new?.listing_id || payload.old?.listing_id;
          if (lid && myListingIds.has(lid)) {
            loadOrders(false);
          }
        })
        .subscribe();

      // Fallback poll every 30s
      pollTimer = setInterval(() => { loadOrders(false); }, 30000);
    } catch (err) {
      console.error("dash init failed", err);
      (window as any).v2Toast?.("error", "Load failed", "Refresh to try again");
    }
  }

  async function loadOrders(showSpinner = true) {
    if (!sellerId) return;
    const list = document.getElementById("v2-orders-list")!;

    if (showSpinner) {
      list.innerHTML = `<div style="text-align:center;padding:24px;color:var(--v2-ink-3);font:500 12px Inter;"><span class="v2-spinner v2-spinner-md"></span><div style="margin-top:8px;">Loading orders...</div></div>`;
    }

    try {
      // Get listing ids for this seller
      const { data: listings } = await supabase.from("fish_listings").select("id").eq("seller_id", sellerId);
      const listingIds = (listings || []).map((l: any) => l.id);

      if (listingIds.length === 0) {
        list.innerHTML = `<div style="padding:24px 16px;"><div class="v2-empty"><div class="v2-empty-icon">📋</div><h3 class="v2-empty-title">No listings yet</h3><p class="v2-empty-desc">Create your first listing to start receiving orders.</p><a href="/v2/dashboard/listings/new" class="v2-btn v2-btn-primary v2-btn-md">Create listing</a></div></div>`;
        return;
      }

      // === Stats: all counts ALL-TIME so seller sees real backlog ===
      const [
        { count: pendingCount },
        { count: inProgressCount },
        { count: completedCount },
        { count: declinedCount },
        { count: preorderCount },
      ] = await Promise.all([
        supabase.from("orders").select("id", { count: "exact", head: true }).in("listing_id", listingIds).in("status", STATUS_BY_TAB.pending),
        supabase.from("orders").select("id", { count: "exact", head: true }).in("listing_id", listingIds).in("status", STATUS_BY_TAB.accepted),
        supabase.from("orders").select("id", { count: "exact", head: true }).in("listing_id", listingIds).in("status", ["picked_up", "completed"]),
        supabase.from("orders").select("id", { count: "exact", head: true }).in("listing_id", listingIds).in("status", ["declined", "cancelled", "refunded"]),
        supabase.from("orders").select("id", { count: "exact", head: true }).in("listing_id", listingIds).eq("status", "pre_order"),
      ]);
      // GMV = today only
      const todayStart = new Date(); todayStart.setHours(0,0,0,0);
      const { data: todayOrdersRaw } = await supabase
        .from("orders")
        .select("total_price")
        .in("listing_id", listingIds)
        .gte("created_at", todayStart.toISOString());
      const todayGmv = (todayOrdersRaw || []).reduce((s: number, o: any) => s + (o.total_price || 0), 0);

      const pt = pendingCount || 0;
      const ip = inProgressCount || 0;
      const ct = (completedCount || 0);
      const dc = declinedCount || 0;
      const po = preorderCount || 0;

      // Hero stats
      document.getElementById("v2-dash-pending")!.textContent = String(pt);
      document.getElementById("v2-dash-inprogress")!.textContent = String(ip);
      document.getElementById("v2-dash-gmv")!.textContent = `₹${todayGmv.toLocaleString("en-IN")}`;
      document.getElementById("v2-dash-preorders")!.textContent = String(po);
      document.getElementById("v2-dash-completed")!.textContent = String(ct);
      document.getElementById("v2-dash-declined")!.textContent = String(dc);

      // Tab badges
      document.getElementById("v2-tab-pending-count")!.textContent = String(pt);
      const ipBadge = document.getElementById("v2-tab-accepted-count")!;
      ipBadge.textContent = String(ip);
      ipBadge.style.display = ip > 0 ? "inline" : "none";
      const hBadge = document.getElementById("v2-tab-completed-count")!;
      hBadge.textContent = String(ct + dc);
      hBadge.style.display = (ct + dc) > 0 ? "inline" : "none";

      // === Paginated orders for current tab + range ===
      const sinceDate = rangeToDate(currentRange);
      const offset = (currentPage - 1) * PAGE_SIZE;
      let q;
      if (searchQuery) {
        // Search mode — always fetch + filter client-side (UUID can't be ilike'd)
        const sq = searchQuery.toLowerCase();
        const { data: allOrders } = await supabase
          .from("orders")
          .select("*, listing:fish_listings(species, preorder_price_min, preorder_price_max)")
          .in("listing_id", listingIds)
          .order("created_at", { ascending: false })
          .limit(500);
        const matched = (allOrders || []).filter((o: any) =>
          o.id.toLowerCase().includes(sq) ||
          (o.buyer_phone || "").includes(sq)
        );
        const totalCount = matched.length;
        const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
        const ordersToShow = matched.slice(offset, offset + PAGE_SIZE);
        document.getElementById("v2-orders-count")!.textContent = totalCount > 0 ? `${totalCount} found` : "No results";

        if (ordersToShow.length === 0) {
          list.innerHTML = `<div style="padding:32px 16px;text-align:center;color:var(--v2-ink-3);font:500 13px Inter;">No orders matching "${escape(searchQuery)}"</div>`;
          return;
        }
        renderOrders(ordersToShow, totalPages);
        return;
      } else {
        q = supabase
          .from("orders")
          .select("*, listing:fish_listings(species, preorder_price_min, preorder_price_max)", { count: "exact" })
          .in("listing_id", listingIds)
          .in("status", STATUS_BY_TAB[currentTab])
          .order("created_at", { ascending: false })
          .range(offset, offset + PAGE_SIZE - 1);
        if (sinceDate) q = q.gte("created_at", sinceDate.toISOString());
      }

      const { data: orders, count } = await q;
      const ordersToShow = orders || [];
      const totalCount = count || 0;
      const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
      document.getElementById("v2-orders-count")!.textContent = totalCount > 0 ? `${totalCount} ${searchQuery ? 'found' : currentTab}` : "";

      if (ordersToShow.length === 0) {
        list.innerHTML = `<div style="padding:32px 16px;text-align:center;color:var(--v2-ink-3);font:500 13px Inter;">No ${searchQuery ? 'results' : currentTab + ' orders in this range'}</div>`;
        return;
      }

      renderOrders(ordersToShow, totalPages);
    } catch (err: any) {
      console.error("loadOrders failed", err);
      list.innerHTML = `<div style="text-align:center;padding:24px;color:var(--v2-red);font:500 13px Inter;">Failed to load orders</div>`;
    }
  }

  function renderOrders(ordersToShow: any[], totalPages: number) {
    const list = document.getElementById("v2-orders-list")!;
    const orderHtml = ordersToShow.map((o: any) => {
        const isPreorder = o.status === "pre_order";
        const isUrgent = o.scheduled_for && new Date(o.scheduled_for).getTime() - Date.now() < 60 * 60 * 1000;
        const time = o.scheduled_for
          ? new Date(o.scheduled_for).toLocaleString("en-IN", { timeZone: "Asia/Kolkata", weekday: "short", hour: "numeric", minute: "2-digit" })
          : new Date(o.created_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata", hour: "numeric", minute: "2-digit" });
        const cls = isUrgent ? "v2-order-urgent" : "";
        const total = o.total_price || o.final_price || 0;
        const id6 = String(o.id || "").slice(0, 6).toUpperCase();

        // Badge per status
        const statusBadges: Record<string, [string, string]> = {
          pending: ["New", "v2-oc-badge-new"],
          pre_order: ["Pre-order", "v2-oc-badge-preorder"],
          scheduled: ["Scheduled", "v2-oc-badge-new"],
          confirmed: ["Confirmed", "v2-oc-badge-new"],
          paid: ["Paid", "v2-oc-badge-new"],
          ready_for_pickup: ["Ready", "v2-oc-badge-ready"],
          out_for_delivery: ["Out for delivery", "v2-oc-badge-ready"],
          picked_up: ["Picked up", "v2-oc-badge-done"],
          completed: ["Completed", "v2-oc-badge-done"],
          declined: ["Declined", "v2-oc-badge-urgent"],
          cancelled: ["Cancelled", "v2-oc-badge-urgent"],
          refunded: ["Refunded", "v2-oc-badge-urgent"],
        };
        const [badgeText, badgeCls] = statusBadges[o.status] || [o.status, "v2-oc-badge-new"];

        // Actions based on status (not tab — so search results also show actions)
        let actionsHtml = "";
        const isDelivery = o.order_type === "delivery";
        if (isPreorder) {
          const paidAmt = o.paid_amount ? Number(o.paid_amount).toLocaleString("en-IN") : "—";
          const priceMin = o.listing?.preorder_price_min;
          const priceMax = o.listing?.preorder_price_max;
          const rangeHtml = priceMin && priceMax
            ? `<div style="font:500 11px Inter;color:#7C3AED;">Your listed range: ₹${Number(priceMin).toLocaleString("en-IN")} – ₹${Number(priceMax).toLocaleString("en-IN")}</div>`
            : "";
          actionsHtml = `<div class="v2-oc-actions" style="flex-direction:column;gap:8px;">
            <div style="font:500 11px Inter;color:var(--v2-ink-3);">🌙 Next-day catch. Set actual price after receiving the fish.</div>
            <div style="font:600 12px Inter;color:#7C3AED;">Buyer pre-paid: ₹${paidAmt}</div>
            ${rangeHtml}
            <div style="display:flex;gap:8px;align-items:center;">
              <input type="number" placeholder="Final price (₹)" id="final-price-${o.id}" style="flex:1;padding:8px 10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 13px Inter;color:var(--v2-ink);background:var(--v2-bg);outline:none;box-sizing:border-box;min-height:36px;" />
              <button class="v2-btn v2-btn-sm" style="background:#7C3AED;color:#fff;white-space:nowrap;" data-action="set_final_price" data-order-id="${o.id}">Set price</button>
            </div>
            <div style="font:400 11px Inter;color:#D97706;">⚠️ If final &lt; ₹${paidAmt} → auto refund within 7 working days. If final &gt; ₹${paidAmt} → buyer approves extra.</div>
            <button class="v2-btn v2-btn-sm" style="background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-action="decline" data-order-id="${o.id}">Decline pre-order</button>
          </div>`;
        } else if (["pending", "scheduled"].includes(o.status)) {
          actionsHtml = `<div class="v2-oc-actions">
            <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-action="decline" data-order-id="${o.id}">Decline</button>
            <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-green);color:#fff;" data-action="accept" data-order-id="${o.id}">✓ Accept</button>
          </div>`;
        } else if (o.status === "confirmed" || o.status === "paid") {
          actionsHtml = isDelivery
            ? `<div class="v2-oc-actions">
                <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-brand);color:#fff;" data-action="out_for_delivery" data-order-id="${o.id}">🚲 Out for delivery</button>
              </div>`
            : `<div class="v2-oc-actions">
                <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-brand);color:#fff;" data-action="ready" data-order-id="${o.id}">📦 Ready for pickup</button>
              </div>`;
        } else if (o.status === "ready_for_pickup") {
          actionsHtml = `<div class="v2-oc-actions">
            <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-green);color:#fff;" data-action="picked_up" data-order-id="${o.id}">✓ Picked up</button>
          </div>`;
        } else if (o.status === "out_for_delivery") {
          actionsHtml = `<div class="v2-oc-actions">
            <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-green);color:#fff;" data-action="delivered" data-order-id="${o.id}">✓ Delivered</button>
          </div>`;
        } else if (o.status === "pending_payment") {
          const screenshotPaths: string[] = o.payment_screenshot_urls || [];
          const screenshotBtns = screenshotPaths.map((p, i) =>
            `<button class="v2-btn v2-btn-sm" style="background:#EEF2FF;color:#4F46E5;border:1px solid #C7D2FE;" data-action="view_screenshot" data-order-id="${o.id}" data-path="${encodeURIComponent(p)}">🖼 View proof ${screenshotPaths.length > 1 ? i + 1 : ''}</button>`
          ).join("");
          actionsHtml = `<div class="v2-oc-actions" style="flex-direction:column;gap:6px;">
            <div style="font:500 11px Inter;color:var(--v2-ink-3);">💳 Buyer uploaded payment proof</div>
            ${screenshotBtns ? `<div style="display:flex;gap:6px;flex-wrap:wrap;">${screenshotBtns}</div>` : ''}
            <div style="display:flex;gap:8px;">
              <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-action="decline" data-order-id="${o.id}">Decline</button>
              <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-green);color:#fff;" data-action="verify_payment" data-order-id="${o.id}">✓ Verify & Confirm</button>
            </div>
          </div>`;
        } else if (o.status === "cancelled" && o.paid_amount > 0) {
          const refundAmt = Number(o.paid_amount).toLocaleString("en-IN");
          const paymentSsPaths: string[] = o.payment_screenshot_urls || [];
          const paymentSsBtns = paymentSsPaths.map((p, i) =>
            `<button class="v2-btn v2-btn-sm" style="background:#EEF2FF;color:#4F46E5;border:1px solid #C7D2FE;" data-action="view_screenshot" data-order-id="${o.id}" data-path="${encodeURIComponent(p)}">🖼 Buyer proof ${paymentSsPaths.length > 1 ? i + 1 : ''}</button>`
          ).join("");
          if (o.refund_sent_at) {
            actionsHtml = `<div style="padding:10px;background:#F0FDF4;border:1px solid #86EFAC;border-radius:var(--v2-radius-sm);margin-top:6px;display:flex;flex-direction:column;gap:6px;">
              <div style="font:700 12px Inter;color:var(--v2-green);">✓ Refund of ₹${refundAmt} marked as sent</div>
              ${o.refund_note ? `<div style="font:400 11px Inter;color:var(--v2-ink-3);">${escape(o.refund_note)}</div>` : ''}
              <div style="font:400 10px Inter;color:var(--v2-ink-3);">${new Date(o.refund_sent_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" })}</div>
              ${paymentSsBtns ? `<div style="font:500 11px Inter;color:var(--v2-ink-3);">💳 Buyer's payment proof:</div><div style="display:flex;gap:6px;flex-wrap:wrap;">${paymentSsBtns}</div>` : ''}
            </div>`;
          } else {
            actionsHtml = `<div class="v2-oc-actions" style="flex-direction:column;gap:8px;" data-refund-block="${o.id}">
              <div style="font:700 12px Inter;color:#7C3AED;">↩ Refund ₹${refundAmt} to buyer via UPI</div>
              <div style="font:400 11px Inter;color:var(--v2-ink-3);">⏱ Buyer expects refund within 7 working days.</div>
              ${paymentSsBtns ? `<div style="font:500 11px Inter;color:var(--v2-ink-3);">💳 Buyer's payment proof:</div><div style="display:flex;gap:6px;flex-wrap:wrap;">${paymentSsBtns}</div>` : ''}
              <input type="text" placeholder="UTR number / note (optional)" id="refund-note-${o.id}" style="width:100%;padding:8px 10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 12px Inter;color:var(--v2-ink);background:var(--v2-bg);outline:none;box-sizing:border-box;" />
              <label style="cursor:pointer;">
                <div id="refund-drop-${o.id}" style="border:1.5px dashed var(--v2-border);border-radius:var(--v2-radius-sm);padding:8px 10px;text-align:center;font:500 11px Inter;color:var(--v2-ink-3);">📷 Upload your UPI screenshot (optional)</div>
                <input type="file" id="refund-file-${o.id}" accept="image/*" style="display:none;" />
              </label>
              <button class="v2-btn v2-btn-sm" style="background:#7C3AED;color:#fff;" data-action="mark_refund_sent" data-order-id="${o.id}">✓ Mark refund sent</button>
            </div>`;
          }
        } else if (o.status === "payment_required") {
          const balanceAmt = o.final_price && o.paid_amount ? (Number(o.final_price) - Number(o.paid_amount)).toLocaleString("en-IN") : "—";
          const balSsPaths: string[] = o.payment_screenshot_urls || [];
          const balSsBtns = balSsPaths.map((p, i) =>
            `<button class="v2-btn v2-btn-sm" style="background:#EEF2FF;color:#4F46E5;border:1px solid #C7D2FE;" data-action="view_screenshot" data-order-id="${o.id}" data-path="${encodeURIComponent(p)}">🖼 Buyer proof ${balSsPaths.length > 1 ? i + 1 : ''}</button>`
          ).join("");
          actionsHtml = `<div style="padding:10px;background:var(--v2-bg-2);border-radius:var(--v2-radius-sm);margin-top:6px;display:flex;flex-direction:column;gap:6px;">
            <div style="font:700 12px Inter;color:var(--v2-orange);">⏳ Waiting for balance ₹${balanceAmt}</div>
            <div style="font:400 11px Inter;color:var(--v2-ink-3);">Buyer notified. Will confirm once they pay the difference.</div>
            ${balSsBtns ? `<div style="font:500 11px Inter;color:var(--v2-ink-3);">💳 Buyer's payment proof:</div><div style="display:flex;gap:6px;flex-wrap:wrap;">${balSsBtns}</div>` : ''}
          </div>`;
        } else if (o.status === "refunded") {
          const refundAmt = o.paid_amount && o.final_price ? (Number(o.paid_amount) - Number(o.final_price)).toLocaleString("en-IN") : "—";
          const refSsPaths: string[] = o.payment_screenshot_urls || [];
          const refSsBtns = refSsPaths.map((p, i) =>
            `<button class="v2-btn v2-btn-sm" style="background:#EEF2FF;color:#4F46E5;border:1px solid #C7D2FE;" data-action="view_screenshot" data-order-id="${o.id}" data-path="${encodeURIComponent(p)}">🖼 Buyer proof ${refSsPaths.length > 1 ? i + 1 : ''}</button>`
          ).join("");
          if (o.refund_sent_at) {
            actionsHtml = `<div style="padding:10px;background:#F0FDF4;border:1px solid #86EFAC;border-radius:var(--v2-radius-sm);margin-top:6px;display:flex;flex-direction:column;gap:6px;">
              <div style="font:700 12px Inter;color:var(--v2-green);">✓ Refund of ₹${refundAmt} marked as sent</div>
              ${o.refund_note ? `<div style="font:400 11px Inter;color:var(--v2-ink-3);">${escape(o.refund_note)}</div>` : ''}
              <div style="font:400 10px Inter;color:var(--v2-ink-3);">${new Date(o.refund_sent_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" })}</div>
              ${refSsBtns ? `<div style="font:500 11px Inter;color:var(--v2-ink-3);">💳 Buyer's payment proof:</div><div style="display:flex;gap:6px;flex-wrap:wrap;">${refSsBtns}</div>` : ''}
            </div>`;
          } else {
            actionsHtml = `<div class="v2-oc-actions" style="flex-direction:column;gap:8px;" data-refund-block="${o.id}">
              <div style="font:700 12px Inter;color:#7C3AED;">↩ Refund ₹${refundAmt} to buyer via UPI</div>
              <div style="font:400 11px Inter;color:var(--v2-ink-3);">⏱ Buyer expects refund within 7 working days.</div>
              ${refSsBtns ? `<div style="font:500 11px Inter;color:var(--v2-ink-3);">💳 Buyer's payment proof:</div><div style="display:flex;gap:6px;flex-wrap:wrap;">${refSsBtns}</div>` : ''}
              <input type="text" placeholder="UTR number / note (optional)" id="refund-note-${o.id}" style="width:100%;padding:8px 10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 12px Inter;color:var(--v2-ink);background:var(--v2-bg);outline:none;box-sizing:border-box;" />
              <label style="cursor:pointer;">
                <div id="refund-drop-${o.id}" style="border:1.5px dashed var(--v2-border);border-radius:var(--v2-radius-sm);padding:8px 10px;text-align:center;font:500 11px Inter;color:var(--v2-ink-3);">📷 Upload your UPI screenshot (optional)</div>
                <input type="file" id="refund-file-${o.id}" accept="image/*" style="display:none;" />
              </label>
              <button class="v2-btn v2-btn-sm" style="background:#7C3AED;color:#fff;" data-action="mark_refund_sent" data-order-id="${o.id}">✓ Mark refund sent</button>
            </div>`;
          }
        }

        return `<div class="v2-seller-order ${cls}" data-order-id="${o.id}">
          <div class="v2-oc-top">
            <div>
              <div class="v2-oc-id">${isPreorder ? "🌙 " : ""}#${id6}${o.buyer_phone ? ' · ' + escape(o.buyer_phone.slice(-4)) : ''}</div>
              <div class="v2-oc-time">${escape(time)}</div>
            </div>
            <span class="v2-oc-badge ${badgeCls}">${badgeText}</span>
          </div>
          <div class="v2-oc-items" style="text-transform:capitalize;">${escape(o.listing?.species || o.species || "")} · ${o.quantity}${escape(o.quantity_unit || 'kg')}</div>
          ${o.cut_style ? `<div style="font:600 11px Inter;color:var(--v2-ink-2);margin-top:4px;">✂️ ${escape(o.cut_style.split(",").map((c: string) => ({whole:"Whole",cleaned:"Cleaned",cut:"Cut"})[c] || c).join(", "))}</div>` : ''}
          ${o.buyer_notes ? `<div style="font:400 11px Inter;color:var(--v2-ink-3);margin-top:2px;">📝 ${escape(o.buyer_notes)}</div>` : ''}
          <div class="v2-oc-total">₹${total.toLocaleString("en-IN")} · ${o.order_type === "delivery" ? "Cash on delivery" : "Pay at pickup"}</div>
          ${actionsHtml}
        </div>`;
      }).join("");

      const pagerHtml = totalPages > 1 ? `
        <div class="v2-pagination">
          <button class="v2-pg-btn" data-pg="prev" ${currentPage <= 1 ? 'disabled' : ''}>← Prev</button>
          <span class="v2-pg-info">Page ${currentPage} of ${totalPages}</span>
          <button class="v2-pg-btn" data-pg="next" ${currentPage >= totalPages ? 'disabled' : ''}>Next →</button>
        </div>` : '';

      list.innerHTML = orderHtml + pagerHtml;

      // Wire pagination
      list.querySelector('[data-pg="prev"]')?.addEventListener("click", () => { currentPage = Math.max(1, currentPage - 1); loadOrders(); });
      list.querySelector('[data-pg="next"]')?.addEventListener("click", () => { currentPage = Math.min(totalPages, currentPage + 1); loadOrders(); });

      // Wire actions
      list.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (btn.dataset.action === "view_screenshot") {
            viewScreenshot(btn.dataset.orderId!, btn.dataset.path!, btn);
          } else {
            updateStatus(btn.dataset.orderId!, btn.dataset.action!, btn);
          }
        });
      });
      // Wire refund file picker label updates
      list.querySelectorAll<HTMLInputElement>("input[id^='refund-file-']").forEach((inp) => {
        const orderId = inp.id.replace("refund-file-", "");
        inp.addEventListener("change", () => {
          const drop = document.getElementById(`refund-drop-${orderId}`);
          if (drop) drop.textContent = inp.files?.[0]?.name || "📷 Upload UPI screenshot (optional)";
        });
      });
  }

  async function viewScreenshot(orderId: string, encodedPath: string, btn: HTMLButtonElement) {
    const path = decodeURIComponent(encodedPath);
    const orig = btn.textContent || "";
    btn.disabled = true;
    btn.textContent = "Loading…";
    try {
      const res = await fetch(`/api/seller/payment-screenshot?order_id=${encodeURIComponent(orderId)}&seller_id=${encodeURIComponent(sellerId!)}&path=${encodeURIComponent(path)}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed");
      window.open(data.url, "_blank", "noopener");
    } catch (err: any) {
      (window as any).v2Toast?.("error", "Could not load screenshot", err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = orig;
    }
  }

  async function updateStatus(orderId: string, action: string, btn?: HTMLButtonElement) {
    if (!sellerId) return;
    // Actions that go directly to the API as action= (not status transitions)
    const apiActions = new Set(["verify_payment", "mark_refund_sent", "set_final_price"]);
    const statusMap: Record<string, string> = {
      accept: "confirmed",
      decline: "declined",
      ready: "ready_for_pickup",
      out_for_delivery: "out_for_delivery",
      picked_up: "completed",
      delivered: "completed",
    };
    const originalText = btn?.textContent || "";
    const loadingLabels: Record<string, string> = {
      accept: "Confirming…", decline: "Declining…", ready: "Updating…",
      out_for_delivery: "Updating…", picked_up: "Completing…", delivered: "Completing…",
      verify_payment: "Verifying…", mark_refund_sent: "Saving…", set_final_price: "Setting…",
    };
    const successLabels: Record<string, string> = {
      accept: "Confirmed", decline: "Declined", ready: "Marked ready",
      out_for_delivery: "Out for delivery", picked_up: "Completed", delivered: "Delivered",
      verify_payment: "Payment verified", mark_refund_sent: "Refund marked sent", set_final_price: "Price set",
    };
    if (btn) {
      btn.disabled = true;
      btn.textContent = loadingLabels[action] || "Updating…";
    }
    try {
      let body: Record<string, any> = { seller_id: sellerId, order_id: orderId };
      if (apiActions.has(action)) {
        body.action = action;
        if (action === "set_final_price") {
          const priceInput = document.getElementById(`final-price-${orderId}`) as HTMLInputElement | null;
          const finalPrice = parseFloat(priceInput?.value || "");
          if (isNaN(finalPrice) || finalPrice <= 0) {
            (window as any).v2Toast?.("error", "Invalid price", "Enter a valid final price");
            if (btn) { btn.disabled = false; btn.textContent = originalText; }
            return;
          }
          body.final_price = finalPrice;
        }
        if (action === "mark_refund_sent") {
          const noteInput = document.getElementById(`refund-note-${orderId}`) as HTMLInputElement | null;
          body.refund_note = noteInput?.value?.trim() || null;
          // Upload screenshot first if selected
          const fileInput = document.getElementById(`refund-file-${orderId}`) as HTMLInputElement | null;
          const file = fileInput?.files?.[0];
          if (file) {
            const form = new FormData();
            form.append("order_id", orderId);
            form.append("seller_id", sellerId!);
            form.append("file", file);
            const uploadRes = await fetch("/api/seller/upload-refund", { method: "POST", body: form });
            const uploadData = await uploadRes.json();
            if (uploadRes.ok && uploadData.path) {
              body.refund_screenshot_path = uploadData.path;
            }
          }
        }
      } else {
        body.status = statusMap[action] || "declined";
      }
      const res = await fetch("/api/seller/orders", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Update failed");
      (window as any).v2Toast?.("success", successLabels[action] || "Updated", "Order status updated");
      // Auto-switch to tab where order now lives
      const tabForStatus: Record<string, string> = {
        confirmed: "accepted", paid: "accepted", ready_for_pickup: "accepted", out_for_delivery: "accepted",
        completed: "completed", declined: "completed", cancelled: "completed", refunded: "completed",
      };
      // For action-based calls, derive status from returned order or action semantics
      const resolvedStatus = data.order?.status ?? body.status;
      const targetTab = tabForStatus[resolvedStatus];
      if (targetTab && targetTab !== currentTab) {
        currentTab = targetTab as any;
        currentPage = 1;
        document.querySelectorAll(".v2-dash-tab").forEach(t => t.classList.remove("v2-dash-tab-active"));
        document.querySelector(`.v2-dash-tab[data-tab="${targetTab}"]`)?.classList.add("v2-dash-tab-active");
      }
      await loadOrders(false);
    } catch (err: any) {
      (window as any).v2Toast?.("error", "Failed", err.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }
  }

  // Tab switching
  document.querySelectorAll<HTMLButtonElement>(".v2-dash-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".v2-dash-tab").forEach(t => t.classList.remove("v2-dash-tab-active"));
      tab.classList.add("v2-dash-tab-active");
      currentTab = tab.dataset.tab as any;
      currentPage = 1;
      loadOrders();
    });
  });

  // Range filter
  document.getElementById("v2-dash-range")?.addEventListener("change", (e) => {
    currentRange = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    loadOrders();
  });

  // Search by order ID or phone
  let searchTimer: any;
  document.getElementById("v2-dash-search")?.addEventListener("input", (e) => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      currentPage = 1;
      loadOrders();
    }, 400);
  });

  // CSV export — respects current range
  document.getElementById("v2-dash-export")?.addEventListener("click", (e) => {
    e.preventDefault();
    if (!sellerId) return;
    const url = `/api/seller/orders-export?seller_id=${encodeURIComponent(sellerId)}&date_filter=${encodeURIComponent(currentRange)}`;
    window.location.href = url;
  });

  // Mark all visible pending orders as confirmed (Promise.all fan-out)
  document.getElementById("v2-mark-ready")?.addEventListener("click", async () => {
    if (!sellerId) return;
    const list = document.getElementById("v2-orders-list");
    const cards = Array.from(list?.querySelectorAll<HTMLDivElement>("[data-order-id]") || []);
    const ids = cards.map((c) => c.dataset.orderId!).filter(Boolean);
    if (ids.length === 0) {
      (window as any).v2Toast?.("error", "Nothing to confirm", "No pending orders in view");
      return;
    }
    if (!confirm(`Confirm all ${ids.length} pending order${ids.length !== 1 ? "s" : ""} now?`)) return;
    const btn = document.getElementById("v2-mark-ready") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = `Confirming ${ids.length}…`;
    const results = await Promise.all(ids.map(async (id) => {
      try {
        const res = await fetch("/api/seller/orders", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ seller_id: sellerId, order_id: id, status: "confirmed" }),
        });
        return res.ok;
      } catch { return false; }
    }));
    const ok = results.filter(Boolean).length;
    const fail = results.length - ok;
    if (fail === 0) {
      (window as any).v2Toast?.("success", `${ok} confirmed`, "All pending orders accepted");
    } else {
      (window as any).v2Toast?.("error", `${ok} confirmed, ${fail} failed`, "Retry the failed ones individually");
    }
    btn.disabled = false;
    btn.textContent = "✓ Mark all ready";
    await loadOrders(false);
  });

  // Wire empty-state CTAs (Refresh status + Sign out on pending activation page)
  document.querySelectorAll<HTMLElement>(".v2-empty-ghost").forEach((el) => {
    if (el.textContent?.includes("Sign out")) {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        try {
          localStorage.removeItem("zepto_seller_id");
          localStorage.removeItem("zepto_seller_phone");
        } catch {}
        window.location.href = "/v2/dashboard/login";
      });
    }
  });
  // "Refresh status" button = reload
  const refreshBtn = document.getElementById("v2-dash-not-active")?.querySelector(".v2-btn");
  refreshBtn?.addEventListener("click", () => location.reload());

  // Stats panel toggle (hidden by default)
  document.getElementById("v2-stats-toggle")?.addEventListener("click", () => {
    const panel = document.getElementById("v2-dash-stats-panel")!;
    const btn = document.getElementById("v2-stats-toggle")!;
    const open = panel.style.display !== "none";
    panel.style.display = open ? "none" : "block";
    btn.textContent = open ? "Stats ▼" : "Stats ▲";
  });

  init();
</script>
