---
export const prerender = false;
import AppShellV2 from "../../../../components/v2/AppShellV2.astro";
import Toast from "../../../../components/v2/atoms/Toast.astro";
import EmptyState from "../../../../components/v2/molecules/EmptyState.astro";
---
<AppShellV2
  title="Orders · Seller Dashboard"
  description="Manage today's orders"
  hideHeader={true}
  nav={{ active: "orders", mode: "seller" }}
>
  <Toast />

  <div id="v2-dash-content" style="display:none;">
    <!-- Hero with stats -->
    <div class="v2-dash-hero">
      <div class="v2-dash-greet">Good day, <span id="v2-dash-name">seller</span></div>
      <div class="v2-dash-title">Today's pipeline</div>
      <div class="v2-dash-stats">
        <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-pending">—</div><div class="v2-dash-l">New orders</div></div>
        <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-gmv">₹0</div><div class="v2-dash-l">Today's GMV</div></div>
        <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-preorders">—</div><div class="v2-dash-l">Pre-orders</div></div>
      </div>
    </div>

    <!-- Action row -->
    <div class="v2-dash-actions">
      <button class="v2-btn v2-btn-primary v2-btn-sm" id="v2-mark-ready">✓ Mark all ready</button>
      <a href="/v2/dashboard/listings/new" class="v2-btn v2-btn-secondary v2-btn-sm">➕ Listing</a>
    </div>

    <!-- Tabs -->
    <div class="v2-dash-tabs">
      <button class="v2-dash-tab v2-dash-tab-active" data-tab="pending">Pending <span class="v2-dash-tab-count" id="v2-tab-pending-count">0</span></button>
      <button class="v2-dash-tab" data-tab="accepted">Accepted</button>
      <button class="v2-dash-tab" data-tab="completed">Completed</button>
    </div>

    <!-- Date filter + export -->
    <div class="v2-dash-filterbar">
      <label class="v2-dash-filter-lbl">Range:</label>
      <select id="v2-dash-range" class="v2-dash-select">
        <option value="today">Today</option>
        <option value="7d">Last 7 days</option>
        <option value="30d" selected>Last 30 days</option>
        <option value="all">All time</option>
      </select>
      <a id="v2-dash-export" href="#" class="v2-dash-export-link" title="Download orders as CSV">⬇ CSV</a>
      <span style="flex:1;"></span>
      <span id="v2-orders-count" class="v2-dash-filter-lbl"></span>
    </div>

    <div id="v2-orders-list">
      <div style="text-align:center;padding:24px;color:var(--v2-ink-3);font:500 12px Inter;">
        <span class="v2-spinner v2-spinner-md"></span><div style="margin-top:8px;">Loading orders...</div>
      </div>
    </div>
  </div>

  <div id="v2-dash-not-active" style="display:none;padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Account pending activation"
      description="Your seller account is awaiting admin approval. We'll notify you when activated."
      ctaText="Refresh status"
      ghostCtaText="Sign out"
    />
  </div>

  <div id="v2-dash-no-auth" style="display:none;padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Sign in required"
      description="Please sign in to access your seller dashboard."
      ctaText="Sign in"
      ctaHref="/v2/dashboard/login"
    />
  </div>
</AppShellV2>

<style is:global>
  .v2-dash-hero {
    background: linear-gradient(135deg, var(--v2-green), #10B981);
    padding: 16px;
    color: #fff;
  }
  .v2-dash-greet { font: 400 12px Inter; opacity: .9; }
  .v2-dash-title { font: 800 20px Inter; margin-top: 2px; }
  .v2-dash-stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 8px; margin-top: 16px;
  }
  .v2-dash-stat {
    background: rgba(255, 255, 255, .15);
    border-radius: 10px;
    padding: 10px;
    text-align: center;
    backdrop-filter: blur(10px);
  }
  .v2-dash-v { font: 800 18px Inter; color: #fff; }
  .v2-dash-l { font: 500 10px Inter; color: rgba(255, 255, 255, .9); margin-top: 1px; }
  .v2-dash-actions {
    display: flex; gap: 8px;
    padding: 16px;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
  }
  .v2-dash-actions .v2-btn { flex: 1; }
  .v2-dash-tabs {
    display: flex;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .v2-dash-tabs::-webkit-scrollbar { display: none; }
  .v2-dash-tab {
    flex: 1; padding: 12px;
    font: 600 12px Inter;
    color: var(--v2-ink-3);
    text-align: center;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    white-space: nowrap;
    min-width: 100px;
  }
  .v2-dash-tab-active { color: var(--v2-brand); }
  .v2-dash-tab-active::after {
    content: '';
    position: absolute; bottom: 0; left: 16px; right: 16px;
    height: 2px;
    background: var(--v2-brand);
  }
  .v2-dash-tab-count {
    font-size: 10px;
    margin-left: 4px;
    background: var(--v2-red); color: #fff;
    padding: 1px 6px;
    border-radius: 9999px;
  }
  .v2-dash-filterbar {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
  }
  .v2-dash-filter-lbl {
    font: 600 11px Inter; color: var(--v2-ink-3);
  }
  .v2-dash-select {
    background: var(--v2-bg-2);
    border: 1px solid var(--v2-border);
    color: var(--v2-ink);
    font: 600 12px Inter;
    padding: 6px 10px;
    border-radius: var(--v2-radius-sm);
    cursor: pointer;
  }
  .v2-dash-export-link {
    font: 600 12px Inter;
    color: var(--v2-brand);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: var(--v2-radius-sm);
    border: 1px solid var(--v2-border);
    background: var(--v2-bg-2);
  }
  .v2-dash-export-link:hover { background: var(--v2-brand-l); }
  .v2-pagination {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px;
    gap: 8px;
  }
  .v2-pg-btn {
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    color: var(--v2-ink);
    font: 600 12px Inter;
    padding: 8px 14px;
    border-radius: var(--v2-radius-sm);
    cursor: pointer;
  }
  .v2-pg-btn:disabled { opacity: .4; cursor: not-allowed; }
  .v2-pg-info { font: 500 12px Inter; color: var(--v2-ink-3); }
</style>

<script>
  import { supabase } from "../../../../lib/supabase";

  let sellerId: string | null = null;
  let sellerData: any = null;
  let currentTab: "pending" | "accepted" | "completed" = "pending";
  let currentRange = "30d";
  let currentPage = 1;
  const PAGE_SIZE = 20;
  let pollTimer: any;

  const STATUS_BY_TAB: Record<string, string[]> = {
    pending: ["pending", "pre_order", "scheduled"],
    accepted: ["confirmed", "paid", "ready_for_pickup"],
    completed: ["picked_up", "completed", "declined", "cancelled", "refunded"],
  };

  function rangeToDate(r: string): Date | null {
    const now = new Date();
    if (r === "today") { const d = new Date(); d.setHours(0,0,0,0); return d; }
    if (r === "7d") return new Date(now.getTime() - 7 * 86400000);
    if (r === "30d") return new Date(now.getTime() - 30 * 86400000);
    return null;
  }

  function getSellerId() {
    try { return localStorage.getItem("zepto_seller_id"); } catch { return null; }
  }

  function escape(s: string) {
    return String(s || "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!));
  }

  async function init() {
    sellerId = getSellerId();
    if (!sellerId) {
      document.getElementById("v2-dash-no-auth")!.style.display = "block";
      return;
    }
    try {
      const { data } = await supabase.from("sellers").select("*").eq("id", sellerId).single();
      sellerData = data;
      if (!sellerData?.is_active) {
        document.getElementById("v2-dash-not-active")!.style.display = "block";
        return;
      }
      document.getElementById("v2-dash-content")!.style.display = "block";
      document.getElementById("v2-dash-name")!.textContent = sellerData.name || "seller";
      await loadOrders();
      // Poll every 10s while on pending tab
      pollTimer = setInterval(() => { if (currentTab === "pending") loadOrders(false); }, 10000);
    } catch (err) {
      console.error("dash init failed", err);
      (window as any).v2Toast?.("error", "Load failed", "Refresh to try again");
    }
  }

  async function loadOrders(showSpinner = true) {
    if (!sellerId) return;
    const list = document.getElementById("v2-orders-list")!;

    if (showSpinner) {
      list.innerHTML = `<div style="text-align:center;padding:24px;color:var(--v2-ink-3);font:500 12px Inter;"><span class="v2-spinner v2-spinner-md"></span><div style="margin-top:8px;">Loading orders...</div></div>`;
    }

    try {
      // Get listing ids for this seller
      const { data: listings } = await supabase.from("fish_listings").select("id").eq("seller_id", sellerId);
      const listingIds = (listings || []).map((l: any) => l.id);

      if (listingIds.length === 0) {
        list.innerHTML = `<div style="padding:24px 16px;"><div class="v2-empty"><div class="v2-empty-icon">📋</div><h3 class="v2-empty-title">No listings yet</h3><p class="v2-empty-desc">Create your first listing to start receiving orders.</p><a href="/v2/dashboard/listings/new" class="v2-btn v2-btn-primary v2-btn-md">Create listing</a></div></div>`;
        return;
      }

      // === Stats (always fetch today's snapshot independently of pagination) ===
      const todayStart = new Date(); todayStart.setHours(0,0,0,0);
      const { data: todayOrdersRaw } = await supabase
        .from("orders")
        .select("status, total_price")
        .in("listing_id", listingIds)
        .gte("created_at", todayStart.toISOString());
      const todayOrders = todayOrdersRaw || [];
      const pendingTotal = todayOrders.filter((o: any) => STATUS_BY_TAB.pending.includes(o.status)).length;
      const preOrdersTotal = todayOrders.filter((o: any) => o.status === "pre_order").length;
      const todayGmv = todayOrders.reduce((s: number, o: any) => s + (o.total_price || 0), 0);
      document.getElementById("v2-dash-pending")!.textContent = String(pendingTotal);
      document.getElementById("v2-dash-gmv")!.textContent = `₹${todayGmv.toLocaleString("en-IN")}`;
      document.getElementById("v2-dash-preorders")!.textContent = String(preOrdersTotal);
      document.getElementById("v2-tab-pending-count")!.textContent = String(pendingTotal);

      // === Paginated orders for current tab + range ===
      const sinceDate = rangeToDate(currentRange);
      const offset = (currentPage - 1) * PAGE_SIZE;
      let q = supabase
        .from("orders")
        .select("*, listing:fish_listings(species)", { count: "exact" })
        .in("listing_id", listingIds)
        .in("status", STATUS_BY_TAB[currentTab])
        .order("created_at", { ascending: false })
        .range(offset, offset + PAGE_SIZE - 1);
      if (sinceDate) q = q.gte("created_at", sinceDate.toISOString());

      const { data: orders, count } = await q;
      const ordersToShow = orders || [];
      const totalCount = count || 0;
      const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
      document.getElementById("v2-orders-count")!.textContent = totalCount > 0 ? `${totalCount} ${currentTab}` : "";

      if (ordersToShow.length === 0) {
        list.innerHTML = `<div style="padding:32px 16px;text-align:center;color:var(--v2-ink-3);font:500 13px Inter;">No ${currentTab} orders in this range</div>`;
        return;
      }

      const orderHtml = ordersToShow.map((o: any) => {
        const isPreorder = o.status === "pre_order";
        const isUrgent = o.scheduled_for && new Date(o.scheduled_for).getTime() - Date.now() < 60 * 60 * 1000;
        const time = o.scheduled_for
          ? new Date(o.scheduled_for).toLocaleString("en-IN", { weekday: "short", hour: "numeric", minute: "2-digit" })
          : new Date(o.created_at).toLocaleString("en-IN", { hour: "numeric", minute: "2-digit" });
        const cls = isUrgent ? "v2-order-urgent" : "";
        const badge = isPreorder ? "v2-oc-badge-preorder" : isUrgent ? "v2-oc-badge-urgent" : "v2-oc-badge-new";
        const badgeText = isPreorder ? "Pre-order" : isUrgent ? "Urgent" : "New";
        const accept = isPreorder ? "Confirm" : "Accept";
        const acceptBg = isPreorder ? "#7C3AED" : "var(--v2-green)";
        const showActions = currentTab === "pending";
        const total = o.total_price || o.final_price || 0;
        const id6 = String(o.id || "").slice(0, 6).toUpperCase();
        return `<div class="v2-seller-order ${cls}" data-order-id="${o.id}">
          <div class="v2-oc-top">
            <div>
              <div class="v2-oc-id">${isPreorder ? "🌙 " : ""}#${id6}${o.buyer_phone ? ' · ' + escape(o.buyer_phone.slice(-4)) : ''}</div>
              <div class="v2-oc-time">${escape(time)}</div>
            </div>
            <span class="v2-oc-badge ${badge}">${badgeText}</span>
          </div>
          <div class="v2-oc-items">${escape(o.listing?.species || o.species || "")} · ${o.quantity}${escape(o.quantity_unit || 'kg')}</div>
          <div class="v2-oc-total">₹${total.toLocaleString("en-IN")} · ${o.paid_amount ? "UPI paid" : "Pay at pickup"}</div>
          ${showActions ? `<div class="v2-oc-actions">
            <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-action="decline" data-order-id="${o.id}">Decline</button>
            <button class="v2-btn v2-btn-sm" style="flex:1;background:${acceptBg};color:#fff;" data-action="accept" data-order-id="${o.id}">✓ ${accept}</button>
          </div>` : ''}
        </div>`;
      }).join("");

      const pagerHtml = totalPages > 1 ? `
        <div class="v2-pagination">
          <button class="v2-pg-btn" data-pg="prev" ${currentPage <= 1 ? 'disabled' : ''}>← Prev</button>
          <span class="v2-pg-info">Page ${currentPage} of ${totalPages}</span>
          <button class="v2-pg-btn" data-pg="next" ${currentPage >= totalPages ? 'disabled' : ''}>Next →</button>
        </div>` : '';

      list.innerHTML = orderHtml + pagerHtml;

      // Wire pagination
      list.querySelector('[data-pg="prev"]')?.addEventListener("click", () => { currentPage = Math.max(1, currentPage - 1); loadOrders(); });
      list.querySelector('[data-pg="next"]')?.addEventListener("click", () => { currentPage = Math.min(totalPages, currentPage + 1); loadOrders(); });

      // Wire actions
      list.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((btn) => {
        btn.addEventListener("click", () => updateStatus(btn.dataset.orderId!, btn.dataset.action!, btn));
      });
    } catch (err: any) {
      console.error("loadOrders failed", err);
      list.innerHTML = `<div style="text-align:center;padding:24px;color:var(--v2-red);font:500 13px Inter;">Failed to load orders</div>`;
    }
  }

  async function updateStatus(orderId: string, action: string, btn?: HTMLButtonElement) {
    if (!sellerId) return;
    const newStatus = action === "accept" ? "confirmed" : "declined";
    const originalText = btn?.textContent || "";
    if (btn) {
      btn.disabled = true;
      btn.textContent = action === "accept" ? "Confirming…" : "Declining…";
    }
    try {
      const res = await fetch("/api/seller/orders", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ seller_id: sellerId, order_id: orderId, status: newStatus }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Update failed");
      (window as any).v2Toast?.("success", action === "accept" ? "Accepted" : "Declined", "Order status updated");
      await loadOrders(false);
    } catch (err: any) {
      (window as any).v2Toast?.("error", "Failed", err.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }
  }

  // Tab switching
  document.querySelectorAll<HTMLButtonElement>(".v2-dash-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".v2-dash-tab").forEach(t => t.classList.remove("v2-dash-tab-active"));
      tab.classList.add("v2-dash-tab-active");
      currentTab = tab.dataset.tab as any;
      currentPage = 1;
      loadOrders();
    });
  });

  // Range filter
  document.getElementById("v2-dash-range")?.addEventListener("change", (e) => {
    currentRange = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    loadOrders();
  });

  // CSV export — respects current range
  document.getElementById("v2-dash-export")?.addEventListener("click", (e) => {
    e.preventDefault();
    if (!sellerId) return;
    const url = `/api/seller/orders-export?seller_id=${encodeURIComponent(sellerId)}&date_filter=${encodeURIComponent(currentRange === "all" ? "30d" : currentRange)}`;
    window.location.href = url;
  });

  // Mark all visible pending orders as confirmed (Promise.all fan-out)
  document.getElementById("v2-mark-ready")?.addEventListener("click", async () => {
    if (!sellerId) return;
    const list = document.getElementById("v2-orders-list");
    const cards = Array.from(list?.querySelectorAll<HTMLDivElement>("[data-order-id]") || []);
    const ids = cards.map((c) => c.dataset.orderId!).filter(Boolean);
    if (ids.length === 0) {
      (window as any).v2Toast?.("error", "Nothing to confirm", "No pending orders in view");
      return;
    }
    if (!confirm(`Confirm all ${ids.length} pending order${ids.length !== 1 ? "s" : ""} now?`)) return;
    const btn = document.getElementById("v2-mark-ready") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = `Confirming ${ids.length}…`;
    const results = await Promise.all(ids.map(async (id) => {
      try {
        const res = await fetch("/api/seller/orders", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ seller_id: sellerId, order_id: id, status: "confirmed" }),
        });
        return res.ok;
      } catch { return false; }
    }));
    const ok = results.filter(Boolean).length;
    const fail = results.length - ok;
    if (fail === 0) {
      (window as any).v2Toast?.("success", `${ok} confirmed`, "All pending orders accepted");
    } else {
      (window as any).v2Toast?.("error", `${ok} confirmed, ${fail} failed`, "Retry the failed ones individually");
    }
    btn.disabled = false;
    btn.textContent = "✓ Mark all ready";
    await loadOrders(false);
  });

  // Wire empty-state CTAs (Refresh status + Sign out on pending activation page)
  document.querySelectorAll<HTMLElement>(".v2-empty-ghost").forEach((el) => {
    if (el.textContent?.includes("Sign out")) {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        try {
          localStorage.removeItem("zepto_seller_id");
          localStorage.removeItem("zepto_seller_phone");
        } catch {}
        window.location.href = "/v2/dashboard/login";
      });
    }
  });
  // "Refresh status" button = reload
  const refreshBtn = document.getElementById("v2-dash-not-active")?.querySelector(".v2-btn");
  refreshBtn?.addEventListener("click", () => location.reload());

  init();
</script>
