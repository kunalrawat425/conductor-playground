---
export const prerender = false;
import AppShellV2 from "../../../components/v2/AppShellV2.astro";
import LoginSheet from "../../../components/v2/organisms/LoginSheet.astro";
import Toast from "../../../components/v2/atoms/Toast.astro";
---
<AppShellV2
  title="Seller Sign In · Relifish"
  description="Sign in to your seller dashboard"
  hideNav={true}
  hideHeader={true}
>
  <Toast />
  <div style="background:linear-gradient(135deg,var(--v2-green),#10B981);padding:48px 16px 32px;color:#fff;text-align:center;">
    <div style="font-size:64px;margin-bottom:12px;">🐟</div>
    <h1 style="font:900 24px Inter;margin:0 0 6px;letter-spacing:-.02em;">Seller dashboard</h1>
    <p style="font:400 14px Inter;opacity:.9;margin:0;">Sign in to manage your fish listings and orders</p>
  </div>

  <div style="padding:24px 16px;">
    <button id="open-login-sheet" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full">
      Sign in with phone
    </button>

    <div style="margin-top:24px;text-align:center;">
      <a href="/v2" style="font:600 13px Inter;color:var(--v2-ink-3);text-decoration:none;">← Back to buyer app</a>
    </div>
  </div>

  <LoginSheet id="seller-login-sheet" role="seller" redirectTo="/v2/dashboard/orders" />

  <script>
    document.getElementById("open-login-sheet")?.addEventListener("click", () => {
      (window as any).v2OpenSheet?.("seller-login-sheet");
    });
    // Auto-open sheet on page load for faster flow
    setTimeout(() => (window as any).v2OpenSheet?.("seller-login-sheet"), 300);
  </script>
</AppShellV2>
