---
export const prerender = false;
import AppShellV2 from "../../../../components/v2/AppShellV2.astro";
import Toast from "../../../../components/v2/atoms/Toast.astro";
import EmptyState from "../../../../components/v2/molecules/EmptyState.astro";
---
<AppShellV2
  title="Listings · Seller Dashboard"
  description="Manage your fish listings"
  header={{ variant: "page", title: "My listings", backHref: "/v2/dashboard/orders" }}
  nav={{ active: "listings" as any, mode: "seller" }}
>
  <Toast />

  <div style="padding:16px;">
    <a href="/v2/dashboard/listings/new" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full" style="margin-bottom:16px;">
      + Add new listing
    </a>

    <div id="v2-listings-loading" style="text-align:center;padding:24px;color:var(--v2-ink-3);font:500 12px Inter;">
      <span class="v2-spinner v2-spinner-md"></span>
      <div style="margin-top:8px;">Loading listings...</div>
    </div>

    <div id="v2-listings-list" style="display:none;"></div>

    <div id="v2-listings-empty" style="display:none;">
      <EmptyState
        variant="no-orders"
        title="No listings yet"
        description="Add your first fish listing to start receiving orders."
        ctaText="Add listing"
        ctaHref="/v2/dashboard/listings/new"
      />
    </div>
  </div>
</AppShellV2>

<script>
  import { supabase } from "../../../../lib/supabase";

  function getSellerId() { try { return localStorage.getItem("zepto_seller_id"); } catch { return null; } }
  function escape(s: string) { return String(s||"").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!)); }

  async function load() {
    const sellerId = getSellerId();
    const loading = document.getElementById("v2-listings-loading")!;
    const list = document.getElementById("v2-listings-list")!;
    const empty = document.getElementById("v2-listings-empty")!;

    if (!sellerId) {
      loading.innerHTML = `<div style="color:var(--v2-red);">Sign in required. <a href="/v2/dashboard/login" style="color:var(--v2-brand);">Sign in →</a></div>`;
      return;
    }

    try {
      const { data: listings, error } = await supabase
        .from("fish_listings")
        .select("*")
        .eq("seller_id", sellerId)
        .is("deleted_at", null)
        .order("created_at", { ascending: false });

      loading.style.display = "none";
      if (error) throw error;
      if (!listings || listings.length === 0) {
        empty.style.display = "block";
        return;
      }

      // Keep a local copy so we can update one card optimistically without a full re-fetch.
      let _listings: any[] = listings;
      function renderCard(l: any): string {
        const opt = (l.pricing_options || [])[0] || {};
        const price = opt.price || 0;
        const unit = opt.unit_label || "kg";
        const stock = l.weight_avail || 0;
        return `<div class="v2-listing-card" data-listing-id="${l.id}">
          <div class="v2-lc-img">${l.photo_url ? `<img src="${l.photo_url}" alt="${escape(l.species)}">` : '🐟'}</div>
          <div class="v2-lc-body">
            <div class="v2-lc-name">${escape(l.species)}${l.is_available ? '' : ' · <span style="color:var(--v2-orange);font-weight:600;">PAUSED</span>'}</div>
            <div class="v2-lc-meta">₹${price}/${escape(unit)} · ${stock}${escape(unit)} available</div>
            <div style="margin-top:8px;display:flex;gap:6px;">
              <a href="/v2/dashboard/listings/${l.id}" class="v2-btn v2-btn-secondary v2-btn-sm" style="flex:1;text-decoration:none;">Edit</a>
              <button class="v2-btn v2-btn-sm" style="flex:1;background:${l.is_available ? 'var(--v2-orange-l)' : 'var(--v2-green-l)'};color:${l.is_available ? 'var(--v2-orange)' : 'var(--v2-green)'};" data-toggle-id="${l.id}" data-toggle-state="${l.is_available}">${l.is_available ? '⏸ Pause' : '▶ Resume'}</button>
              <button class="v2-btn v2-btn-sm" style="flex:0 0 44px;background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-delete-id="${l.id}" data-delete-name="${escape(l.species)}" title="Delete listing">🗑</button>
            </div>
          </div>
        </div>`;
      }

      list.style.display = "block";
      list.innerHTML = _listings.map(renderCard).join("");

      function rerenderOne(lid: string) {
        const l = _listings.find((x) => x.id === lid);
        if (!l) return;
        const card = list.querySelector(`[data-listing-id="${lid}"]`);
        if (card) card.outerHTML = renderCard(l);
        wireCardActions();
      }

      function removeCard(lid: string) {
        _listings = _listings.filter((x) => x.id !== lid);
        const card = list.querySelector(`[data-listing-id="${lid}"]`);
        if (card) card.remove();
        if (_listings.length === 0) {
          list.style.display = "none";
          empty.style.display = "block";
        }
      }

      function wireCardActions() {
        list.querySelectorAll<HTMLButtonElement>("[data-toggle-id]").forEach((btn) => {
          btn.onclick = async () => {
            const lid = btn.dataset.toggleId!;
            const l = _listings.find((x) => x.id === lid);
            if (!l) return;
            const prev = !!l.is_available;
            const next = !prev;
            // Optimistic flip
            l.is_available = next;
            rerenderOne(lid);
            try {
              const res = await fetch("/api/seller/listings", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "update", seller_id: sellerId, listing_id: lid, updates: { is_available: next } }),
              });
              const data = await res.json();
              if (!res.ok) throw new Error(data.error || "Failed");
              (window as any).v2Toast?.("success", next ? "Listing live" : "Paused", "Buyers will see updated state");
            } catch (err: any) {
              // Rollback
              l.is_available = prev;
              rerenderOne(lid);
              (window as any).v2Toast?.("error", "Failed", err.message);
            }
          };
        });
        list.querySelectorAll<HTMLButtonElement>("[data-delete-id]").forEach((btn) => {
          btn.onclick = async () => {
            const lid = btn.dataset.deleteId!;
            const name = btn.dataset.deleteName!;
            if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;
            btn.disabled = true;
            btn.textContent = "…";
            try {
              const res = await fetch("/api/seller/listings", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "delete", seller_id: sellerId, listing_id: lid }),
              });
              const data = await res.json();
              if (!res.ok) throw new Error(data.error || "Delete failed");
              removeCard(lid);
              (window as any).v2Toast?.("success", "Deleted", `${name} removed from your menu`);
            } catch (err: any) {
              btn.disabled = false;
              btn.textContent = "🗑";
              (window as any).v2Toast?.("error", "Delete failed", err.message);
            }
          };
        });
      }
      wireCardActions();
    } catch (err: any) {
      loading.innerHTML = `<div style="color:var(--v2-red);">Failed to load: ${escape(err.message)}</div>`;
    }
  }
  load();
</script>

<style is:global>
  .v2-listing-card {
    display: flex; gap: 12px;
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius);
    padding: 12px;
    margin-bottom: 12px;
  }
  .v2-lc-img {
    width: 70px; height: 70px;
    border-radius: 10px;
    background: var(--v2-bg-3);
    display: flex; align-items: center; justify-content: center;
    font-size: 32px;
    flex-shrink: 0;
    overflow: hidden;
  }
  .v2-lc-img img { width: 100%; height: 100%; object-fit: cover; }
  .v2-lc-body { flex: 1; min-width: 0; }
  .v2-lc-name { font: 700 14px Inter; color: var(--v2-ink); }
  .v2-lc-meta { font: 400 12px Inter; color: var(--v2-ink-3); margin-top: 2px; }
</style>
