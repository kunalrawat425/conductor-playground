---
export const prerender = false;
import AppShellV2 from "../../../components/v2/AppShellV2.astro";
import PreorderBanner from "../../../components/v2/molecules/PreorderBanner.astro";
import EmptyState from "../../../components/v2/molecules/EmptyState.astro";
import Skeleton from "../../../components/v2/atoms/Skeleton.astro";
import Toast from "../../../components/v2/atoms/Toast.astro";

const species = [
  { id: "surmai", name: "Surmai", emoji: "🐟", marathi: "सुरमई" },
  { id: "rawas", name: "Rawas", emoji: "🐟", marathi: "रावस" },
  { id: "pomfret", name: "Pomfret", emoji: "🐟", marathi: "पापलेट" },
  { id: "bangda", name: "Bangda", emoji: "🐟", marathi: "बांगडा" },
  { id: "ghol", name: "Ghol", emoji: "🐟", marathi: "घोल" },
  { id: "hilsa", name: "Hilsa", emoji: "🐟", marathi: "पाला" },
  { id: "prawn", name: "Prawns", emoji: "🦐", marathi: "कोलंबी" },
  { id: "crab", name: "Crab", emoji: "🦀", marathi: "खेकडा" },
];
---
<AppShellV2
  title="Pre-order · Relifish"
  description="Pre-order tomorrow's catch from Mumbai sellers"
  header={{ variant: "preorder", locationLabel: "Pre-order mode", locationSub: "Tomorrow's catch, reserved tonight" }}
  nav={{ active: "preorder" }}
>
  <Toast />

  <div style="padding:16px;">
    <PreorderBanner variant="hero" title="Order tomorrow's catch tonight" description="Pick species. Pick seller. We confirm in the morning." ctaText="" />
  </div>

  <div style="padding:0 16px;">
    <h2 style="font:800 17px Inter;color:var(--v2-ink);margin:8px 0 12px;">Popular species</h2>
    <div class="v2-species-grid">
      {species.map((sp) => (
        <a href={`/v2/preorder/${sp.id}`} class="v2-species-card">
          <div class="v2-species-emoji">{sp.emoji}</div>
          <div class="v2-species-name">{sp.name}</div>
          <div class="v2-species-marathi">{sp.marathi}</div>
        </a>
      ))}
    </div>

    <h2 style="font:800 17px Inter;color:var(--v2-ink);margin:24px 0 12px;">Sellers accepting pre-orders</h2>
    <div id="v2-preorder-loading">
      <div style="margin-bottom:12px;"><Skeleton shape="card" height="120px" /></div>
      <div><Skeleton shape="card" height="120px" /></div>
    </div>
    <div id="v2-preorder-sellers" style="display:none;"></div>
    <div id="v2-preorder-empty" style="display:none;">
      <EmptyState variant="no-results" title="No pre-order sellers in your area" description="Be the first to know when sellers go live for pre-orders." ctaText="Join waitlist" ctaHref="/buyer-banner.html" />
    </div>
  </div>
</AppShellV2>

<style is:global>
  .v2-species-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  @media (max-width: 380px) {
    .v2-species-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .v2-species-card {
    background: #fff;
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius);
    padding: 12px 8px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform var(--v2-dur-fast) var(--v2-ease), border-color var(--v2-dur-fast) var(--v2-ease);
  }
  .v2-species-card:hover { transform: translateY(-2px); border-color: var(--v2-brand); }
  .v2-species-emoji { font-size: 32px; }
  .v2-species-name { font: 700 12px Inter; color: var(--v2-ink); margin-top: 4px; }
  .v2-species-marathi { font: 400 10px Inter; color: var(--v2-ink-3); margin-top: 1px; }
</style>

<script>
  import { supabase } from "../../../lib/supabase";

  function escape(s: string) {
    return String(s || "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!));
  }

  async function loadSellers() {
    const loading = document.getElementById("v2-preorder-loading")!;
    const list = document.getElementById("v2-preorder-sellers")!;
    const empty = document.getElementById("v2-preorder-empty")!;

    try {
      const { data: sellers } = await supabase
        .from("sellers")
        .select("id, name, location_name, lat, lng, opens_at, closes_at, accepts_preorder, has_delivery, rating_avg")
        .eq("is_active", true)
        .eq("accepts_preorder", true)
        .neq("name", "New Seller");

      loading.style.display = "none";
      if (!sellers || sellers.length === 0) {
        empty.style.display = "block";
        return;
      }

      list.style.display = "block";
      list.innerHTML = sellers.map((s: any) => {
        const rating = s.rating_avg ? Number(s.rating_avg).toFixed(1) : null;
        return `<a href="/v2/seller/${s.id}" class="v2-seller-card" style="margin-bottom:12px;">
          <div class="v2-sc-img" style="background:linear-gradient(135deg,#EEF2FF,#E0E7FF);">
            <span class="v2-badge v2-badge-offer v2-badge-indigo v2-badge-size-md">🌙 Pre-order</span>
            <span class="v2-sc-emoji">🐟</span>
          </div>
          <div class="v2-sc-body">
            <div class="v2-sc-top">
              <div class="v2-sc-info">
                <div class="v2-sc-name">${escape(s.name)}</div>
                <div class="v2-sc-loc">${escape(s.location_name || "")}</div>
              </div>
              ${rating ? `<span class="v2-badge v2-badge-rating v2-badge-green v2-badge-size-md">${rating} ★</span>` : ''}
            </div>
            <div class="v2-sc-tags">
              <span class="v2-badge v2-badge-tag v2-badge-indigo v2-badge-size-md">Reserves at 5am</span>
              ${s.has_delivery ? '<span class="v2-badge v2-badge-tag v2-badge-green v2-badge-size-md">Delivery available</span>' : '<span class="v2-badge v2-badge-tag v2-badge-size-md">Pickup only</span>'}
            </div>
          </div>
        </a>`;
      }).join("");
    } catch (err) {
      loading.innerHTML = `<div style="text-align:center;padding:40px;color:var(--v2-red);">Failed to load. Try again.</div>`;
    }
  }
  loadSellers();
</script>
