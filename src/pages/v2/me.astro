---
export const prerender = false;
import AppShellV2 from "../../components/v2/AppShellV2.astro";
import ThemeToggle from "../../components/v2/atoms/ThemeToggle.astro";
import LoginSheet from "../../components/v2/organisms/LoginSheet.astro";
import AddressPickerSheet from "../../components/v2/organisms/AddressPickerSheet.astro";
import BottomSheet from "../../components/v2/organisms/BottomSheet.astro";
import Toast from "../../components/v2/atoms/Toast.astro";
---
<AppShellV2
  title="Account | Relifish"
  description="Manage your profile, addresses, and notifications."
  header={{
    variant: "page",
    title: "Account",
    backHref: "/v2",
  }}
  nav={{ active: "account" }}
>
  <Toast />
  <LoginSheet id="v2-me-login" role="buyer" redirectTo="/v2/me" />
  <AddressPickerSheet id="v2-me-addr-sheet" />

  <BottomSheet id="v2-me-name-sheet" title="Edit your name">
    <form id="v2-me-name-form">
      <label class="v2-label">First name</label>
      <input id="v2-me-fn" class="v2-input" type="text" placeholder="Your first name" />
      <label class="v2-label" style="margin-top:12px;">Last name</label>
      <input id="v2-me-ln" class="v2-input" type="text" placeholder="Your last name" />
      <label class="v2-label" style="margin-top:12px;">Email (optional)</label>
      <input id="v2-me-em" class="v2-input" type="email" placeholder="you@example.com" />
      <button type="submit" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full" style="margin-top:16px;">Save</button>
    </form>
  </BottomSheet>

  <div id="v2-me-guest" style="display:none;padding:0 16px;margin-top:24px;">
    <div class="v2-empty">
      <div class="v2-empty-icon">🔑</div>
      <h3 class="v2-empty-title">Sign in to your account</h3>
      <p class="v2-empty-desc">Use your phone number to view profile, saved addresses, and order history.</p>
      <button id="v2-me-signin-btn" class="v2-btn v2-btn-primary v2-btn-md">Sign in</button>
    </div>
  </div>

  <div id="v2-me-loading" style="padding:24px;text-align:center;">
    <span class="v2-spinner v2-spinner-md"></span>
  </div>

  <div id="v2-me-content" style="display:none;">
    <!-- Profile hero -->
    <div class="v2-me-hero">
      <div class="v2-me-avatar">👤</div>
      <div class="v2-me-name" id="v2-me-name">—</div>
      <div class="v2-me-phone" id="v2-me-phone">—</div>
      <button id="v2-me-edit-name" class="v2-me-edit-btn">✎ Edit profile</button>
    </div>

    <!-- Quick actions -->
    <div class="v2-me-quick">
      <button type="button" class="v2-me-qa" data-action="addresses"><div class="v2-me-qa-icon">📍</div><div class="v2-me-qa-lbl">Addresses</div></button>
      <a href="/v2/track" class="v2-me-qa"><div class="v2-me-qa-icon">📋</div><div class="v2-me-qa-lbl">Orders</div></a>
      <button type="button" class="v2-me-qa" data-action="notifications"><div class="v2-me-qa-icon">🔔</div><div class="v2-me-qa-lbl">Notifications</div></button>
      <a href="mailto:relifishstore@gmail.com" class="v2-me-qa"><div class="v2-me-qa-icon">💬</div><div class="v2-me-qa-lbl">Help</div></a>
    </div>

    <!-- Saved addresses block -->
    <div class="v2-me-section-head">Saved addresses</div>
    <div id="v2-me-addr-list" style="margin: 0 16px 16px;">
      <div style="text-align:center;padding:16px;color:var(--v2-ink-3);font:500 12px Inter;">
        <span class="v2-spinner v2-spinner-sm"></span>
      </div>
    </div>
    <div style="margin: 0 16px 16px;">
      <button id="v2-me-add-addr" type="button" class="v2-btn v2-btn-secondary v2-btn-md v2-btn-full">+ Add new address</button>
    </div>

    <!-- Settings list -->
    <div class="v2-me-section-head">Preferences</div>

    <!-- Theme toggle -->
    <div style="margin: 0 16px 16px;">
      <ThemeToggle variant="button" />
    </div>

    <a href="/v2/privacy" class="v2-me-list-item">
      <div class="v2-me-li-icon">📋</div>
      <div class="v2-me-li-name">Terms & Privacy</div>
      <div class="v2-me-li-arrow">›</div>
    </a>

    <button id="v2-me-logout" class="v2-me-logout">Log out</button>

    <div class="v2-me-version">Made in Mumbai · v2.0</div>
  </div>
</AppShellV2>

<style is:global>
  .v2-me-hero {
    background: linear-gradient(135deg, var(--v2-brand), #3B82F6);
    padding: 32px 16px 60px;
    color: #fff;
    text-align: center;
    position: relative;
  }
  .v2-me-avatar {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .2);
    display: flex; align-items: center; justify-content: center;
    font-size: 40px;
    margin: 0 auto 12px;
  }
  .v2-me-name { font: 800 22px Inter; }
  .v2-me-phone { font: 400 12px Inter; opacity: .85; margin-top: 2px; }
  .v2-me-edit-btn {
    margin-top: 8px;
    background: rgba(255,255,255,0.2);
    color: #fff;
    border: none;
    padding: 6px 14px;
    border-radius: 9999px;
    font: 600 12px Inter;
    cursor: pointer;
  }
  .v2-me-quick {
    margin: -40px 16px 16px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    background: var(--v2-bg);
    border-radius: var(--v2-radius-lg);
    padding: 16px 8px;
    box-shadow: var(--v2-shadow-md);
    position: relative;
    z-index: 2;
  }
  .v2-me-qa {
    text-align: center;
    text-decoration: none;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .v2-me-qa-icon {
    width: 44px; height: 44px;
    border-radius: var(--v2-radius);
    background: var(--v2-bg-3);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    margin: 0 auto 4px;
  }
  .v2-me-qa-lbl { font: 600 10px Inter; color: var(--v2-ink); }
  .v2-me-section-head {
    padding: 16px 16px 8px;
    font: 700 12px Inter;
    color: var(--v2-ink-3);
    text-transform: uppercase; letter-spacing: .05em;
  }
  .v2-me-list-item {
    margin: 0 16px 1px;
    background: var(--v2-bg);
    padding: 14px 16px;
    display: flex; align-items: center; gap: 12px;
    text-decoration: none;
    color: inherit;
    border-radius: var(--v2-radius);
  }
  .v2-me-li-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    background: var(--v2-bg-3);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }
  .v2-me-li-name { flex: 1; font: 600 13px Inter; color: var(--v2-ink); }
  .v2-me-li-arrow { color: var(--v2-ink-4); font-size: 20px; }
  .v2-me-logout {
    margin: 8px 16px;
    background: var(--v2-bg);
    border: 1px solid var(--v2-red-l);
    color: var(--v2-red);
    padding: 14px;
    border-radius: var(--v2-radius);
    font: 700 13px Inter;
    text-align: center;
    width: calc(100% - 32px);
    cursor: pointer;
  }
  .v2-me-version {
    text-align: center;
    font: 400 10px Inter;
    color: var(--v2-ink-4);
    padding: 16px;
  }
  .v2-me-addr-card {
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius);
    padding: 12px 14px;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .v2-me-addr-label { font: 700 13px Inter; color: var(--v2-ink); }
  .v2-me-addr-default { font: 600 10px Inter; color: var(--v2-green); margin-left: 6px; text-transform: uppercase; }
  .v2-me-addr-text { font: 400 12px Inter; color: var(--v2-ink-2); margin-top: 2px; line-height: 1.4; }
  .v2-me-addr-actions {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .v2-me-addr-btn {
    background: none;
    border: none;
    color: var(--v2-brand);
    font-size: 14px;
    cursor: pointer;
    padding: 4px;
  }
  .v2-me-addr-btn-del { color: var(--v2-red); }
  .v2-me-addr-empty {
    text-align: center;
    color: var(--v2-ink-3);
    font: 500 12px Inter;
    padding: 16px;
    background: var(--v2-bg);
    border-radius: var(--v2-radius);
  }
</style>

<script>
  function getBuyerId(): string | null {
    try { return localStorage.getItem("zepto_buyer_id") || null; } catch { return null; }
  }
  function getBuyerPhone(): string | null {
    try { return localStorage.getItem("zepto_phone") || null; } catch { return null; }
  }
  function escape(s: any) {
    return String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!));
  }

  const loading = document.getElementById("v2-me-loading")!;
  const guest = document.getElementById("v2-me-guest")!;
  const content = document.getElementById("v2-me-content")!;

  const phone = getBuyerPhone();
  const buyerId = getBuyerId();
  loading.style.display = "none";

  if (!phone || !buyerId) {
    guest.style.display = "block";
    document.getElementById("v2-me-signin-btn")?.addEventListener("click", () => {
      (window as any).v2OpenSheet?.("v2-me-login");
    });
  } else {
    content.style.display = "block";
    initSignedIn(buyerId, phone);
  }

  async function initSignedIn(buyerId: string, phone: string) {
    // Hydrate name from local cache instantly
    const fnLocal = localStorage.getItem("zepto_buyer_first_name") || "";
    const lnLocal = localStorage.getItem("zepto_buyer_last_name") || "";
    const fullLocal = `${fnLocal} ${lnLocal}`.trim();
    document.getElementById("v2-me-name")!.textContent = fullLocal || "Welcome";
    document.getElementById("v2-me-phone")!.textContent = phone;

    // Fetch profile from server (truth)
    try {
      const r = await fetch(`/api/buyer/profile?buyer_id=${buyerId}`);
      const d = await r.json();
      if (r.ok && d.profile) {
        const fn = d.profile.first_name || "";
        const ln = d.profile.last_name || "";
        const em = d.profile.email || "";
        const full = `${fn} ${ln}`.trim();
        document.getElementById("v2-me-name")!.textContent = full || "Welcome";
        try {
          if (fn) localStorage.setItem("zepto_buyer_first_name", fn);
          if (ln) localStorage.setItem("zepto_buyer_last_name", ln);
        } catch {}
        (document.getElementById("v2-me-fn") as HTMLInputElement).value = fn;
        (document.getElementById("v2-me-ln") as HTMLInputElement).value = ln;
        (document.getElementById("v2-me-em") as HTMLInputElement).value = em;
      }
    } catch {}

    // Edit name button
    document.getElementById("v2-me-edit-name")?.addEventListener("click", () => {
      (window as any).v2OpenSheet?.("v2-me-name-sheet");
    });

    // Save name form
    document.getElementById("v2-me-name-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const first_name = (document.getElementById("v2-me-fn") as HTMLInputElement).value.trim();
      const last_name = (document.getElementById("v2-me-ln") as HTMLInputElement).value.trim();
      const email = (document.getElementById("v2-me-em") as HTMLInputElement).value.trim();
      try {
        const res = await fetch("/api/buyer/profile", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ buyer_id: buyerId, updates: { first_name, last_name, email } }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Save failed");
        try {
          localStorage.setItem("zepto_buyer_first_name", first_name);
          localStorage.setItem("zepto_buyer_last_name", last_name);
        } catch {}
        const full = `${first_name} ${last_name}`.trim();
        document.getElementById("v2-me-name")!.textContent = full || "Welcome";
        (window as any).v2Toast?.("success", "Profile saved");
        (window as any).v2CloseSheet?.("v2-me-name-sheet");
      } catch (err: any) {
        (window as any).v2Toast?.("error", "Save failed", err.message);
      }
    });

    // Logout
    document.getElementById("v2-me-logout")?.addEventListener("click", () => {
      try {
        localStorage.removeItem("zepto_buyer_id");
        localStorage.removeItem("zepto_phone");
        localStorage.removeItem("zepto_buyer_first_name");
        localStorage.removeItem("zepto_buyer_last_name");
        localStorage.removeItem("v2_cart_global");
      } catch {}
      window.location.href = "/v2";
    });

    // Quick action: addresses → scroll to address section
    document.querySelectorAll<HTMLButtonElement>('[data-action="addresses"]').forEach((b) => {
      b.addEventListener("click", () => {
        document.getElementById("v2-me-addr-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    // Quick action: notifications → request push permission
    document.querySelectorAll<HTMLButtonElement>('[data-action="notifications"]').forEach((b) => {
      b.addEventListener("click", async () => {
        if (!("Notification" in window)) {
          (window as any).v2Toast?.("error", "Not supported", "Push isn't available on this browser");
          return;
        }
        const perm = await Notification.requestPermission();
        if (perm === "granted") {
          (window as any).v2Toast?.("success", "Notifications on", "We'll ping for order updates");
        } else {
          (window as any).v2Toast?.("error", "Denied", "Enable in browser settings");
        }
      });
    });

    // === Address book ===
    async function loadAddresses() {
      const listEl = document.getElementById("v2-me-addr-list")!;
      try {
        const r = await fetch(`/api/buyer/addresses?buyer_id=${buyerId}`);
        const d = await r.json();
        const addrs = d.addresses || [];
        if (addrs.length === 0) {
          listEl.innerHTML = `<div class="v2-me-addr-empty">No saved addresses yet. Add one below.</div>`;
          return;
        }
        listEl.innerHTML = addrs.map((a: any) => `
          <div class="v2-me-addr-card" data-addr-id="${a.id}">
            <div style="flex:1;min-width:0;">
              <div class="v2-me-addr-label">
                ${escape(a.label || "Address")}
                ${a.is_default ? '<span class="v2-me-addr-default">Default</span>' : ''}
              </div>
              <div class="v2-me-addr-text">${[a.flat, a.building, a.landmark, a.location_name].filter(Boolean).map(escape).join(", ")}</div>
            </div>
            <div class="v2-me-addr-actions">
              ${!a.is_default ? `<button class="v2-me-addr-btn" data-act="default" data-id="${a.id}" aria-label="Set default">⭐</button>` : ''}
              <button class="v2-me-addr-btn v2-me-addr-btn-del" data-act="delete" data-id="${a.id}" aria-label="Delete">🗑</button>
            </div>
          </div>`).join("");

        listEl.querySelectorAll<HTMLButtonElement>("[data-act]").forEach((b) => {
          b.addEventListener("click", async (e) => {
            e.stopPropagation();
            const id = b.dataset.id!;
            const act = b.dataset.act!;
            if (act === "delete") {
              if (!confirm("Delete this address?")) return;
              await fetch("/api/buyer/addresses", {
                method: "DELETE",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ buyer_id: buyerId, id }),
              });
            } else if (act === "default") {
              await fetch("/api/buyer/addresses", {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ buyer_id: buyerId, id, address: { is_default: true } }),
              });
            }
            loadAddresses();
          });
        });
      } catch (err) {
        listEl.innerHTML = `<div class="v2-me-addr-empty" style="color:var(--v2-red);">Failed to load addresses</div>`;
      }
    }

    document.getElementById("v2-me-add-addr")?.addEventListener("click", () => {
      (window as any).v2OpenSheet?.("v2-me-addr-sheet");
    });

    document.addEventListener("v2-address-confirmed", () => {
      loadAddresses();
    });

    loadAddresses();
  }
</script>
