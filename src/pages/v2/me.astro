---
export const prerender = false;
import AppShellV2 from "../../components/v2/AppShellV2.astro";
import EmptyState from "../../components/v2/molecules/EmptyState.astro";
import ThemeToggle from "../../components/v2/atoms/ThemeToggle.astro";
---
<AppShellV2
  title="Account | Relifish"
  description="Manage your profile, addresses, and notifications."
  header={{
    variant: "page",
    title: "Account",
    backHref: "/v2",
  }}
  nav={{ active: "account" }}
>
  <div id="v2-me-guest" style="display:none;padding:0 16px;margin-top:24px;">
    <EmptyState
      variant="no-orders"
      title="Sign in to your account"
      description="Use your phone number to view profile, saved addresses, and order history."
      ctaText="Sign in"
      ctaHref="/me"
    />
  </div>

  <div id="v2-me-loading" style="padding:24px;text-align:center;">
    <span class="v2-spinner v2-spinner-md"></span>
  </div>

  <div id="v2-me-content" style="display:none;">
    <!-- Profile hero -->
    <div class="v2-me-hero">
      <div class="v2-me-avatar">👤</div>
      <div class="v2-me-name" id="v2-me-name">—</div>
      <div class="v2-me-phone" id="v2-me-phone">—</div>
    </div>

    <!-- Quick actions -->
    <div class="v2-me-quick">
      <a href="/v2/me" class="v2-me-qa"><div class="v2-me-qa-icon">📍</div><div class="v2-me-qa-lbl">Addresses</div></a>
      <a href="/v2/me" class="v2-me-qa"><div class="v2-me-qa-icon">🔔</div><div class="v2-me-qa-lbl">Notifications</div></a>
      <a href="/v2/track" class="v2-me-qa"><div class="v2-me-qa-icon">📋</div><div class="v2-me-qa-lbl">Orders</div></a>
      <a href="mailto:relifishstore@gmail.com" class="v2-me-qa"><div class="v2-me-qa-icon">💬</div><div class="v2-me-qa-lbl">Help</div></a>
    </div>

    <!-- Settings list -->
    <div class="v2-me-section-head">Preferences</div>

    <!-- Theme toggle -->
    <div style="margin: 0 16px 16px;">
      <ThemeToggle variant="button" />
    </div>

    <a href="/v2/me" class="v2-me-list-item">
      <div class="v2-me-li-icon">🔔</div>
      <div class="v2-me-li-name">Push notifications</div>
      <div class="v2-me-li-arrow">›</div>
    </a>
    <a href="/v2/me" class="v2-me-list-item">
      <div class="v2-me-li-icon">📍</div>
      <div class="v2-me-li-name">Saved addresses</div>
      <div class="v2-me-li-arrow">›</div>
    </a>
    <a href="/privacy" class="v2-me-list-item">
      <div class="v2-me-li-icon">📋</div>
      <div class="v2-me-li-name">Terms & Privacy</div>
      <div class="v2-me-li-arrow">›</div>
    </a>

    <button id="v2-me-logout" class="v2-me-logout">Log out</button>

    <div class="v2-me-version">Made in Mumbai · v2.0</div>
  </div>
</AppShellV2>

<style is:global>
  .v2-me-hero {
    background: linear-gradient(135deg, var(--v2-brand), #3B82F6);
    padding: 32px 16px 60px;
    color: #fff;
    text-align: center;
    position: relative;
  }
  .v2-me-avatar {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .2);
    display: flex; align-items: center; justify-content: center;
    font-size: 40px;
    margin: 0 auto 12px;
  }
  .v2-me-name {
    font: 800 22px Inter;
  }
  .v2-me-phone {
    font: 400 12px Inter;
    opacity: .85;
    margin-top: 2px;
  }
  .v2-me-quick {
    margin: -40px 16px 16px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    background: #fff;
    border-radius: var(--v2-radius-lg);
    padding: 16px 8px;
    box-shadow: var(--v2-shadow-md);
    position: relative;
    z-index: 2;
  }
  .v2-me-qa {
    text-align: center;
    text-decoration: none;
    color: inherit;
  }
  .v2-me-qa-icon {
    width: 44px; height: 44px;
    border-radius: var(--v2-radius);
    background: var(--v2-bg-3);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    margin: 0 auto 4px;
  }
  .v2-me-qa-lbl {
    font: 600 10px Inter;
    color: var(--v2-ink);
  }
  .v2-me-section-head {
    padding: 16px 16px 8px;
    font: 700 12px Inter;
    color: var(--v2-ink-3);
    text-transform: uppercase; letter-spacing: .05em;
  }
  .v2-me-list-item {
    margin: 0 16px 1px;
    background: #fff;
    padding: 14px 16px;
    display: flex; align-items: center; gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .v2-me-list-item:first-of-type { border-radius: var(--v2-radius) var(--v2-radius) 0 0; }
  .v2-me-list-item:nth-of-type(3) { border-radius: 0 0 var(--v2-radius) var(--v2-radius); margin-bottom: 16px; }
  .v2-me-li-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    background: var(--v2-bg-3);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }
  .v2-me-li-name {
    flex: 1;
    font: 600 13px Inter;
    color: var(--v2-ink);
  }
  .v2-me-li-arrow {
    color: var(--v2-ink-4);
    font-size: 20px;
  }
  .v2-me-logout {
    margin: 8px 16px;
    background: #fff;
    border: 1px solid var(--v2-red-l);
    color: var(--v2-red);
    padding: 14px;
    border-radius: var(--v2-radius);
    font: 700 13px Inter;
    text-align: center;
    width: calc(100% - 32px);
    cursor: pointer;
  }
  .v2-me-version {
    text-align: center;
    font: 400 10px Inter;
    color: var(--v2-ink-4);
    padding: 16px;
  }
</style>

<script>
  function getBuyerPhone(): string | null {
    try { return localStorage.getItem("zepto_phone") || null; } catch { return null; }
  }
  function getBuyerName(): string {
    try {
      const first = localStorage.getItem("zepto_buyer_first_name") || "";
      const last = localStorage.getItem("zepto_buyer_last_name") || "";
      const full = `${first} ${last}`.trim();
      return full || "Welcome";
    } catch { return "Welcome"; }
  }

  const loading = document.getElementById("v2-me-loading")!;
  const guest = document.getElementById("v2-me-guest")!;
  const content = document.getElementById("v2-me-content")!;

  const phone = getBuyerPhone();
  loading.style.display = "none";

  if (!phone) {
    guest.style.display = "block";
  } else {
    content.style.display = "block";
    document.getElementById("v2-me-name")!.textContent = getBuyerName();
    document.getElementById("v2-me-phone")!.textContent = phone;
    document.getElementById("v2-me-logout")?.addEventListener("click", () => {
      try {
        localStorage.removeItem("zepto_buyer_id");
        localStorage.removeItem("zepto_phone");
        localStorage.removeItem("zepto_buyer_first_name");
        localStorage.removeItem("zepto_buyer_last_name");
      } catch {}
      window.location.href = "/v2";
    });
  }
</script>
