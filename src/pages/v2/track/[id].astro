---
export const prerender = false;
import AppShellV2 from "../../../components/v2/AppShellV2.astro";
import Toast from "../../../components/v2/atoms/Toast.astro";
import EmptyState from "../../../components/v2/molecules/EmptyState.astro";

const { id } = Astro.params;
---
<AppShellV2
  title="Order details | Relifish"
  description="View order details, status, and seller contact."
  header={{
    variant: "page",
    title: "Order details",
    backHref: "/v2/track",
  }}
  nav={{ active: "orders" }}
>
  <Toast />

  <div id="v2-od-loading" style="padding:24px;text-align:center;">
    <span class="v2-spinner v2-spinner-md"></span>
  </div>

  <div id="v2-od-not-found" style="display:none;padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Order not found"
      description="This order doesn't exist or you don't have access."
      ctaText="See all orders"
      ctaHref="/v2/track"
    />
  </div>

  <div id="v2-od-content" style="display:none;padding:0 16px 24px;">
    <!-- Status hero -->
    <div class="v2-od-hero">
      <div class="v2-od-status" id="v2-od-status">—</div>
      <div class="v2-od-id">Order <span id="v2-od-shortid">—</span></div>
      <div class="v2-od-time" id="v2-od-time">—</div>
    </div>

    <!-- Stepper -->
    <div class="v2-od-section">
      <div class="v2-od-stepper" id="v2-od-stepper"></div>
      <div class="v2-od-steplabels">
        <span>Placed</span><span>Confirmed</span><span>Ready</span><span>Done</span>
      </div>
    </div>

    <!-- Seller -->
    <div class="v2-od-section">
      <div class="v2-od-section-h">From</div>
      <div class="v2-od-row">
        <div>
          <div class="v2-od-seller" id="v2-od-seller">—</div>
          <div class="v2-od-sub" id="v2-od-seller-loc">—</div>
        </div>
        <!-- Call option removed per user request -->
      </div>
    </div>

    <!-- Items -->
    <div class="v2-od-section">
      <div class="v2-od-section-h">Items</div>
      <div id="v2-od-items"></div>
    </div>

    <!-- Delivery / Pickup -->
    <div class="v2-od-section" id="v2-od-fulfill"></div>

    <!-- Bill -->
    <div class="v2-od-section">
      <div class="v2-od-section-h">Bill summary</div>
      <div class="v2-od-bill" id="v2-od-bill"></div>
    </div>

    <!-- Actions -->
    <div id="v2-od-actions" style="margin-top:16px;"></div>
  </div>
</AppShellV2>

<style is:global>
  .v2-od-hero {
    background: linear-gradient(135deg, var(--v2-brand), #3B82F6);
    color: #fff;
    padding: 20px 16px;
    margin: 16px 0;
    border-radius: var(--v2-radius-lg);
    text-align: center;
  }
  .v2-od-status { font: 800 18px Inter; }
  .v2-od-id { font: 600 12px Inter; opacity: .9; margin-top: 4px; }
  .v2-od-time { font: 400 11px Inter; opacity: .8; margin-top: 2px; }
  .v2-od-section {
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius);
    padding: 14px;
    margin-bottom: 12px;
  }
  .v2-od-section-h { font: 700 11px Inter; color: var(--v2-ink-3); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 8px; }
  .v2-od-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .v2-od-seller { font: 700 14px Inter; color: var(--v2-ink); }
  .v2-od-sub { font: 400 12px Inter; color: var(--v2-ink-2); margin-top: 2px; }
  .v2-od-call {
    background: var(--v2-green);
    color: #fff;
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 9999px;
    font: 700 12px Inter;
    flex-shrink: 0;
  }
  .v2-od-item-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--v2-border);
    font: 500 13px Inter;
  }
  .v2-od-item-row:last-child { border-bottom: none; }
  .v2-od-item-name { color: var(--v2-ink); font-weight: 600; }
  .v2-od-item-qty { color: var(--v2-ink-3); font-size: 11px; margin-top: 2px; }
  .v2-od-bill div { display: flex; justify-content: space-between; padding: 4px 0; font: 500 13px Inter; color: var(--v2-ink-2); }
  .v2-od-bill .total { font: 800 15px Inter; color: var(--v2-ink); padding-top: 8px; border-top: 1px solid var(--v2-border); margin-top: 4px; }
  .v2-od-stepper {
    display: flex; align-items: center; gap: 4px;
    margin-bottom: 6px;
  }
  .v2-od-stepper .dot {
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--v2-ink-4); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font: 700 11px Inter; flex-shrink: 0;
  }
  .v2-od-stepper .dot.done { background: var(--v2-green); }
  .v2-od-stepper .line { flex: 1; height: 2px; background: var(--v2-bg-3); }
  .v2-od-stepper .line.done { background: var(--v2-green); }
  .v2-od-steplabels {
    display: flex; justify-content: space-between;
    font: 500 9px Inter; color: var(--v2-ink-3);
  }
  .v2-od-cancel {
    width: 100%;
    background: var(--v2-bg);
    color: var(--v2-red);
    border: 1px solid var(--v2-red-l);
    padding: 14px;
    border-radius: var(--v2-radius);
    font: 700 13px Inter;
    cursor: pointer;
  }
</style>

<script>
  import { createClient } from "@supabase/supabase-js";
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL || "",
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || ""
  );
  // Extract order ID from URL path: /v2/track/{id}
  const orderId = window.location.pathname.split("/").filter(Boolean).pop() || "";
  function escape(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  }
  function statusLabel(s) {
    return ({
      pending: "Awaiting confirmation",
      pending_payment: "Upload payment proof",
      pre_order: "Pre-order placed",
      scheduled: "Scheduled pickup",
      confirmed: "Confirmed ✓",
      paid: "Payment received",
      payment_required: "Additional payment needed",
      ready_for_pickup: "Ready for pickup",
      out_for_delivery: "Out for delivery",
      picked_up: "Picked up",
      completed: "Completed",
      declined: "Declined by seller",
      cancelled: "Cancelled",
      refunded: "Refund processed",
    })[s] || s;
  }
  let _orderType = "pickup"; // set during load()
  function statusToStep(s) {
    if (_orderType === "delivery") {
      return ({ pending:0, pending_payment:0, pre_order:0, scheduled:0, confirmed:1, paid:1, payment_required:1, out_for_delivery:2, picked_up:3, completed:3, refunded:3 })[s] ?? 0;
    }
    return ({ pending:0, pending_payment:0, pre_order:0, scheduled:0, confirmed:1, paid:1, payment_required:1, ready_for_pickup:2, picked_up:3, completed:3, refunded:3 })[s] ?? 0;
  }
  function isCancellable(s) {
    return s === "pending" || s === "pre_order" || s === "scheduled";
  }

  let pollTimer = null;

  async function load() {
    const phone = (() => { try { return localStorage.getItem("zepto_phone") || ""; } catch { return ""; } })();
    const buyerId = (() => { try { return localStorage.getItem("zepto_buyer_id") || ""; } catch { return ""; } })();
    if (!phone || !buyerId) {
      window.location.href = "/v2/track";
      return;
    }
    try {
      const res = await fetch(`/api/orders/detail?id=${encodeURIComponent(orderId)}&buyer_id=${encodeURIComponent(buyerId)}`);
      if (res.status === 404 || res.status === 403) {
        document.getElementById("v2-od-loading").style.display = "none";
        document.getElementById("v2-od-not-found").style.display = "block";
        return;
      }
      if (!res.ok) throw new Error("Load failed");
      const { order } = await res.json();
      render(order);
    } catch (err) {
      document.getElementById("v2-od-loading").style.display = "none";
      document.getElementById("v2-od-not-found").style.display = "block";
    }
  }

  function render(o) {
    document.getElementById("v2-od-loading").style.display = "none";
    document.getElementById("v2-od-content").style.display = "block";

    document.getElementById("v2-od-status").textContent = statusLabel(o.status);
    document.getElementById("v2-od-shortid").textContent = "#" + String(o.id).slice(0,6).toUpperCase();
    document.getElementById("v2-od-time").textContent = new Date(o.created_at).toLocaleString("en-IN");
    // Hero colour: green for confirmed/done, red for declined/cancelled, orange for payment actions
    const hero = document.querySelector(".v2-od-hero");
    if (hero) {
      if (["confirmed","paid","ready_for_pickup","out_for_delivery","picked_up","completed"].includes(o.status)) {
        hero.style.background = "linear-gradient(135deg,#059669,#10B981)";
      } else if (["declined","cancelled"].includes(o.status)) {
        hero.style.background = "linear-gradient(135deg,#DC2626,#EF4444)";
      } else if (["pending_payment","payment_required"].includes(o.status)) {
        hero.style.background = "linear-gradient(135deg,#D97706,#F59E0B)";
      } else if (o.status === "refunded") {
        hero.style.background = "linear-gradient(135deg,#6366F1,#818CF8)";
      }
    }

    // Stepper — different labels for pickup vs delivery
    _orderType = o.order_type || "pickup";
    const step = statusToStep(o.status);
    const stepLabels = _orderType === "delivery"
      ? ["Placed", "Confirmed", "On the way", "Delivered"]
      : ["Placed", "Confirmed", "Ready", "Picked up"];
    const stepper = document.getElementById("v2-od-stepper");
    stepper.innerHTML = [0,1,2,3].map(i =>
      `<div class="dot${i <= step ? ' done' : ''}">${i <= step ? '✓' : i+1}</div>` +
      (i < 3 ? `<div class="line${i < step ? ' done' : ''}"></div>` : '')
    ).join("");
    const stepLabelEl = document.querySelector(".v2-od-steplabels");
    if (stepLabelEl) stepLabelEl.innerHTML = stepLabels.map(l => `<span>${l}</span>`).join("");

    // Seller
    const seller = o.seller || {};
    document.getElementById("v2-od-seller").textContent = seller.name || "Seller";
    document.getElementById("v2-od-seller-loc").textContent = seller.location_name || seller.location || "";
    // Call option removed per user request

    // Items
    const items = (o.items && o.items.length > 0) ? o.items : [{
      species: o.listing?.species || o.species,
      quantity: o.quantity,
      quantity_unit: o.quantity_unit,
      total_price: o.total_price,
    }];
    // Cut style & notes (may be on order directly or on individual items)
    const cutStyle = o.cut_style || "";
    const buyerNotes = o.buyer_notes || "";

    document.getElementById("v2-od-items").innerHTML = items.map(it => `
      <div class="v2-od-item-row">
        <div>
          <div class="v2-od-item-name" style="text-transform:capitalize;">${escape(it.species || "Fish")}</div>
          <div class="v2-od-item-qty">${escape(it.quantity)} ${escape(it.quantity_unit || 'kg')}</div>
        </div>
        <div style="font-weight:700;">₹${(it.total_price || 0).toLocaleString("en-IN")}</div>
      </div>`).join("")
      + (cutStyle ? `<div style="font:600 12px Inter;color:var(--v2-ink-2);margin-top:8px;">✂️ ${escape(cutStyle.split(",").map(c => ({whole:"Whole",cleaned:"Cleaned",cut:"Cut"})[c] || c).join(", "))}</div>` : "")
      + (buyerNotes ? `<div style="font:400 12px Inter;color:var(--v2-ink-3);margin-top:4px;">📝 ${escape(buyerNotes)}</div>` : "");

    // Fulfillment
    const fulfillEl = document.getElementById("v2-od-fulfill");
    if (o.order_type === "delivery" && o.address) {
      const a = o.address;
      const text = [a.flat, a.building, a.landmark, a.location_name].filter(Boolean).map(escape).join(", ");
      fulfillEl.innerHTML = `
        <div class="v2-od-section-h">Deliver to</div>
        <div style="font:600 13px Inter;color:var(--v2-ink);">${escape(a.label || "Address")}</div>
        <div class="v2-od-sub">${text || "Saved address"}</div>`;
    } else {
      fulfillEl.innerHTML = `
        <div class="v2-od-section-h">Pickup at</div>
        <div style="font:600 13px Inter;color:var(--v2-ink);">${escape(seller.location_name || seller.location || "Seller location")}</div>
        ${o.scheduled_for ? `<div class="v2-od-sub">Scheduled: ${new Date(o.scheduled_for).toLocaleString("en-IN")}</div>` : ''}`;
    }

    // Bill
    const subtotal = o.total_price || 0;
    const delivery = o.delivery_fee || 0;
    const grand = subtotal + delivery;
    const finalPrice = o.final_price ? Number(o.final_price) : null;
    const paidAmount = o.paid_amount ? Number(o.paid_amount) : null;
    const balance = finalPrice && paidAmount ? finalPrice - paidAmount : null;
    document.getElementById("v2-od-bill").innerHTML = `
      <div><span>Subtotal</span><span>₹${subtotal.toLocaleString("en-IN")}</span></div>
      ${delivery > 0 ? `<div><span>Delivery</span><span>₹${delivery.toLocaleString("en-IN")}</span></div>` : ''}
      <div class="total"><span>Total</span><span>₹${grand.toLocaleString("en-IN")}</span></div>
      ${finalPrice ? `<div style="padding-top:6px;border-top:1px solid var(--v2-border);margin-top:4px;"><span style="color:var(--v2-ink-2);">Final price (seller)</span><span style="font-weight:700;color:var(--v2-ink);">₹${finalPrice.toLocaleString("en-IN")}</span></div>` : ''}
      ${paidAmount ? `<div><span style="color:var(--v2-ink-2);">You paid</span><span style="color:var(--v2-green);">₹${paidAmount.toLocaleString("en-IN")}</span></div>` : ''}
      ${balance && balance > 0 ? `<div><span style="color:var(--v2-red);">Balance due</span><span style="font-weight:700;color:var(--v2-red);">₹${balance.toLocaleString("en-IN")}</span></div>` : ''}
      ${balance && balance < 0 ? `<div><span style="color:var(--v2-green);">Refund</span><span style="font-weight:700;color:var(--v2-green);">₹${Math.abs(balance).toLocaleString("en-IN")}</span></div>` : ''}
      <div style="font:400 11px Inter;color:var(--v2-ink-3);margin-top:4px;">${paidAmount ? "Paid via UPI" : "Pay at pickup / on delivery"}</div>`;

    // Actions
    const actions = document.getElementById("v2-od-actions");
    if (isCancellable(o.status)) {
      actions.innerHTML = `<button class="v2-od-cancel" id="v2-od-cancel-btn">Cancel order</button>`;
      document.getElementById("v2-od-cancel-btn").addEventListener("click", async () => {
        if (!confirm("Cancel this order? This cannot be undone.")) return;
        try {
          const buyerId = localStorage.getItem("zepto_buyer_id") || "";
          const res = await fetch("/api/orders/cancel", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ order_id: o.id, buyer_id: buyerId, action: "cancel" }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Cancel failed");
          window.v2Toast?.("success", "Order cancelled");
          setTimeout(() => load(), 600);
        } catch (err) {
          window.v2Toast?.("error", "Failed", err.message);
        }
      });
    } else if (["completed", "picked_up", "cancelled", "declined"].includes(o.status)) {
      // Finished/cancelled order — offer re-order from same seller.
      const sellerIdForReorder = o.seller?.id || o.listing?.seller_id || "";
      if (sellerIdForReorder) {
        actions.innerHTML = `<button class="v2-od-cancel" id="v2-od-reorder-btn" style="background:var(--v2-brand);color:#fff;border:none;">Re-order from ${escape(seller.name || "this seller")}</button>`;
        document.getElementById("v2-od-reorder-btn").addEventListener("click", () => {
          // Dump items back into RelifishCart then navigate to seller page.
          const Cart = window.RelifishCart;
          if (Cart) {
            items.forEach(it => {
              Cart.addItem({
                listing_id: o.listing_id || "",
                seller_id: sellerIdForReorder,
                seller_name: seller.name || "Seller",
                name: it.species || "Fish",
                qty_unit: it.quantity_unit || "kg",
                price: it.total_price || 0,
                qty: it.quantity || 1,
              });
            });
          }
          window.location.href = `/v2/seller/${sellerIdForReorder}`;
        });
      } else {
        actions.innerHTML = "";
      }
    } else if (["confirmed", "paid", "ready_for_pickup"].includes(o.status)) {
      const hasCut = !!o.cut_style;
      const hasNotes = !!o.buyer_notes;
      const alreadySaved = hasCut || hasNotes;

      const savedCuts = (o.cut_style || "").split(",").filter(Boolean);
      const cutOptions = [
        { value: "whole", label: "🐟 Whole" },
        { value: "cleaned", label: "✂️ Cleaned" },
        { value: "cut", label: "🔪 Cut" },
      ];

      if (alreadySaved) {
        const cutDisplay = savedCuts.map(c => cutOptions.find(x => x.value === c)?.label || c).join(", ") || "Not set";
        actions.innerHTML = `
          <div style="background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:var(--v2-radius);padding:14px;margin-top:8px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
              <div style="font:700 13px Inter;color:var(--v2-ink);">✅ Preferences saved</div>
              <button id="v2-od-edit-prefs" type="button" style="background:none;border:none;font:600 12px Inter;color:var(--v2-brand);cursor:pointer;">Edit</button>
            </div>
            <div style="font:500 13px Inter;color:var(--v2-ink);margin-bottom:4px;">${cutDisplay}</div>
            ${hasNotes ? `<div style="font:400 12px Inter;color:var(--v2-ink-3);margin-top:4px;">📝 ${escape(o.buyer_notes)}</div>` : ''}
          </div>`;
        document.getElementById("v2-od-edit-prefs")?.addEventListener("click", () => showPrefsForm(o));
      } else {
        showPrefsForm(o);
      }

      function showPrefsForm(o) {
        const sc = (o.cut_style || "").split(",").filter(Boolean);
        actions.innerHTML = `
          <div style="background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:var(--v2-radius);padding:14px;margin-top:8px;">
            <div style="font:700 13px Inter;color:var(--v2-ink);margin-bottom:10px;">✂️ Add preferences</div>
            <div style="font:400 11px Inter;color:var(--v2-ink-3);margin-bottom:12px;">Select how you want your fish prepared. You can choose multiple.</div>
            <div style="margin-bottom:10px;">
              <label style="font:600 12px Inter;color:var(--v2-ink-2);display:block;margin-bottom:6px;">Cut style</label>
              <div style="display:flex;gap:8px;" id="v2-od-cut-opts">
                ${cutOptions.map(opt => {
                  const checked = sc.includes(opt.value);
                  return `<label style="flex:1;display:flex;align-items:center;gap:6px;padding:10px;border:1.5px solid ${checked ? 'var(--v2-brand)' : 'var(--v2-border)'};border-radius:var(--v2-radius-sm);cursor:pointer;background:${checked ? 'var(--v2-brand-l)' : 'var(--v2-bg)'};font:500 12px Inter;color:var(--v2-ink);">
                    <input type="checkbox" name="v2-od-cut" value="${opt.value}" ${checked ? 'checked' : ''} style="display:none;" /> ${opt.label}
                  </label>`;
                }).join("")}
              </div>
            </div>
            <div style="margin-bottom:12px;">
              <label style="font:600 12px Inter;color:var(--v2-ink-2);display:block;margin-bottom:6px;">Special request (optional)</label>
              <textarea id="v2-od-notes" rows="2" placeholder="e.g. medium pieces, no head" style="width:100%;padding:10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 13px Inter;color:var(--v2-ink);background:var(--v2-bg);resize:vertical;outline:none;box-sizing:border-box;">${escape(o.buyer_notes || "")}</textarea>
            </div>
            <button id="v2-od-save-notes" class="v2-btn v2-btn-primary v2-btn-sm v2-btn-full">${alreadySaved ? 'Update preferences' : 'Save preferences'}</button>
          </div>`;

        actions.querySelectorAll('input[name="v2-od-cut"]').forEach(cb => {
          cb.addEventListener("change", () => {
            actions.querySelectorAll('#v2-od-cut-opts label').forEach(l => {
              const inp = l.querySelector('input') as HTMLInputElement;
              l.style.borderColor = inp?.checked ? 'var(--v2-brand)' : 'var(--v2-border)';
              l.style.background = inp?.checked ? 'var(--v2-brand-l)' : 'var(--v2-bg)';
            });
          });
        });

        document.getElementById("v2-od-save-notes")?.addEventListener("click", async () => {
          const checked = Array.from(actions.querySelectorAll('input[name="v2-od-cut"]:checked')).map((c: any) => c.value);
          const cut = checked.join(",") || "";
          const notes = (document.getElementById("v2-od-notes") as HTMLTextAreaElement)?.value?.trim() || "";
          const btn = document.getElementById("v2-od-save-notes") as HTMLButtonElement;
          btn.disabled = true;
          btn.textContent = "Saving...";
          try {
            const res = await fetch("/api/orders/update-notes", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ order_id: o.id, buyer_id: localStorage.getItem("zepto_buyer_id"), cut_style: cut, buyer_notes: notes }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Failed");
            window.v2Toast?.("success", "Preferences saved", "Seller will see your request");
            load();
          } catch (err) {
            window.v2Toast?.("error", "Failed", err.message || "Could not save");
            btn.disabled = false;
            btn.textContent = "Save preferences";
          }
        });
      }
    } else if (o.status === "pending_payment") {
      renderPaymentUpload(o, false);
    } else if (o.status === "payment_required") {
      renderPaymentUpload(o, true);
    } else if (o.status === "refunded") {
      const paidAmt = Number(o.paid_amount) || 0;
      const finalAmt = Number(o.final_price) || 0;
      const refundAmt = finalAmt > 0 ? Math.max(0, paidAmt - finalAmt) : paidAmt;
      const sentAt = o.refund_sent_at ? new Date(o.refund_sent_at).toLocaleString("en-IN") : null;
      const note = o.refund_note || "";
      if (sentAt) {
        actions.innerHTML = `
          <div style="background:var(--v2-bg);border:1.5px solid #6366F1;border-radius:var(--v2-radius);padding:16px;margin-top:8px;">
            <div style="font:800 14px Inter;color:#6366F1;margin-bottom:6px;">✅ Refund sent by seller</div>
            ${refundAmt > 0 ? `<div style="font:700 16px Inter;color:var(--v2-ink);margin-bottom:6px;">₹${refundAmt.toLocaleString("en-IN")}</div>` : ''}
            <div style="font:400 12px Inter;color:var(--v2-ink-2);margin-bottom:4px;">Marked sent on ${sentAt}</div>
            ${note ? `<div style="font:500 12px Inter;color:var(--v2-ink-2);margin-top:6px;padding:8px 10px;background:var(--v2-bg-2);border-radius:var(--v2-radius-sm);">📝 ${escape(note)}</div>` : ''}
            <div style="font:400 11px Inter;color:var(--v2-ink-3);margin-top:8px;">Check your UPI app for the refund. If not received, contact the seller.</div>
          </div>`;
      } else {
        actions.innerHTML = `
          <div style="background:var(--v2-bg);border:1.5px solid #A78BFA;border-radius:var(--v2-radius);padding:16px;margin-top:8px;">
            <div style="font:800 14px Inter;color:#7C3AED;margin-bottom:6px;">🔄 Refund in process</div>
            ${refundAmt > 0 ? `<div style="font:700 16px Inter;color:var(--v2-ink);margin-bottom:6px;">₹${refundAmt.toLocaleString("en-IN")}</div>` : ''}
            <div style="font:400 12px Inter;color:var(--v2-ink-2);">Seller will send your refund via UPI. You'll get an update here once it's confirmed.</div>
          </div>`;
      }
    } else {
      actions.innerHTML = "";
    }

    function renderPaymentUpload(o, isBalance) {
      const paidSoFar = Number(o.paid_amount) || 0;
      const finalPrice = Number(o.final_price) || 0;
      const balance = isBalance ? Math.max(0, finalPrice - paidSoFar) : (Number(o.total_price) + Number(o.delivery_fee || 0));
      const alreadyUploaded = o.payment_screenshot_urls && o.payment_screenshot_urls.length > 0;

      actions.innerHTML = `
        <div style="background:var(--v2-bg);border:1.5px solid var(--v2-brand);border-radius:var(--v2-radius);padding:16px;margin-top:8px;">
          <div style="font:800 14px Inter;color:var(--v2-ink);margin-bottom:4px;">
            ${isBalance ? "💸 Additional payment needed" : "💳 Upload payment proof"}
          </div>
          <div style="font:400 12px Inter;color:var(--v2-ink-2);margin-bottom:12px;">
            ${isBalance
              ? `Seller updated the final price. Please pay ₹${balance.toLocaleString("en-IN")} and upload the UPI screenshot.`
              : `Pay ₹${balance.toLocaleString("en-IN")} via UPI and upload the screenshot below.`
            }
          </div>
          <div style="font:800 16px Inter;color:var(--v2-brand);margin-bottom:16px;">₹${balance.toLocaleString("en-IN")}</div>
          ${alreadyUploaded ? `<div style="font:500 12px Inter;color:var(--v2-green);margin-bottom:12px;">✓ Screenshot uploaded — awaiting seller confirmation</div>` : ""}
          <label style="display:block;cursor:pointer;">
            <div id="v2-pay-drop" style="border:2px dashed var(--v2-border);border-radius:var(--v2-radius-sm);padding:20px;text-align:center;font:500 13px Inter;color:var(--v2-ink-2);">
              📷 Tap to select screenshot
            </div>
            <input type="file" id="v2-pay-file" accept="image/*" style="display:none;" />
          </label>
          <div id="v2-pay-preview" style="margin-top:10px;display:none;">
            <img id="v2-pay-img" style="width:100%;max-height:180px;object-fit:contain;border-radius:var(--v2-radius-sm);border:1px solid var(--v2-border);" />
          </div>
          <button id="v2-pay-submit" class="v2-btn v2-btn-primary v2-btn-full" style="margin-top:12px;display:none;">Submit payment proof</button>
          <div id="v2-pay-err" style="font:500 11px Inter;color:var(--v2-red);margin-top:8px;display:none;"></div>
        </div>`;

      const fileInput = document.getElementById("v2-pay-file");
      const dropZone = document.getElementById("v2-pay-drop");
      const preview = document.getElementById("v2-pay-preview");
      const previewImg = document.getElementById("v2-pay-img") as HTMLImageElement;
      const submitBtn = document.getElementById("v2-pay-submit") as HTMLButtonElement;
      const errEl = document.getElementById("v2-pay-err");

      fileInput?.addEventListener("change", () => {
        const file = (fileInput as HTMLInputElement).files?.[0];
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) {
          errEl.style.display = "block";
          errEl.textContent = "File too large (max 5 MB)";
          return;
        }
        const url = URL.createObjectURL(file);
        previewImg.src = url;
        preview.style.display = "block";
        dropZone.textContent = file.name;
        submitBtn.style.display = "block";
        errEl.style.display = "none";
      });

      submitBtn?.addEventListener("click", async () => {
        const file = (fileInput as HTMLInputElement).files?.[0];
        if (!file) return;
        submitBtn.disabled = true;
        submitBtn.textContent = "Uploading...";
        errEl.style.display = "none";
        try {
          const buyerId = localStorage.getItem("zepto_buyer_id") || "";
          const form = new FormData();
          form.append("order_id", o.id);
          form.append("buyer_id", buyerId);
          form.append("file", file);
          const res = await fetch("/api/orders/upload-payment", { method: "POST", body: form });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Upload failed");
          window.v2Toast?.("success", "Payment proof submitted", "Seller will confirm shortly");
          setTimeout(() => load(), 600);
        } catch (err) {
          errEl.style.display = "block";
          errEl.textContent = err.message || "Upload failed";
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit payment proof";
        }
      });
    }
  }

  function initPage() {
    load();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPage);
  } else {
    initPage();
  }

  // Supabase Realtime: instant order status updates
  const terminalStatuses = ["picked_up", "completed", "cancelled", "declined", "refunded"];
  const channel = supabase
    .channel(`order-${orderId}`)
    .on("postgres_changes", {
      event: "UPDATE",
      schema: "public",
      table: "orders",
      filter: `id=eq.${orderId}`,
    }, (payload: any) => {
      load(); // re-render with new data
      const newStatus = payload.new?.status;
      if (newStatus && terminalStatuses.includes(newStatus)) {
        channel.unsubscribe();
      }
    })
    .subscribe();

  // Fallback poll every 30s in case realtime connection drops
  pollTimer = setInterval(() => {
    const statusEl = document.getElementById("v2-od-status");
    const text = statusEl?.textContent || "";
    if (text.includes("Picked up") || text.includes("Cancelled") || text.includes("Declined") || text.includes("Completed")) {
      clearInterval(pollTimer);
      return;
    }
    load();
  }, 30000);
</script>
