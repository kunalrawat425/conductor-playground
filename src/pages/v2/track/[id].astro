---
export const prerender = false;
import AppShellV2 from "../../../components/v2/AppShellV2.astro";
import Toast from "../../../components/v2/atoms/Toast.astro";
import EmptyState from "../../../components/v2/molecules/EmptyState.astro";

const { id } = Astro.params;
---
<AppShellV2
  title="Order details | Relifish"
  description="View order details, status, and seller contact."
  header={{
    variant: "page",
    title: "Order details",
    backHref: "/v2/track",
  }}
  nav={{ active: "orders" }}
>
  <Toast />

  <div id="v2-od-loading" style="padding:24px;text-align:center;">
    <span class="v2-spinner v2-spinner-md"></span>
  </div>

  <div id="v2-od-not-found" style="display:none;padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Order not found"
      description="This order doesn't exist or you don't have access."
      ctaText="See all orders"
      ctaHref="/v2/track"
    />
  </div>

  <div id="v2-od-content" style="display:none;padding:0 16px 24px;">
    <!-- Status hero -->
    <div class="v2-od-hero">
      <div class="v2-od-status" id="v2-od-status">—</div>
      <div class="v2-od-id">Order <span id="v2-od-shortid">—</span></div>
      <div class="v2-od-time" id="v2-od-time">—</div>
    </div>

    <!-- Stepper -->
    <div class="v2-od-section">
      <div class="v2-od-stepper" id="v2-od-stepper"></div>
      <div class="v2-od-steplabels">
        <span>Placed</span><span>Confirmed</span><span>Ready</span><span>Done</span>
      </div>
    </div>

    <!-- Seller -->
    <div class="v2-od-section">
      <div class="v2-od-section-h">From</div>
      <div class="v2-od-row">
        <div>
          <div class="v2-od-seller" id="v2-od-seller">—</div>
          <div class="v2-od-sub" id="v2-od-seller-loc">—</div>
        </div>
        <!-- Call option removed per user request -->
      </div>
    </div>

    <!-- Items -->
    <div class="v2-od-section">
      <div class="v2-od-section-h">Items</div>
      <div id="v2-od-items"></div>
    </div>

    <!-- Pre-order info (shown only for pre_order status) -->
    <div id="v2-od-preorder-info" style="display:none;"></div>

    <!-- Delivery / Pickup -->
    <div class="v2-od-section" id="v2-od-fulfill"></div>

    <!-- Bill -->
    <div class="v2-od-section">
      <div class="v2-od-section-h">Bill summary</div>
      <div class="v2-od-bill" id="v2-od-bill"></div>
    </div>

    <!-- Actions -->
    <div id="v2-od-actions" style="margin-top:16px;"></div>
    <!-- Optional payment proof (confirmed+); separate from #v2-od-actions so prefs form re-renders do not wipe it -->
    <div id="v2-od-extra-payment"></div>
  </div>
</AppShellV2>

<style is:global>
  .v2-od-hero {
    background: linear-gradient(135deg, var(--v2-brand), #3B82F6);
    color: #fff;
    padding: 20px 16px;
    margin: 16px 0;
    border-radius: var(--v2-radius-lg);
    text-align: center;
  }
  .v2-od-status { font: 800 18px Inter; }
  .v2-od-id { font: 600 12px Inter; opacity: .9; margin-top: 4px; }
  .v2-od-time { font: 400 11px Inter; opacity: .8; margin-top: 2px; }
  .v2-od-section {
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius);
    padding: 14px;
    margin-bottom: 12px;
  }
  .v2-od-section-h { font: 700 11px Inter; color: var(--v2-ink-3); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 8px; }
  .v2-od-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .v2-od-seller { font: 700 14px Inter; color: var(--v2-ink); }
  .v2-od-sub { font: 400 12px Inter; color: var(--v2-ink-2); margin-top: 2px; }
  .v2-od-call {
    background: var(--v2-green);
    color: #fff;
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 9999px;
    font: 700 12px Inter;
    flex-shrink: 0;
  }
  .v2-od-item-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--v2-border);
    font: 500 13px Inter;
  }
  .v2-od-item-row:last-child { border-bottom: none; }
  .v2-od-item-name { color: var(--v2-ink); font-weight: 600; }
  .v2-od-item-qty { color: var(--v2-ink-3); font-size: 11px; margin-top: 2px; }
  .v2-od-bill div { display: flex; justify-content: space-between; padding: 4px 0; font: 500 13px Inter; color: var(--v2-ink-2); }
  .v2-od-bill .total { font: 800 15px Inter; color: var(--v2-ink); padding-top: 8px; border-top: 1px solid var(--v2-border); margin-top: 4px; }
  .v2-od-stepper {
    display: flex; align-items: center; gap: 4px;
    margin-bottom: 6px;
  }
  .v2-od-stepper .dot {
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--v2-ink-4); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font: 700 11px Inter; flex-shrink: 0;
  }
  .v2-od-stepper .dot.done { background: var(--v2-green); }
  .v2-od-stepper .line { flex: 1; height: 2px; background: var(--v2-bg-3); }
  .v2-od-stepper .line.done { background: var(--v2-green); }
  .v2-od-steplabels {
    display: flex; justify-content: space-between;
    font: 500 9px Inter; color: var(--v2-ink-3);
  }
  .v2-od-cancel {
    width: 100%;
    background: var(--v2-bg);
    color: var(--v2-red);
    border: 1px solid var(--v2-red-l);
    padding: 14px;
    border-radius: var(--v2-radius);
    font: 700 13px Inter;
    cursor: pointer;
  }
</style>

<script>
  import { createClient } from "@supabase/supabase-js";
  import { isPreorderCatchFlow, resolveBuyerStepper } from "../../../lib/buyer-order-stepper";
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL || "",
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || ""
  );
  // Extract order ID from URL path: /v2/track/{id}
  const orderId = window.location.pathname.split("/").filter(Boolean).pop() || "";
  function escape(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  }
  function stars(n) {
    const rating = Math.max(0, Math.min(5, Number(n) || 0));
    return [1, 2, 3, 4, 5].map(i => i <= rating ? "★" : "☆").join(" ");
  }
  function statusLabel(s, o) {
    const proofOnFile = o && Array.isArray(o.payment_screenshot_urls) && o.payment_screenshot_urls.length > 0;
    return ({
      pending: "Awaiting confirmation",
      pending_payment: proofOnFile ? "Payment proof submitted" : "Upload payment proof",
      pre_order: "Pre-order placed",
      scheduled: "Scheduled pickup",
      confirmed: "Confirmed ✓",
      paid: "Payment received",
      payment_required: "Additional payment needed",
      ready_for_pickup: "Ready for pickup",
      out_for_delivery: "Out for delivery",
      picked_up: "Picked up",
      completed: "Completed",
      declined: "Declined by seller",
      cancelled: "Cancelled",
      refunded: "Refund processed",
    })[s] || s;
  }
  function billPaymentFootnote(o) {
    const paidAmt = o.paid_amount ? Number(o.paid_amount) : 0;
    const proofOnFile = Array.isArray(o.payment_screenshot_urls) && o.payment_screenshot_urls.length > 0;
    if (paidAmt > 0 && proofOnFile) return "Paid via UPI · screenshot on file";
    if (paidAmt > 0) return "Paid via UPI";
    if (proofOnFile) return "Payment proof submitted — seller will verify shortly";
    return "Payment proof pending";
  }
  function isCancellable(s) {
    return s === "pending" || s === "pending_payment" || s === "pre_order";
  }

  let pollTimer = null;

  async function load() {
    const phone = (() => { try { return localStorage.getItem("zepto_phone") || ""; } catch { return ""; } })();
    const buyerId = (() => { try { return localStorage.getItem("zepto_buyer_id") || ""; } catch { return ""; } })();
    if (!phone || !buyerId) {
      window.location.href = "/v2/track";
      return;
    }
    try {
      const res = await fetch(`/api/orders/detail?id=${encodeURIComponent(orderId)}&buyer_id=${encodeURIComponent(buyerId)}`);
      if (res.status === 404 || res.status === 403) {
        document.getElementById("v2-od-loading").style.display = "none";
        document.getElementById("v2-od-not-found").style.display = "block";
        return;
      }
      if (!res.ok) throw new Error("Load failed");
      const { order } = await res.json();
      render(order);
    } catch (err) {
      document.getElementById("v2-od-loading").style.display = "none";
      document.getElementById("v2-od-not-found").style.display = "block";
    }
  }

  function render(o) {
    document.getElementById("v2-od-loading").style.display = "none";
    document.getElementById("v2-od-content").style.display = "block";
    const extraPaySlot = document.getElementById("v2-od-extra-payment");
    if (extraPaySlot) extraPaySlot.innerHTML = "";

    document.getElementById("v2-od-status").textContent = statusLabel(o.status, o);
    document.getElementById("v2-od-shortid").textContent = "#" + String(o.id).slice(0,6).toUpperCase();
    document.getElementById("v2-od-time").textContent = new Date(o.created_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" });
    // Hero colour: green for confirmed/done, red for declined/cancelled, orange for payment actions
    const hero = document.querySelector(".v2-od-hero");
    if (hero) {
      if (["confirmed","paid","ready_for_pickup","out_for_delivery","picked_up","completed"].includes(o.status)) {
        hero.style.background = "linear-gradient(135deg,#059669,#10B981)";
      } else if (["declined","cancelled"].includes(o.status)) {
        hero.style.background = "linear-gradient(135deg,#DC2626,#EF4444)";
      } else if (["pending_payment","payment_required"].includes(o.status)) {
        hero.style.background = "linear-gradient(135deg,#D97706,#F59E0B)";
      } else if (o.status === "refunded") {
        hero.style.background = "linear-gradient(135deg,#6366F1,#818CF8)";
      } else if (o.status === "pre_order") {
        hero.style.background = "linear-gradient(135deg,#7C3AED,#A78BFA)";
      }
    }

    // Stepper — simple (4) vs same-day UPI (5, no Price set) vs catch pre-order (5 + Price set)
    const orderType = (o.order_type || "pickup") === "delivery" ? "delivery" : "pickup";
    const { labels: stepLabels, step } = resolveBuyerStepper(o, orderType);
    const stepper = document.getElementById("v2-od-stepper");
    const terminalMeta = {
      declined: { label: "Declined", color: "#DC2626", icon: "✕" },
      cancelled: { label: "Cancelled", color: "#DC2626", icon: "✕" },
      refunded: { label: "Refunded", color: "#7C3AED", icon: "₹" },
    };
    const terminal = terminalMeta[o.status];
    if (terminal) {
      stepper.innerHTML = `
        <div class="dot done">✓</div>
        <div class="line done"></div>
        <div class="dot" style="background:${terminal.color};color:#fff;font-size:11px;">${terminal.icon}</div>
      `;
    } else {
      stepper.innerHTML = Array.from({ length: stepLabels.length }, (_, i) =>
        `<div class="dot${i <= step ? ' done' : ''}">${i <= step ? '✓' : i+1}</div>` +
        (i < stepLabels.length - 1 ? `<div class="line${i < step ? ' done' : ''}"></div>` : '')
      ).join("");
    }
    const stepLabelEl = document.querySelector(".v2-od-steplabels");
    if (stepLabelEl) {
      if (terminal) {
        stepLabelEl.innerHTML = `<span>Placed</span><span style="color:${terminal.color};font-weight:700;margin-left:auto;">${terminal.label}</span>`;
      } else {
        stepLabelEl.innerHTML = stepLabels.map(l => `<span>${l}</span>`).join("");
      }
    }

    // Seller
    const seller = o.seller || {};
    document.getElementById("v2-od-seller").textContent = seller.name || "Seller";
    document.getElementById("v2-od-seller-loc").textContent = seller.location_name || seller.location || "";
    // Call option removed per user request

    // Items
    const items = (o.items && o.items.length > 0) ? o.items : [{
      species: o.listing?.species || o.species,
      quantity: o.quantity,
      quantity_unit: o.quantity_unit,
      total_price: o.total_price,
    }];
    // Cut style & notes (may be on order directly or on individual items)
    const cutStyle = o.cut_style || "";
    const buyerNotes = o.buyer_notes || "";

    const pricingOpts = o.listing?.pricing_options || [];
    const opt = pricingOpts.find((x: any) => x?.id && x.id === o.pricing_option_id) || null;
    const bundle = opt?.bundle_size && opt.bundle_size > 1 ? Number(opt.bundle_size) : 1;
    document.getElementById("v2-od-items").innerHTML = items.map(it => {
      const unit = it.quantity_unit || 'kg';
      const qtyLabel = unit === "piece" && bundle > 1 ? `${Math.round(Number(it.quantity) / bundle)} pack` : `${escape(it.quantity)} ${escape(unit)}`;
      return `
      <div class="v2-od-item-row">
        <div>
          <div class="v2-od-item-name" style="text-transform:capitalize;">${escape(it.species || "Fish")}</div>
          <div class="v2-od-item-qty">${qtyLabel}</div>
        </div>
        <div style="font-weight:700;">₹${(it.total_price || 0).toLocaleString("en-IN")}</div>
      </div>`;
    }).join("")
      + (cutStyle ? `<div style="font:600 12px Inter;color:var(--v2-ink-2);margin-top:8px;">✂️ ${escape(cutStyle.split(",").map(c => ({whole:"Whole",cleaned:"Cleaned",cut:"Cut"})[c] || c).join(", "))}</div>` : "")
      + (buyerNotes ? `<div style="font:400 12px Inter;color:var(--v2-ink-3);margin-top:4px;">📝 ${escape(buyerNotes)}</div>` : "");

    // Fulfillment
    const fulfillEl = document.getElementById("v2-od-fulfill");
    if (o.order_type === "delivery" && o.address) {
      const a = o.address;
      const text = [a.flat, a.building, a.landmark, a.location_name].filter(Boolean).map(escape).join(", ");
      fulfillEl.innerHTML = `
        <div class="v2-od-section-h">Deliver to</div>
        <div style="font:600 13px Inter;color:var(--v2-ink);">${escape(a.label || "Address")}</div>
        <div class="v2-od-sub">${text || "Saved address"}</div>`;
    } else {
      fulfillEl.innerHTML = `
        <div class="v2-od-section-h">Pickup at</div>
        <div style="font:600 13px Inter;color:var(--v2-ink);">${escape(seller.location_name || seller.location || "Seller location")}</div>
        ${o.scheduled_for ? `<div class="v2-od-sub">Scheduled: ${new Date(o.scheduled_for).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" })}</div>` : ''}`;
    }

    // Pre-order info box
    const preorderEl = document.getElementById("v2-od-preorder-info");
    if (preorderEl) {
      const awaitingFinal =
        Number(o.paid_amount) > 0 &&
        (o.final_price == null || o.final_price === "");
      if (
        isPreorderCatchFlow(o) &&
        (["pending_payment", "payment_required", "pre_order"].includes(o.status) || awaitingFinal)
      ) {
        const amountDue = o.paid_amount ? `₹${Number(o.paid_amount).toLocaleString("en-IN")}` : "";
        // Per-unit preorder range from pricing_options (matched by pricing_option_id used on this order)
        const popts: any[] = o.listing?.pricing_options || [];
        const matchedOpt = popts.find((p: any) => p?.id && p.id === o.pricing_option_id) || popts[0] || {};
        const priceMin = matchedOpt.preorder_price_min;
        const priceMax = matchedOpt.preorder_price_max;
        const rangeHtml = priceMin && priceMax
          ? `<div style="font:700 13px Inter;color:#7C3AED;margin:8px 0 4px;">Expected price range: ₹${Number(priceMin).toLocaleString("en-IN")} – ₹${Number(priceMax).toLocaleString("en-IN")}</div>`
          : priceMin ? `<div style="font:700 13px Inter;color:#7C3AED;margin:8px 0 4px;">Min estimate: ₹${Number(priceMin).toLocaleString("en-IN")}</div>` : "";
        preorderEl.innerHTML = `
          <div style="background:#F5F3FF;border:1.5px solid #C4B5FD;border-radius:var(--v2-radius-sm);padding:14px;margin-bottom:12px;">
            <div style="font:700 13px Inter;color:#7C3AED;margin-bottom:6px;">🌙 Next-day catch pre-order</div>
            ${rangeHtml}
            <div style="font:400 12px Inter;color:#6D28D9;line-height:1.6;margin-top:6px;">Pay and upload UPI screenshot so the seller can verify, then they’ll set the final price after the morning catch.${amountDue ? ` Amount: <strong>${amountDue}</strong>.` : ""}</div>
            <div style="font:400 11px Inter;color:#8B5CF6;margin-top:6px;line-height:1.5;">If the final price is <strong>lower</strong> than you paid → <strong>refund within 7 working days</strong>. If <strong>higher</strong> → you'll approve the difference.</div>
          </div>`;
        preorderEl.style.display = "block";
      } else {
        preorderEl.style.display = "none";
        preorderEl.innerHTML = "";
      }
    }

    // Bill
    const subtotal = o.total_price || 0;
    const delivery = o.delivery_fee || 0;
    const grand = subtotal + delivery;
    const finalPrice = o.final_price ? Number(o.final_price) : null;
    const paidAmount = o.paid_amount ? Number(o.paid_amount) : null;
    const balance = finalPrice && paidAmount ? finalPrice - paidAmount : null;
    document.getElementById("v2-od-bill").innerHTML = `
      <div><span>Subtotal</span><span>₹${subtotal.toLocaleString("en-IN")}</span></div>
      ${delivery > 0 ? `<div><span>Delivery</span><span>₹${delivery.toLocaleString("en-IN")}</span></div>` : ''}
      <div class="total"><span>Total</span><span>₹${grand.toLocaleString("en-IN")}</span></div>
      ${finalPrice ? `<div style="padding-top:6px;border-top:1px solid var(--v2-border);margin-top:4px;"><span style="color:var(--v2-ink-2);">Final price (seller)</span><span style="font-weight:700;color:var(--v2-ink);">₹${finalPrice.toLocaleString("en-IN")}</span></div>` : ''}
      ${paidAmount ? `<div><span style="color:var(--v2-ink-2);">You paid</span><span style="color:var(--v2-green);">₹${paidAmount.toLocaleString("en-IN")}</span></div>` : ''}
      ${balance && balance > 0 ? `<div><span style="color:var(--v2-red);">Balance due</span><span style="font-weight:700;color:var(--v2-red);">₹${balance.toLocaleString("en-IN")}</span></div>` : ''}
      ${balance && balance < 0 ? `<div><span style="color:var(--v2-green);">Refund</span><span style="font-weight:700;color:var(--v2-green);">₹${Math.abs(balance).toLocaleString("en-IN")}</span></div>` : ''}
      <div style="font:400 11px Inter;color:var(--v2-ink-3);margin-top:4px;">${escape(billPaymentFootnote(o))}</div>`;

    // Actions
    const actions = document.getElementById("v2-od-actions");
    if (o.status === "pending_payment") {
      // UPI screenshot upload (catch pre-order + same-day when seller asks for proof)
      renderPaymentUpload(o, "pending");
      const pre = isPreorderCatchFlow(o);
      const cancelLabel = pre ? "Cancel pre-order" : "Cancel order";
      const cancelConfirm = pre ? "Cancel this pre-order?" : "Cancel this order?";
      const cancelToast = pre ? "Pre-order cancelled" : "Order cancelled";
      const cancelHtml = `<button class="v2-od-cancel" id="v2-od-cancel-btn" style="margin-top:8px;">${cancelLabel}</button>`;
      // Don't use `innerHTML += ...` here. It re-parses the whole subtree and drops
      // the event listeners we just attached inside renderPaymentUpload().
      actions.insertAdjacentHTML("beforeend", cancelHtml);
      document.getElementById("v2-od-cancel-btn")?.addEventListener("click", async () => {
        if (!confirm(cancelConfirm)) return;
        try {
          const buyerId = localStorage.getItem("zepto_buyer_id") || "";
          const res = await fetch("/api/orders/cancel", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ order_id: o.id, buyer_id: buyerId, action: "cancel" }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Cancel failed");
          window.v2Toast?.("success", cancelToast);
          setTimeout(() => load(), 600);
        } catch (err) {
          window.v2Toast?.("error", "Failed", err.message);
        }
      });
    } else if (isCancellable(o.status)) {
      actions.innerHTML = `<button class="v2-od-cancel" id="v2-od-cancel-btn">Cancel order</button>`;
      document.getElementById("v2-od-cancel-btn").addEventListener("click", async () => {
        if (!confirm("Cancel this order? This cannot be undone.")) return;
        try {
          const buyerId = localStorage.getItem("zepto_buyer_id") || "";
          const res = await fetch("/api/orders/cancel", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ order_id: o.id, buyer_id: buyerId, action: "cancel" }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Cancel failed");
          window.v2Toast?.("success", "Order cancelled");
          setTimeout(() => load(), 600);
        } catch (err) {
          window.v2Toast?.("error", "Failed", err.message);
        }
      });
    } else if (["completed", "picked_up", "cancelled", "declined"].includes(o.status)) {
      // Finished/cancelled order — show refund notice if paid, ask rating for completed/picked_up, then offer re-order.
      const paidForRefund = Number(o.paid_amount) || 0;
      let refundHtml = "";
      const isDelivered = ["completed", "picked_up"].includes(o.status);
      const existingFeedback = o.buyer_feedback || null;
      if (paidForRefund > 0 && ["cancelled", "declined"].includes(o.status)) {
        const buyerSsPaths2: string[] = o.payment_screenshot_urls || [];
        const buyerSsBtns2 = buyerSsPaths2.map((_, i) =>
          `<button id="v2-od-refund-ss2-${i}" style="width:100%;margin-top:6px;padding:9px;background:#EEF2FF;color:#4F46E5;border:1px solid #C7D2FE;border-radius:var(--v2-radius-sm);font:600 12px Inter;cursor:pointer;">🖼 View my screenshot${buyerSsPaths2.length > 1 ? ' ' + (i+1) : ''}</button>`
        ).join("");
        const label = o.status === "declined" ? "Order declined by seller" : "Order cancelled";
        const sellerRefundBtn = o.refund_screenshot_path
          ? `<button id="v2-od-seller-refund-ss" style="width:100%;margin-top:6px;padding:9px;background:#EEF2FF;color:#4F46E5;border:1px solid #C7D2FE;border-radius:var(--v2-radius-sm);font:600 12px Inter;cursor:pointer;">🧾 View seller's refund proof</button>`
          : "";
        const sellerRefundNote = o.refund_sent_at
