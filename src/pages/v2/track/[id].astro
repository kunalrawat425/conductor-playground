    function renderPaymentUpload(o, kind, mountEl) {
      const actionsRoot = document.getElementById("v2-od-actions");
      const root = mountEl || actionsRoot;
      if (!root) return;

      const isBalance = kind === "balance";
      const isOptional = kind === "optional";

      const paidSoFar = Number(o.paid_amount) || 0;
      const finalPrice = Number(o.final_price) || 0;
      let balance = 0;
      if (isBalance) {
        balance = Math.max(0, finalPrice - paidSoFar);
      } else if (!isOptional) {
        balance = Number(o.total_price) + Number(o.delivery_fee || 0);
      }

      const alreadyUploaded = o.payment_screenshot_urls && o.payment_screenshot_urls.length > 0;
      const orderTotalRef = Number(o.total_price) + Number(o.delivery_fee || 0);

      const title = isOptional
        ? "💳 Payment screenshot"
        : isBalance
          ? "💸 Additional payment needed"
          : "💳 Upload payment proof";
      const subtitle = isOptional
        ? "Upload or replace your UPI payment photo. The seller is notified and can verify again if needed."
        : isBalance
          ? `Seller updated the final price. Please pay ₹${balance.toLocaleString("en-IN")} and upload the UPI screenshot.`
          : `Pay ₹${balance.toLocaleString("en-IN")} via UPI and upload the screenshot below.`;
      const amountBlock = isOptional
        ? paidSoFar > 0
          ? `<div style="font:600 12px Inter;color:var(--v2-ink-2);margin-bottom:12px;">Paid on record: ₹${paidSoFar.toLocaleString("en-IN")}</div>`
          : `<div style="font:400 12px Inter;color:var(--v2-ink-2);margin-bottom:12px;">Order total (reference): ₹${orderTotalRef.toLocaleString("en-IN")}</div>`
        : `<div style="font:800 16px Inter;color:var(--v2-brand);margin-bottom:16px;">₹${balance.toLocaleString("en-IN")}</div>`;

      root.innerHTML = `
        <div style="background:var(--v2-bg);border:1.5px solid var(--v2-brand);border-radius:var(--v2-radius);padding:16px;margin-top:8px;">
          <div style="font:800 14px Inter;color:var(--v2-ink);margin-bottom:4px;">${title}</div>
          <div style="font:400 12px Inter;color:var(--v2-ink-2);margin-bottom:12px;">${subtitle}</div>
          ${amountBlock}
          ${alreadyUploaded ? `<div id="v2-pay-ss-status" style="font:600 12px Inter;color:var(--v2-green);margin-bottom:6px;">✓ Screenshot uploaded — awaiting seller confirmation</div><div id="v2-pay-screenshots-list" style="margin-bottom:12px;font:400 11px Inter;color:var(--v2-ink-3);">Loading your screenshot...</div>` : ""}
          <label style="display:block;cursor:pointer;">
            <div id="v2-pay-drop" style="border:2px dashed var(--v2-border);border-radius:var(--v2-radius-sm);padding:20px;text-align:center;font:500 13px Inter;color:var(--v2-ink-2);">
              ${alreadyUploaded ? "📷 Replace screenshot" : "📷 Tap to select screenshot"}
            </div>
            <input type="file" id="v2-pay-file" accept="image/*" style="display:none;" />
          </label>
          <div id="v2-pay-preview" style="margin-top:10px;display:none;">
            <img id="v2-pay-img" style="width:100%;max-height:180px;object-fit:contain;border-radius:var(--v2-radius-sm);border:1px solid var(--v2-border);" />
          </div>
          <button type="button" id="v2-pay-submit" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full" style="margin-top:12px;display:none;">Submit payment proof</button>
          <div id="v2-pay-err" style="font:500 11px Inter;color:var(--v2-red);margin-top:8px;display:none;"></div>
        </div>`;

      const qs = (sel) => root.querySelector(sel);

      if (alreadyUploaded) {
        const buyerIdForSS = (() => { try { return localStorage.getItem("zepto_buyer_id") || ""; } catch { return ""; } })();
        fetch(`/api/orders/payment-screenshots?order_id=${encodeURIComponent(o.id)}&buyer_id=${encodeURIComponent(buyerIdForSS)}`)
          .then(r => r.json())
          .then(ssData => {
            const list = qs("#v2-pay-screenshots-list");
            const statusEl = qs("#v2-pay-ss-status");
            if (!list) return;
            if (ssData.verified && statusEl) {
              statusEl.textContent = "✓ Payment verified by seller";
              statusEl.style.fontWeight = "800";
            }
            if (ssData.urls && ssData.urls.length > 0) {
              list.innerHTML = ssData.urls.map((url: string) =>
                `<img src="${url}" onclick="window.open('${url}','_blank','noopener')" style="width:100%;max-height:200px;object-fit:contain;border-radius:var(--v2-radius-sm);border:1px solid var(--v2-border);margin-bottom:6px;cursor:pointer;" />`
              ).join("") + `<div style="font:400 10px Inter;color:var(--v2-ink-3);">Tap image to open full size</div>`;
            } else {
              list.innerHTML = "";
            }
          })
          .catch(() => {
            const list = qs("#v2-pay-screenshots-list");
            if (list) list.innerHTML = "";
          });
      }

      const fileInput = qs("#v2-pay-file") as HTMLInputElement | null;
      const dropZone = qs("#v2-pay-drop") as HTMLElement | null;
      const preview = qs("#v2-pay-preview") as HTMLElement | null;
      const previewImg = qs("#v2-pay-img") as HTMLImageElement | null;
      const submitBtn = qs("#v2-pay-submit") as HTMLButtonElement | null;
      const errEl = qs("#v2-pay-err") as HTMLElement | null;

      fileInput?.addEventListener("change", () => {
        const file = fileInput.files?.[0];
        if (!file || !errEl || !preview || !dropZone || !previewImg || !submitBtn) return;
        if (file.size > 5 * 1024 * 1024) {
          errEl.style.display = "block";
          errEl.textContent = "File too large (max 5 MB)";
          return;
        }
        const url = URL.createObjectURL(file);
        previewImg.src = url;
        preview.style.display = "block";
        dropZone.textContent = file.name;
        submitBtn.style.display = "block";
        errEl.style.display = "none";
      });

      submitBtn?.addEventListener("click", async () => {
        const file = fileInput?.files?.[0];
        if (!file || !submitBtn || !errEl) return;
        submitBtn.disabled = true;
        submitBtn.textContent = "Uploading...";
        errEl.style.display = "none";
        try {
          const buyerId = localStorage.getItem("zepto_buyer_id") || "";
          const form = new FormData();
          form.append("order_id", o.id);
          form.append("buyer_id", buyerId);
          form.append("file", file);
          const res = await fetch("/api/orders/upload-payment", { method: "POST", body: form });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Upload failed");
          if (data.url) {
            const list = qs("#v2-pay-screenshots-list");
            const statusEl = qs("#v2-pay-ss-status");
            if (statusEl) statusEl.textContent = "✓ Screenshot uploaded — awaiting seller confirmation";
            if (list) {
              list.innerHTML = `<img src="${data.url}" onclick="window.open('${data.url}','_blank','noopener')" style="width:100%;max-height:200px;object-fit:contain;border-radius:var(--v2-radius-sm);border:1px solid var(--v2-border);margin-bottom:6px;cursor:pointer;" />`;
            }
          }
          window.v2Toast?.(
            "success",
            isOptional ? "Payment proof updated" : "Payment proof submitted",
            isOptional ? "The seller has been notified." : "Seller will confirm shortly"
          );
          setTimeout(() => load(), 1500);
        } catch (err) {
          errEl.style.display = "block";
          const msg = err.message || "Upload failed";
          if (/bucket[_ ]missing|storage is not configured|bucket .*not found/i.test(msg)) {
            errEl.textContent = "Payment upload is not configured yet. Ask admin to create private Supabase bucket `order-payments`.";
          } else {
            errEl.textContent = msg;
          }
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit payment proof";
        }
      });
    }
  }

  function initPage() {
    load();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPage);
  } else {
    initPage();
  }

  // Supabase Realtime: instant order status updates
  const terminalStatuses = ["picked_up", "completed", "cancelled", "declined", "refunded"];
  const channel = supabase
    .channel(`order-${orderId}`)
    .on("postgres_changes", {
      event: "UPDATE",
      schema: "public",
      table: "orders",
      filter: `id=eq.${orderId}`,
    }, (payload: any) => {
      load(); // re-render with new data
      const newStatus = payload.new?.status;
      if (newStatus && terminalStatuses.includes(newStatus)) {
        channel.unsubscribe();
      }
    })
    .subscribe();

  // Fallback poll every 30s in case realtime connection drops
  pollTimer = setInterval(() => {
    const statusEl = document.getElementById("v2-od-status");
    const text = statusEl?.textContent || "";
    if (text.includes("Picked up") || text.includes("Cancelled") || text.includes("Declined") || text.includes("Completed")) {
      clearInterval(pollTimer);
      return;
    }
    load();
  }, 30000);
</script>
