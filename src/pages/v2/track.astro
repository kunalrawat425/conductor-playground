---
export const prerender = false;
import AppShellV2 from "../../components/v2/AppShellV2.astro";
import EmptyState from "../../components/v2/molecules/EmptyState.astro";
import LoginSheet from "../../components/v2/organisms/LoginSheet.astro";
import Toast from "../../components/v2/atoms/Toast.astro";
---
<AppShellV2
  title="Your Orders | Relifish"
  description="Track your fish orders and reorder favorites."
  header={{
    variant: "page",
    title: "Your Orders",
    backHref: "/v2",
  }}
  nav={{ active: "orders" }}
>
  <Toast />
  <LoginSheet id="v2-track-login" role="buyer" redirectTo="/v2/track" />

  <div id="v2-track-loading" style="padding:24px;text-align:center;">
    <span class="v2-spinner v2-spinner-md"></span>
    <div style="margin-top:8px;font:500 12px Inter;color:var(--v2-ink-3);">Loading your orders...</div>
  </div>

  <div id="v2-track-guest" style="display:none;padding:0 16px;margin-top:16px;">
    <div class="v2-empty">
      <div class="v2-empty-icon">📋</div>
      <h3 class="v2-empty-title">Sign in to see your orders</h3>
      <p class="v2-empty-desc">Use your phone number to view past orders and track current ones.</p>
      <button id="v2-track-signin-btn" class="v2-btn v2-btn-primary v2-btn-md">Sign in</button>
    </div>
  </div>

  <div id="v2-track-empty" style="display:none;padding:0 16px;margin-top:16px;">
    <EmptyState
      variant="no-orders"
      ctaHref="/v2"
    />
  </div>

  <div id="v2-track-active"></div>
  <div id="v2-track-list" style="padding:0 16px;"></div>
</AppShellV2>

<style is:global>
  .v2-active-order {
    margin: 16px 16px 16px;
    background: linear-gradient(135deg, var(--v2-brand-l), #DBEAFE);
    border: 1px solid var(--v2-brand-m);
    border-radius: var(--v2-radius-lg);
    padding: 16px;
  }
  .v2-active-order .label {
    font: 700 10px Inter;
    color: var(--v2-brand);
    text-transform: uppercase; letter-spacing: .1em;
    margin-bottom: 6px;
  }
  .v2-active-order h3 {
    font: 800 16px Inter; color: var(--v2-ink); margin: 0 0 4px;
  }
  .v2-active-order .sub {
    font: 400 12px Inter; color: var(--v2-ink-2); margin: 0 0 16px;
  }
  .v2-stepper {
    display: flex; align-items: center; gap: 4px;
  }
  .v2-stepper .dot {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--v2-ink-4);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font: 700 11px Inter;
    flex-shrink: 0;
  }
  .v2-stepper .dot.done { background: var(--v2-green); }
  .v2-stepper .line { flex: 1; height: 2px; background: var(--v2-bg-3); }
  .v2-stepper .line.done { background: var(--v2-green); }
  .v2-stepper-labels {
    display: flex; justify-content: space-between;
    margin-top: 6px;
    font: 500 9px Inter; color: var(--v2-ink-3);
  }

  .v2-section-head-light {
    padding: 16px 16px 8px;
    font: 700 12px Inter;
    color: var(--v2-ink-3);
    text-transform: uppercase; letter-spacing: .05em;
  }

  .v2-order-row {
    margin-bottom: 12px;
    background: #fff;
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius);
    padding: 14px;
    text-decoration: none; color: inherit;
    display: block;
    transition: box-shadow var(--v2-dur-fast) var(--v2-ease);
  }
  .v2-order-row:hover { box-shadow: var(--v2-shadow); }
  .v2-or-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .v2-or-seller { font: 700 14px Inter; color: var(--v2-ink); }
  .v2-or-meta { font: 400 11px Inter; color: var(--v2-ink-3); margin-top: 1px; }
  .v2-or-items { font: 400 12px Inter; color: var(--v2-ink-2); margin-top: 6px; line-height: 1.4; }
  .v2-or-bot {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--v2-border);
  }
  .v2-or-total { font: 800 14px Inter; color: var(--v2-ink); }
  .v2-or-reorder {
    background: #fff; color: var(--v2-brand);
    border: 1.5px solid var(--v2-brand);
    font: 700 11px Inter;
    padding: 6px 14px;
    border-radius: var(--v2-radius-sm);
    cursor: pointer;
  }
</style>

<script>
  import { supabase } from "../../lib/supabase";

  function getBuyerPhone(): string | null {
    try { return localStorage.getItem("zepto_phone") || null; } catch { return null; }
  }

  function escapeHtml(s: string) {
    return String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!));
  }

  function statusToTag(status: string) {
    const map: Record<string, [string, string]> = {
      "pending": ["Pending", "v2-badge-tag v2-badge-orange"],
      "confirmed": ["Confirmed", "v2-badge-tag v2-badge-brand"],
      "paid": ["Paid", "v2-badge-tag v2-badge-brand"],
      "ready_for_pickup": ["Ready for pickup", "v2-badge-tag v2-badge-green"],
      "picked_up": ["Picked up", "v2-badge-tag v2-badge-green"],
      "completed": ["Completed", "v2-badge-tag v2-badge-green"],
      "declined": ["Declined", "v2-badge-tag v2-badge-red"],
      "cancelled": ["Cancelled", "v2-badge-tag v2-badge-red"],
      "refunded": ["Refunded", "v2-badge-tag v2-badge-red"],
      "scheduled": ["Scheduled", "v2-badge-tag v2-badge-indigo"],
      "pre_order": ["Pre-order", "v2-badge-tag v2-badge-indigo"],
    };
    const [text, cls] = map[status] || [status, "v2-badge-tag"];
    return `<span class="v2-badge ${cls} v2-badge-size-md">${escapeHtml(text)}</span>`;
  }

  function isActive(status: string) {
    return ["pending", "confirmed", "paid", "ready_for_pickup", "scheduled", "pre_order"].includes(status);
  }

  function fmtDate(iso: string) {
    const d = new Date(iso);
    const today = new Date();
    const diffDays = Math.floor((today.getTime() - d.getTime()) / 86400000);
    if (diffDays === 0) return "Today";
    if (diffDays === 1) return "Yesterday";
    if (diffDays < 7) return `${diffDays} days ago`;
    return d.toLocaleDateString("en-IN", { day: "numeric", month: "short" });
  }

  async function load() {
    const phone = getBuyerPhone();
    const loading = document.getElementById("v2-track-loading")!;
    const guest = document.getElementById("v2-track-guest")!;
    const empty = document.getElementById("v2-track-empty")!;
    const active = document.getElementById("v2-track-active")!;
    const list = document.getElementById("v2-track-list")!;

    if (!phone) {
      loading.style.display = "none";
      guest.style.display = "block";
      document.getElementById("v2-track-signin-btn")?.addEventListener("click", () => {
        (window as any).v2OpenSheet?.("v2-track-login");
      });
      return;
    }

    try {
      const { data: orders } = await supabase
        .from("orders")
        .select("*, listing:fish_listings(species, seller:sellers(name))")
        .eq("buyer_phone", phone)
        .order("created_at", { ascending: false })
        .limit(50);

      loading.style.display = "none";

      if (!orders || orders.length === 0) {
        empty.style.display = "block";
        return;
      }

      const activeOrders = orders.filter(o => isActive(o.status));
      const pastOrders = orders.filter(o => !isActive(o.status));

      // Active: render top one as stepper card
      if (activeOrders.length > 0) {
        const o = activeOrders[0];
        const seller = o.listing?.seller?.name || "Seller";
        // Simplified 4-step flow (most orders are COD — no separate Paid step needed for buyer view)
        // Map: pending → step 0, confirmed/paid → step 1, ready_for_pickup → step 2, picked_up/completed → step 3
        const statusToStep: Record<string, number> = {
          pending: 0, pre_order: 0, scheduled: 0,
          confirmed: 1, paid: 1,
          ready_for_pickup: 2,
          picked_up: 3, completed: 3,
        };
        const stepIdx = statusToStep[o.status] ?? 0;
        const labels = ["Placed", "Confirmed", "Ready", "Picked up"];
        active.innerHTML = `
          <div class="v2-active-order">
            <div class="label">Live · Active order</div>
            <h3>${escapeHtml(seller)}</h3>
            <div class="sub">Order #${o.id.slice(0, 6).toUpperCase()}</div>
            <div class="v2-stepper">
              ${labels.map((label, i) => `
                <div class="dot${i <= stepIdx ? ' done' : ''}">${i <= stepIdx ? '✓' : i + 1}</div>
                ${i < labels.length - 1 ? `<div class="line${i < stepIdx ? ' done' : ''}"></div>` : ''}
              `).join("")}
            </div>
            <div class="v2-stepper-labels">
              ${labels.map(l => `<span>${l}</span>`).join("")}
            </div>
          </div>`;
      }

      // Past orders — paginated (client-side, 10 per page)
      if (pastOrders.length > 0) {
        const PAGE_SIZE = 10;
        let currentPage = 1;
        const totalPages = Math.ceil(pastOrders.length / PAGE_SIZE);

        function renderPage(page: number) {
          currentPage = Math.max(1, Math.min(totalPages, page));
          const start = (currentPage - 1) * PAGE_SIZE;
          const slice = pastOrders.slice(start, start + PAGE_SIZE);
          list.innerHTML = `
            <div class="v2-section-head-light">Past orders (${pastOrders.length})</div>
            ${slice.map(o => {
              const seller = o.listing?.seller?.name || "Seller";
              const sp = o.listing?.species || "";
              return `
                <a href="/v2/track" class="v2-order-row">
                  <div class="v2-or-top">
                    <div>
                      <div class="v2-or-seller">${escapeHtml(seller)}</div>
                      <div class="v2-or-meta">${escapeHtml(fmtDate(o.created_at))} · ${o.quantity}${o.quantity_unit || 'kg'} ${escapeHtml(sp)}</div>
                    </div>
                    ${statusToTag(o.status)}
                  </div>
                  <div class="v2-or-bot">
                    <div class="v2-or-total">₹${(o.total_price || o.final_price || 0).toLocaleString("en-IN")}</div>
                    <button class="v2-or-reorder" data-listing="${o.listing_id}">Reorder</button>
                  </div>
                </a>`;
            }).join("")}
            ${totalPages > 1 ? `
              <div class="v2-pagination">
                <button class="v2-pg-btn" data-pg="prev" ${currentPage <= 1 ? 'disabled' : ''}>← Prev</button>
                <span class="v2-pg-info">Page ${currentPage} of ${totalPages}</span>
                <button class="v2-pg-btn" data-pg="next" ${currentPage >= totalPages ? 'disabled' : ''}>Next →</button>
              </div>` : ''}
          `;

          list.querySelector('[data-pg="prev"]')?.addEventListener("click", () => renderPage(currentPage - 1));
          list.querySelector('[data-pg="next"]')?.addEventListener("click", () => renderPage(currentPage + 1));
        }

        renderPage(1);

        list.addEventListener("click", (e) => {
          const t = e.target;
          if (t instanceof HTMLElement && t.classList.contains("v2-or-reorder")) {
            e.preventDefault();
            const listingId = t.getAttribute("data-listing");
            // Navigate to seller page; user can re-add
            window.location.href = "/v2";
          }
        });
      } else if (activeOrders.length === 0) {
        empty.style.display = "block";
      }
    } catch (err) {
      console.error("track: load failed", err);
      loading.innerHTML = `<div style="text-align:center;padding:40px;color:var(--v2-red);">Failed to load orders.</div>`;
    }
  }

  load();
</script>
