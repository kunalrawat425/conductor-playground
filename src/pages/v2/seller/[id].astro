---
export const prerender = false;

import AppShellV2 from "../../../components/v2/AppShellV2.astro";
import SellerHero from "../../../components/v2/organisms/SellerHero.astro";
import EmptyState from "../../../components/v2/molecules/EmptyState.astro";
import LoginSheet from "../../../components/v2/organisms/LoginSheet.astro";
import CheckoutSheet from "../../../components/v2/organisms/CheckoutSheet.astro";
import CartStackSheet from "../../../components/v2/organisms/CartStackSheet.astro";
import AddressPickerSheet from "../../../components/v2/organisms/AddressPickerSheet.astro";
import Toast from "../../../components/v2/atoms/Toast.astro";
import Modal from "../../../components/v2/atoms/Modal.astro";
import { getSellerById, getSellerListings } from "../../../lib/supabase";
import { getSpeciesDisplay } from "../../../lib/species";

const { id } = Astro.params;
const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";

let seller: any = null;
let listings: any[] = [];
let notFound = false;
try {
  seller = await getSellerById(id!);
  if (seller) {
    listings = await getSellerListings(id!);
    listings = listings.filter((l: any) => l.is_available);
  } else notFound = true;
} catch { notFound = true; }

const sellerName = seller?.name || "Seller";
const sellerLocation = seller?.location_name || "";
const itemCount = listings.length;
const isOpen = (() => {
  if (!seller?.opens_at || !seller?.closes_at) return true;
  const now = new Date();
  const cur = now.getHours() * 60 + now.getMinutes();
  const [oh, om] = seller.opens_at.split(":").map(Number);
  const [ch, cm] = seller.closes_at.split(":").map(Number);
  const openMin = oh * 60 + om;
  const closeMin = ch * 60 + cm;
  // Handle cross-midnight ranges (e.g. 17:00 → 01:58)
  if (openMin <= closeMin) return cur >= openMin && cur <= closeMin;
  return cur >= openMin || cur <= closeMin;
})();
const status: "open" | "closed" = isOpen ? "open" : "closed";
const tags = [
  seller?.accepts_preorder ? "Pre-order" : null,
  !seller?.has_delivery ? "Pickup only" : null,
  seller?.has_delivery ? `${seller.delivery_rad || 5}km delivery` : null,
].filter(Boolean) as string[];
---
<AppShellV2
  title={`${sellerName} · ${brandName}`}
  description={`Order fresh fish from ${sellerName} in ${sellerLocation}.`}
  hideHeader={true}
  nav={{ active: "home" }}
>
  <Toast />
  <Modal />
  <LoginSheet id="seller-login-sheet" role="buyer" redirectTo={`/v2/seller/${id}`} />
  <AddressPickerSheet id="seller-addr-sheet" />
  <CartStackSheet id="seller-cart-stack" />
  <CheckoutSheet id="seller-checkout" />

  {notFound ? (
    <div style="padding:24px 16px;margin-top:24px;">
      <EmptyState variant="server-error" title="Seller not found" description="This seller doesn't exist or has been deactivated." ctaText="Browse sellers" ctaHref="/" />
    </div>
  ) : (
    <>
      <SellerHero
        name={sellerName}
        location={sellerLocation || seller?.location || ""}
        rating={seller?.rating_avg || 0}
        status={status}
        opensAt={seller?.opens_at}
        closesAt={seller?.closes_at}
        itemCount={itemCount}
        tags={tags}
      />

      {itemCount === 0 ? (
        <div style="padding:0 16px;margin-top:16px;">
          <EmptyState
            variant="no-results"
            title="No items available"
            description={seller?.accepts_preorder ? "Pre-order tomorrow's catch instead." : "Check back during opening hours."}
            ctaText={seller?.accepts_preorder ? "Pre-order" : "Browse sellers"}
            ctaHref={seller?.accepts_preorder ? "/v2/preorder" : "/"}
          />
        </div>
      ) : (
        <>
          <div style="padding:16px 16px 8px;display:flex;justify-content:space-between;align-items:center;">
            <h2 style="font:800 17px Inter;color:var(--v2-ink);margin:0;">Today's Menu</h2>
            <span style="font:600 12px Inter;color:var(--v2-ink-3);">{itemCount} items</span>
          </div>
          <div id="v2-menu-grid" class="v2-menu-grid"></div>
        </>
      )}
    </>
  )}

  <div id="v2-cart-bar-mount"></div>
</AppShellV2>

<style is:global>
  .v2-menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 0 16px 24px;
  }
  @media (min-width: 600px) {
    .v2-menu-grid { grid-template-columns: repeat(3, 1fr); }
  }
  body.v2-has-cart .v2-main { padding-bottom: 144px; }

  /* Multi-tier pricing rows inside item cards */
  .v2-item-tiers {
    margin-top: 6px;
  }
  .v2-item-tier {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 0;
  }
  .v2-item-tier-label {
    flex: 1;
    font: 500 11px Inter;
    color: var(--v2-ink-2);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .v2-item-tier-price {
    font: 800 12px Inter;
    color: var(--v2-ink);
    white-space: nowrap;
  }
  .v2-item-add-sm {
    width: 28px !important;
    height: 28px !important;
    min-width: 28px;
    font-size: 14px !important;
    padding: 0 !important;
  }
</style>

<script define:vars={{ listings, sellerId: id, sellerName, hasDelivery: seller?.has_delivery, deliveryFreeAbove: seller?.delivery_free_above, minOrder: seller?.min_order_amount, acceptsPreorder: seller?.accepts_preorder }}>
  function withCart(fn) {
    if (window.RelifishCart) return fn(window.RelifishCart);
    document.addEventListener("v2-cart-ready", () => fn(window.RelifishCart), { once: true });
  }

  const grid = document.getElementById("v2-menu-grid");
  const cartMount = document.getElementById("v2-cart-bar-mount");
  if (grid && listings) {
    function Cart() { return window.RelifishCart; }

    function getSellerItems() {
      const c = Cart();
      if (!c) return {};
      const cart = c.getCart();
      const out = {};
      for (const lid of Object.keys(cart)) {
        if (cart[lid].seller_id === sellerId) out[lid] = cart[lid];
      }
      return out;
    }

    function speciesEmoji(sp) {
      if (!sp) return "🐟";
      const s = sp.toLowerCase();
      if (s.includes("prawn")) return "🦐";
      if (s.includes("crab")) return "🦀";
      if (s.includes("squid") || s.includes("octopus")) return "🦑";
      return "🐟";
    }
    function escape(s) { return String(s||"").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
    function getName(sp) { try { return getSpeciesDisplay(sp) || sp; } catch { return sp; } }

    // Build composite cart key matching cart.ts logic
    function ck(listingId, optId) {
      return optId && optId !== "default" ? listingId + ":" + optId : listingId;
    }

    function renderItem(l) {
      const opts = l.pricing_options || [];
      const firstOpt = opts[0] || {};
      const name = getName(l.species);
      const sellerItems = getSellerItems();
      const emoji = speciesEmoji(l.species);
      const isPreorder = l.weight_avail === 0 && acceptsPreorder;

      // Total qty across all tiers for this listing (for incart highlight)
      const totalInCart = Object.keys(sellerItems).filter(k => k === l.id || k.startsWith(l.id + ":")).reduce((s, k) => s + (sellerItems[k]?.qty || 0), 0);

      // Show all pricing tiers as individual add buttons so buyer picks the right pack/unit.
      const pricingHtml = opts.length <= 1
        ? (() => {
            const price = firstOpt.price || 0;
            const unit = firstOpt.unit_label || firstOpt.label || "kg";
            const optId = firstOpt.id || "default";
            const key = ck(l.id, optId);
            const inCart = sellerItems[key]?.qty || 0;
            return `<div class="v2-item-bottom">
              <div class="v2-item-price">₹${price}<span style="font-size:10px;font-weight:500;color:var(--v2-ink-3);"> /${escape(unit)}</span></div>
              ${inCart > 0
                ? `<div class="v2-item-counter" data-id="${key}">
                     <button class="v2-item-dec" aria-label="Decrease">−</button>
                     <span class="v2-item-count">${inCart}</span>
                     <button class="v2-item-inc" aria-label="Increase">+</button>
                   </div>`
                : `<button class="v2-item-add" style="background:${isPreorder ? '#7C3AED' : 'var(--v2-brand)'};" data-id="${l.id}" data-price="${price}" data-name="${escape(name)}" data-unit="${escape(unit)}" data-opt-id="${optId}" data-opt-label="${escape(unit)}" aria-label="Add ${escape(name)}">+</button>`}
            </div>`;
          })()
        : (() => {
            // Multiple tiers — each tier gets its own add/counter using composite key.
            return `<div class="v2-item-tiers">
              ${opts.map((o) => {
                const label = o.label || o.unit_label || o.unit || "unit";
                const optId = o.id || "default";
                const key = ck(l.id, optId);
                const tierQty = sellerItems[key]?.qty || 0;
                const bSize = o.bundle_size && o.bundle_size !== 1 ? ` (${o.bundle_size}${o.unit === 'kg' ? 'kg' : 'pc'})` : '';
                return `<div class="v2-item-tier">
                  <span class="v2-item-tier-label">${escape(label)}${bSize}</span>
                  <span class="v2-item-tier-price">₹${o.price}</span>
                  ${tierQty > 0
                    ? `<div class="v2-item-counter" data-id="${key}" style="transform:scale(0.85);">
                         <button class="v2-item-dec" aria-label="Decrease">−</button>
                         <span class="v2-item-count">${tierQty}</span>
                         <button class="v2-item-inc" aria-label="Increase">+</button>
                       </div>`
                    : `<button class="v2-item-add v2-item-add-sm" style="background:${isPreorder ? '#7C3AED' : 'var(--v2-brand)'};" data-id="${l.id}" data-price="${o.price}" data-name="${escape(name)}" data-unit="${escape(o.unit || 'kg')}" data-opt-id="${optId}" data-opt-label="${escape(label)}" aria-label="Add ${escape(name)} ${escape(label)}">+</button>`}
                </div>`;
              }).join("")}
            </div>`;
          })();

      return `
        <div class="v2-item-card${totalInCart > 0 ? ' v2-item-incart' : ''}" data-listing-id="${l.id}">
          <div class="v2-item-img" style="background:${isPreorder ? 'linear-gradient(135deg,#F3E8FF,#E9D5FF)' : 'linear-gradient(135deg,#E0F2FE,#BAE6FD)'};">
            <span class="v2-item-emoji">${emoji}</span>
            ${isPreorder ? '<span class="v2-item-cut" style="background:#F3E8FF;color:#7C3AED;">Pre-order</span>' : ''}
          </div>
          <div class="v2-item-body">
            <div class="v2-item-name">${escape(name)}</div>
            ${pricingHtml}
          </div>
        </div>`;
    }

    function render() {
      grid.innerHTML = listings.map(renderItem).join("");
      renderCart();
    }

    let selectedAddressId = null;
    // Remember which seller's cart we're currently checking out (set when user
    // taps Checkout on a CartStackSheet card, OR defaults to this page's sellerId
    // when only one seller has items).
    let activeCheckoutSellerId = sellerId;

    // Publish per-seller min-order hints so CartStackSheet can show "Add ₹X more"
    // without needing its own DB query.
    (function publishMinOrder() {
      window.__relifishMinOrders = window.__relifishMinOrders || {};
      window.__relifishMinOrders[sellerId] = minOrder || 0;
    })();

    function renderCart() {
      const c = Cart(); if (!c) return;
      const cart = c.getCart();
      const totalQty = c.totalQty(cart);

      // Single-seller cart: all items belong to one seller.
      const sellerItems = Object.values(getSellerItems());
      const sellerQty = sellerItems.reduce((s, i) => s + i.qty, 0);
      const sellerSubtotal = sellerItems.reduce((s, i) => s + i.qty * i.price, 0);

      if (totalQty === 0) { cartMount.innerHTML = ""; document.body.classList.remove("v2-has-cart"); return; }
      document.body.classList.add("v2-has-cart");

      const belowMin = minOrder && sellerQty > 0 && sellerSubtotal < minOrder;
      const freeHit = deliveryFreeAbove && sellerSubtotal >= deliveryFreeAbove;
      const variant = belowMin ? "warning" : freeHit ? "success" : "default";

      const leftLine = belowMin
        ? `Add ₹${minOrder - sellerSubtotal} more for min order`
        : freeHit ? "🎉 Free delivery unlocked"
        : `${sellerQty} item${sellerQty !== 1 ? "s" : ""}`;
      const displayTotal = sellerSubtotal;
      const ctaText = belowMin ? "Keep shopping" : "Checkout →";
      const variantClass = variant === "warning" ? "v2-cart-warning" : variant === "success" ? "v2-cart-success" : "";
      const ctaColorStyle = variant === "warning" ? "color:var(--v2-orange);" : variant === "success" ? "color:var(--v2-green);" : "";

      cartMount.innerHTML = `<button class="v2-cart-bar ${variantClass}" id="v2-checkout-btn" type="button">
        <div class="v2-cb-left">
          <div class="v2-cb-items">${leftLine}</div>
          <div class="v2-cb-total">${sellerQty > 0 ? `₹${displayTotal.toLocaleString("en-IN")}` : ""}</div>
        </div>
        <span class="v2-cb-btn" style="${ctaColorStyle}">${ctaText}</span>
      </button>`;

      document.getElementById("v2-checkout-btn")?.addEventListener("click", onCartBarTap);
    }

    // Single-seller cart: always go straight to checkout for this seller.
    function onCartBarTap() {
      openCheckout(sellerId);
    }

    // Toast when cart switches seller (user added item from different seller page)
    window.addEventListener("v2-cart-seller-switched", () => {
      window.v2Toast?.("success", "Cart updated", "Previous seller's items cleared");
    });

    // Single-seller checkout. `targetSellerId` is the seller whose cart we're placing.
    // Defaults to this page's sellerId but CartStackSheet may pass any seller_id from
    // the global cart.
    function openCheckout(targetSellerId) {
      const c = Cart(); if (!c) return;
      const sid = targetSellerId || sellerId;
      activeCheckoutSellerId = sid;

      const groups = c.groupBySeller();
      const group = groups.find((g) => g.seller_id === sid);
      if (!group || group.items.length === 0) {
        window.v2Toast?.("error", "Cart empty", "Add items before checkout");
        return;
      }

      // Pre-flight: must be signed in
      let buyerId = null, buyerPhone = null;
      try { buyerId = localStorage.getItem("zepto_buyer_id"); buyerPhone = localStorage.getItem("zepto_phone"); } catch {}
      if (!buyerId || !buyerPhone) {
        window.v2OpenSheet?.("seller-login-sheet");
        return;
      }

      // Min-order gate for the active seller (the one we're checking out).
      // Only enforce for THIS page's seller since we only have minOrder for them.
      if (sid === sellerId && minOrder && group.subtotal < minOrder) {
        window.v2Toast?.("error", "Below min order", `Add ₹${minOrder - group.subtotal} more to checkout`);
        return;
      }

      // Populate cart items in CheckoutSheet step 1 — single seller only
      const cartItemsEl = document.getElementById("seller-checkout-cart-items");
      if (cartItemsEl) {
        cartItemsEl.innerHTML = `
          <div style="font:700 12px Inter;color:var(--v2-ink-2);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;">From ${escape(group.seller_name || "Seller")}</div>
          ${group.items.map(i => `
            <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--v2-border);font:500 13px Inter;">
              <div>
                <div style="color:var(--v2-ink);font-weight:600;">${escape(i.name)}</div>
                <div style="color:var(--v2-ink-3);font-size:11px;">${i.qty} × ${escape(i.pricing_label || i.qty_unit)}</div>
              </div>
              <div style="font-weight:700;color:var(--v2-ink);">₹${(i.qty * i.price).toLocaleString("en-IN")}</div>
            </div>`).join("")}`;
      }
      const subtotal = group.subtotal;
      document.getElementById("seller-checkout-subtotal").textContent = `₹${subtotal.toLocaleString("en-IN")}`;
      // Total = subtotal (delivery fee shows up in the Delivery row below only if user picks delivery).
      document.getElementById("seller-checkout-total").textContent = `₹${subtotal.toLocaleString("en-IN")}`;
      document.getElementById("seller-checkout-total-final").textContent = `₹${subtotal.toLocaleString("en-IN")}`;

      // Reset delivery fee preview — method radio click will repopulate.
      const delivRow = document.getElementById("seller-checkout-delivery-row");
      if (delivRow) delivRow.style.display = "none";

      // Toggle delivery option visibility based on seller's has_delivery.
      // NOTE: we only know hasDelivery for this page's seller. If the CartStack sent
      // us into a different seller's checkout, treat delivery as unknown and force pickup.
      const delivOpt = document.getElementById("seller-checkout-delivery-opt");
      const noDelivNote = document.getElementById("seller-checkout-no-delivery-note");
      const canDeliver = sid === sellerId && hasDelivery;
      if (canDeliver) {
        if (delivOpt) delivOpt.style.display = "flex";
        if (noDelivNote) noDelivNote.style.display = "none";
      } else {
        if (delivOpt) delivOpt.style.display = "none";
        if (noDelivNote) noDelivNote.style.display = "block";
        const pickupRadio = document.querySelector('input[name="seller-checkout-method"][value="pickup"]');
        if (pickupRadio) pickupRadio.checked = true;
      }

      // Auto-load default address when sheet opens
      preloadAddress();

      window.v2OpenSheet?.("seller-checkout");
    }

    // When user toggles method to delivery, show the fee preview row with a client-side
    // estimate. Real fee is computed server-side at place-order time via computeDeliveryFee.
    document.querySelectorAll('input[name="seller-checkout-method"]').forEach((r) => {
      r.addEventListener("change", () => {
        const isDelivery = r.value === "delivery" && r.checked;
        const delivRow = document.getElementById("seller-checkout-delivery-row");
        const delivEl = document.getElementById("seller-checkout-delivery");
        const totalEl = document.getElementById("seller-checkout-total");
        const totalFinal = document.getElementById("seller-checkout-total-final");
        const subEl = document.getElementById("seller-checkout-subtotal");
        const subtotalText = (subEl?.textContent || "").replace(/[^\d]/g, "");
        const subtotal = parseInt(subtotalText) || 0;
        // Rough client estimate — server is authoritative.
        // ₹40 flat under ₹500, FREE at/above ₹500 when seller has free delivery threshold.
        let fee = 0;
        if (isDelivery) {
          if (deliveryFreeAbove && subtotal >= deliveryFreeAbove) fee = 0;
          else fee = 40;
        }
        if (delivRow) delivRow.style.display = isDelivery ? "flex" : "none";
        if (delivEl) delivEl.textContent = fee > 0 ? `₹${fee}` : "FREE";
        const total = subtotal + fee;
        if (totalEl) totalEl.textContent = `₹${total.toLocaleString("en-IN")}`;
        if (totalFinal) totalFinal.textContent = `₹${total.toLocaleString("en-IN")}`;
      });
    });

    async function preloadAddress() {
      let buyerId = null;
      try { buyerId = localStorage.getItem("zepto_buyer_id"); } catch {}
      if (!buyerId) return;
      try {
        const res = await fetch(`/api/buyer/addresses?buyer_id=${buyerId}`);
        const data = await res.json();
        const addrs = data.addresses || [];
        const def = addrs.find((a) => a.is_default) || addrs[0];
        if (def) {
          selectedAddressId = def.id;
          const labelEl = document.getElementById("seller-checkout-addr-label");
          const textEl = document.getElementById("seller-checkout-addr-text");
          if (labelEl) labelEl.textContent = (def.label || "Address") + (def.is_default ? " · Default" : "");
          if (textEl) {
            const text = [def.flat, def.building, def.landmark, def.location_name].filter(Boolean).join(", ");
            textEl.textContent = text || "Saved address";
          }
        }
      } catch {}
    }

    // Listen for address picker selection
    document.addEventListener("v2-address-confirmed", async (e) => {
      selectedAddressId = e.detail?.addressId;
      // Refresh address card UI from API
      let buyerId = null;
      try { buyerId = localStorage.getItem("zepto_buyer_id"); } catch {}
      if (buyerId && selectedAddressId) {
        try {
          const res = await fetch(`/api/buyer/addresses?buyer_id=${buyerId}`);
          const data = await res.json();
          const addr = (data.addresses || []).find((a) => a.id === selectedAddressId);
          if (addr) {
            const labelEl = document.getElementById("seller-checkout-addr-label");
            const textEl = document.getElementById("seller-checkout-addr-text");
            if (labelEl) labelEl.textContent = addr.label || "Address";
            if (textEl) {
              const text = [addr.flat, addr.building, addr.landmark, addr.location_name].filter(Boolean).join(", ");
              textEl.textContent = text || "Saved address";
            }
          }
        } catch {}
      }
      window.v2Toast?.("success", "Address selected", "Continue to payment");
    });

    // Address card itself is the trigger (clickable)
    document.getElementById("seller-checkout-current-address")?.addEventListener("click", () => {
      window.v2OpenSheet?.("seller-addr-sheet");
    });

    // Place order — single seller only (the activeCheckoutSellerId)
    document.addEventListener("v2-checkout-place-order", async () => {
      const c = Cart(); if (!c) return;
      const group = c.groupBySeller().find((g) => g.seller_id === activeCheckoutSellerId);
      if (!group || group.items.length === 0) {
        window.v2Toast?.("error", "Cart empty", "Add items before checkout");
        return;
      }

      let buyerId = null, buyerPhone = null;
      try { buyerId = localStorage.getItem("zepto_buyer_id"); buyerPhone = localStorage.getItem("zepto_phone"); } catch {}
      if (!buyerId || !buyerPhone) { window.v2OpenSheet?.("seller-login-sheet"); return; }

      const methodEl = document.querySelector('input[name="seller-checkout-method"]:checked');
      const orderType = methodEl?.value === "delivery" ? "delivery" : "pickup";
      if (orderType === "delivery" && !selectedAddressId) {
        window.v2Toast?.("error", "Address needed", "Pick a delivery address");
        return;
      }

      const btn = document.getElementById("seller-checkout-place-order");
      btn.disabled = true;
      btn.textContent = "Placing order...";

      try {
        const lines = group.items.map(i => ({
          listing_id: i.listing_id,
          quantity: i.qty,
          quantity_unit: i.qty_unit,
          pricing_option_id: i.pricing_option_id || null,
        }));
        const res = await fetch("/api/orders/create-seller-cart", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            seller_id: activeCheckoutSellerId,
            lines,
            buyer_phone: buyerPhone,
            buyer_id: buyerId,
            buyer_addr: selectedAddressId,
            order_type: orderType,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Failed");

        // Success: clear cart, navigate to track.
        c.clearCart({ sellerId: activeCheckoutSellerId });
        render();
        window.v2Toast?.("success", "Order placed!", `${group.items.length} item${group.items.length !== 1 ? "s" : ""} confirmed`);
        setTimeout(() => { window.location.href = "/v2/track"; }, 1200);
      } catch (err) {
        window.v2Toast?.("error", "Failed", err.message || "Try again");
        btn.disabled = false;
        btn.textContent = "Place order";
      }
    });

    function add(id, price, name, unit, optId, optLabel) {
      const c = Cart(); if (!c) return;
      c.addItem({
        listing_id: id,
        seller_id: sellerId,
        seller_name: sellerName,
        name,
        qty_unit: unit,
        price,
        pricing_option_id: optId || "default",
        pricing_label: optLabel || unit,
      });
      render();
    }
    function dec(id) { const c = Cart(); if (!c) return; c.decQty(id); render(); }
    function inc(id) { const c = Cart(); if (!c) return; c.incQty(id); render(); }

    grid.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      if (t.classList.contains("v2-item-add")) {
        add(t.dataset.id, parseFloat(t.dataset.price), t.dataset.name, t.dataset.unit, t.dataset.optId, t.dataset.optLabel);
      } else if (t.classList.contains("v2-item-inc")) {
        inc(t.closest(".v2-item-counter")?.dataset.id);
      } else if (t.classList.contains("v2-item-dec")) {
        dec(t.closest(".v2-item-counter")?.dataset.id);
      }
    });

    // Re-render if cart changes from another tab/window or hydration completes
    window.addEventListener("v2-cart-changed", () => render());
    window.addEventListener("storage", (e) => {
      if (e.key === "v2_cart_global") render();
    });

    // First paint: render whatever we know (works even before cart module loads)
    render();

    // Once cart module loads: migrate legacy + hydrate from server, then re-render
    withCart((c) => {
      c.migrateLegacyCarts({ sellerLookup: (sid) => sid === sellerId ? sellerName : "" });
      c.hydrateFromServer().then(() => render());
      render();
    });
  }
</script>
