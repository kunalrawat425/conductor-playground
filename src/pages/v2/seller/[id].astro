---
export const prerender = false;

import AppShellV2 from "../../../components/v2/AppShellV2.astro";
import SellerHero from "../../../components/v2/organisms/SellerHero.astro";
import EmptyState from "../../../components/v2/molecules/EmptyState.astro";
import { getSellerById, getSellerListings } from "../../../lib/supabase";
import { getSpeciesDisplay } from "../../../lib/species";

const { id } = Astro.params;
const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";

let seller: any = null;
let listings: any[] = [];
let notFound = false;
try {
  seller = await getSellerById(id!);
  if (seller) {
    listings = await getSellerListings(id!);
    listings = listings.filter((l: any) => l.is_available);
  } else {
    notFound = true;
  }
} catch {
  notFound = true;
}

const sellerName = seller?.name || "Seller";
const sellerLocation = seller?.location_name || "";
const itemCount = listings.length;
const isOpen = (() => {
  if (!seller?.opens_at || !seller?.closes_at) return true;
  const now = new Date();
  const cur = now.getHours() * 60 + now.getMinutes();
  const [oh, om] = seller.opens_at.split(":").map(Number);
  const [ch, cm] = seller.closes_at.split(":").map(Number);
  return cur >= (oh * 60 + om) && cur <= (ch * 60 + cm);
})();
const status: "open" | "closed" = isOpen ? "open" : "closed";

const tags = [
  seller?.accepts_preorder ? "Pre-order" : null,
  !seller?.has_delivery ? "Pickup only" : null,
  seller?.has_delivery ? `${seller.delivery_rad || 5}km delivery` : null,
].filter(Boolean) as string[];

const pageTitle = `${sellerName} - Fresh Fish Menu | ${brandName}`;
const pageDesc = sellerLocation
  ? `Order fresh fish from ${sellerName} in ${sellerLocation}.`
  : `Order fresh fish from ${sellerName}.`;
---
<AppShellV2
  title={pageTitle}
  description={pageDesc}
  hideHeader={true}
  nav={{ active: "home" }}
>
  {notFound ? (
    <div style="padding:0 16px;margin-top:24px;">
      <EmptyState
        variant="server-error"
        title="Seller not found"
        description="This seller doesn't exist or has been deactivated."
        ctaHref="/v2"
      />
    </div>
  ) : (
    <>
      <SellerHero
        name={sellerName}
        location={sellerLocation || seller?.location || ""}
        rating={seller?.rating_avg || 0}
        status={status}
        opensAt={seller?.opens_at}
        closesAt={seller?.closes_at}
        itemCount={itemCount}
        tags={tags}
      />

      {itemCount === 0 ? (
        <div style="padding:0 16px;margin-top:16px;">
          <EmptyState
            variant="no-results"
            title="No items right now"
            description={seller?.accepts_preorder
              ? "Check back during opening hours, or pre-order tomorrow's catch."
              : "This seller has no listings available right now."}
            ctaText={seller?.accepts_preorder ? "Pre-order" : "Browse other sellers"}
            ctaHref={seller?.accepts_preorder ? "/v2" : "/v2"}
          />
        </div>
      ) : (
        <>
          <div style="padding:16px 16px 8px;">
            <h2 style="font:800 17px Inter;color:var(--v2-ink);margin:0;">Today's Menu</h2>
          </div>
          <div id="v2-menu-grid" class="v2-menu-grid"></div>
        </>
      )}
    </>
  )}

  <div id="v2-cart-bar-mount"></div>
</AppShellV2>

<style is:global>
  .v2-menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 0 16px;
  }
  @media (min-width: 600px) {
    .v2-menu-grid { grid-template-columns: repeat(3, 1fr); }
  }
  body.v2-has-cart .v2-main { padding-bottom: 80px; }
</style>

<script define:vars={{ listings, sellerId: id, sellerName, hasDelivery: seller?.has_delivery, deliveryFreeAbove: seller?.delivery_free_above, minOrder: seller?.min_order_amount, acceptsPreorder: seller?.accepts_preorder }}>
  const grid = document.getElementById("v2-menu-grid");
  const cartMount = document.getElementById("v2-cart-bar-mount");
  if (!grid || !listings) {
    // No menu to render; bail.
  } else {

  // Cart state per seller
  const CART_KEY = `v2_cart_${sellerId}`;
  function loadCart() {
    try { return JSON.parse(localStorage.getItem(CART_KEY) || "{}"); } catch { return {}; }
  }
  function saveCart(c) {
    try { localStorage.setItem(CART_KEY, JSON.stringify(c)); } catch {}
  }
  let cart = loadCart();

  function speciesEmoji(species) {
    if (!species) return "🐟";
    const s = species.toLowerCase();
    if (s.includes("prawn")) return "🦐";
    if (s.includes("crab")) return "🦀";
    if (s.includes("squid") || s.includes("octopus")) return "🦑";
    return "🐟";
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  }

  function renderItem(l) {
    const opt = (l.pricing_options || [])[0] || {};
    const price = opt.price || 0;
    const unit = opt.unit_label || "kg";
    const name = getDisplayName(l.species);
    const inCart = cart[l.id]?.qty || 0;
    const emoji = speciesEmoji(l.species);
    const isPreorder = l.is_preorder === true || (l.weight_avail === 0 && acceptsPreorder);

    return `
      <div class="v2-item-card${inCart > 0 ? ' v2-item-incart' : ''}" data-listing-id="${l.id}">
        <div class="v2-item-img" style="background:${isPreorder ? 'linear-gradient(135deg,#F3E8FF,#E9D5FF)' : 'linear-gradient(135deg,#E0F2FE,#BAE6FD)'};">
          <span class="v2-item-emoji">${emoji}</span>
          ${isPreorder ? '<span class="v2-item-cut" style="background:#F3E8FF;color:#7C3AED;">Pre-order</span>' : ''}
        </div>
        <div class="v2-item-body">
          <div class="v2-item-name">${escapeHtml(name)}</div>
          <div class="v2-item-desc">Per ${escapeHtml(unit)}</div>
          <div class="v2-item-bottom">
            <div class="v2-item-price">₹${price}</div>
            ${inCart > 0
              ? `<div class="v2-item-counter" data-id="${l.id}">
                   <button class="v2-item-dec" aria-label="Decrease">−</button>
                   <span class="v2-item-count">${inCart}</span>
                   <button class="v2-item-inc" aria-label="Increase">+</button>
                 </div>`
              : `<button class="v2-item-add" style="background:${isPreorder ? '#7C3AED' : 'var(--v2-brand)'};" data-id="${l.id}" data-price="${price}" data-name="${escapeHtml(name)}" data-unit="${escapeHtml(unit)}" aria-label="Add ${escapeHtml(name)}">+</button>`}
          </div>
        </div>
      </div>`;
  }

  function getDisplayName(species) {
    try {
      const display = getSpeciesDisplay ? getSpeciesDisplay(species) : species;
      return display || species;
    } catch { return species; }
  }

  function render() {
    grid.innerHTML = listings.map(renderItem).join("");
    renderCart();
  }

  function renderCart() {
    const items = Object.values(cart);
    const totalQty = items.reduce((s, i) => s + i.qty, 0);
    const totalPrice = items.reduce((s, i) => s + i.qty * i.price, 0);

    if (totalQty === 0) {
      cartMount.innerHTML = "";
      document.body.classList.remove("v2-has-cart");
      return;
    }

    document.body.classList.add("v2-has-cart");

    const belowMin = minOrder && totalPrice < minOrder;
    const freeHit = deliveryFreeAbove && totalPrice >= deliveryFreeAbove;
    const variant = belowMin ? "warning" : freeHit ? "success" : "default";
    const leftLine = belowMin
      ? `Add ₹${minOrder - totalPrice} more for min order`
      : freeHit
        ? "🎉 Free delivery unlocked"
        : `${totalQty} item${totalQty !== 1 ? "s" : ""}`;
    const ctaText = belowMin ? "Keep shopping" : "View cart →";
    const variantClass = variant === "warning" ? "v2-cart-warning" : variant === "success" ? "v2-cart-success" : "";
    const ctaColorStyle = variant === "warning" ? "color:var(--v2-orange);" : variant === "success" ? "color:var(--v2-green);" : "";

    cartMount.innerHTML = `
      <a href="#" class="v2-cart-bar ${variantClass}" id="v2-checkout-btn" role="button">
        <div class="v2-cb-left">
          <div class="v2-cb-items">${leftLine}</div>
          <div class="v2-cb-total">₹${totalPrice.toLocaleString("en-IN")}</div>
        </div>
        <span class="v2-cb-btn" style="${ctaColorStyle}">${ctaText}</span>
      </a>`;

    document.getElementById("v2-checkout-btn")?.addEventListener("click", (e) => {
      e.preventDefault();
      // Hand off to existing checkout flow:
      // store cart in legacy format, then navigate to /seller/[id] which handles checkout
      try {
        const lines = items.map(i => ({ listing_id: i.id, quantity: i.qty, name: i.name, price: i.price, unit: i.unit }));
        sessionStorage.setItem("relifish_cart_handoff", JSON.stringify({ seller_id: sellerId, lines }));
      } catch {}
      // Navigate to V1 seller page which has full checkout flow (slot picker, address, payment)
      window.location.href = `/seller/${sellerId}?from=v2cart`;
    });
  }

  function add(id, price, name, unit) {
    cart[id] = { id, qty: (cart[id]?.qty || 0) + 1, price, name, unit };
    saveCart(cart);
    render();
  }
  function dec(id) {
    if (!cart[id]) return;
    cart[id].qty -= 1;
    if (cart[id].qty <= 0) delete cart[id];
    saveCart(cart);
    render();
  }
  function inc(id) {
    if (!cart[id]) return;
    cart[id].qty += 1;
    saveCart(cart);
    render();
  }

  grid.addEventListener("click", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;
    if (t.classList.contains("v2-item-add")) {
      add(t.dataset.id, parseFloat(t.dataset.price), t.dataset.name, t.dataset.unit);
    } else if (t.classList.contains("v2-item-inc")) {
      inc(t.closest(".v2-item-counter")?.dataset.id);
    } else if (t.classList.contains("v2-item-dec")) {
      dec(t.closest(".v2-item-counter")?.dataset.id);
    }
  });

  render();
  } // end of if (!grid || !listings) else block
</script>
