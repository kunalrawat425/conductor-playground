<script is:inline>
  function switchType(name) {
    const types = ['daily','preorder','delivery','home'];
    const colors = { daily:'#FF4500', preorder:'#7C3AED', delivery:'#EA580C', home:'#059669' };
    types.forEach(t => {
      const panel = document.getElementById('panel-' + t);
      const btn = document.getElementById('type-' + t);
      const active = t === name;
      if (panel) panel.style.display = active ? 'flex' : 'none';
      if (btn) {
        btn.style.color = active ? colors[name] : '#94A3B8';
        btn.style.borderBottomColor = active ? colors[name] : 'transparent';
      }
    });
  }
</script>

