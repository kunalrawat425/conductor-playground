<script is:inline>
  function switchType(name) {
    const types = ['daily','preorder','delivery'];
    const colors = { daily:'#0066FF', preorder:'#4F46E5', delivery:'#059669' };
    types.forEach(t => {
      const panel = document.getElementById('panel-' + t);
      const btn = document.getElementById('tab-' + t);
      const active = t === name;
      if (panel) { panel.classList.toggle('active', active); }
      if (btn) {
        btn.style.color = active ? colors[name] : '#94A3B8';
        btn.style.borderBottomColor = active ? colors[name] : 'transparent';
      }
    });
  }
</script>

