---
export const prerender = true;
import AppShell from "../components/ui/AppShell.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.relifish.store/for-sellers",
      "url": "https://www.relifish.store/for-sellers",
      "name": "Sell Fish Online Mumbai — Free Store, Zero Commission | Relifish",
      "description": "Start selling fish online in Mumbai in under 5 minutes. Free to list, zero commission. Accept orders, pre-orders, UPI payments. Relifish is the online fish selling platform built for Mumbai fish sellers.",
      "inLanguage": "en-IN",
      "about": { "@id": "https://www.relifish.store#service" },
      "isPartOf": { "@id": "https://www.relifish.store" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.relifish.store" },
          { "@type": "ListItem", "position": 2, "name": "Sell on Relifish", "item": "https://www.relifish.store/for-sellers" }
        ]
      }
    },
    {
      "@type": "Service",
      "@id": "https://www.relifish.store#service",
      "name": "Sell Fish Online — Relifish Seller Platform",
      "description": "Relifish is a free online fish selling platform for fish sellers in Tardeo, Kandivali, Thane, and Kamothe. List your daily catch, accept pre-orders, manage home delivery, and collect UPI payments. Zero commission on every sale.",
      "provider": { "@id": "https://www.relifish.store#org" },
      "serviceType": "Online Fish Selling Platform",
      "areaServed": [
        { "@type": "City", "name": "Mumbai" },
        { "@type": "City", "name": "Thane" },
        { "@type": "City", "name": "Navi Mumbai" }
      ],
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR",
        "description": "Free to list. Zero commission on every sale.",
        "availability": "https://schema.org/InStock"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Seller Features",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Free fish listing and online store" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pre-order management for fish sellers" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "UPI payment collection" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fish home delivery management" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Push and email order alerts" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fish inventory management" } }
        ]
      }
    },
    {
      "@type": "Organization",
      "@id": "https://www.relifish.store#org",
      "name": "Relifish",
      "url": "https://www.relifish.store",
      "logo": "https://witoghpdfocywiosmrzv.supabase.co/storage/v1/object/public/meta/logo_horizontal.png",
      "description": "Online marketplace for fresh fish in Mumbai. Connects local fish sellers with buyers for same-day pickup and pre-order delivery.",
      "areaServed": [
        { "@type": "City", "name": "Mumbai" },
        { "@type": "City", "name": "Thane" },
        { "@type": "City", "name": "Navi Mumbai" }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://www.relifish.store/for-sellers#howto",
      "name": "How to start selling fish online on Relifish",
      "description": "Set up your online fish store in Mumbai on Relifish in under 5 minutes. Accept orders, pre-orders, and UPI payments. Free to list, zero commission.",
      "totalTime": "PT5M",
      "estimatedCost": { "@type": "MonetaryAmount", "currency": "INR", "value": "0" },
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "Create your free seller account", "text": "Sign up with your phone number in 30 seconds. No tech skills needed. Your online fish store is created instantly." },
        { "@type": "HowToStep", "position": 2, "name": "Add your fish inventory", "text": "Upload photos, set prices, quantity, and shop hours. Your live fish catalogue goes live instantly for buyers in your area." },
        { "@type": "HowToStep", "position": 3, "name": "Share your store link", "text": "Share relifish.store/s/your-store on WhatsApp, Instagram bio, or print a QR code on your flyer. Buyers click and order." },
        { "@type": "HowToStep", "position": 4, "name": "Accept orders and get paid", "text": "Buyers order directly from your store. You get an instant push notification and email. Confirm with one tap and collect payment via UPI or COD." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Is Relifish free for fish sellers?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Relifish is 100% free to list your fish products. We charge zero commission on every sale — you keep 100% of every rupee. No hidden fees, no monthly charges, no percentage cuts." } },
        { "@type": "Question", "name": "How do I sell fish online in Mumbai?", "acceptedAnswer": { "@type": "Answer", "text": "Sign up on Relifish, add your fish inventory with photos and prices, and share your store link on WhatsApp and Instagram. Buyers in your area find you, browse your live catalogue, and order directly. Most sellers get their first order within 24 hours." } },
        { "@type": "Question", "name": "Can I accept fish pre-orders on Relifish?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Set a pre-order window (e.g. 8pm–10pm) to take orders the night before for tomorrow's catch. Demand is locked in advance — you buy exactly what's needed at the docks, reducing wastage and eliminating cold storage costs." } },
        { "@type": "Question", "name": "Does Relifish support fish home delivery?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Set a delivery radius in km, flat delivery fee or per-km rate. Distance is auto-calculated from the buyer's address to your location. Buyers outside your serviceable radius see pickup only." } },
        { "@type": "Question", "name": "How do I get notified about new fish orders?", "acceptedAnswer": { "@type": "Answer", "text": "Every new order sends an instant push notification to your phone and an email. Confirm, reject, or mark orders ready from your dashboard — no calls, no WhatsApp back-and-forth." } },
        { "@type": "Question", "name": "What payments do fish buyers use?", "acceptedAnswer": { "@type": "Answer", "text": "Buyers pay via UPI or cash on delivery (COD). They upload UPI payment proof; you confirm and fulfill. Relifish takes zero commission on any payment." } },
        { "@type": "Question", "name": "How fast can I start selling fish online?", "acceptedAnswer": { "@type": "Answer", "text": "Your online fish store goes live in under 5 minutes. Sign up, add inventory, share your link — first orders typically arrive the same day." } },
        { "@type": "Question", "name": "Can I manage my fish store from my phone?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Relifish seller dashboard is fully mobile-first. Manage orders, inventory, delivery settings, shop hours, and notifications from your smartphone." } },
        { "@type": "Question", "name": "How does Relifish reduce fish wastage?", "acceptedAnswer": { "@type": "Answer", "text": "Pre-orders let you know tomorrow's demand tonight. You buy exactly the right quantity at the docks — no excess, no cold storage costs, no panic selling. Sellers report significantly less wastage after enabling pre-orders." } },
        { "@type": "Question", "name": "Which areas of Mumbai does Relifish serve?", "acceptedAnswer": { "@type": "Answer", "text": "Relifish is available across Tardeo, Kandivali, Thane, and Kamothe. You set your own delivery radius — buyers within your chosen area see your store and can order directly from you." } }
      ]
    }
  ]
};
---
<AppShell
  title="Sell Fish Online Mumbai — Free Store, Zero Commission | Relifish"
  description="Start selling fish online in Mumbai in 5 minutes. Free to list, zero commission. Accept orders, pre-orders, UPI payments in your serviceable area. Mumbai fish sellers keep 100% of every sale."
  hideNav={true}
  hideHeader={true}
  jsonLd={jsonLd}
  canonical="https://www.relifish.store/for-sellers"
>

<style>
  /* ─── Reset ──────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0 !important; padding: 0 !important; max-width: none !important; }
  :global(.v2-app) { max-width: none !important; }
  :global(.v2-main) { padding-bottom: 0 !important; }
  @keyframes scroll-cue {
    0%,100%{opacity:.3;transform:scaleY(1);}
    50%{opacity:.7;transform:scaleY(1.15);}
  }

  /* ─── Layout containers ──────────────── */
  .fs-wrap { width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .fs-section { padding: 64px 0; }
  .fs-section-light { background: #fff; }
  .fs-section-tinted { background: #F8FAFC; border-top: 1px solid #E2E8F0; }
  .fs-section-dark { background: #0F172A; }
  .fs-section-ink { background: #080c16; }

  /* ─── Hero ───────────────────────────── */
  .fs-hero { position: relative; min-height: 100svh; background: #080c16; display: flex; align-items: center; overflow: hidden; }
  .fs-hero-bg { position: absolute; inset: 0; background-image: url('https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1200&q=70&fit=crop'); background-size: cover; background-position: center; opacity: 0.15; }
  .fs-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,12,22,0.5) 0%, rgba(8,12,22,0.9) 70%, #080c16 100%); }
  .fs-hero-glow { position: absolute; top: -80px; right: -60px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(0,102,255,0.18) 0%, transparent 65%); pointer-events: none; }
  .fs-hero-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; padding: 100px 24px 60px; width: 100%; max-width: 1280px; margin: 0 auto; }
  .fs-hero-copy h1 { font: 900 52px/1.0 Inter, sans-serif; color: #fff; margin: 0 0 20px; letter-spacing: -2px; }
  .fs-hero-copy h1 span { color: #0066FF; }
  .fs-hero-copy p { font: 400 17px/1.6 Inter, sans-serif; color: rgba(255,255,255,0.55); margin: 0 0 32px; max-width: 440px; }
  .fs-cta-form { display: flex; background: rgba(255,255,255,0.95); border-radius: 10px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.4); max-width: 400px; margin-top: 8px; }
  .fs-cta-form input { flex: 1; padding: 14px 16px; border: none; outline: none; font: 500 14px Inter, sans-serif; color: #0F172A; background: transparent; min-width: 0; }
  .fs-cta-form a { background: #0066FF; color: #fff; font: 700 14px Inter, sans-serif; padding: 14px 20px; text-decoration: none; white-space: nowrap; display: flex; align-items: center; }
  .fs-cta-note { font: 400 11px Inter, sans-serif; color: rgba(255,255,255,0.3); margin: 16px 0 0; }
  .fs-cta-sub { margin-top: 14px; font: 500 13px Inter, sans-serif; color: rgba(255,255,255,0.4); }
  .fs-cta-sub a { color: rgba(255,255,255,0.65); text-decoration: underline; text-underline-offset: 3px; }

  /* ─── Phone mockup (matches landing page .demo-phone style) ─── */
  .fs-phone {
    width: 270px;
    min-height: 520px;
    background: linear-gradient(175deg, #1E2D4A, #0D1629);
    border-radius: 44px;
    border: 2px solid rgba(255,255,255,0.15);
    box-shadow: 0 48px 96px rgba(0,0,0,0.65), 0 0 0 1px rgba(255,255,255,0.05), inset 0 1px 0 rgba(255,255,255,0.08);
    overflow: hidden;
    flex-shrink: 0;
  }
  .fs-phone-notch { height: 28px; background: #000; display: flex; align-items: center; justify-content: center; }
  .fs-phone-pill { width: 72px; height: 9px; background: #111; border-radius: 100px; }
  .fs-phone-screen { padding: 12px; background: #050D1A; }
  .fs-phone-sbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; font: 600 9px Inter, sans-serif; color: rgba(255,255,255,0.4); }
  .fs-phone-header { background: rgba(0,102,255,0.18); border: 1px solid rgba(0,102,255,0.25); border-radius: 12px; padding: 11px 13px; margin-bottom: 10px; }
  .fs-phone-header-label { font: 700 9px Inter, sans-serif; color: #60a5fa; margin-bottom: 3px; letter-spacing: 0.5px; text-transform: uppercase; }
  .fs-phone-header-val { font: 900 22px Inter, sans-serif; color: #fff; line-height: 1; }
  .fs-phone-header-val span { font: 400 10px Inter, sans-serif; color: rgba(255,255,255,0.45); }
  .fs-order-card { background: rgba(255,255,255,0.06); border-radius: 9px; padding: 8px 10px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; border: 1px solid rgba(255,255,255,0.04); }
  .fs-order-name { font: 600 10px Inter, sans-serif; color: #fff; }
  .fs-order-sub { font: 400 9px Inter, sans-serif; color: #64748B; margin-top: 1px; }
  .fs-badge { font: 700 9px Inter, sans-serif; padding: 3px 8px; border-radius: 999px; white-space: nowrap; }
  .fs-badge-green { background: #059669; color: #fff; }
  .fs-badge-blue { background: rgba(0,102,255,0.25); color: #60a5fa; }
  .fs-badge-indigo { background: rgba(79,70,229,0.25); color: #818cf8; }
  .fs-badge-orange { background: rgba(234,88,12,0.25); color: #fb923c; }
  .fs-phone-nav { margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.07); display: flex; justify-content: space-around; font: 400 9px Inter, sans-serif; color: #64748B; }
  .fs-phone-nav span.active { color: #0066FF; font-weight: 700; }
  .fs-phone-bar { width: 50px; height: 4px; background: rgba(255,255,255,0.15); border-radius: 999px; margin: 10px auto 0; }

  /* ─── Trust bar ──────────────────────── */
  .fs-trust { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .fs-trust-item { text-align: center; }
  .fs-trust-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; font-size: 22px; }
  .fs-trust-title { font: 700 14px Inter, sans-serif; color: #0F172A; margin-bottom: 4px; }
  .fs-trust-desc { font: 400 12px Inter, sans-serif; color: #64748B; }

  /* ─── Section headers ────────────────── */
  .fs-eyebrow { font: 700 11px Inter, sans-serif; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 12px; }
  .fs-h2 { font: 800 32px/1.2 Inter, sans-serif; letter-spacing: -0.5px; margin: 0 0 12px; }
  .fs-lead { font: 400 15px/1.6 Inter, sans-serif; color: #64748B; margin: 0 0 28px; }

  /* ─── Tabs ───────────────────────────── */
  .fs-tabs { display: flex; gap: 0; overflow-x: auto; scrollbar-width: none; border-bottom: 2px solid #F1F5F9; }
  .fs-tabs::-webkit-scrollbar { display: none; }
  .fs-tab { font: 700 13px Inter, sans-serif; padding: 12px 22px; border: none; background: transparent; cursor: pointer; white-space: nowrap; border-bottom: 2px solid transparent; margin-bottom: -2px; transition: color 0.15s, border-color 0.15s; }

  /* ─── Feature panels ─────────────────── */
  .fs-panel { display: none; flex-direction: column; gap: 28px; padding: 36px 0; }
  .fs-panel.active { display: flex; }
  .fs-panel-copy ul { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 10px; }
  .fs-panel-copy li { display: flex; align-items: center; gap: 10px; font: 500 14px Inter, sans-serif; color: #334155; }
  .fs-ui-card { border-radius: 16px; padding: 22px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }

  /* ─── Analytics cards ────────────────── */
  .fs-insight { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; padding: 14px 16px; display: flex; align-items: center; gap: 14px; }
  .fs-insight-icon { width: 44px; height: 44px; border-radius: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font: 700 15px Inter, sans-serif; }
  .fs-insight-title { font: 700 14px Inter, sans-serif; color: #0F172A; margin-bottom: 3px; }
  .fs-insight-sub { font: 400 12px Inter, sans-serif; color: #64748B; }

  /* ─── Testimonials ───────────────────── */
  .fs-testimonials { display: flex; flex-direction: column; gap: 16px; }
  .fs-tcard { background: #fff; border: 1px solid #E2E8F0; border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
  .fs-tcard-tag { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 4px 10px; margin-bottom: 14px; }
  .fs-tcard-tag-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
  .fs-tcard-tag span { font: 600 11px Inter, sans-serif; }
  .fs-tcard p { font: 500 14px/1.6 Inter, sans-serif; color: #334155; margin: 0 0 16px; }
  .fs-tcard-author { display: flex; align-items: center; gap: 10px; }
  .fs-tcard-avatar { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font: 700 14px Inter, sans-serif; }
  .fs-tcard-name { font: 700 12px Inter, sans-serif; color: #0F172A; }
  .fs-tcard-role { font: 400 11px Inter, sans-serif; color: #94A3B8; }

  /* ─── Steps ──────────────────────────── */
  .fs-steps { display: flex; flex-direction: column; gap: 0; }
  .fs-step { display: flex; gap: 16px; align-items: flex-start; position: relative; padding-bottom: 28px; }
  .fs-step:last-child { padding-bottom: 0; }
  .fs-step-num { width: 36px; height: 36px; border-radius: 50%; color: #fff; font: 800 14px Inter, sans-serif; display: flex; align-items: center; justify-content: center; flex-shrink: 0; position: relative; z-index: 1; }
  .fs-step-line { position: absolute; left: 17px; top: 36px; bottom: 0; width: 2px; background: #F1F5F9; z-index: 0; }
  .fs-step-title { font: 700 15px Inter, sans-serif; color: #0F172A; margin-bottom: 4px; }
  .fs-step-desc { font: 400 13px Inter, sans-serif; color: #64748B; }

  /* ─── Segment pills ──────────────────── */
  .fs-pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .fs-pill { display: inline-flex; align-items: center; font: 600 13px Inter, sans-serif; color: rgba(255,255,255,0.8); text-decoration: none; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 999px; padding: 10px 18px; transition: background 0.15s; }
  .fs-pill:hover { background: rgba(255,255,255,0.12); }

  /* ─── Problem/Solution callouts ─────── */
  .fs-problem-box { background: #FEF2F2; border: 1px solid #FECACA; border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; }
  .fs-problem-title { font: 700 12px Inter, sans-serif; color: #DC2626; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 8px; }
  .fs-problem-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .fs-problem-list li { font: 400 13px Inter, sans-serif; color: #7F1D1D; display: flex; gap: 8px; }
  .fs-solution-box { background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 12px; padding: 18px 20px; }
  .fs-solution-title { font: 700 12px Inter, sans-serif; color: #059669; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 8px; }
  .fs-solution-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .fs-solution-list li { font: 400 13px Inter, sans-serif; color: #064E3B; display: flex; gap: 8px; }

  /* ─── Navigation ─────────────────────── */
  .fs-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: rgba(8, 12, 22, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    transition: height 0.15s ease;
  }
  .fs-nav-logo {
    height: 38px;
    object-fit: contain;
    transition: height 0.15s ease;
  }

  /* ─── Desktop breakpoint ─────────────── */
  @media (min-width: 768px) {
    .fs-nav {
      height: 64px;
    }
    .fs-nav-logo {
      height: 50px;
    }
    .fs-hero-inner { grid-template-columns: 1fr 300px; padding: 120px 48px 80px; }
    .fs-hero-copy h1 { font-size: 72px; }
    .fs-trust { grid-template-columns: repeat(4, 1fr); }
    .fs-panel { flex-direction: row; }
    .fs-panel-copy { flex: 1; }
    .fs-ui-card { flex: 1; }
    .fs-testimonials { display: grid; grid-template-columns: 1fr 1fr; }
    .fs-wrap { padding: 0 48px; }
    .fs-h2 { font-size: 40px; }
    .fs-section { padding: 80px 0; }
    .fs-steps { max-width: 560px; }
    .fs-hero-phone-wrap { display: flex; justify-content: center; align-items: flex-end; }
    .fs-store-grid { grid-template-columns: repeat(4, 1fr); }
    .fs-hyperlocal-grid { grid-template-columns: 1fr 260px; }
    .fs-analytics-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 1100px) {
    .fs-hero-copy h1 { font-size: 80px; }
    .fs-hero-inner { grid-template-columns: 1fr 320px; }
    .fs-testimonials { grid-template-columns: repeat(3, 1fr); }
    .fs-store-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>

<!-- ─── NAV ───────────────────────────────────────────────────────── -->
<nav class="fs-nav">
  <a href="/" style="display:flex;align-items:center;gap:8px;text-decoration:none;">
    <img src="https://witoghpdfocywiosmrzv.supabase.co/storage/v1/object/public/meta/logo_horizontal.png" alt="Relifish" class="fs-nav-logo" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
    <span style="display:none;font:900 20px Inter;color:#fff;letter-spacing:-0.5px;">Relifish</span>
  </a>
  <div style="display:flex;gap:8px;align-items:center;">
    <a href="/shop" style="font:500 13px Inter;color:rgba(255,255,255,0.5);text-decoration:none;padding:8px 12px;display:none;" class="fs-desktop-link">Browse sellers</a>
    <a href="/dashboard/login" style="font:700 13px Inter;color:#fff;text-decoration:none;padding:8px 16px;border-radius:8px;background:#0066FF;">Get started free</a>
  </div>
</nav>

<!-- ─── HERO ───────────────────────────────────────────────────────── -->
<section class="fs-hero">
  <div class="fs-hero-bg"></div>
  <div class="fs-hero-overlay"></div>
  <div class="fs-hero-glow"></div>

  <div class="fs-hero-inner">
    <div class="fs-hero-copy">
      <h1>Built For<br/><span>Fish Sellers</span></h1>
      <p>Start accepting orders in your serviceable area — one link, one click, instant confirmation. Built for daily catch volume, slim margins, and fresh fish at scale. No middleman. No commission.</p>
      <form onsubmit="return false;">
        <div class="fs-cta-form">
          <input type="tel" placeholder="Your phone number" />
          <a href="/dashboard/login">Get Started</a>
        </div>
      </form>
