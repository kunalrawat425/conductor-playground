---
export const prerender = true;
import AppShell from "../components/ui/AppShell.astro";
const SITE = "https://www.relifish.com";
---
<AppShell
  title="About Relifish — Fish from Local Sellers in Thane &amp; Mumbai"
  description="Relifish is a hyperlocal marketplace where you buy fish online from local sellers in Thane, South Mumbai and Kamothe. Order same-day or pre-order for tomorrow; sellers deliver or keep it ready for pickup."
  canonical={`${SITE}/about`}
  nav={{ active: "home" }}
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${SITE}/#org`,
        "name": "Relifish",
        "url": SITE,
        "logo": { "@type": "ImageObject", "url": `${SITE}/icon-192.svg` },
        "foundingDate": "2025",
        "description": "Hyperlocal fish marketplace: buy fish online from local sellers in Thane, South Mumbai and Navi Mumbai. Order same-day or pre-order for tomorrow; sellers deliver or keep it ready for pickup.",
        "areaServed": [
          { "@type": "City", "name": "Thane" },
          { "@type": "City", "name": "Mumbai" },
          { "@type": "City", "name": "Navi Mumbai" }
        ],
        "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "email": "relifishstore@gmail.com", "telephone": "+91-9152207607" },
        "sameAs": ["https://www.instagram.com/relifish.store/", "https://wa.me/919152207607"]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE}/` },
          { "@type": "ListItem", "position": 2, "name": "About", "item": `${SITE}/about` }
        ]
      }
    ]
  }}
>
  <article style="max-width:680px;margin:0 auto;padding:32px 16px 64px;font-family:var(--v2-font,Inter);color:var(--v2-ink);">

    <h1 style="font:800 28px/1.2 var(--v2-font,Inter);margin-bottom:8px;">About Relifish</h1>
    <p style="font:400 15px/1.6 var(--v2-font,Inter);color:var(--v2-ink-2);margin-bottom:32px;"><strong>Relifish is a hyperlocal marketplace where you buy fish online directly from local fish sellers.</strong> Sellers list the fish they have each day. You order same-day, or pre-order tonight for tomorrow, and the seller delivers to you or keeps it ready for pickup.</p>

    <section style="margin-bottom:32px;">
      <h2 style="font:700 18px/1.3 var(--v2-font,Inter);margin-bottom:12px;">How ordering works</h2>
      <ol style="margin:0 0 0 20px;font:400 15px/1.8 var(--v2-font,Inter);color:var(--v2-ink-2);">
        <li>Set your location to see sellers who serve your area.</li>
        <li>Log in with your mobile number (OTP) to see each seller's live prices.</li>
        <li>Order same-day during the seller's opening hours, or pre-order before the seller's cutoff (shown on their page) for tomorrow.</li>
        <li>Pay online with Razorpay. Pre-order prices are a range: you pay the top, and the difference is refunded once the seller sets the final price.</li>
        <li>Choose how you want the fish prepared (whole, cleaned or cut). The seller confirms, then delivers or keeps it ready for pickup.</li>
      </ol>
      <p style="font:400 15px/1.7 var(--v2-font,Inter);color:var(--v2-ink-2);">If the seller declines, or you cancel before they confirm, the full amount is refunded to your original payment method, usually within 5 to 7 working days.</p>
    </section>

    <section style="margin-bottom:32px;">
      <h2 style="font:700 18px/1.3 var(--v2-font,Inter);margin-bottom:12px;">Where Relifish works today</h2>
      <p style="font:400 15px/1.7 var(--v2-font,Inter);color:var(--v2-ink-2);">Sellers on Relifish currently serve parts of Thane, South Mumbai (Tardeo) and Kamothe in Navi Mumbai. Each seller sets their own delivery radius and fee. See <a href="/area/thane" style="color:var(--v2-brand,#2563eb);">Thane</a>, <a href="/area/tardeo" style="color:var(--v2-brand,#2563eb);">Tardeo</a> and <a href="/area/kamothe" style="color:var(--v2-brand,#2563eb);">Kamothe</a>, or <a href="/shop" style="color:var(--v2-brand,#2563eb);">set your location</a>.</p>
    </section>

    <section style="margin-bottom:32px;">
      <h2 style="font:700 18px/1.3 var(--v2-font,Inter);margin-bottom:12px;">For fish sellers</h2>
      <p style="font:400 15px/1.7 var(--v2-font,Inter);color:var(--v2-ink-2);">Sellers join free and pay 0% commission on orders. List your fish, set your own prices and delivery terms, and manage orders from your phone.</p>
      <a href="/for-sellers" style="display:inline-block;margin-top:12px;padding:10px 20px;background:var(--v2-brand,#2563eb);color:#fff;border-radius:8px;font:600 14px var(--v2-font,Inter);text-decoration:none;">Sell on Relifish →</a>
    </section>

    <section style="margin-bottom:32px;">
      <h2 style="font:700 18px/1.3 var(--v2-font,Inter);margin-bottom:12px;">Contact</h2>
      <p style="font:400 15px/1.7 var(--v2-font,Inter);color:var(--v2-ink-2);">
        WhatsApp: <a href="https://wa.me/919152207607" style="color:var(--v2-brand,#2563eb);">9152207607</a><br />
        Email: <a href="mailto:relifishstore@gmail.com" style="color:var(--v2-brand,#2563eb);">relifishstore@gmail.com</a><br />
        Hours: 7:30 AM to 9 PM
      </p>
    </section>

  </article>
</AppShell>
