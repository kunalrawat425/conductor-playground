---
export const prerender = false;
import AppShell from "../../components/ui/AppShell.astro";
import EmptyState from "../../components/ui/molecules/EmptyState.astro";
---
<AppShell
  title="Account pending · Seller Dashboard"
  hideNav={true}
  hideHeader={true}
>
  <div style="padding:48px 16px;">
    <EmptyState
      variant="server-error"
      title="Account awaiting activation"
      description="Your seller account is being reviewed. We'll notify you within 24 hours when activated."
      ctaText="Refresh status"
      ghostCtaText="Sign out"
    />
  </div>
  <script>
    import { supabase } from "../../lib/supabase";

    // If seller is already active, redirect to dashboard (don't trap them here)
    async function checkActive() {
      const sid = localStorage.getItem("zepto_seller_id");
      if (!sid) {
        location.href = "/dashboard/login";
        return;
      }
      try {
        const { data } = await supabase.from("sellers").select("is_active").eq("id", sid).single();
        if (data?.is_active) {
          location.href = "/dashboard/orders";
          return;
        }
      } catch {}
    }
    checkActive();

    // Wire Refresh + Sign out (EmptyState renders ghost as <a>, CTA as <button>)
    document.querySelectorAll("button, a").forEach(el => {
      const text = el.textContent || "";
      if (text.includes("Refresh")) {
        el.addEventListener("click", (e) => { e.preventDefault(); location.reload(); });
      }
      if (text.includes("Sign out")) {
        el.addEventListener("click", (e) => {
          e.preventDefault();
          try { localStorage.removeItem("zepto_seller_id"); localStorage.removeItem("zepto_seller_phone"); } catch {}
          location.href = "/dashboard/login";
        });
      }
    });
  </script>
</AppShell>
