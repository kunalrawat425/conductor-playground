---
export const prerender = false;
import AppShell from "../../components/ui/AppShell.astro";
import Toast from "../../components/ui/atoms/Toast.astro";
import Input from "../../components/ui/atoms/Input.astro";
import Textarea from "../../components/ui/atoms/Textarea.astro";
import { whatsappLink } from "../../lib/brand";

const helpLink = whatsappLink("Hi Relifish, I'm a seller and need help activating my account");
const fulfilCard = "display:flex;align-items:center;gap:10px;padding:14px;background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:var(--v2-radius-sm);cursor:pointer;margin-bottom:12px;";
---
<AppShell
  title="Account pending · Seller Dashboard"
  hideNav={true}
  hideHeader={true}
>
  <Toast />

  <div id="ap-loading" style="text-align:center;padding:48px 16px;color:var(--v2-ink-3);font:500 12px Inter;">
    <span class="v2-spinner v2-spinner-md"></span>
  </div>

  <!-- New sellers apply here; the founder approves (is_active) after a call. -->
  <form id="ap-form" style="display:none;padding:24px 16px;" novalidate>
    <h1 style="font:800 20px Inter;color:var(--v2-ink);margin:0 0 4px;">Tell us about your shop</h1>
    <p style="font:400 13px Inter;color:var(--v2-ink-3);margin:0 0 20px;">We check every seller before buyers can see them. This takes 2 minutes.</p>

    <Input id="ap-name" name="name" label="Shop name" required={true} maxlength={60} placeholder="e.g. Sai Fish Centre" />
    <div style="display:flex;gap:12px;">
      <div style="flex:1;"><Input id="ap-first-name" name="first_name" label="Owner first name" required={true} maxlength={40} autocomplete="given-name" /></div>
      <div style="flex:1;"><Input id="ap-last-name" name="last_name" label="Last name" maxlength={40} autocomplete="family-name" /></div>
    </div>

    <Input id="ap-area" name="location_name" label="Shop area / address" required={true} maxlength={120} placeholder="e.g. Naupada, Thane West" />
    <div style="background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:var(--v2-radius-sm);padding:14px;margin-bottom:16px;">
      <div id="ap-loc-status" style="font:600 13px Inter;color:var(--v2-ink-3);margin-bottom:10px;">Location not set (optional)</div>
      <button type="button" id="ap-use-location" class="v2-btn v2-btn-secondary v2-btn-sm v2-btn-full">📍 Use my current location</button>
      <div style="font:400 11px Inter;color:var(--v2-ink-3);margin-top:8px;">Tap this at your shop so buyers can see how far you are</div>
    </div>

    <h3 style="font:700 14px Inter;color:var(--v2-ink);margin:24px 0 12px;">How do buyers get their fish?</h3>
    <label style={fulfilCard}>
      <input type="checkbox" id="ap-pickup" />
      <div>
        <div style="font:700 13px Inter;color:var(--v2-ink);">Pickup from my shop 🏪</div>
        <div style="font:400 11px Inter;color:var(--v2-ink-3);">Buyers collect orders at your shop</div>
      </div>
    </label>
    <label style={fulfilCard}>
      <input type="checkbox" id="ap-delivery" />
      <div>
        <div style="font:700 13px Inter;color:var(--v2-ink);">I deliver 🚲</div>
        <div style="font:400 11px Inter;color:var(--v2-ink-3);">Deliver to buyers within your radius</div>
      </div>
    </label>
    <div id="ap-delivery-settings" style="display:none;margin-left:16px;padding-left:12px;border-left:2px solid var(--v2-border);">
      <Input id="ap-delivery-rad" name="delivery_rad" label="Delivery radius (km)" type="number" inputmode="numeric" />
      <div class="v2-field-label" style="margin-bottom:8px;">Delivery charges<span class="v2-field-req">*</span></div>
      <!-- Saved as delivery_fee_* exactly like the profile page's fee settings. -->
      <div style="display:flex;gap:8px;margin-bottom:12px;">
        {[["free", "Free", "No charge"], ["fixed", "Flat fee", "Per order"], ["per_km", "Per km", "By distance"]].map(([value, title, sub]) => (
          <label style="flex:1;display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);cursor:pointer;">
            <input type="radio" name="ap-fee-type" value={value} style="accent-color:var(--v2-brand);margin:0;" />
            <div>
              <div style="font:700 12px Inter;color:var(--v2-ink);">{title}</div>
              <div style="font:400 10px Inter;color:var(--v2-ink-3);">{sub}</div>
            </div>
          </label>
        ))}
      </div>
      <div id="ap-fee-fixed" style="display:none;">
        <Input id="ap-fee-amount" name="delivery_fee_amount" label="Delivery fee per order (₹)" type="number" inputmode="decimal" />
      </div>
      <div id="ap-fee-perkm" style="display:none;">
        <Input id="ap-fee-perkm-rate" name="delivery_fee_per_km" label="Rate per km (₹/km)" type="number" inputmode="decimal" />
      </div>
      <div id="ap-free-above-wrap" style="display:none;">
        <Input id="ap-free-above" name="free_delivery_above" label="Free delivery above ₹ (optional)" type="number" inputmode="decimal" placeholder="e.g. 500" />
      </div>
    </div>

    <h3 style="font:700 14px Inter;color:var(--v2-ink);margin:24px 0 12px;">About your fish</h3>
    <Textarea id="ap-fish" name="fish_sold" label="What fish do you sell?" required={true} rows={2} maxlength={300} placeholder="e.g. pomfret, surmai, prawns" />
    <Textarea id="ap-areas" name="areas_served" label="Which areas / localities do you serve?" required={true} rows={2} maxlength={300} placeholder="e.g. Majiwada, Manpada, Ghodbunder Road" />
    <Input id="ap-fssai" name="fssai" label="FSSAI licence number" required={true} inputmode="numeric" maxlength={14} placeholder="14 digits" />
    <Input id="ap-email" name="email" label="Email" required={true} type="email" autocomplete="email" />
    <div id="ap-email-err" style="display:none;font:600 12px Inter;color:var(--v2-red);margin:-8px 0 12px;"></div>

    <h3 style="font:700 14px Inter;color:var(--v2-ink);margin:24px 0 12px;">Your phone</h3>
    <div style="background:var(--v2-bg-2);padding:14px;border-radius:var(--v2-radius-sm);font:600 14px Inter;color:var(--v2-ink);margin-bottom:12px;">
      <span id="ap-phone">—</span>
      <span style="font:400 11px Inter;color:var(--v2-ink-3);margin-left:8px;">(from your login)</span>
    </div>

    <button type="submit" id="ap-submit" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full" style="margin-top:16px;">Send for approval</button>
    <div style="text-align:center;margin-top:16px;">
      <a href={helpLink} target="_blank" rel="noopener" class="v2-empty-ghost">💬 Ask us on WhatsApp →</a>
      <a href="#" class="v2-empty-ghost" data-sign-out>Sign out →</a>
    </div>
  </form>

  <div id="ap-done" style="display:none;padding:48px 16px;">
    <div class="v2-empty">
      <div class="v2-empty-icon" aria-hidden="true">✅</div>
      <h3 class="v2-empty-title">Thanks! We've received your shop details.</h3>
      <p class="v2-empty-desc">Our team will review them and get back to you on WhatsApp or a call once your shop is approved (usually within 24 hours). Meanwhile you can add your fish listings.</p>
      <a href="/dashboard/listings" class="v2-btn v2-btn-primary v2-btn-md">Add your fish listings</a>
      <a href="#" id="ap-edit" class="v2-empty-ghost">Edit details →</a>
      <a href={helpLink} target="_blank" rel="noopener" class="v2-empty-ghost">💬 Ask us on WhatsApp →</a>
      <a href="#" class="v2-empty-ghost" data-sign-out>Sign out →</a>
    </div>
  </div>

  <script>
    import { loadOwnSeller, signOut } from "../../lib/seller-auth";
    import { validateSellerName } from "../../lib/seller-display";
    import { cleanSellerApplication, deliveryFeeUpdates, hasSellerApplied, isPlaceholderSellerName } from "../../lib/seller-application";
    import { GEO_OPTIONS, geolocateErrorMessage } from "../../lib/geolocate-error";

    const toast = (kind: string, title: string, body?: string) => (window as any).v2Toast?.(kind, title, body);
    const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
    const sellerId = localStorage.getItem("rlf_seller_id");
    let coords: { lat: number; lng: number } | null = null;

    function show(view: "form" | "done") {
      $("ap-loading").style.display = "none";
      $("ap-form").style.display = view === "form" ? "block" : "none";
      $("ap-done").style.display = view === "done" ? "block" : "none";
      window.scrollTo(0, 0);
    }

    function showCoords() {
      if (!coords) return;
      const el = $("ap-loc-status");
      el.textContent = `✅ Location set · ${coords.lat.toFixed(5)}, ${coords.lng.toFixed(5)}`;
      el.style.color = "var(--v2-green, #16a34a)";
    }

    async function load() {
      if (!sellerId) { location.href = "/dashboard/login"; return; }
      const seller = await loadOwnSeller(sellerId).catch(() => null);
      // Active sellers don't belong here (don't trap them).
      if (seller?.is_active) { location.href = "/dashboard/orders"; return; }
      $("ap-name").value = isPlaceholderSellerName(seller?.name) ? "" : seller?.name || "";
      $("ap-first-name").value = seller?.first_name || "";
      $("ap-last-name").value = seller?.last_name || "";
      $("ap-area").value = seller?.location_name || "";
      $("ap-email").value = seller?.email || "";
      $("ap-pickup").checked = seller ? seller.has_pickup !== false : true;
      $("ap-delivery").checked = !!seller?.has_delivery;
      $("ap-delivery-rad").value = String(seller?.delivery_rad || 5);
      $("ap-delivery-settings").style.display = seller?.has_delivery ? "block" : "none";
      // Charges only pre-picked when they already deliver (a new row's fee-off default isn't a choice they made).
      if (seller?.has_delivery) {
        const choice = !seller.delivery_fee_enabled ? "free" : seller.delivery_fee_type === "per_km" ? "per_km" : "fixed";
        document.querySelector<HTMLInputElement>(`input[name="ap-fee-type"][value="${choice}"]`)!.checked = true;
        $("ap-fee-amount").value = seller.delivery_fee_amount ? String(seller.delivery_fee_amount) : "";
        $("ap-fee-perkm-rate").value = seller.delivery_fee_per_km ? String(seller.delivery_fee_per_km) : "";
        $("ap-free-above").value = seller.free_delivery_above ? String(seller.free_delivery_above) : "";
        showFeeFields();
      }
      $("ap-phone").textContent = seller?.phone || localStorage.getItem("rlf_seller_phone") || "—";
      if (seller?.lat != null && seller?.lng != null) { coords = { lat: Number(seller.lat), lng: Number(seller.lng) }; showCoords(); }
      show(hasSellerApplied(seller) ? "done" : "form");
    }
    load();

    const feeChoice = () => document.querySelector<HTMLInputElement>('input[name="ap-fee-type"]:checked')?.value;
    function showFeeFields() {
      const c = feeChoice();
      $("ap-fee-fixed").style.display = c === "fixed" ? "block" : "none";
      $("ap-fee-perkm").style.display = c === "per_km" ? "block" : "none";
      $("ap-free-above-wrap").style.display = c === "fixed" || c === "per_km" ? "block" : "none";
    }
    document.querySelectorAll('input[name="ap-fee-type"]').forEach((r) => r.addEventListener("change", showFeeFields));

    function emailError(msg: string | null) {
      const el = $("ap-email-err");
      el.textContent = msg || "";
      el.style.display = msg ? "block" : "none";
      if (msg) $("ap-email").scrollIntoView({ behavior: "smooth", block: "center" });
    }
    $("ap-email").addEventListener("input", () => emailError(null));

    $("ap-delivery").addEventListener("change", (e) => {
      $("ap-delivery-settings").style.display = (e.target as HTMLInputElement).checked ? "block" : "none";
    });

    $("ap-use-location").addEventListener("click", () => {
      const btn = $<HTMLButtonElement>("ap-use-location");
      if (!navigator.geolocation) { toast("error", "Not supported", "Type your area instead"); return; }
      btn.disabled = true;
      btn.textContent = "Getting location...";
      const done = () => { btn.disabled = false; btn.textContent = "📍 Use my current location"; };
      navigator.geolocation.getCurrentPosition(
        (pos) => { coords = { lat: pos.coords.latitude, lng: pos.coords.longitude }; showCoords(); done(); },
        (err) => { const m = geolocateErrorMessage(err.code, navigator.userAgent); toast("error", m.title, m.body); done(); },
        GEO_OPTIONS,
      );
    });

    $("ap-edit").addEventListener("click", (e) => { e.preventDefault(); show("form"); });
    document.querySelectorAll("[data-sign-out]").forEach((el) => el.addEventListener("click", (e) => {
      e.preventDefault();
      signOut();
      location.href = "/dashboard/login";
    }));

    $<HTMLFormElement>("ap-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = $<HTMLButtonElement>("ap-submit");
      const updates: Record<string, unknown> = {
        name: $("ap-name").value.trim(),
        first_name: $("ap-first-name").value.trim(),
        last_name: $("ap-last-name").value.trim(),
        location_name: $("ap-area").value.trim(),
        has_pickup: $("ap-pickup").checked,
        has_delivery: $("ap-delivery").checked,
        delivery_rad: parseInt($("ap-delivery-rad").value) || 5,
        email: $("ap-email").value.trim(),
        ...(coords || {}),
      };
      const fees = updates.has_delivery
        ? deliveryFeeUpdates(feeChoice(), $("ap-fee-amount").value, $("ap-fee-perkm-rate").value, $("ap-free-above").value)
        : {};
      const app = cleanSellerApplication({ fish_sold: $("ap-fish").value, areas_served: $("ap-areas").value, fssai: $("ap-fssai").value });

      const badEmail = !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(updates.email)) ? "Enter a valid email address." : null;
      emailError(badEmail);
      const problem =
        validateSellerName(updates.name) ||
        (!updates.first_name ? "Enter the owner's first name." : null) ||
        (!updates.location_name ? "Enter your shop area or address." : null) ||
        (!updates.has_pickup && !updates.has_delivery ? "Choose pickup, delivery or both." : null) ||
        ("error" in fees ? fees.error : null) ||
        ("error" in app ? app.error : null) ||
        badEmail;
      if (problem) { toast("error", "Check your details", problem); return; }

      btn.disabled = true;
      btn.textContent = "Sending...";
      try {
        const post = async (url: string, body: object) => {
          const res = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
          const data = await res.json().catch(() => ({}));
          // Email taken (by a buyer or another seller): the profile API answers 409, shown under the field.
          if (res.status === 409 && /email/i.test(data.error || "")) { emailError(data.error); throw new Error(data.error); }
          if (!res.ok) throw new Error(data.error || "Something went wrong. Please try again.");
        };
        await post("/api/seller/profile", { seller_id: sellerId, updates: { ...updates, ...fees } });
        await post("/api/seller/apply", { seller_id: sellerId, ...app });
        show("done");
      } catch (err: any) {
        toast("error", "Couldn't send", err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = "Send for approval";
      }
    });
  </script>
</AppShell>
