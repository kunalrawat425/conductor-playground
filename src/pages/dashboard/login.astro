---
import { LOGO_URL } from "../../lib/brand";
export const prerender = false;
import AppShell from "../../components/ui/AppShell.astro";
import LoginSheet from "../../components/ui/organisms/LoginSheet.astro";
import Toast from "../../components/ui/atoms/Toast.astro";
---
<AppShell
  title="Seller Sign In · Relifish"
  description="Sign in to your seller dashboard"
  hideNav={true}
  hideHeader={true}
>
  <Toast />

  <style>
    .dl-hero-wrap {
      background: linear-gradient(135deg, var(--v2-green), #10B981);
      padding: 32px 24px 28px;
      color: #fff;
      text-align: center;
      border-radius: 16px;
    }
  </style>

  <div class="dl-hero-wrap">
    <div style="margin-bottom:14px;">
      <img src={LOGO_URL} alt="Relifish" style="height:72px;width:auto;display:block;margin:0 auto;filter:brightness(0) invert(1);" />
    </div>
    <h1 style="font:900 24px Inter;margin:0 0 6px;letter-spacing:-.02em;">Seller dashboard</h1>
    <p style="font:400 14px Inter;opacity:.9;margin:0;">Sign in to manage your fish listings and orders</p>
  </div>

  <!-- Spacer so content doesn't hide behind fixed footer -->
  <div style="height:150px;"></div>

  <!-- Sticky CTA — pinned to bottom, works on mobile -->
  <div style="position:fixed;bottom:0;left:0;right:0;display:flex;justify-content:center;pointer-events:none;">
    <div style="width:100%;max-width:800px;background:var(--v2-bg);border-top:1px solid var(--v2-border);padding:16px 16px calc(16px + env(safe-area-inset-bottom));pointer-events:auto;">
      <button id="open-login-sheet" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full">
        Sign in with phone
      </button>
      <p style="font:400 11px Inter;color:var(--v2-ink-3);margin:10px 0 0;text-align:center;line-height:1.5;">
        By continuing, you agree to Relifish's <a href="/terms#sellers" target="_blank" style="color:inherit;text-decoration:underline;">Terms (incl. seller responsibilities)</a> and <a href="/privacy" target="_blank" style="color:inherit;text-decoration:underline;">Privacy Policy</a>.
      </p>
      <div style="margin-top:12px;text-align:center;">
        <a href="/" style="font:600 13px Inter;color:var(--v2-ink-3);text-decoration:none;">← Back to buyer app</a>
      </div>
    </div>
  </div>

  <LoginSheet id="seller-login-sheet" role="seller" redirectTo="/dashboard/orders" />

  <script>
    document.getElementById("open-login-sheet")?.addEventListener("click", () => {
      (window as any).v2OpenSheet?.("seller-login-sheet");
    });
    // Auto-open sheet on page load for faster flow
    setTimeout(() => (window as any).v2OpenSheet?.("seller-login-sheet"), 300);
  </script>
</AppShell>
