---
export const prerender = false;

import Header from "../../components/Header.astro";
import "../../styles/global.css";

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066cc" />
    <title>{`Seller Login - ${brandName}`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body>
    <Header showDashboardLink={false} />

    <!-- Toast -->
    <div id="toast" style="display:none;position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,0.15);transition:opacity 0.3s;"></div>

    <main>
      <div style="max-width:440px;margin:24px auto 40px;padding:0 16px;">
        <!-- Seller hook: value they can't easily argue with (time = money, same phone, ready buyers) -->
        <section
          class="seller-hook-card"
          aria-labelledby="seller-hook-title"
          style="background:linear-gradient(145deg, #e8f4fd 0%, #f0f9ff 100%);border:1px solid rgba(0,102,204,0.15);border-radius:16px;padding:20px 18px;margin-bottom:28px;box-shadow:0 2px 12px rgba(0,102,204,0.08);"
        >
          <p
            id="seller-hook-title"
            style="margin:0 0 6px;font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--blue);"
          >
            Why sellers say yes
          </p>
          <h2 style="margin:0 0 12px;font-size:18px;font-weight:800;line-height:1.35;color:var(--gray-900);">
            You already wake up for the market—{brandName} brings buyers to <em style="font-style:normal;color:var(--blue);">your</em> menu, not someone else’s.
          </h2>
          <ul
            style="margin:0;padding:0 0 0 18px;font-size:14px;line-height:1.55;color:var(--gray-700);list-style:disc;"
          >
            <li style="margin-bottom:8px;">
              <strong>No extra stall, no new habit:</strong> same phone, your prices—orders show up with quantity and (for delivery) address.
            </li>
            <li style="margin-bottom:8px;">
              <strong>Less “rate kya hai?” spam:</strong> serious buyers browse what you listed and pay intent is clearer before they ping you.
            </li>
            <li>
              <strong>You’re not giving anything up:</strong> you still run your shop; this is another lane for the catch you were going to sell anyway.
            </li>
          </ul>
          <p class="text-muted" style="margin:14px 0 0;font-size:12px;line-height:1.4;">
            Listing takes minutes. If it doesn’t bring you a single extra order, you’ve lost nothing but a few taps—if it does, you’ve gained sales you might have missed on the footpath alone.
          </p>
        </section>

        <h1 style="font-size:24px;font-weight:700;margin-bottom:8px;">Seller Login</h1>
        <p class="text-muted" style="margin-bottom:24px;">Enter your phone number to receive an OTP.</p>

        <!-- Step 1: Phone -->
        <div id="phone-step">
          <div class="form-group">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" placeholder="+91 9876543210" required />
          </div>
          <button id="send-otp-btn" class="btn btn-primary" style="width:100%;">Send OTP</button>
        </div>

        <!-- Step 2: OTP -->
        <div id="otp-step" style="display:none;">
          <div class="form-group">
            <label for="otp">Enter OTP</label>
            <input type="text" id="otp" placeholder="123456" maxlength="6" required />
          </div>
          <button id="verify-otp-btn" class="btn btn-primary" style="width:100%;">Verify & Login</button>
          <p class="text-muted" style="margin-top:8px;text-align:center;">
            <button type="button" id="resend-btn" class="btn" style="background:none;border:none;color:var(--blue);cursor:pointer;font-size:13px;min-height:40px;display:inline-flex;">Resend OTP</button>
          </p>
        </div>
      </div>
    </main>

    <script>
      import { sendOtp, verifyOtp, getSession } from "../../lib/seller-auth";
      import { setButtonLoading } from "../../lib/button-loading";

      const session = getSession();
      if (session) window.location.href = "/dashboard/orders";

      const phoneStep = document.getElementById("phone-step")!;
      const otpStep = document.getElementById("otp-step")!;
      const phoneInput = document.getElementById("phone") as HTMLInputElement;
      const otpInput = document.getElementById("otp") as HTMLInputElement;
      const sendBtn = document.getElementById("send-otp-btn") as HTMLButtonElement;
      const verifyBtn = document.getElementById("verify-otp-btn") as HTMLButtonElement;
      const resendBtn = document.getElementById("resend-btn") as HTMLButtonElement;

      function showToast(message: string, type: "success" | "error" = "success") {
        const toast = document.getElementById("toast")!;
        toast.textContent = message;
        toast.style.display = "block";
        toast.style.opacity = "1";
        toast.style.background = type === "success" ? "var(--green)" : "var(--red)";
        toast.style.color = "white";
        setTimeout(() => {
          toast.style.opacity = "0";
          setTimeout(() => { toast.style.display = "none"; }, 300);
        }, 3000);
      }

      function normalizePhone(raw: string): string {
        const digits = raw.replace(/\D/g, "");
        if (digits.startsWith("91") && digits.length === 12) return "+" + digits;
        if (digits.length === 10) return "+91" + digits;
        return "+" + digits;
      }

      let phone = "";

      sendBtn.addEventListener("click", async () => {
        phone = normalizePhone(phoneInput.value);
        if (phone.length < 12) {
          showToast("Please enter a valid phone number.", "error");
          return;
        }
        setButtonLoading(sendBtn, true, "Send OTP", "on-dark");
        try {
          await sendOtp(phone);
          phoneStep.style.display = "none";
          otpStep.style.display = "block";
          showToast("OTP sent!");
        } catch (err: any) {
          showToast(err.message || "Failed to send OTP.", "error");
        } finally {
          setButtonLoading(sendBtn, false, "Send OTP", "on-dark");
        }
      });

      verifyBtn.addEventListener("click", async () => {
        const token = otpInput.value.trim();
        if (token.length !== 6) {
          showToast("Please enter the 6-digit OTP.", "error");
          return;
        }
        setButtonLoading(verifyBtn, true, "Verify & Login", "on-dark");
        try {
          const data = await verifyOtp(phone, token);
          window.location.href = data?.is_active === false ? "/dashboard/pending" : "/dashboard/orders";
        } catch (err: any) {
          showToast(err.message || "Invalid OTP. Try again.", "error");
          setButtonLoading(verifyBtn, false, "Verify & Login", "on-dark");
        }
      });

      resendBtn.addEventListener("click", async () => {
        setButtonLoading(resendBtn, true, "Resend OTP", "textlink");
        try {
          await sendOtp(phone);
          showToast("OTP resent!");
        } catch (err: any) {
          showToast(err.message || "Failed to resend OTP.", "error");
        } finally {
          setButtonLoading(resendBtn, false, "Resend OTP", "textlink");
        }
      });

      phoneInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter") sendBtn.click();
      });
      otpInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter") verifyBtn.click();
      });
    </script>
  </body>
</html>
