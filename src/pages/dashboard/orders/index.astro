---
export const prerender = false;
import AppShell from "../../../components/ui/AppShell.astro";
import Toast from "../../../components/ui/atoms/Toast.astro";
import EmptyState from "../../../components/ui/molecules/EmptyState.astro";
---
<AppShell
  title="Orders · Seller Dashboard"
  description="Manage today's orders"
  hideHeader={true}
  nav={{ active: "orders", mode: "seller" }}
>
  <Toast />

  <div id="v2-dash-content" style="display:none;">
    <!-- Hero with toggleable stats -->
    <div class="v2-dash-hero">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <div>
          <div class="v2-dash-greet">Good day, <span id="v2-dash-name">seller</span></div>
          <div class="v2-dash-title">Today's pipeline</div>
        </div>
        <button id="v2-stats-toggle" type="button" style="background:rgba(255,255,255,.2);border:none;color:#fff;font:600 11px Inter;padding:6px 12px;border-radius:20px;cursor:pointer;">Stats ▼</button>
      </div>
      <div id="v2-dash-stats-panel" style="display:none;">
        <div class="v2-dash-stats" style="margin-top:12px;">
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-pending">—</div><div class="v2-dash-l">New</div></div>
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-inprogress">—</div><div class="v2-dash-l">In Progress</div></div>
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-gmv">₹0</div><div class="v2-dash-l">Today GMV</div></div>
        </div>
        <div class="v2-dash-stats" style="margin-top:8px;">
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-preorders">—</div><div class="v2-dash-l">Pre-orders</div></div>
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-completed">—</div><div class="v2-dash-l">Completed</div></div>
          <div class="v2-dash-stat"><div class="v2-dash-v" id="v2-dash-declined">—</div><div class="v2-dash-l">Declined</div></div>
        </div>
      </div>
    </div>

    <!-- Action row removed — use Listings tab and per-order actions instead -->

    <div class="v2-dash-sticky-controls">
      <!-- Tabs -->
      <div class="v2-dash-tabs">
        <button class="v2-dash-tab v2-dash-tab-active" data-tab="pending">New <span class="v2-dash-tab-count" id="v2-tab-pending-count">0</span></button>
        <button class="v2-dash-tab" data-tab="accepted">In Progress <span class="v2-dash-tab-count" id="v2-tab-accepted-count" style="display:none;">0</span></button>
        <button class="v2-dash-tab" data-tab="completed">History <span class="v2-dash-tab-count" id="v2-tab-completed-count" style="display:none;">0</span></button>
      </div>

      <!-- Search + Date filter + export -->
      <div style="padding:8px 16px;background:var(--v2-bg);border-bottom:1px solid var(--v2-border);">
        <input id="v2-dash-search" type="text" placeholder="Search by order ID or phone..." style="width:100%;padding:8px 12px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 13px Inter;color:var(--v2-ink);background:var(--v2-bg-2);outline:none;box-sizing:border-box;" />
      </div>
      <div class="v2-dash-filterbar">
        <label class="v2-dash-filter-lbl">Range:</label>
        <select id="v2-dash-range" class="v2-dash-select">
          <option value="today">Today</option>
          <option value="7d">Last 7 days</option>
          <option value="30d" selected>Last 30 days</option>
          <option value="all">All time</option>
        </select>
        <label class="v2-dash-filter-lbl" style="margin-left:6px;">Type:</label>
        <select id="v2-dash-type" class="v2-dash-select">
          <option value="all" selected>All</option>
          <option value="order">Order</option>
          <option value="preorder">Pre-order</option>
        </select>
        <a id="v2-dash-export" href="#" class="v2-dash-export-link" title="Download orders as CSV">⬇ CSV</a>
        <span style="flex:1;"></span>
        <span id="v2-orders-count" class="v2-dash-filter-lbl"></span>
      </div>
    </div>

    <div id="v2-orders-list">
      <div style="text-align:center;padding:24px;color:var(--v2-ink-3);font:500 12px Inter;">
        <span class="v2-spinner v2-spinner-md"></span><div style="margin-top:8px;">Loading orders...</div>
      </div>
    </div>
  </div>

  <div id="v2-dash-not-active" style="display:none;padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Account pending activation"
      description="Your seller account is awaiting admin approval. We'll notify you when activated."
      ctaText="Refresh status"
      ghostCtaText="Sign out"
    />
  </div>

  <div id="v2-dash-no-auth" style="display:none;padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Sign in required"
      description="Please sign in to access your seller dashboard."
      ctaText="Sign in"
      ctaHref="/dashboard/login"
    />
  </div>
</AppShell>

<style is:global>
  .v2-dash-sticky-controls {
    position: sticky;
    top: 0;
    z-index: 25;
    background: var(--v2-bg);
    box-shadow: 0 4px 10px rgba(15, 23, 42, .08);
  }
  .v2-dash-hero {
    background: linear-gradient(135deg, var(--v2-green), #10B981);
    padding: 16px;
    color: #fff;
  }
  .v2-dash-greet { font: 400 12px Inter; opacity: .9; }
  .v2-dash-title { font: 800 20px Inter; margin-top: 2px; }
  .v2-dash-stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 8px; margin-top: 16px;
  }
  .v2-dash-stat {
    background: rgba(255, 255, 255, .15);
    border-radius: 10px;
    padding: 10px;
    text-align: center;
    backdrop-filter: blur(10px);
  }
  .v2-dash-v { font: 800 18px Inter; color: #fff; }
  .v2-dash-l { font: 500 10px Inter; color: rgba(255, 255, 255, .9); margin-top: 1px; }
  .v2-dash-actions {
    display: flex; gap: 8px;
    padding: 16px;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
  }
  .v2-dash-actions .v2-btn { flex: 1; }
  .v2-dash-tabs {
    display: flex;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .v2-dash-tabs::-webkit-scrollbar { display: none; }
  .v2-dash-tab {
    flex: 1; padding: 12px;
    font: 600 12px Inter;
    color: var(--v2-ink-3);
    text-align: center;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    white-space: nowrap;
    min-width: 100px;
  }
  .v2-dash-tab-active { color: var(--v2-brand); }
  .v2-dash-tab-active::after {
    content: '';
    position: absolute; bottom: 0; left: 16px; right: 16px;
    height: 2px;
    background: var(--v2-brand);
  }
  .v2-dash-tab-count {
    font-size: 10px;
    margin-left: 4px;
    background: var(--v2-red); color: #fff;
    padding: 1px 6px;
    border-radius: 9999px;
  }
  .v2-dash-filterbar {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
    flex-wrap: wrap;
  }
  .v2-dash-filter-lbl {
    font: 600 11px Inter; color: var(--v2-ink-3);
  }
  .v2-dash-select {
    background: var(--v2-bg-2);
    border: 1px solid var(--v2-border);
    color: var(--v2-ink);
    font: 600 12px Inter;
    padding: 6px 10px;
    border-radius: var(--v2-radius-sm);
    cursor: pointer;
  }
  .v2-dash-export-link {
    font: 600 12px Inter;
    color: var(--v2-brand);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: var(--v2-radius-sm);
    border: 1px solid var(--v2-border);
    background: var(--v2-bg-2);
  }
  .v2-dash-export-link:hover { background: var(--v2-brand-l); }
  #v2-orders-list {
    margin-top: 12px;
    padding: 0 8px 8px;
  }
  .v2-seller-order {
    box-shadow: 0 8px 18px rgba(15, 23, 42, .06);
    border: 1px solid color-mix(in srgb, var(--v2-border) 88%, #ffffff);
  }
  .v2-oc-meta {
    display: flex;
    gap: 6px;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .v2-oc-meta-pill {
    font: 700 10px Inter;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: var(--v2-ink-3);
    background: var(--v2-bg-2);
    border: 1px solid var(--v2-border);
    border-radius: 999px;
    padding: 3px 8px;
  }
  /* Order type pill — blue for same-day, purple for pre-order */
  .v2-oc-meta-pill-order {
    color: #1d4ed8;
    background: #eff6ff;
    border-color: #bfdbfe;
  }
  .v2-oc-meta-pill-preorder {
    color: #7c3aed;
    background: #f5f3ff;
    border-color: #ddd6fe;
  }
  /* Delivery/pickup pill — teal for delivery, amber for pickup */
  .v2-oc-meta-pill-delivery {
    color: #0e7490;
    background: #ecfeff;
    border-color: #a5f3fc;
  }
  .v2-oc-meta-pill-pickup {
    color: #b45309;
    background: #fffbeb;
    border-color: #fde68a;
  }
  .v2-oc-sub {
    font: 500 11px Inter;
    color: var(--v2-ink-3);
    margin-top: 2px;
  }
  .v2-oc-next {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px dashed var(--v2-border);
    background: var(--v2-bg-2);
    font: 600 11px Inter;
    color: var(--v2-ink-2);
  }
  @media (max-width: 430px) {
    .v2-dash-filterbar { gap: 6px; }
    .v2-dash-select { padding: 6px 8px; font-size: 11px; }
    .v2-dash-export-link { padding: 6px 8px; font-size: 11px; }
  }
  .v2-pagination {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px;
    gap: 8px;
  }
  .v2-pg-btn {
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    color: var(--v2-ink);
    font: 600 12px Inter;
    padding: 8px 14px;
    border-radius: var(--v2-radius-sm);
    cursor: pointer;
  }
  .v2-pg-btn:disabled { opacity: .4; cursor: not-allowed; }
  .v2-pg-info { font: 500 12px Inter; color: var(--v2-ink-3); }
</style>

<script>
  import { wasActuallyPaid, refundableAmount, paymentMethodLabel, preorderNeedsFinalPrice, refundStatus } from "../../../lib/order-payment-state";
  import { supabase } from "../../../lib/supabase";
  import { cancelledByText, cancelReasonText } from "../../../lib/order-cancel";

  let sellerId: string | null = null;
  let sellerData: any = null;
  let currentTab: "pending" | "accepted" | "completed" = "pending";
  let currentRange = "30d";
  let currentPage = 1;
  let searchQuery = "";
  let currentType: "all" | "order" | "preorder" = "all";
  const PAGE_SIZE = 10;

  function wasPreorderWindow(createdAt: string, seller: any): boolean {
    if (!seller) return false;
    const ist = new Date(new Date(createdAt).getTime() + 5.5 * 60 * 60 * 1000);
    const DAY_NAMES = ['sun','mon','tue','wed','thu','fri','sat'];
    const dayName = DAY_NAMES[ist.getUTCDay()];
    const timeMin = ist.getUTCHours() * 60 + ist.getUTCMinutes();
    function toMin(t: string | null | undefined): number | null {
      if (!t) return null;
      const [h, m] = String(t).split(':').map(Number);
      return h * 60 + (m || 0);
    }
    const preorderDays: string[] = seller.preorder_days || [];
    const openDays: string[] = seller.open_days || [];
    const isPreorderDay = preorderDays.length > 0
      ? preorderDays.includes(dayName)
      : !!seller.accepts_preorder;
    if (!isPreorderDay) return false;
    // Must be before cutoff
    const cutoffMin = toMin(seller.preorder_cutoff_time);
    if (cutoffMin !== null && timeMin >= cutoffMin) return false;
    // On order days: window only starts after store closes (same rule as order-timing.ts)
    const isOrderDay = openDays.length === 0 || openDays.includes(dayName);
    if (isOrderDay) {
      const closeMin = toMin(seller.closes_at);
      if (closeMin !== null && timeMin < closeMin) return false;
    }
    return true;
  }
  let pollTimer: any;
  /** One-shot scroll/highlight from `?order=<uuid>` (e.g. seller Web Push deep link). */
  let didFocusFromOrderQuery = false;

  const STATUS_BY_TAB: Record<string, string[]> = {
    // `paid` = buyer paid, seller hasn't accepted yet → needs action → New.
    pending: ["pending", "pending_payment", "pre_order", "scheduled", "paid"],
    accepted: ["confirmed", "payment_required", "ready_for_pickup", "out_for_delivery"],
    completed: ["picked_up", "completed", "declined", "cancelled", "refunded"],
  };

  function nowInIST(): Date {
    // Convert "current time in IST" → Date object in local runtime.
    // (We only use this for filtering cutoffs, not for display.)
    return new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Kolkata" }));
  }
  function rangeToDate(r: string): Date | null {
    const now = nowInIST();
    if (r === "today") { const d = new Date(now); d.setHours(0,0,0,0); return d; }
    if (r === "7d") return new Date(now.getTime() - 7 * 86400000);
    if (r === "30d") return new Date(now.getTime() - 30 * 86400000);
    return null;
  }

  function getSellerId() {
    try { return localStorage.getItem("rlf_seller_id"); } catch { return null; }
  }

  function renderProfileCompletion(s: any) {
    const steps = [
      { label: "Business name", done: !!(s.name && s.name.trim() && s.name !== "New Seller") },
      { label: "Location set", done: !!(s.location_name || (s.lat && s.lng)) },
      { label: "Store hours", done: !!(s.opens_at && s.closes_at) },
      { label: "Email verified", done: !!(s.email && s.email_verified) },
    ];
    const incomplete = steps.filter(st => !st.done);
    if (incomplete.length === 0) return;
    const hero = document.querySelector(".v2-dash-hero");
    if (!hero) return;
    const banner = document.createElement("div");
    banner.id = "v2-profile-completion-banner";
    banner.style.cssText = "margin:12px 16px 0;padding:12px 14px;background:#FFF7ED;border:1.5px solid #FED7AA;border-radius:var(--v2-radius);";
    banner.innerHTML = `
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
        <div style="font:700 12px Inter;color:#EA580C;">⚡ Complete your setup</div>
        <a href="/dashboard/profile" style="font:600 11px Inter;color:var(--v2-brand);text-decoration:none;">Go to profile →</a>
      </div>
      <div style="display:flex;flex-direction:column;gap:4px;">
        ${steps.map(st => `<div style="font:500 11px Inter;color:${st.done ? '#059669' : '#EA580C'};">${st.done ? '✓' : '○'} ${st.label}</div>`).join("")}
      </div>`;
    hero.after(banner);
  }

  function escape(s: string) {
    return String(s || "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!));
  }

  function tryFocusOrderFromQuery() {
    if (didFocusFromOrderQuery) return;
    const id = new URLSearchParams(location.search).get("order");
    if (!id || !/^[0-9a-f-]{36}$/i.test(id)) return;
    const root = document.getElementById("v2-orders-list");
    if (!root) return;
    const card = root.querySelector(`[data-order-id="${id}"]`) as HTMLElement | null;
    if (!card) return;
    didFocusFromOrderQuery = true;
    card.scrollIntoView({ behavior: "smooth", block: "center" });
    const prev = card.style.outline;
    card.style.outline = "2px solid var(--v2-brand, #0066cc)";
    card.style.outlineOffset = "2px";
    setTimeout(() => {
      card.style.outline = prev;
      card.style.outlineOffset = "";
    }, 4500);
  }

  /** Read-only refund status for cancelled/declined/refunded cards. Razorpay refunds run server-side. */
  function refundStatusHtml(o: any, amt: number) {
    const amtStr = amt.toLocaleString("en-IN");
    const rs = refundStatus(o);
    const box = (bg: string, border: string, color: string, title: string) =>
      `<div style="padding:10px;background:${bg};border:1px solid ${border};border-radius:var(--v2-radius-sm);margin-top:6px;display:flex;flex-direction:column;gap:6px;">
        <div style="font:700 12px Inter;color:${color};">${title}</div>
        <div style="font:400 11px Inter;color:var(--v2-ink-3);">${escape(rs.text)} No action needed from you.</div>
      </div>`;
    if (rs.state === "refunded") return box("#F0FDF4", "#86EFAC", "var(--v2-green)", `✓ ₹${amtStr} refunded to buyer · ${new Date(o.refund_sent_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" })}`);
    if (rs.state === "delayed") return box("#FFF7ED", "#FED7AA", "var(--v2-orange)", `↩ Refund ₹${amtStr} to buyer — delayed, retrying`);
    return box("#F5F3FF", "#C4B5FD", "#7C3AED", `↩ Refund ₹${amtStr} to buyer — processing via Razorpay`);
  }

  async function init() {
    sellerId = getSellerId();
    if (!sellerId) {
      document.getElementById("v2-dash-no-auth")!.style.display = "block";
      return;
    }
    try {
      const { data } = await supabase.from("sellers").select("*").eq("id", sellerId).single();
      sellerData = data;
      if (!sellerData?.is_active) {
        document.getElementById("v2-dash-not-active")!.style.display = "block";
        return;
      }
      document.getElementById("v2-dash-content")!.style.display = "block";
      document.getElementById("v2-dash-name")!.textContent = sellerData.name || "seller";
      renderProfileCompletion(sellerData);
      await loadOrders();

      // Deep link from Web Push: `/dashboard/orders?order=<uuid>` — search loads the row on any tab.
      const deepOrder = new URLSearchParams(location.search).get("order");
      if (deepOrder && /^[0-9a-f-]{36}$/i.test(deepOrder.trim())) {
        const searchInput = document.getElementById("v2-dash-search") as HTMLInputElement | null;
        if (searchInput && !searchQuery.trim()) {
          searchInput.value = deepOrder.trim();
          searchQuery = deepOrder.trim();
          currentPage = 1;
          await loadOrders(false);
        }
      }

      // Poll for new/updated orders. Realtime from the browser needed the public
      // key to read every order, so it is gone with that leak.
      pollTimer = setInterval(() => { loadOrders(false); }, 20000);
    } catch (err) {
      console.error("dash init failed", err);
      (window as any).v2Toast?.("error", "Load failed", "Refresh to try again");
    }
  }

  async function loadOrders(showSpinner = true) {
    if (!sellerId) return;
    const list = document.getElementById("v2-orders-list")!;

    if (showSpinner) {
      list.innerHTML = `<div style="text-align:center;padding:24px;color:var(--v2-ink-3);font:500 12px Inter;"><span class="v2-spinner v2-spinner-md"></span><div style="margin-top:8px;">Loading orders...</div></div>`;
    }

    try {
      // Orders come from the API (seller session + masked buyer contact),
      // never straight from the database with the public key.
      const sinceDate = rangeToDate(currentRange);
      const todayStart = new Date(); todayStart.setHours(0,0,0,0);
      const qs = new URLSearchParams({
        seller_id: sellerId, tab: currentTab, type: currentType, page: String(currentPage),
        today_start: todayStart.toISOString(),
      });
      if (sinceDate) qs.set("since", sinceDate.toISOString());
      if (searchQuery) qs.set("q", searchQuery);
      const res = await fetch(`/api/seller/orders?${qs}`);
      const payload = await res.json();
      if (!res.ok) throw new Error(payload.error || "Could not load orders");

      if (!payload.has_listings) {
        list.innerHTML = `<div style="padding:24px 16px;"><div class="v2-empty"><div class="v2-empty-icon">📋</div><h3 class="v2-empty-title">No listings yet</h3><p class="v2-empty-desc">Create your first listing to start receiving orders.</p><a href="/dashboard/listings/new" class="v2-btn v2-btn-primary v2-btn-md">Create listing</a></div></div>`;
        return;
      }

      // === Stats: all counts ALL-TIME so seller sees real backlog; GMV = today only ===
      const c = payload.counts;
      const pt = c.pending || 0;
      const ip = c.accepted || 0;
      const ct = c.completed || 0;
      const dc = c.declined || 0;
      const po = c.preorders || 0;
      const todayGmv = Number(payload.today_gmv) || 0;

      // Hero stats
      document.getElementById("v2-dash-pending")!.textContent = String(pt);
      document.getElementById("v2-dash-inprogress")!.textContent = String(ip);
      document.getElementById("v2-dash-gmv")!.textContent = `₹${todayGmv.toLocaleString("en-IN")}`;
      document.getElementById("v2-dash-preorders")!.textContent = String(po);
      document.getElementById("v2-dash-completed")!.textContent = String(ct);
      document.getElementById("v2-dash-declined")!.textContent = String(dc);

      // Tab badges
      document.getElementById("v2-tab-pending-count")!.textContent = String(pt);
      const ipBadge = document.getElementById("v2-tab-accepted-count")!;
      ipBadge.textContent = String(ip);
      ipBadge.style.display = ip > 0 ? "inline" : "none";
      const hBadge = document.getElementById("v2-tab-completed-count")!;
      hBadge.textContent = String(ct + dc);
      hBadge.style.display = (ct + dc) > 0 ? "inline" : "none";

      const ordersToShow = payload.orders || [];
      const totalCount = payload.total || 0;
      const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
      document.getElementById("v2-orders-count")!.textContent = totalCount > 0 ? `${totalCount} ${searchQuery ? "found" : currentTab}` : (searchQuery ? "No results" : "");

      if (ordersToShow.length === 0) {
        list.innerHTML = searchQuery
          ? `<div style="padding:32px 16px;text-align:center;color:var(--v2-ink-3);font:500 13px Inter;">No orders matching "${escape(searchQuery)}"</div>`
          : `<div style="padding:32px 16px;text-align:center;color:var(--v2-ink-3);font:500 13px Inter;">No ${currentTab} orders in this range</div>`;
        return;
      }

      renderOrders(ordersToShow, totalPages);
    } catch (err: any) {
      console.error("loadOrders failed", err);
      list.innerHTML = `<div style="text-align:center;padding:24px;color:var(--v2-red);font:500 13px Inter;">Failed to load orders</div>`;
    }
  }

  function renderOrders(ordersToShow: any[], totalPages: number) {
    const list = document.getElementById("v2-orders-list")!;

    const orderHtml = ordersToShow.map((o: any) => renderSingleOrder(o)).join("");

    const pagerHtml = totalPages > 1 ? `
      <div class="v2-pagination">
        <button class="v2-pg-btn" data-pg="prev" ${currentPage <= 1 ? 'disabled' : ''}>← Prev</button>
        <span class="v2-pg-info">Page ${currentPage} of ${totalPages}</span>
        <button class="v2-pg-btn" data-pg="next" ${currentPage >= totalPages ? 'disabled' : ''}>Next →</button>
      </div>` : '';

    list.innerHTML = orderHtml + pagerHtml;

    // Pagination — use onclick to avoid duplicate listeners across reloads
    const prevBtn = list.querySelector<HTMLButtonElement>('[data-pg="prev"]');
    const nextBtn = list.querySelector<HTMLButtonElement>('[data-pg="next"]');
    if (prevBtn) prevBtn.onclick = () => { currentPage = Math.max(1, currentPage - 1); loadOrders(); };
    if (nextBtn) nextBtn.onclick = () => { currentPage = Math.min(totalPages, currentPage + 1); loadOrders(); };

    // Action delegation for all order cards (including session group cards)
    list.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.action === "decline-show-reason") {
          const orderId = btn.dataset.orderId!;
          const noteInput = document.getElementById(`decline-note-${orderId}`) as HTMLInputElement | null;
          const confirmBtn = document.getElementById(`decline-confirm-${orderId}`) as HTMLButtonElement | null;
          if (noteInput) noteInput.style.display = "block";
          if (confirmBtn) confirmBtn.style.display = "block";
          btn.style.display = "none";
        } else if (btn.dataset.action === "reconcile-razorpay") {
          reconcileRazorpay(btn.dataset.orderId!, btn);
        } else {
          updateStatus(btn.dataset.orderId!, btn.dataset.action!, btn);
        }
      });
    });
    tryFocusOrderFromQuery();
  }

  function renderSingleOrder(o: any) {
        const needsFinalPrice = preorderNeedsFinalPrice(o);
        const isPreorder = o.is_preorder === true || o.placement_kind === "preorder" || o.status === "pre_order";
        const isUrgent = o.scheduled_for && new Date(o.scheduled_for).getTime() - Date.now() < 60 * 60 * 1000;
        const time = o.scheduled_for
          ? new Date(o.scheduled_for).toLocaleString("en-IN", { timeZone: "Asia/Kolkata", weekday: "short", day: "numeric", month: "short", hour: "numeric", minute: "2-digit" })
          : new Date(o.created_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata", day: "numeric", month: "short", hour: "numeric", minute: "2-digit" });
        const cls = isUrgent ? "v2-order-urgent" : "";
        const total = o.total_price || o.final_price || 0;
        const id6 = String(o.id || "").slice(0, 8).toUpperCase();

        // Badge per status
        const statusBadges: Record<string, [string, string]> = {
          pending: ["New", "v2-oc-badge-new"],
          pre_order: ["Pre-order", "v2-oc-badge-preorder"],
          pending_payment: ["New", "v2-oc-badge-new"],
          scheduled: ["Scheduled", "v2-oc-badge-new"],
          confirmed: ["Confirmed", "v2-oc-badge-new"],
          paid: ["Paid — confirm", "v2-oc-badge-urgent"],
          ready_for_pickup: ["Ready", "v2-oc-badge-ready"],
          out_for_delivery: ["Out for delivery", "v2-oc-badge-ready"],
          picked_up: ["Picked up", "v2-oc-badge-done"],
          completed: ["Completed", "v2-oc-badge-done"],
          payment_required: ["Extra payment needed", "v2-oc-badge-urgent"],
          declined: ["Declined", "v2-oc-badge-urgent"],
          cancelled: ["Cancelled", "v2-oc-badge-urgent"],
          refunded: ["Refunded", "v2-oc-badge-urgent"],
        };
        const [badgeText, badgeCls] = statusBadges[o.status] || [o.status, "v2-oc-badge-new"];

        // Actions based on status (not tab — so search results also show actions)
        let actionsHtml = "";
        const isDelivery = o.order_type === "delivery";
        const isPaidViaRazorpay = o.payment_method === "razorpay" || !!o.payment_verified_at;
        if (["pending", "scheduled", "pending_payment", "pre_order"].includes(o.status)) {
          // Paid but the row is still in a pre-confirm status (a confirm write was
          // lost). Ready/Out-for-delivery are rejected by the server from here, so
          // the one useful action is to confirm it.
          if (isPaidViaRazorpay) {
            actionsHtml = `<div style="padding:8px 10px;background:#f0fdf4;border:1px solid #86efac;border-radius:var(--v2-radius-sm);margin-bottom:6px;font:600 11px Inter;color:#15803d;">✅ Payment received — confirm to start preparing</div>
              <div class="v2-oc-actions"><button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-brand);color:#fff;" data-action="accept" data-order-id="${o.id}">✓ Confirm order</button></div>`;
          } else {
            // Buyer hasn't completed payment yet. Offer a manual reconcile
            // button — if buyer paid but the client handler never fired, this
            // checks Razorpay directly and flips the row to confirmed. Backup
            // for when the webhook is missing/lagged.
            const hasRzpOrder = !!o.razorpay_order_id;
            const reconcileBtn = hasRzpOrder
              ? `<button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-brand);color:#fff;" data-action="reconcile-razorpay" data-order-id="${o.id}">🔄 Check Razorpay for payment</button>`
              : `<div style="font:500 11px Inter;color:var(--v2-ink-3);">Buyer hasn't opened payment yet — nothing to reconcile.</div>`;
            actionsHtml = `<div class="v2-oc-actions" style="flex-direction:column;gap:6px;">
              <div style="font:500 11px Inter;color:var(--v2-ink-3);">⏳ Waiting for buyer to complete Razorpay payment. If buyer says money was deducted, click below to reconcile.</div>
              <div style="display:flex;gap:8px;">${reconcileBtn}</div>
              <div id="reconcile-result-${o.id}" style="font:500 11px Inter;margin-top:4px;"></div>
              <div style="display:flex;gap:8px;">
                <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-action="decline-show-reason" data-order-id="${o.id}">Can't fulfill</button>
              </div>
              <input type="text" placeholder="Decline reason (shown to buyer, optional)" id="decline-note-${o.id}" style="width:100%;padding:8px 10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 12px Inter;color:var(--v2-ink);background:var(--v2-bg);outline:none;box-sizing:border-box;display:none;" />
              <button class="v2-btn v2-btn-sm" style="display:none;background:var(--v2-red);color:#fff;" data-action="decline" data-order-id="${o.id}" id="decline-confirm-${o.id}">✓ Confirm — refund buyer</button>
            </div>`;
          }
        } else if (o.status === "paid") {
          // Buyer paid; the seller decides. Accept → confirmed, decline → full refund.
          actionsHtml = `<div style="padding:8px 10px;background:#f0fdf4;border:1px solid #86efac;border-radius:var(--v2-radius-sm);margin-bottom:6px;font:600 11px Inter;color:#15803d;">✅ Buyer paid ₹${(Number(o.paid_amount) || 0).toLocaleString("en-IN")} — confirm to accept the order</div>
            <div class="v2-oc-actions" style="flex-direction:column;gap:6px;">
              <div style="display:flex;gap:8px;">
                <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-brand);color:#fff;" data-action="accept" data-order-id="${o.id}">✓ Confirm order</button>
                <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-action="decline-show-reason" data-order-id="${o.id}">Can't fulfill</button>
              </div>
              <input type="text" placeholder="Reason (shown to buyer, optional)" id="decline-note-${o.id}" style="width:100%;padding:8px 10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 12px Inter;color:var(--v2-ink);background:var(--v2-bg);outline:none;box-sizing:border-box;display:none;" />
              <button class="v2-btn v2-btn-sm" style="display:none;background:var(--v2-red);color:#fff;" data-action="decline" data-order-id="${o.id}" id="decline-confirm-${o.id}">✓ Decline — refund buyer in full</button>
            </div>`;
        } else if (o.status === "confirmed") {
          const preorderPriceBlock = needsFinalPrice
            ? (() => {
                const paidAmt = o.paid_amount ? Number(o.paid_amount).toLocaleString("en-IN") : "—";
                const listingOpts2 = o.listing?.pricing_options || [];
                const matchedOpt = listingOpts2.find((x: any) => x?.id && x.id === o.pricing_option_id) || listingOpts2[0] || null;
                const priceMin = matchedOpt?.preorder_price_min;
                const priceMax = matchedOpt?.preorder_price_max;
                const rangeHtml = priceMin && priceMax
                  ? `<div style="font:500 11px Inter;color:#7C3AED;">Your listed range: ₹${Number(priceMin).toLocaleString("en-IN")} – ₹${Number(priceMax).toLocaleString("en-IN")}</div>`
                  : "";
                return `<div class="v2-oc-actions" style="flex-direction:column;gap:8px;margin-top:8px;">
                  <div style="font:500 11px Inter;color:var(--v2-ink-3);">🌙 Next-day catch. Set actual price after receiving the fish.</div>
                  <div style="font:600 12px Inter;color:#7C3AED;">Amount received: ₹${paidAmt}</div>
                  ${rangeHtml}
                  <div style="display:flex;gap:8px;align-items:center;">
                    <input type="number" placeholder="Final price (₹)" id="final-price-${o.id}" style="flex:1;padding:8px 10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 13px Inter;color:var(--v2-ink);background:var(--v2-bg);outline:none;box-sizing:border-box;min-height:36px;" />
                    <button class="v2-btn v2-btn-sm" style="background:#7C3AED;color:#fff;white-space:nowrap;" data-action="set_final_price" data-order-id="${o.id}">Set price</button>
                  </div>
                  <div style="font:400 11px Inter;color:#D97706;">⚠️ If final &lt; ₹${paidAmt} → the difference is refunded to the buyer automatically via Razorpay. If final &gt; ₹${paidAmt} → buyer pays the difference.</div>
                  <div style="font:600 11px Inter;color:#7C3AED;">Next step unlocks only after final price is set.</div>
                </div>`;
              })()
            : "";
          if (needsFinalPrice) {
            actionsHtml = preorderPriceBlock;
          } else {
            const fulfill = isDelivery
              ? `<div class="v2-oc-actions">
                  <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-brand);color:#fff;" data-action="out_for_delivery" data-order-id="${o.id}">🚲 Out for delivery</button>
                </div>`
              : `<div class="v2-oc-actions">
                  <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-brand);color:#fff;" data-action="ready" data-order-id="${o.id}">📦 Ready for pickup</button>
                </div>`;
            // BUG-43: a pre-order that came in cheaper than the buyer paid used
            // to be flipped to status `refunded`, which tripped the inventory
            // restore trigger on an order still being fulfilled. It now stays
            // `confirmed` with the difference recorded in refund_amt — so the
            // amount owed has to be surfaced here, or it becomes invisible.
            const dueBack = Number(o.refund_amt) || 0;
            const owedBlock = dueBack > 0
              ? `<div style="padding:10px;background:${o.refund_sent_at ? "#F0FDF4" : "#FFF7ED"};border:1px solid ${o.refund_sent_at ? "#86EFAC" : "#FED7AA"};border-radius:var(--v2-radius-sm);display:flex;flex-direction:column;gap:6px;">
                  ${o.refund_sent_at
                    ? `<div style="font:700 12px Inter;color:var(--v2-green);">✓ Refund of ₹${dueBack.toLocaleString("en-IN")} sent via Razorpay</div>`
                    : `<div style="font:700 12px Inter;color:var(--v2-orange);">↩ Refund ₹${dueBack.toLocaleString("en-IN")} to buyer</div>
                  <div style="font:400 11px Inter;color:var(--v2-ink-3);">Final price came in lower than they paid. The difference is refunded automatically via Razorpay — just fulfil the order as normal.</div>`}
                </div>`
              : "";
            actionsHtml = `${owedBlock}${fulfill}<button class="v2-btn v2-btn-sm" style="width:100%;margin-top:6px;background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-action="seller_cancel" data-order-id="${o.id}">Cancel order · refund buyer</button>`;
          }
        } else if (o.status === "ready_for_pickup") {
          actionsHtml = `<div class="v2-oc-actions" style="flex-direction:column;">
            <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-green);color:#fff;" data-action="picked_up" data-order-id="${o.id}">✓ Picked up</button><button class="v2-btn v2-btn-sm" style="width:100%;margin-top:6px;background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-action="seller_cancel" data-order-id="${o.id}">Cancel order · refund buyer</button>
          </div>`;
        } else if (o.status === "out_for_delivery") {
          actionsHtml = `<div class="v2-oc-actions" style="flex-direction:column;">
            <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-green);color:#fff;" data-action="delivered" data-order-id="${o.id}">✓ Delivered</button><button class="v2-btn v2-btn-sm" style="width:100%;margin-top:6px;background:var(--v2-bg);color:var(--v2-red);border:1.5px solid var(--v2-red-l);" data-action="seller_cancel" data-order-id="${o.id}">Cancel order · refund buyer</button>
          </div>`;
        } else if (["cancelled", "declined"].includes(o.status) && wasActuallyPaid(o)) {
          // BUG-42: paid_amount is pre-set at creation, so this used to tell the
          // seller to refund orders the buyer had never paid for.
          actionsHtml = refundStatusHtml(o, refundableAmount(o));
        } else if (o.status === "payment_required") {
          const balanceAmt = o.final_price && o.paid_amount ? (Number(o.final_price) - Number(o.paid_amount)).toLocaleString("en-IN") : "—";
          actionsHtml = `<div style="padding:10px;background:var(--v2-bg-2);border-radius:var(--v2-radius-sm);margin-top:6px;display:flex;flex-direction:column;gap:6px;">
            <div style="font:700 12px Inter;color:var(--v2-orange);">⏳ Waiting for balance ₹${balanceAmt}</div>
            <div style="font:400 11px Inter;color:var(--v2-ink-3);">Buyer notified. Will confirm once they pay the difference.</div>
          </div>`;
        } else if (o.status === "refunded") {
          const paidAmt = Number(o.paid_amount) || 0;
          const finalAmt = Number(o.final_price) || 0;
          actionsHtml = refundStatusHtml(o, finalAmt > 0 ? Math.max(0, paidAmt - finalAmt) : paidAmt);
        }
        if (["cancelled", "declined"].includes(o.status)) {
          const who = cancelledByText(o.cancelled_by, "seller", o.cancel_reason);
          const why = cancelReasonText(o.cancel_reason);
          actionsHtml = `<div style="padding:10px;background:var(--v2-bg-2);border-radius:var(--v2-radius-sm);margin-top:6px;display:flex;flex-direction:column;gap:4px;">
            <div style="font:700 12px Inter;color:var(--v2-red);">${escape(o.status === "declined" ? who.replace(/^Cancelled/, "Declined") : who)}</div>
            ${why ? `<div style="font:400 12px Inter;color:var(--v2-ink-2);">Reason: ${escape(why)}</div>` : ""}
          </div>${actionsHtml}`;
        }

        const listingOpts = o.listing?.pricing_options || [];
        const opt = listingOpts.find((x: any) => x?.id && x.id === o.pricing_option_id) || null;
        const bundle = opt?.bundle_size && opt.bundle_size > 0 ? Number(opt.bundle_size) : 1;
        const unit = o.quantity_unit || "kg";
        const qtyLabel = unit === "piece" && bundle > 1 ? `${Math.round(Number(o.quantity) / bundle)} pack` : (unit === "kg" && Number(o.quantity) > 0 && Number(o.quantity) < 1 ? `${Math.round(Number(o.quantity) * 1000)} grams` : `${o.quantity}${escape(unit)}`);
        let nextStepHint = "";
        if (["pending", "scheduled", "pending_payment", "pre_order"].includes(o.status)) {
          nextStepHint = isPaidViaRazorpay ? "Next: Confirm the order." : "Waiting for buyer to complete Razorpay payment.";
        } else if (o.status === "paid") {
          nextStepHint = "Next: Confirm the order (or decline — the buyer is refunded in full).";
        } else if (o.status === "confirmed" && needsFinalPrice) {
          nextStepHint = "Next: Set final price before delivery or pickup.";
        } else if (o.status === "confirmed") {
          nextStepHint = isDelivery ? "Next: Mark as out for delivery." : "Next: Mark as ready for pickup.";
        } else if (o.status === "payment_required") {
          nextStepHint = "Waiting: Buyer must pay the difference.";
        } else if (o.status === "ready_for_pickup") {
          nextStepHint = "Next: Mark as picked up when handed over.";
        } else if (o.status === "out_for_delivery") {
          nextStepHint = "Next: Mark as delivered after drop-off.";
        }
        const fbRaw = o.order_feedback;
        const fbRow = Array.isArray(fbRaw) ? fbRaw[0] : fbRaw;
        const buyerRatingHtml =
          fbRow && Number(fbRow.rating) > 0
            ? `<div style="margin-top:8px;padding:10px;background:#FFFBEB;border:1px solid #FCD34D;border-radius:var(--v2-radius-sm);">
                <div style="font:700 12px Inter;color:#D97706;">⭐ Buyer rated ${Number(fbRow.rating)}/5</div>
                ${fbRow.feedback ? `<div style="font:400 12px Inter;color:var(--v2-ink);margin-top:4px;">${escape(String(fbRow.feedback))}</div>` : ""}
                ${fbRow.updated_at ? `<div style="font:400 10px Inter;color:var(--v2-ink-3);margin-top:4px;">${escape(new Date(fbRow.updated_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" }))}</div>` : ""}
              </div>`
            : "";
        // Determine payment status badge — order matters: most specific first
        let payStatusText = "Payment pending"; // default for new/awaiting orders
        if (o.status === 'refunded') payStatusText = "Refunded";
        else if (['declined', 'cancelled'].includes(o.status) && wasActuallyPaid(o)) payStatusText = "Refund pending";
        else if (['declined', 'cancelled'].includes(o.status)) payStatusText = "Unpaid";
        else if (['pending_payment', 'payment_required'].includes(o.status) && !isPaidViaRazorpay) payStatusText = "Payment pending";
        else if (wasActuallyPaid(o) || isPaidViaRazorpay || ['confirmed', 'paid', 'ready_for_pickup', 'out_for_delivery', 'picked_up', 'completed'].includes(o.status)) payStatusText = "Paid";

        return `<div class="v2-seller-order ${cls}" data-order-id="${o.id}">
          <div class="v2-oc-top">
            <div>
              <div class="v2-oc-id">${isPreorder ? "🌙 " : ""}#${id6}${o.buyer_phone ? ' · ' + escape(o.buyer_phone.slice(-4)) : ''}</div>
              <div class="v2-oc-time">${escape(time)}</div>
            </div>
            <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap; justify-content:flex-end;">
              <span class="v2-oc-badge" style="background:${payStatusText === 'Paid' ? '#dcfce7' : payStatusText.includes('Refund') ? '#fee2e2' : '#f3f4f6'};color:${payStatusText === 'Paid' ? '#059669' : payStatusText.includes('Refund') ? '#dc2626' : 'var(--v2-ink-3)'};">${payStatusText}</span>
              <span class="v2-oc-badge ${badgeCls}">${badgeText}</span>
            </div>
          </div>
          <div class="v2-oc-items" style="text-transform:capitalize;">${escape(o.listing?.species || o.species || "")} · ${qtyLabel}</div>
          <div class="v2-oc-meta">
            <span class="v2-oc-meta-pill ${isPreorder ? "v2-oc-meta-pill-preorder" : "v2-oc-meta-pill-order"}">${isPreorder ? "Pre-order" : "Order"}</span>
            <span class="v2-oc-meta-pill ${isDelivery ? "v2-oc-meta-pill-delivery" : "v2-oc-meta-pill-pickup"}">${isDelivery ? "Delivery" : "Pickup"}</span>
          </div>
          ${o.cut_style ? `<div style="font:600 11px Inter;color:var(--v2-ink-2);margin-top:4px;">✂️ ${escape(o.cut_style.split(",").map((c: string) => ({whole:"Whole",cleaned:"Cleaned",cut:"Cut"})[c] || c).join(", "))}</div>` : ''}
          ${o.buyer_notes ? `<div style="font:400 11px Inter;color:var(--v2-ink-3);margin-top:2px;">📝 ${escape(o.buyer_notes)}</div>` : ''}
          ${buyerRatingHtml}
          <div class="v2-oc-total">₹${total.toLocaleString("en-IN")}</div>
          ${paymentMethodLabel(o) ? `<div style="font:500 11px Inter;color:var(--v2-ink-3);margin-top:2px;">${escape(paymentMethodLabel(o))}${o.razorpay_payment_id ? ` · Ref <span style="font-family:monospace;user-select:all;">${escape(o.razorpay_payment_id)}</span>` : ""}</div>` : ""}
          ${nextStepHint ? `<div class="v2-oc-next">${nextStepHint}</div>` : ""}
          ${actionsHtml}
        </div>`;
  }

  async function reconcileRazorpay(orderId: string, btn?: HTMLButtonElement) {
    if (!sellerId) return;
    const resultEl = document.getElementById(`reconcile-result-${orderId}`);
    if (btn) { btn.disabled = true; btn.textContent = "🔄 Checking Razorpay..."; }
    if (resultEl) resultEl.textContent = "";
    try {
      const res = await fetch("/api/seller/reconcile-razorpay", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ order_id: orderId, seller_id: sellerId, seller_phone: localStorage.getItem("rlf_seller_phone") || "" }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Reconcile failed");
      if (data.ok && (data.reconciled || data.already_confirmed)) {
        if (resultEl) { resultEl.style.color = "#15803d"; resultEl.textContent = data.already_confirmed ? "✓ Already confirmed" : "✓ Payment found — order confirmed"; }
        (window as any).v2Toast?.("success", "Reconciled", data.already_confirmed ? "Order was already confirmed" : `Payment ${data.payment_id} confirmed`);
        setTimeout(() => loadOrders(true), 800);
      } else {
        if (resultEl) { resultEl.style.color = "var(--v2-ink-3)"; resultEl.textContent = data.reason || "No captured payment on Razorpay yet"; }
      }
    } catch (err: any) {
      if (resultEl) { resultEl.style.color = "var(--v2-red)"; resultEl.textContent = `Failed: ${err.message}`; }
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = "🔄 Check Razorpay for payment"; }
    }
  }

  async function updateStatus(orderId: string, action: string, btn?: HTMLButtonElement) {
    if (!sellerId) return;
    if (!orderId) {
      (window as any).v2Toast?.("error", "Order action failed", "Missing order id on this action. Refresh and retry.");
      return;
    }
    // Actions that go directly to the API as action= (not status transitions)
    const apiActions = new Set(["set_final_price"]);
    const statusMap: Record<string, string> = {
      accept: "confirmed",
      decline: "declined",
      ready: "ready_for_pickup",
      out_for_delivery: "out_for_delivery",
      picked_up: "completed",
      delivered: "completed",
      seller_cancel: "cancelled",
    };
    let sellerCancelReason = "";
    if (action === "seller_cancel") {
      const r = window.prompt("Why are you cancelling? The buyer sees this reason and is refunded in full.", "");
      if (r === null) return;
      sellerCancelReason = r.trim();
      if (!sellerCancelReason) { (window as any).v2Toast?.("error", "Reason needed", "Tell the buyer why the order is cancelled"); return; }
    }
    const originalText = btn?.textContent || "";
    const loadingLabels: Record<string, string> = {
      accept: "Confirming…", decline: "Declining…", ready: "Updating…",
      out_for_delivery: "Updating…", picked_up: "Completing…", delivered: "Completing…",
      set_final_price: "Setting…", seller_cancel: "Cancelling…",
    };
    const successLabels: Record<string, string> = {
      accept: "Confirmed", decline: "Declined", ready: "Marked ready",
      out_for_delivery: "Out for delivery", picked_up: "Completed", delivered: "Delivered",
      set_final_price: "Price set", seller_cancel: "Cancelled",
    };
    if (btn) {
      btn.disabled = true;
      btn.textContent = loadingLabels[action] || "Updating…";
    }
    try {
      let body: Record<string, any> = { seller_id: sellerId, seller_phone: localStorage.getItem("rlf_seller_phone") || "", order_id: orderId };
      if (apiActions.has(action)) {
        body.action = action;
        if (action === "set_final_price") {
          const priceInput = document.getElementById(`final-price-${orderId}`) as HTMLInputElement | null;
          const finalPrice = parseFloat(priceInput?.value || "");
          if (isNaN(finalPrice) || finalPrice <= 0) {
            (window as any).v2Toast?.("error", "Invalid price", "Enter a valid final price");
            if (btn) { btn.disabled = false; btn.textContent = originalText; }
            return;
          }
          body.final_price = finalPrice;
        }
      } else {
        body.status = statusMap[action] || "declined";
        if (body.status === "declined" || body.status === "cancelled") {
          const declineNoteInput = document.getElementById(`decline-note-${orderId}`) as HTMLInputElement | null;
          const note = sellerCancelReason || declineNoteInput?.value?.trim();
          if (note) body.cancel_reason = note;
        }
      }
      const res = await fetch("/api/seller/orders", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Update failed");

      (window as any).v2Toast?.("success", successLabels[action] || "Updated", "Order status updated");
      // Auto-switch to tab where order now lives
      const tabForStatus: Record<string, string> = {
        confirmed: "accepted", paid: "accepted", ready_for_pickup: "accepted", out_for_delivery: "accepted",
        completed: "completed", declined: "completed", cancelled: "completed", refunded: "completed",
      };
      // For action-based calls, derive status from returned order or action semantics
      const resolvedStatus = data.order?.status ?? body.status;
      const targetTab = tabForStatus[resolvedStatus];
      if (targetTab && targetTab !== currentTab) {
        currentTab = targetTab as any;
        currentPage = 1;
        document.querySelectorAll(".v2-dash-tab").forEach(t => t.classList.remove("v2-dash-tab-active"));
        document.querySelector(`.v2-dash-tab[data-tab="${targetTab}"]`)?.classList.add("v2-dash-tab-active");
      }
      await loadOrders(false);
    } catch (err: any) {
      (window as any).v2Toast?.("error", "Failed", err.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }
  }

  // Tab switching
  document.querySelectorAll<HTMLButtonElement>(".v2-dash-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".v2-dash-tab").forEach(t => t.classList.remove("v2-dash-tab-active"));
      tab.classList.add("v2-dash-tab-active");
      currentTab = tab.dataset.tab as any;
      currentPage = 1;
      loadOrders();
    });
  });

  // Range filter
  document.getElementById("v2-dash-range")?.addEventListener("change", (e) => {
    currentRange = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    loadOrders();
  });

  // Order type filter (Order vs Pre-order)
  document.getElementById("v2-dash-type")?.addEventListener("change", (e) => {
    currentType = (e.target as HTMLSelectElement).value as any;
    currentPage = 1;
    loadOrders();
  });

  // Search by order ID or phone
  let searchTimer: any;
  document.getElementById("v2-dash-search")?.addEventListener("input", (e) => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      currentPage = 1;
      loadOrders();
    }, 400);
  });

  // CSV export — respects current range
  document.getElementById("v2-dash-export")?.addEventListener("click", (e) => {
    e.preventDefault();
    if (!sellerId) return;
    // fetch, not a link: the download must carry the seller session header.
    const url = `/api/seller/orders-export?seller_id=${encodeURIComponent(sellerId)}&date_filter=${encodeURIComponent(currentRange)}`;
    fetch(url).then(async (res) => {
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || "Export failed");
      const a = document.createElement("a");
      a.href = URL.createObjectURL(await res.blob());
      a.download = `relifish-orders-${currentRange}.csv`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 5000);
    }).catch((err) => (window as any).v2Toast?.("error", "Export failed", err.message));
  });

  // Wire empty-state CTAs (Refresh status + Sign out on pending activation page)
  document.querySelectorAll<HTMLElement>(".v2-empty-ghost").forEach((el) => {
    if (el.textContent?.includes("Sign out")) {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        try {
          localStorage.removeItem("rlf_seller_id"); localStorage.removeItem("rlf_session_seller");
          localStorage.removeItem("rlf_seller_phone");
        } catch {}
        window.location.href = "/dashboard/login";
      });
    }
  });
  // "Refresh status" button = reload
  const refreshBtn = document.getElementById("v2-dash-not-active")?.querySelector(".v2-btn");
  refreshBtn?.addEventListener("click", () => location.reload());

  // Stats panel toggle (hidden by default)
  document.getElementById("v2-stats-toggle")?.addEventListener("click", () => {
    const panel = document.getElementById("v2-dash-stats-panel")!;
    const btn = document.getElementById("v2-stats-toggle")!;
    const open = panel.style.display !== "none";
    panel.style.display = open ? "none" : "block";
    btn.textContent = open ? "Stats ▼" : "Stats ▲";
  });

  init();
</script>
