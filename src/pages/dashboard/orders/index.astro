---
export const prerender = false;

import Header from "../../../components/Header.astro";
import DashboardGate from "../../../components/DashboardGate.astro";
import SellerActiveGate from "../../../components/SellerActiveGate.astro";
import SellerBottomNav from "../../../components/SellerBottomNav.astro";
import "../../../styles/global.css";

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "reslifih";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066cc" />
    <title>{`Orders - ${brandName}`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body class="seller-dash">
    <DashboardGate />
    <SellerActiveGate />
    <Header showDashboardLink={false} />

    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>

    <!-- Toast -->
    <div id="toast" style="display:none;position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,0.15);transition:opacity 0.3s;"></div>

    <!-- Loading skeleton -->
    <div id="dash-loading" style="padding:16px;">
      <div class="skeleton" style="height:32px;width:160px;border-radius:8px;margin-bottom:16px;"></div>
      <div class="skeleton" style="height:40px;border-radius:8px;margin-bottom:16px;"></div>
      <div class="skeleton" style="height:120px;border-radius:8px;margin-bottom:12px;"></div>
      <div class="skeleton" style="height:120px;border-radius:8px;"></div>
    </div>

    <main id="dash-main" style="display:none;">
      <div class="dash-toolbar-card">
        <div class="dash-toolbar-row">
          <div class="dash-toolbar-title">Date range</div>
          <label class="stats-toggle-label">
            <span>Show dashboard stats</span>
            <span class="stats-toggle-shell">
              <input type="checkbox" id="seller-stats-toggle" />
              <span id="stats-toggle-track" class="stats-toggle-track"></span>
              <span id="stats-toggle-knob" class="stats-toggle-knob"></span>
            </span>
          </label>
        </div>
        <div class="global-date-row">
          <select id="global-date-preset" class="filter-select filter-select-wide" aria-label="Date range preset">
            <option value="all">All time</option>
            <option value="today">Today</option>
            <option value="7d">Last 7 days</option>
            <option value="30d">Last 30 days (~1 month)</option>
            <option value="1y">Last year</option>
            <option value="custom">Custom range</option>
          </select>
          <div id="global-date-custom" class="global-date-custom" style="display:none;">
            <input type="date" id="global-date-from" aria-label="From date" class="date-input" />
            <span class="text-muted global-date-to-label">to</span>
            <input type="date" id="global-date-to" aria-label="To date" class="date-input" />
          </div>
        </div>
        <p id="stats-range-hint" class="text-muted stats-range-hint"></p>

        <div id="seller-stats-panel" class="seller-stats-panel" style="display:none;">
          <h3 class="stats-section-title">Fresh orders</h3>
          <div id="seller-stats-fresh" class="stats-grid"></div>
          <h3 class="stats-section-title stats-section-title-pre">Pre-order queue</h3>
          <div id="seller-stats-pre" class="stats-grid stats-grid-pre"></div>
        </div>
      </div>

      <!-- Tabs: Fresh / Pre-orders -->
      <div class="tabs">
        <button class="tab active" data-tab="fresh-orders">Fresh Orders <span id="fresh-count" class="tab-count"></span></button>
        <button class="tab" data-tab="pre-orders">Pre-orders <span id="pre-count" class="tab-count"></span></button>
      </div>

      <div id="tab-fresh-orders">
        <div class="order-filters">
          <select id="fresh-status-filter" class="filter-select filter-select-grow">
            <option value="all">All statuses</option>
            <option value="pending">Pending</option>
            <option value="confirmed">Confirmed</option>
            <option value="paid">Paid</option>
            <option value="picked_up">Picked up</option>
            <option value="completed">Completed</option>
            <option value="declined">Declined</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
        <div id="fresh-orders-list"></div>
        <div id="fresh-pagination" class="pagination"></div>
      </div>

      <div id="tab-pre-orders" style="display:none;">
        <div class="order-filters">
          <select id="pre-status-filter" class="filter-select filter-select-grow">
            <option value="all">All statuses</option>
            <option value="pre_order">Awaiting</option>
            <option value="confirmed">Confirmed</option>
            <option value="cancelled">Cancelled</option>
            <option value="refunded">Refunded</option>
          </select>
        </div>
        <div id="pre-orders-list"></div>
        <div id="pre-pagination" class="pagination"></div>
      </div>
    </main>

    <script>
      import { getSession, signOut } from "../../../lib/seller-auth";
      import {
        getSellerById,
        getFreshOrdersForSellerPage,
        getPreOrdersForSellerPage,
        getSellerOrderTabCounts,
        getSellerOrdersDashboardStats,
        updateOrderStatus,
      } from "../../../lib/supabase";
      import { SELLER_ORDERS_PAGE_SIZE } from "../../../lib/seller-orders-pagination";
      import { getSpeciesDisplay } from "../../../lib/species";
      import type { Seller, Order } from "../../../lib/supabase";

      function showToast(message: string, type: "success" | "error" = "success") {
        const toast = document.getElementById("toast")!;
        toast.textContent = message;
        toast.style.display = "block";
        toast.style.opacity = "1";
        toast.style.background = type === "success" ? "var(--green)" : "var(--red)";
        toast.style.color = "white";
        setTimeout(() => {
          toast.style.opacity = "0";
          setTimeout(() => { toast.style.display = "none"; }, 300);
        }, 3000);
      }

      const STATS_TOGGLE_LS = "da_nang_seller_orders_show_stats";

      let freshPage = 1;
      let prePage = 1;
      let _sellerId = "";
      /** Avoid duplicate fetches when clicking the already-selected tab. */
      let activeOrdersTab: "fresh-orders" | "pre-orders" = "fresh-orders";

      function getDateFilterPayload(): {
        dateFilter: string;
        customDateFrom?: string;
        customDateTo?: string;
      } {
        const preset = (document.getElementById("global-date-preset") as HTMLSelectElement).value;
        const fromEl = document.getElementById("global-date-from") as HTMLInputElement;
        const toEl = document.getElementById("global-date-to") as HTMLInputElement;
        if (preset === "custom") {
          return {
            dateFilter: "custom",
            customDateFrom: fromEl.value || undefined,
            customDateTo: toEl.value || undefined,
          };
        }
        return { dateFilter: preset };
      }

      function updateCustomDateVisibility() {
        const preset = (document.getElementById("global-date-preset") as HTMLSelectElement).value;
        const row = document.getElementById("global-date-custom")!;
        row.style.display = preset === "custom" ? "flex" : "none";
      }

      function updateStatsToggleUI(on: boolean) {
        const track = document.getElementById("stats-toggle-track")!;
        const knob = document.getElementById("stats-toggle-knob")!;
        track.style.background = on ? "var(--green)" : "var(--gray-200)";
        knob.style.transform = on ? "translateX(18px)" : "translateX(0)";
      }

      function isStatsVisible(): boolean {
        return (document.getElementById("seller-stats-toggle") as HTMLInputElement).checked;
      }

      function formatRangeHint(preset: string, from: string, to: string): string {
        if (preset === "all") return "Showing all time.";
        if (preset === "today") return "Showing orders from today (local time).";
        if (preset === "7d") return "Showing orders from the last 7 days.";
        if (preset === "30d") return "Showing orders from the last 30 days.";
        if (preset === "1y") return "Showing orders from the last 365 days.";
        if (preset === "custom" && (from || to)) {
          return `Custom: ${from || "…"} → ${to || "…"}`;
        }
        if (preset === "custom") return "Pick from/to dates for a custom range.";
        return "";
      }

      function statCard(label: string, value: number, tone: "default" | "blue" | "green" | "red" | "orange" = "default") {
        const toneClass =
          tone === "blue"
            ? "stat-card--blue"
            : tone === "green"
              ? "stat-card--green"
              : tone === "red"
                ? "stat-card--red"
                : tone === "orange"
                  ? "stat-card--orange"
                  : "";
        return `<div class="stat-card ${toneClass}"><div class="stat-card-value">${value}</div><div class="stat-card-label">${label}</div></div>`;
      }

      async function renderStats() {
        if (!_sellerId || !isStatsVisible()) return;
        const { dateFilter, customDateFrom, customDateTo } = getDateFilterPayload();
        try {
          const s = await getSellerOrdersDashboardStats(_sellerId, {
            dateFilter,
            customDateFrom,
            customDateTo,
          });
          const f = s.fresh;
          const fulfilled = f.picked_up + f.completed;
          document.getElementById("seller-stats-fresh")!.innerHTML = [
            statCard("Pending", f.pending, "blue"),
            statCard("Confirmed", f.confirmed, "default"),
            statCard("Paid", f.paid, "default"),
            statCard("Fulfilled", fulfilled, "green"),
            statCard("Declined", f.declined, "red"),
            statCard("Cancelled", f.cancelled, "orange"),
            statCard("Total (fresh)", f.total, "default"),
          ].join("");

          const p = s.pre;
          document.getElementById("seller-stats-pre")!.innerHTML = [
            statCard("Awaiting", p.awaiting, "orange"),
            statCard("Confirmed", p.confirmed, "default"),
            statCard("Cancelled", p.cancelled, "red"),
            statCard("Refunded", p.refunded, "default"),
          ].join("");
        } catch (e) {
          console.error("Stats:", e);
        }
      }

      function renderPaginationControls(containerId: string, total: number, page: number, onPage: (p: number) => void) {
        const el = document.getElementById(containerId)!;
        const totalPages = Math.max(1, Math.ceil(total / SELLER_ORDERS_PAGE_SIZE));
        if (total <= SELLER_ORDERS_PAGE_SIZE) { el.innerHTML = ""; return; }
        el.innerHTML = `
          <button class="pg-prev" ${page <= 1 ? "disabled" : ""}>← Prev</button>
          <span class="page-info">${page} / ${totalPages}</span>
          <button class="pg-next" ${page >= totalPages ? "disabled" : ""}>Next →</button>
        `;
        el.querySelector(".pg-prev")?.addEventListener("click", () => { if (page > 1) onPage(page - 1); });
        el.querySelector(".pg-next")?.addEventListener("click", () => { if (page < totalPages) onPage(page + 1); });
      }

      async function updateTabCounts() {
        if (!_sellerId) return;
        try {
          const { pendingFresh, preAwaiting } = await getSellerOrderTabCounts(_sellerId);
          const freshEl = document.getElementById("fresh-count")!;
          const preEl = document.getElementById("pre-count")!;
          freshEl.textContent = pendingFresh > 0 ? String(pendingFresh) : "";
          freshEl.style.display = pendingFresh > 0 ? "inline-flex" : "none";
          preEl.textContent = preAwaiting > 0 ? String(preAwaiting) : "";
          preEl.style.display = preAwaiting > 0 ? "inline-flex" : "none";
        } catch (e) {
          console.error("Tab counts:", e);
        }
      }

      async function renderFresh() {
        if (!_sellerId) return;
        const statusFilter = (document.getElementById("fresh-status-filter") as HTMLSelectElement).value;
        const { dateFilter, customDateFrom, customDateTo } = getDateFilterPayload();
        try {
          const { orders, total } = await getFreshOrdersForSellerPage(_sellerId, {
            page: freshPage,
            pageSize: SELLER_ORDERS_PAGE_SIZE,
            statusFilter,
            dateFilter,
            customDateFrom,
            customDateTo,
          });
          renderOrders(orders, "fresh-orders-list", _sellerId);
          renderPaginationControls("fresh-pagination", total, freshPage, (p) => {
            freshPage = p;
            void renderFresh();
          });
        } catch (e) {
          console.error("Fresh orders:", e);
        }
      }

      async function renderPre() {
        if (!_sellerId) return;
        const statusFilter = (document.getElementById("pre-status-filter") as HTMLSelectElement).value;
        const { dateFilter, customDateFrom, customDateTo } = getDateFilterPayload();
        try {
          const { orders, total } = await getPreOrdersForSellerPage(_sellerId, {
            page: prePage,
            pageSize: SELLER_ORDERS_PAGE_SIZE,
            statusFilter,
            dateFilter,
            customDateFrom,
            customDateTo,
          });
          renderOrders(orders, "pre-orders-list", _sellerId);
          renderPaginationControls("pre-pagination", total, prePage, (p) => {
            prePage = p;
            void renderPre();
          });
        } catch (e) {
          console.error("Pre-orders:", e);
        }
      }

      async function refreshOrders(sellerId: string) {
        _sellerId = sellerId;
        await Promise.all([renderFresh(), renderPre(), updateTabCounts(), renderStats()]);
      }

      async function init() {
        const session = getSession();
        if (!session) {
          window.location.href = "/dashboard/login";
          return;
        }

        let seller: Seller;
        try {
          seller = await getSellerById(session.seller_id);
        } catch (err: any) {
          console.error("Orders load error:", err);
          signOut();
          window.location.href = "/dashboard/login";
          return;
        }

        // Tabs — refetch only when switching tabs (not on re-clicking the active tab).
        // Tab badges refresh on load and after order actions (refreshOrders); skipping counts here
        // avoids 3 extra Supabase calls on every switch (getSellerOrderTabCounts duplicates listing fetch).
        const tabs = document.querySelectorAll(".tab");
        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            const tabName = (tab as HTMLElement).dataset.tab as "fresh-orders" | "pre-orders";
            if (tabName === activeOrdersTab) return;
            activeOrdersTab = tabName;
            tabs.forEach((t) => t.classList.remove("active"));
            tab.classList.add("active");
            document.getElementById("tab-fresh-orders")!.style.display = tabName === "fresh-orders" ? "block" : "none";
            document.getElementById("tab-pre-orders")!.style.display = tabName === "pre-orders" ? "block" : "none";
            if (tabName === "fresh-orders") {
              void renderFresh();
            } else {
              void renderPre();
            }
          });
        });

        _sellerId = seller.id;

        const statsToggle = document.getElementById("seller-stats-toggle") as HTMLInputElement;
        const statsPanel = document.getElementById("seller-stats-panel")!;
        const hintEl = document.getElementById("stats-range-hint")!;
        try {
          const saved = localStorage.getItem(STATS_TOGGLE_LS);
          statsToggle.checked = saved === null ? true : saved === "1";
        } catch {
          statsToggle.checked = true;
        }
        updateStatsToggleUI(statsToggle.checked);
        statsPanel.style.display = statsToggle.checked ? "block" : "none";

        statsToggle.addEventListener("change", () => {
          const on = statsToggle.checked;
          try {
            localStorage.setItem(STATS_TOGGLE_LS, on ? "1" : "0");
          } catch {
            /* ignore */
          }
          updateStatsToggleUI(on);
          statsPanel.style.display = on ? "block" : "none";
          if (on) void renderStats();
        });

        function refreshDateHint() {
          const preset = (document.getElementById("global-date-preset") as HTMLSelectElement).value;
          const from = (document.getElementById("global-date-from") as HTMLInputElement).value;
          const to = (document.getElementById("global-date-to") as HTMLInputElement).value;
          hintEl.textContent = formatRangeHint(preset, from, to);
        }

        const onGlobalDateChange = () => {
          updateCustomDateVisibility();
          refreshDateHint();
          freshPage = 1;
          prePage = 1;
          void Promise.all([renderFresh(), renderPre(), renderStats()]);
        };

        document.getElementById("global-date-preset")!.addEventListener("change", onGlobalDateChange);
        document.getElementById("global-date-from")!.addEventListener("change", onGlobalDateChange);
        document.getElementById("global-date-to")!.addEventListener("change", onGlobalDateChange);

        updateCustomDateVisibility();
        refreshDateHint();

        // Fresh tab is default; pre-orders load on first switch (tab handler calls renderPre)
        await Promise.all([renderFresh(), updateTabCounts(), renderStats()]);

        // Filters
        document.getElementById("fresh-status-filter")!.addEventListener("change", () => {
          freshPage = 1;
          void renderFresh();
        });
        document.getElementById("pre-status-filter")!.addEventListener("change", () => {
          prePage = 1;
          void renderPre();
        });

        // Show content
        requestAnimationFrame(() => {
          document.getElementById("dash-loading")!.style.display = "none";
          const main = document.getElementById("dash-main")!;
          main.style.display = "block";
          main.classList.add("fade-in");
        });
      }

      function renderOrders(orders: Order[], containerId: string, sellerId?: string) {
        const el = document.getElementById(containerId)!;
        if (orders.length === 0) {
          el.innerHTML = '<p class="text-muted">No orders yet.</p>';
          return;
        }

        el.innerHTML = orders
          .map((o) => {
            const name = o.species ? getSpeciesDisplay(o.species) : "Unknown";
            const unitLabel = o.quantity_unit === "dozen" ? "dz" : o.quantity_unit;
            const isPreOrder = o.status === "pre_order";
            const canAct = o.status === "pre_order" || o.status === "pending";

            const statusColors: Record<string, string> = {
              pre_order: "badge-orange",
              pending: "badge-blue",
              confirmed: "badge-green",
              paid: "badge-green",
              picked_up: "badge-green",
              completed: "badge-green",
              declined: "badge-red",
              cancelled: "badge-red",
              refunded: "badge-orange",
            };

            return `
              <div class="card" style="margin-bottom:12px;" data-order-id="${o.id}">
                <div class="card-body">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
                    <div>
                      <h4 style="font-size:16px;font-weight:700;">${name}</h4>
                      <span class="text-muted">${o.quantity} ${unitLabel}${isPreOrder ? " (pre-order)" : ""}</span>
                    </div>
                    <span class="badge ${statusColors[o.status] || "badge-blue"}">${o.status.replace("_", " ")}</span>
                  </div>
                  <div style="display:flex;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--gray-700);margin-bottom:8px;">
                    <span>📱 ${o.buyer_phone}</span>
                    ${o.buyer_addr ? `<span>📍 ${o.buyer_addr}</span>` : ""}
                    <span>🛒 ${o.order_type}</span>
                  </div>
                  ${(() => {
                    const df = Number(o.delivery_fee) || 0;
                    const sub = o.total_price;
                    if (df > 0) {
                      return `<div style="font-size:14px;margin-bottom:8px;">💰 Items <strong>₹${sub}</strong> + delivery <strong>₹${df}</strong> → <strong>₹${sub + df}</strong></div>`;
                    }
                    return `<div style="font-size:14px;margin-bottom:8px;">💰 <strong>₹${sub}</strong></div>`;
                  })()}
                  ${isPreOrder && o.paid_amount ? `<div style="background:#fff3cd;padding:8px 12px;border-radius:var(--radius);font-size:13px;margin-bottom:8px;">Buyer paid upfront: <strong>₹${o.paid_amount}</strong> <span class="text-muted">(max range)</span></div>` : ""}
                  ${
                    canAct
                      ? isPreOrder
                        ? `
                          <div>
                            <div class="form-group" style="margin-bottom:8px;">
                              <label>Actual Price (₹/${unitLabel})</label>
                              <input type="number" class="final-price-input" data-order-id="${o.id}" min="1" step="0.01" placeholder="Enter actual price" style="max-width:200px;" />
                            </div>
                            <div style="display:flex;gap:8px;">
                              <button class="btn btn-green confirm-preorder-btn" data-order-id="${o.id}" style="padding:6px 16px;font-size:13px;">Confirm with Price</button>
                              <button class="btn btn-red cancel-order-btn" data-order-id="${o.id}" style="padding:6px 16px;font-size:13px;">Cancel (Full Refund)</button>
                            </div>
                          </div>
                        `
                        : `
                          <div style="display:flex;gap:8px;">
                            <button class="btn btn-green confirm-order-btn" data-order-id="${o.id}" style="padding:6px 16px;font-size:13px;">Confirm</button>
                            <button class="btn btn-red decline-order-btn" data-order-id="${o.id}" style="padding:6px 16px;font-size:13px;">Decline</button>
                          </div>
                        `
                      : ""
                  }
                  ${o.final_price ? `<div style="font-size:14px;padding:8px 12px;background:#d4edda;border-radius:var(--radius);margin-top:8px;">Final: <strong>₹${o.final_price}/${unitLabel}</strong>${o.refund_amt && o.refund_amt > 0 ? ` <span style="color:var(--orange);font-size:12px;">(₹${o.refund_amt} refunded)</span>` : ""}</div>` : ""}
                </div>
              </div>
            `;
          })
          .join("");

        function setBtnLoading(b: HTMLElement, loading: boolean, text: string) {
          (b as HTMLButtonElement).disabled = loading;
          b.textContent = loading ? "Processing..." : text;
          b.style.opacity = loading ? "0.6" : "1";
        }

        el.querySelectorAll(".confirm-order-btn").forEach((btn) => {
          btn.addEventListener("click", async (e) => {
            const b = e.target as HTMLElement;
            const orderId = b.dataset.orderId!;
            setBtnLoading(b, true, "Confirm");
            try {
              await updateOrderStatus(orderId, "confirmed", undefined, sellerId);
              showToast("Order confirmed!");
              if (sellerId) await refreshOrders(sellerId);
            } catch (err: any) {
              showToast(err.message || "Failed to confirm", "error");
              setBtnLoading(b, false, "Confirm");
            }
          });
        });

        el.querySelectorAll(".decline-order-btn").forEach((btn) => {
          btn.addEventListener("click", async (e) => {
            const b = e.target as HTMLElement;
            const orderId = b.dataset.orderId!;
            setBtnLoading(b, true, "Decline");
            try {
              await updateOrderStatus(orderId, "declined", undefined, sellerId);
              showToast("Order declined");
              if (sellerId) await refreshOrders(sellerId);
            } catch (err: any) {
              showToast(err.message || "Failed to decline", "error");
              setBtnLoading(b, false, "Decline");
            }
          });
        });

        el.querySelectorAll(".confirm-preorder-btn").forEach((btn) => {
          btn.addEventListener("click", async (e) => {
            const b = e.target as HTMLElement;
            const orderId = b.dataset.orderId!;
            const input = el.querySelector(`.final-price-input[data-order-id="${orderId}"]`) as HTMLInputElement;
            const finalPrice = parseFloat(input?.value || "0");
            if (!finalPrice || finalPrice <= 0) {
              showToast("Please enter the actual price", "error");
              return;
            }
            setBtnLoading(b, true, "Confirm with Price");
            try {
              await updateOrderStatus(orderId, "confirmed", finalPrice, sellerId);
              showToast("Pre-order confirmed with price!");
              if (sellerId) await refreshOrders(sellerId);
            } catch (err: any) {
              showToast(err.message || "Failed to confirm", "error");
              setBtnLoading(b, false, "Confirm with Price");
            }
          });
        });

        el.querySelectorAll(".cancel-order-btn").forEach((btn) => {
          btn.addEventListener("click", async (e) => {
            const b = e.target as HTMLElement;
            const orderId = b.dataset.orderId!;
            if (confirm("Cancel this pre-order? Buyer will get a full refund.")) {
              setBtnLoading(b, true, "Cancel (Full Refund)");
              try {
                await updateOrderStatus(orderId, "cancelled", undefined, sellerId);
                showToast("Pre-order cancelled, buyer will be refunded");
                if (sellerId) await refreshOrders(sellerId);
              } catch (err: any) {
                showToast(err.message || "Failed to cancel", "error");
                setBtnLoading(b, false, "Cancel (Full Refund)");
              }
            }
          });
        });
      }

      void init();
    </script>

    <style is:global>
      .dash-toolbar-card {
