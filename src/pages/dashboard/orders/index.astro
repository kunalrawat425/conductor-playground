                  <div style="font:600 11px Inter;color:#7C3AED;">Next step unlocks only after final price is set.</div>
                </div>`;
              })()
            : "";
          if (needsFinalPrice) {
            actionsHtml = preorderPriceBlock;
          } else {
            const proofAfterPrice = paymentProofHtml(o.id, o.payment_screenshot_urls, "Payment proof on file");
            const fulfill = isDelivery
              ? `<div class="v2-oc-actions">
                  <button class="v2-btn v2-btn-sm" style="flex:1;background:var(--v2-brand);color:#fff;" data-action="out_for_delivery" data-order-id="${o.id}">🚲 Out for delivery</button>
