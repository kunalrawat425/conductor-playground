---
export const prerender = false;
import AppShell from "../../../components/ui/AppShell.astro";
import Toast from "../../../components/ui/atoms/Toast.astro";
import EmptyState from "../../../components/ui/molecules/EmptyState.astro";
---
<AppShell
  title="Inventory · Seller Dashboard"
  description="Manage your fish inventory"
  header={{ variant: "page", title: "My inventory", backHref: "/dashboard/orders" }}
  nav={{ active: "listings" as any, mode: "seller" }}
>
  <Toast />

  <div style="padding:16px;">
    <a href="/dashboard/listings/new" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full" style="margin-bottom:16px;">
      + Add new listing
    </a>

    <div id="v2-listings-loading" style="text-align:center;padding:24px;color:var(--v2-ink-3);font:500 12px Inter;">
      <span class="v2-spinner v2-spinner-md"></span>
      <div style="margin-top:8px;">Loading listings...</div>
    </div>

    <p id="v2-listings-order-hint" style="display:none;font:500 12px Inter;color:var(--v2-ink-3);margin:0 0 10px;">Use the up and down arrows to set the order buyers see on your menu.</p>
    <div id="v2-listings-list" style="display:none;"></div>

    <div id="v2-listings-empty" style="display:none;">
      <EmptyState
        variant="no-orders"
        title="No inventory yet"
        description="Add your first fish item to start receiving orders."
        ctaText="Add item"
        ctaHref="/dashboard/listings/new"
      />
    </div>
  </div>
</AppShell>

<script>
  import { supabase } from "../../../lib/supabase";
  import { getSpeciesDisplay } from "../../../lib/species";
  import { resizedImageUrl } from "../../../lib/seller-display";

  function getSellerId() { try { return localStorage.getItem("rlf_seller_id"); } catch { return null; } }
  function escape(s: string) { return String(s||"").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!)); }

  const PAGE_SIZE = 10;
  let currentPage = 1;
  let _listings: any[] = [];

  async function load() {
    const sellerId = getSellerId();
    const loading = document.getElementById("v2-listings-loading")!;
    const list = document.getElementById("v2-listings-list")!;
    const empty = document.getElementById("v2-listings-empty")!;

    if (!sellerId) { window.location.replace("/dashboard/login"); return; }

    try {
      const offset = (currentPage - 1) * PAGE_SIZE;
      // Same order buyers see (lib/menu-order): sort_order, unset last, then oldest first.
      // Before migration 082 there is no sort_order column, so retry without it.
      let bySortOrder = true;
      const baseQ = () => {
        let q = supabase.from("fish_listings").select("*", { count: "exact" }).eq("seller_id", sellerId);
        if (bySortOrder) q = q.order("sort_order", { ascending: true, nullsFirst: false });
        return q.order("created_at", { ascending: true });
      };
      let r1 = await baseQ().is("deleted_at", null).range(offset, offset + PAGE_SIZE - 1);
      if (r1.error?.message?.includes("sort_order")) {
        bySortOrder = false;
        r1 = await baseQ().is("deleted_at", null).range(offset, offset + PAGE_SIZE - 1);
      }
      let listings: any[] = [];
      let error: any = null;
      let totalCount = 0;
      if (r1.error && r1.error.message?.includes("deleted_at")) {
        const r2 = await baseQ().range(offset, offset + PAGE_SIZE - 1);
        listings = r2.data || [];
        error = r2.error;
        totalCount = r2.count || 0;
      } else {
        listings = r1.data || [];
        error = r1.error;
        totalCount = r1.count || 0;
      }

      loading.style.display = "none";
      if (error) throw error;
      if (!listings || listings.length === 0) {
        if (currentPage === 1) { empty.style.display = "block"; return; }
        currentPage = 1; load(); return;
      }
      empty.style.display = "none";

      _listings = listings;
      const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
      // Lucide icons (lucide.dev, ISC), inline so no icon package is needed.
      const icon = (paths: string) => `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
      const ICON = {
        up: icon(`<path d="m18 15-6-6-6 6"/>`),
        down: icon(`<path d="m6 9 6 6 6-6"/>`),
        edit: icon(`<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/>`),
        pause: icon(`<rect x="14" y="3" width="5" height="18" rx="1"/><rect x="5" y="3" width="5" height="18" rx="1"/>`),
        play: icon(`<path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/>`),
        trash: icon(`<path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>`),
      };
      // "500 g", "kg", "3 pc", "pc" — the amount one pack holds.
      const packSize = (o: any) => {
        const bs = Number(o.bundle_size) || 1;
        if (o.unit === "kg") return bs < 1 ? `${Math.round(bs * 1000)} g` : bs === 1 ? "kg" : `${bs} kg`;
        return bs === 1 ? "pc" : `${bs} pc`;
      };
      const _delIcon = ICON.trash + "<span>Delete</span>";

      function renderCard(l: any): string {
        const opts: any[] = l.pricing_options || [];
        const unit = (opts[0] || {}).unit || "piece";
        const stock = Number(l.weight_avail) || 0;
        const unitLabel = unit === "kg" ? "kg" : "pc";
        // Headline = cheapest pack, same as buyers see.
        const head = opts.reduce((m: any, o: any) => (!m || Number(o.price) < Number(m.price) ? o : m), null);
        const price = head ? `₹${Number(head.price) || 0} / ${packSize(head)}` : "No price set";
        const packList = opts.map((o) => `₹${Number(o.price) || 0} · ${packSize(o)}`).join(", ");
        const emoji = (l.species || "").includes("prawn") ? "🦐" : (l.species || "").includes("crab") ? "🦀" : (l.species || "").includes("squid") ? "🦑" : "🐟";
        const status = !l.is_available ? `<span class="v2-lc-pill v2-lc-pill-paused">Paused</span>`
          : l.is_order_paused ? `<span class="v2-lc-pill v2-lc-pill-paused">Orders paused</span>`
          : stock <= 0 ? `<span class="v2-lc-pill v2-lc-pill-out">Out of stock</span>`
          : `<span class="v2-lc-pill v2-lc-pill-live">Live</span>`;
        const meta = [
          status,
          l.is_preorder_enabled ? `<span class="v2-lc-pill v2-lc-pill-pre">Pre-order</span>` : "",
          `<span class="v2-lc-chip${stock <= 0 ? " v2-lc-chip-out" : ""}">${stock} ${unitLabel} in stock</span>`,
          opts.length > 1 ? `<span class="v2-lc-chip" title="${escape(packList)}">${opts.length} packs</span>` : "",
        ].join("");
        const fishSize = l.fish_size ? String(l.fish_size) : "";
        const note = l.size_label || (fishSize ? `${fishSize[0].toUpperCase()}${fishSize.slice(1)} size` : "");
        const pos = offset + _listings.indexOf(l);
        const name = getSpeciesDisplay(l.species);
        return `<div class="v2-listing-card${!l.is_available ? " v2-lc-paused" : ""}" data-listing-id="${l.id}">
          <div class="v2-lc-top">
            <div class="v2-lc-grip" role="group" aria-label="Menu position">
              <button class="v2-lc-move" data-move-id="${l.id}" data-move-dir="up" aria-label="Move ${escape(name)} up" ${pos <= 0 ? "disabled" : ""}>${ICON.up}</button>
              <button class="v2-lc-move" data-move-id="${l.id}" data-move-dir="down" aria-label="Move ${escape(name)} down" ${pos >= totalCount - 1 ? "disabled" : ""}>${ICON.down}</button>
            </div>
            <a href="/dashboard/listings/${l.id}" class="v2-lc-main">
              <div class="v2-lc-img">${l.photo_url ? `<img src="${escape(resizedImageUrl(l.photo_url, 160) || l.photo_url)}" alt="" loading="lazy">` : emoji}</div>
              <div class="v2-lc-info">
                <div class="v2-lc-name">${escape(name)}</div>
                ${note ? `<div class="v2-lc-note">${escape(note)}</div>` : ""}
                <div class="v2-lc-price">${escape(price)}</div>
                <div class="v2-lc-meta">${meta}</div>
              </div>
            </a>
          </div>
          <div class="v2-lc-actions">
            <a class="v2-lc-act" href="/dashboard/listings/${l.id}" aria-label="Edit ${escape(name)}">${ICON.edit}<span>Edit</span></a>
            <button class="v2-lc-act${l.is_available ? "" : " v2-lc-act-resume"}" data-toggle-id="${l.id}" data-toggle-state="${l.is_available}" aria-label="${l.is_available ? "Pause" : "Resume"} ${escape(name)}">${l.is_available ? `${ICON.pause}<span>Pause</span>` : `${ICON.play}<span>Resume</span>`}</button>
            <button class="v2-lc-act v2-lc-act-del" data-delete-id="${l.id}" data-delete-name="${escape(name)}" aria-label="Delete ${escape(name)}">${_delIcon}</button>
          </div>
        </div>`;
      }

      list.style.display = "block";
      document.getElementById("v2-listings-order-hint")!.style.display = totalCount > 1 ? "block" : "none";
      list.innerHTML = _listings.map(renderCard).join("")
        + (totalPages > 1 ? `
          <div class="v2-pagination" style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;gap:8px;">
            <button class="v2-pg-btn" id="v2-lst-prev" ${currentPage <= 1 ? 'disabled' : ''}>← Prev</button>
            <span style="font:500 12px Inter;color:var(--v2-ink-3);">Page ${currentPage} of ${totalPages}</span>
            <button class="v2-pg-btn" id="v2-lst-next" ${currentPage >= totalPages ? 'disabled' : ''}>Next →</button>
          </div>` : '');
      document.getElementById("v2-lst-prev")?.addEventListener("click", () => { if (currentPage > 1) { currentPage--; load(); } });
      document.getElementById("v2-lst-next")?.addEventListener("click", () => { if (currentPage < totalPages) { currentPage++; load(); } });

      function rerenderOne(lid: string) {
        const l = _listings.find((x) => x.id === lid);
        if (!l) return;
        const card = list.querySelector(`[data-listing-id="${lid}"]`);
        if (card) card.outerHTML = renderCard(l);
        wireCardActions();
      }

      function removeCard(lid: string) {
        _listings = _listings.filter((x) => x.id !== lid);
        const card = list.querySelector(`[data-listing-id="${lid}"]`);
        if (card) card.remove();
        if (_listings.length === 0) {
          list.style.display = "none";
          empty.style.display = "block";
        }
      }

      let moving = false;
      function wireCardActions() {
        list.querySelectorAll<HTMLButtonElement>("[data-move-id]").forEach((btn) => {
          btn.onclick = async () => {
            if (moving) return;
            const lid = btn.dataset.moveId!;
            const direction = btn.dataset.moveDir as "up" | "down";
            const i = _listings.findIndex((x) => x.id === lid);
            const j = direction === "up" ? i - 1 : i + 1;
            // Neighbour on this page: swap now so the seller sees it instantly.
            // Crossing a page edge: the reload after saving shows it.
            if (i >= 0 && j >= 0 && j < _listings.length) {
              const other = _listings[j];
              [_listings[i], _listings[j]] = [_listings[j], _listings[i]];
              const a = list.querySelector(`[data-listing-id="${lid}"]`);
              const b = list.querySelector(`[data-listing-id="${other.id}"]`);
              if (a && b) direction === "up" ? b.before(a) : b.after(a);
              rerenderOne(lid);
              rerenderOne(other.id);
            }
            moving = true;
            try {
              const res = await fetch("/api/seller/listings", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "move", seller_id: sellerId, seller_phone: localStorage.getItem("rlf_seller_phone") || "", listing_id: lid, direction }),
              });
              const data = await res.json();
              if (!res.ok) throw new Error(data.error || "Could not move");
              if (j < 0 || j >= _listings.length) load();
            } catch (err: any) {
              (window as any).v2Toast?.("error", "Order not saved", err.message);
              load();
            } finally {
              moving = false;
            }
          };
        });
        list.querySelectorAll<HTMLButtonElement>("[data-toggle-id]").forEach((btn) => {
          btn.onclick = async () => {
            const lid = btn.dataset.toggleId!;
            const l = _listings.find((x) => x.id === lid);
            if (!l) return;
            const prev = !!l.is_available;
            const next = !prev;
            // Optimistic flip
            l.is_available = next;
            rerenderOne(lid);
            try {
              const res = await fetch("/api/seller/listings", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "update", seller_id: sellerId, seller_phone: localStorage.getItem("rlf_seller_phone") || "", listing_id: lid, updates: { is_available: next } }),
              });
              const data = await res.json();
              if (!res.ok) throw new Error(data.error || "Failed");
              (window as any).v2Toast?.("success", next ? "Listing live" : "Paused", "Buyers will see updated state");
            } catch (err: any) {
              // Rollback
              l.is_available = prev;
              rerenderOne(lid);
              (window as any).v2Toast?.("error", "Failed", err.message);
            }
          };
        });
        list.querySelectorAll<HTMLButtonElement>("[data-delete-id]").forEach((btn) => {
          btn.onclick = async () => {
            const lid = btn.dataset.deleteId!;
            const name = btn.dataset.deleteName!;
            if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;
            btn.disabled = true;
            btn.innerHTML = "<span>Deleting…</span>";
            try {
              const res = await fetch("/api/seller/listings", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "delete", seller_id: sellerId, seller_phone: localStorage.getItem("rlf_seller_phone") || "", listing_id: lid }),
              });
              const data = await res.json();
              if (!res.ok) throw new Error(data.error || "Delete failed");
              removeCard(lid);
              (window as any).v2Toast?.("success", "Deleted", `${name} removed from your menu`);
            } catch (err: any) {
              btn.disabled = false;
              btn.innerHTML = _delIcon;
              (window as any).v2Toast?.("error", "Delete failed", err.message);
            }
          };
        });
      }
      wireCardActions();
    } catch (err: any) {
      loading.innerHTML = `<div style="color:var(--v2-red);">Failed to load: ${escape(err.message)}</div>`;
    }
  }
  load();
</script>

<style is:global>
  /* Inventory card: compact up/down column + photo + full name, size note, price, status;
     labelled actions along the bottom. */
  .v2-listing-card {
    --lc-amber: color-mix(in srgb, var(--v2-orange) 82%, #000);
    --lc-red: var(--v2-red);
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius);
    margin-bottom: 12px;
    overflow: hidden;
  }
  :root[data-theme="dark"] .v2-listing-card { --lc-amber: var(--v2-orange); --lc-red: color-mix(in srgb, var(--v2-red) 70%, #fff); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .v2-listing-card { --lc-amber: var(--v2-orange); --lc-red: color-mix(in srgb, var(--v2-red) 70%, #fff); }
  }
  .v2-lc-top { display: flex; align-items: flex-start; gap: 4px; padding: 10px 12px 10px 4px; }
  .v2-lc-paused .v2-lc-main { opacity: .6; }
  .v2-lc-grip { display: flex; flex-direction: column; flex-shrink: 0; }
  .v2-lc-move {
    width: 32px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    background: transparent; color: var(--v2-ink-2);
    border: none; border-radius: 8px; padding: 0; cursor: pointer;
  }
  .v2-lc-move:hover:not(:disabled) { background: var(--v2-bg-3); }
  .v2-lc-move:disabled { opacity: .25; cursor: default; }
  .v2-lc-main { flex: 1; min-width: 0; display: flex; gap: 12px; align-items: flex-start; text-decoration: none; color: inherit; }
  .v2-lc-img {
    width: 60px; height: 60px; border-radius: 12px;
    background: var(--v2-bg-3);
    display: flex; align-items: center; justify-content: center;
    font-size: 26px; flex-shrink: 0; overflow: hidden;
  }
  .v2-lc-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .v2-lc-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .v2-lc-name, .v2-lc-note { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: break-word; }
  .v2-lc-name { font: 700 15px/1.3 Inter; color: var(--v2-ink); }
  .v2-lc-note { font: 500 12px/1.35 Inter; color: var(--v2-ink-3); }
  .v2-lc-price { font: 700 14px/1.3 Inter; color: var(--v2-ink); margin-top: 2px; }
  .v2-lc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .v2-lc-pill, .v2-lc-chip { font: 600 11px/1 Inter; padding: 5px 8px; border-radius: 999px; white-space: nowrap; }
  .v2-lc-pill-live { color: var(--v2-green); background: var(--v2-green-l); }
  .v2-lc-pill-paused { color: var(--lc-amber); background: var(--v2-orange-l); }
  .v2-lc-pill-out { color: var(--lc-red); background: var(--v2-red-l); }
  .v2-lc-pill-pre { color: var(--v2-indigo); background: var(--v2-indigo-l); }
  :root[data-theme="dark"] .v2-lc-pill-pre { color: var(--v2-ink); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .v2-lc-pill-pre { color: var(--v2-ink); } }
  .v2-lc-chip { color: var(--v2-ink-2); background: var(--v2-bg-2); border: 1px solid var(--v2-border); padding: 4px 8px; }
  .v2-lc-chip-out { color: var(--lc-red); }
  .v2-lc-actions { display: flex; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--v2-border); background: var(--v2-bg-2); }
  .v2-lc-act {
    flex: 1; min-width: 0; height: 40px;
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 0 8px;
    background: var(--v2-bg); color: var(--v2-ink-2);
    border: 1px solid var(--v2-border); border-radius: 10px;
    font: 600 13px Inter; text-decoration: none; white-space: nowrap; cursor: pointer;
  }
  .v2-lc-act:hover:not(:disabled) { background: var(--v2-bg-3); }
  .v2-lc-act svg { flex-shrink: 0; }
  .v2-lc-act-resume { color: var(--lc-amber); border-color: color-mix(in srgb, var(--v2-orange) 45%, transparent); }
  .v2-lc-act-del { color: var(--lc-red); background: transparent; border-color: color-mix(in srgb, var(--v2-red) 40%, transparent); }
  .v2-lc-act-del:hover:not(:disabled) { background: var(--v2-red-l); }
  .v2-lc-act:disabled { opacity: .6; cursor: default; }
</style>
