---
export const prerender = false;

import Header from "../../../components/Header.astro";
import DashboardGate from "../../../components/DashboardGate.astro";
import SellerBottomNav from "../../../components/SellerBottomNav.astro";
import VercelAnalytics from "../../../components/VercelAnalytics.astro";
import "../../../styles/global.css";

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066cc" />
    <title>{`Listings - ${brandName}`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body>
    <DashboardGate />
    <Header showDashboardLink={false} />

    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>

    <!-- Toast -->
    <div id="toast" style="display:none;position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,0.15);transition:opacity 0.3s;"></div>

    <!-- Loading skeleton -->
    <div id="dash-loading" style="padding:16px;">
      <div class="skeleton" style="height:32px;width:200px;border-radius:8px;margin-bottom:16px;"></div>
      <div class="skeleton" style="height:40px;border-radius:8px;margin-bottom:16px;"></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="skeleton" style="height:120px;border-radius:8px;"></div>
        <div class="skeleton" style="height:120px;border-radius:8px;"></div>
      </div>
    </div>

    <main id="dash-main" style="display:none;">

      <!-- Add listing button -->
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h2 id="seller-name" style="font-size:20px;font-weight:700;">My Listings</h2>
        <a href="/dashboard/listings/new" class="btn btn-primary" style="padding:8px 16px;font-size:14px;">+ Add Listing</a>
      </div>

      <div id="listings-list" class="grid grid-2"></div>

      <!-- Bulk action bar -->
      <div id="bulk-bar" class="bulk-bar" style="display:none;">
        <span id="bulk-count" style="font-size:13px;font-weight:600;"></span>
        <div style="display:flex;gap:8px;">
          <button type="button" id="bulk-pause" class="btn" style="font-size:12px;padding:6px 14px;background:#fff3e0;color:#e65100;border:none;border-radius:8px;cursor:pointer;font-weight:600;">Pause All</button>
          <button type="button" id="bulk-resume" class="btn" style="font-size:12px;padding:6px 14px;background:#e8f5e9;color:#2e7d32;border:none;border-radius:8px;cursor:pointer;font-weight:600;">Resume All</button>
        </div>
      </div>
    </main>

    <script>
      import { getSession, signOut } from "../../../lib/seller-auth";
      import { getSellerById, getSellerListings, updateListing } from "../../../lib/supabase";
      import { getSpeciesDisplay } from "../../../lib/species";
      import type { Seller, FishListing } from "../../../lib/supabase";

      let _sellerId = "";

      async function init() {
        const session = getSession();
        if (!session) {
          window.location.href = "/dashboard/login";
          return;
        }

        let seller: Seller;
        try {
          seller = await getSellerById(session.seller_id);
        } catch (err: any) {
          console.error("Dashboard load error:", err);
          signOut();
          window.location.href = "/dashboard/login";
          return;
        }

        _sellerId = seller.id;
        const displayName = [seller.first_name, seller.last_name].filter(Boolean).join(" ") || seller.name;
        document.getElementById("seller-name")!.textContent = `${displayName}'s Listings`;

        function listToast(msg: string, type: string = "success") {
          let t = document.getElementById("toast");
          if (!t) { t = document.createElement("div"); t.id = "toast"; document.body.appendChild(t); }
          t.textContent = msg;
          t.style.cssText = `display:block;position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;color:white;background:${type === "error" ? "var(--red)" : "var(--green)"};box-shadow:0 4px 20px rgba(0,0,0,0.15);`;
          setTimeout(() => { t!.style.display = "none"; }, 3000);
        }

        // Bulk action handlers
        document.getElementById("bulk-pause")!.addEventListener("click", async () => {
          const ids = getSelectedIds();
          const btn = document.getElementById("bulk-pause") as HTMLButtonElement;
          btn.disabled = true; btn.textContent = "Pausing...";
          try {
            for (const id of ids) { await updateListing(id, { is_available: false } as any, _sellerId); }
            listToast(`${ids.length} listing(s) paused`);
            const listings = await getSellerListings(_sellerId);
            renderListings(listings);
          } catch (_) { listToast("Failed to pause some listings", "error"); }
          btn.disabled = false; btn.textContent = "Pause All";
        });
        document.getElementById("bulk-resume")!.addEventListener("click", async () => {
          const ids = getSelectedIds();
          const btn = document.getElementById("bulk-resume") as HTMLButtonElement;
          btn.disabled = true; btn.textContent = "Resuming...";
          try {
            for (const id of ids) { await updateListing(id, { is_available: true } as any, _sellerId); }
            listToast(`${ids.length} listing(s) resumed`);
            const listings = await getSellerListings(_sellerId);
            renderListings(listings);
          } catch (_) { listToast("Failed to resume some listings", "error"); }
          btn.disabled = false; btn.textContent = "Resume All";
        });

        const listings = await getSellerListings(seller.id);
        renderListings(listings);

        requestAnimationFrame(() => {
          document.getElementById("dash-loading")!.style.display = "none";
          const main = document.getElementById("dash-main")!;
          main.style.display = "block";
          main.classList.add("fade-in");
        });
      }

      function esc(s: string) {
        const d = document.createElement("div");
        d.textContent = s;
        return d.innerHTML;
      }

      let _listings: FishListing[] = [];

      function renderListings(listings: FishListing[]) {
        _listings = listings;
        const el = document.getElementById("listings-list")!;
        const bulkBar = document.getElementById("bulk-bar")!;
        if (listings.length === 0) {
          el.innerHTML = '<p class="text-muted">No listings yet. <a href="/dashboard/listings/new">Add your first listing</a>.</p>';
          bulkBar.style.display = "none";
          return;
        }

        const LOW_STOCK = 2;

        el.innerHTML = listings
          .map((l) => {
            const name = getSpeciesDisplay(l.species);
            const unitLabel = l.price_unit === "dozen" ? "dz" : l.price_unit;
            const statusBadge = !l.is_available
              ? '<span class="badge badge-orange">Paused</span>'
              : l.weight_avail <= 0
                ? '<span class="badge badge-orange">Out of stock</span>'
                : '<span class="badge badge-green">Active</span>';
            const lowStock = l.is_available && l.weight_avail > 0 && l.weight_avail <= LOW_STOCK;
            const stockText = l.weight_avail > 0
              ? (lowStock ? `⚠️ Low stock: ${l.weight_avail} ${l.price_unit}` : `📦 ${l.weight_avail} ${l.price_unit} in stock`)
              : `❌ Out of stock`;
            const stockClass = lowStock ? "badge-orange" : l.weight_avail > 0 ? "" : "text-muted";

            return `
              <div class="card listing-dash-card" style="cursor:pointer;" data-listing-id="${l.id}">
                <div class="card-body">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                    <div style="display:flex;align-items:center;gap:8px;">
                      <input type="checkbox" class="listing-check" data-id="${l.id}" style="width:18px;height:18px;accent-color:var(--blue);" />
                      <h3 style="font-size:16px;font-weight:700;">${name}</h3>
                    </div>
                    ${statusBadge}
                  </div>
                  <div style="font-size:18px;font-weight:700;color:var(--green);margin-bottom:4px;">₹${l.price}/${unitLabel}</div>
                  <div class="${stockClass}" style="font-size:13px;${lowStock ? "color:#e65100;font-weight:600;" : ""}">${stockText}</div>
                  <div class="listing-card-actions" style="margin-top:10px;display:flex;gap:8px;align-items:center;">
                    <a href="/dashboard/listings/${l.id}" class="btn btn-primary" style="padding:6px 16px;font-size:13px;">Edit</a>
                    <button type="button" class="btn listing-toggle-btn" data-id="${l.id}" data-available="${l.is_available}" style="padding:6px 14px;font-size:12px;font-weight:600;background:${l.is_available ? "#fff3e0" : "#e8f5e9"};color:${l.is_available ? "#e65100" : "#2e7d32"};border:none;border-radius:8px;cursor:pointer;">
                      ${l.is_available ? "Pause" : "Resume"}
                    </button>
                  </div>
                </div>
              </div>
            `;
          })
          .join("");

        // Quick toggle per listing
        el.querySelectorAll(".listing-toggle-btn").forEach((btn: any) => {
          btn.addEventListener("click", async (e: Event) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            const currentlyAvailable = btn.dataset.available === "true";
            btn.disabled = true;
            btn.textContent = "...";
            try {
              await updateListing(id, { is_available: !currentlyAvailable } as any, _sellerId);
              const l = _listings.find(x => x.id === id);
              if (l) l.is_available = !currentlyAvailable;
              renderListings(_listings);
            } catch (_) { listToast("Failed to update", "error"); btn.disabled = false; btn.textContent = currentlyAvailable ? "Pause" : "Resume"; }
          });
        });

        // Checkbox selection for bulk actions
        updateBulkBar();
        el.querySelectorAll(".listing-check").forEach((cb: any) => {
          cb.addEventListener("change", updateBulkBar);
        });
      }

      function getSelectedIds(): string[] {
        return Array.from(document.querySelectorAll(".listing-check:checked")).map((cb: any) => cb.dataset.id);
      }

      function updateBulkBar() {
        const ids = getSelectedIds();
        const bar = document.getElementById("bulk-bar")!;
        const countEl = document.getElementById("bulk-count")!;
        if (ids.length > 0) {
          bar.style.display = "flex";
          countEl.textContent = `${ids.length} selected`;
        } else {
          bar.style.display = "none";
        }
      }

      init();
    </script>

    <style is:global>
      .bulk-bar {
        position: fixed;
        bottom: calc(56px + env(safe-area-inset-bottom, 0px));
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        max-width: var(--app-max-width);
        z-index: 101;
        padding: 12px 16px;
        background: white;
        border-top: 1px solid var(--gray-200);
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 -4px 16px rgba(0,0,0,0.1);
        border-radius: 16px 16px 0 0;
      }
      /* Extra bottom padding when bulk bar is visible */
      body:has(.bulk-bar[style*="flex"]) #listings-list {
        padding-bottom: 60px;
      }

      .dash-nav {
        display: flex;
        gap: 0;
        margin-bottom: 16px;
        border-bottom: 2px solid var(--gray-200);
      }
      .dash-nav-item {
        padding: 10px 16px;
        font-size: 14px;
        font-weight: 600;
        color: var(--gray-500);
        text-decoration: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: color 0.15s, border-color 0.15s;
      }
      .dash-nav-item:hover {
        color: var(--gray-700);
        text-decoration: none;
      }
      .dash-nav-item.active {
        color: var(--blue);
        border-bottom-color: var(--blue);
      }
    </style>
    <SellerBottomNav active="listings" />
    <VercelAnalytics />
  </body>
</html>
