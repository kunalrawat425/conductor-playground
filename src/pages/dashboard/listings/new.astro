---
export const prerender = false;

import Header from "../../../components/Header.astro";
import DashboardGate from "../../../components/DashboardGate.astro";
import ListingForm from "../../../components/ListingForm.astro";
import "../../../styles/global.css";

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Zepto";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066cc" />
    <title>{`Add Listing - ${brandName}`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body>
    <DashboardGate />
    <Header showDashboardLink={false} />

    <main>
      <div style="margin-bottom:16px;">
        <a href="/dashboard/listings" style="font-size:14px;">← Back to Listings</a>
      </div>
      <h1 style="font-size:24px;font-weight:700;margin-bottom:24px;">Add New Listing</h1>

      <div id="form-container">
        <ListingForm sellerId="" />
      </div>

      <div id="error-msg" style="display:none;color:var(--red);margin-top:12px;"></div>
    </main>

    <script>
      import { getSession, signOut } from "../../../lib/seller-auth";
      import { getSellerById, createListing, uploadFishPhoto } from "../../../lib/supabase";
      import type { PriceUnit } from "../../../lib/species";

      async function init() {
        const session = getSession();
        if (!session) {
          window.location.href = "/dashboard/login";
          return;
        }

        let seller;
        try {
          seller = await getSellerById(session.seller_id);
        } catch {
          signOut();
          window.location.href = "/dashboard/login";
          return;
        }

        const form = document.getElementById("listing-form");
        if (!form) return;

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const formData = new FormData(form as HTMLFormElement);

          const species = formData.get("species") as string;
          const price = parseFloat(formData.get("price") as string);
          const priceUnit = formData.get("price_unit") as PriceUnit;
          const weightAvail = parseFloat(formData.get("weight_avail") as string);
          const pickupLoc = formData.get("pickup_loc") as string;
          const photoFile = formData.get("photo") as File;

          if (!species || !price || !pickupLoc) {
            showError("Please fill in all required fields.");
            return;
          }

          const submitBtn = (form as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "Creating..."; submitBtn.style.opacity = "0.6"; }

          try {
            let photoUrl: string | null = null;
            if (photoFile && photoFile.size > 0) {
              photoUrl = await uploadFishPhoto(photoFile, seller.id);
            }

            await createListing({
              seller_id: seller.id,
              species,
              price,
              price_unit: priceUnit,
              weight_avail: weightAvail,
              photo_url: photoUrl,
              listed_date: new Date().toISOString().split("T")[0],
              is_available: true,
              pickup_loc: pickupLoc,
            });

            showToast("Listing created!", "success");
            setTimeout(() => { window.location.href = "/dashboard/listings"; }, 800);
          } catch (err: any) {
            showToast(err.message || "Failed to create listing.", "error");
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "Add Listing"; submitBtn.style.opacity = "1"; }
          }
        });
      }

      function showToast(message: string, type: "success" | "error" = "success") {
        let toast = document.getElementById("toast");
        if (!toast) { toast = document.createElement("div"); toast.id = "toast"; document.body.appendChild(toast); }
        toast.textContent = message;
        toast.style.cssText = `position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;color:white;box-shadow:0 4px 20px rgba(0,0,0,0.15);transition:opacity 0.3s;background:${type === "success" ? "var(--green)" : "var(--red)"};`;
        setTimeout(() => { toast!.style.opacity = "0"; setTimeout(() => { toast!.style.display = "none"; }, 300); }, 3000);
      }

      function showError(msg: string) {
        showToast(msg, "error");
      }

      init();
    </script>
  </body>
</html>
