---
export const prerender = false;

import Header from "../../../components/Header.astro";
import DashboardGate from "../../../components/DashboardGate.astro";
import ListingForm from "../../../components/ListingForm.astro";
import VercelAnalytics from "../../../components/VercelAnalytics.astro";
import "../../../styles/global.css";

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066cc" />
    <title>{`Add Listing - ${brandName}`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body>
    <DashboardGate />
    <Header showDashboardLink={false} />

    <main class="dash-listing-page">
      <header class="dash-listing-header">
        <a href="/dashboard/listings" class="dash-listing-back">← Back to listings</a>
        <h1 class="dash-listing-title">Add listing</h1>
        <p class="dash-listing-sub">Set pricing, then stock in the same unit as your first price row.</p>
      </header>

      <div id="form-container" class="dash-listing-form">
        <ListingForm sellerId="" />
      </div>

      <div id="error-msg" style="display:none;color:var(--red);margin-top:12px;"></div>
    </main>

    <style is:global>
      .dash-listing-page {
        padding: 8px 0 32px;
        max-width: 560px;
        margin: 0 auto;
      }
      .dash-listing-header {
        margin-bottom: 20px;
      }
      .dash-listing-back {
        font-size: 14px;
        font-weight: 500;
        color: var(--gray-500);
        display: inline-block;
        margin-bottom: 12px;
      }
      .dash-listing-back:hover {
        color: var(--blue);
      }
      .dash-listing-title {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.03em;
        margin: 0 0 8px;
        color: var(--gray-900);
      }
      .dash-listing-sub {
        font-size: 14px;
        color: var(--gray-500);
        margin: 0;
        line-height: 1.4;
      }
    </style>

    <script>
      import { getSession, signOut } from "../../../lib/seller-auth";
      import { getSellerById, createListing, uploadFishPhoto, invalidateSellerListingIdsCache } from "../../../lib/supabase";
      import { validateSellerListingForm, focusListingField } from "../../../lib/listing-form-validation";

      async function init() {
        const session = getSession();
        if (!session) {
          window.location.href = "/dashboard/login";
          return;
        }

        let seller;
        try {
          seller = await getSellerById(session.seller_id);
        } catch {
          signOut();
          window.location.href = "/dashboard/login";
          return;
        }

        const form = document.getElementById("listing-form") as HTMLFormElement | null;
        if (!form) return;
        form.dataset.sellerId = seller.id;

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const formData = new FormData(form);

          const species = formData.get("species") as string;
          const fishSizeRaw = (formData.get("fish_size") as string)?.trim() || "";
          const fish_size =
            fishSizeRaw === "small" || fishSizeRaw === "medium" || fishSizeRaw === "large"
              ? fishSizeRaw
              : null;
          const photoFile = formData.get("photo") as File;

          const validated = validateSellerListingForm({
            species,
            weightAvailStr: (formData.get("weight_avail") as string) ?? "",
            pricingOptionsJson: (formData.get("pricing_options_json") as string) ?? "[]",
            buyerDailyStr: formData.get("buyer_daily_qty_limit")?.toString() ?? "",
            oosThresholdStr: formData.get("oos_threshold")?.toString() ?? "",
          });
          if (!validated.ok) {
            showError(validated.message);
            focusListingField(validated.focusId);
            return;
          }

          const { weightAvail, buyerDaily, oosThreshold, pricingOptions } = validated.data;

          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Creating…";
            submitBtn.style.opacity = "0.6";
          }

          try {
            let photoUrl: string | null = null;
            if (photoFile && photoFile.size > 0) {
              if (photoFile.size > 5 * 1024 * 1024) {
                showToast("Photo must be under 5MB", "error");
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.textContent = "Create listing";
                  submitBtn.style.opacity = "1";
                }
                return;
              }
              photoUrl = await uploadFishPhoto(photoFile, seller.id);
            }

            await createListing({
              seller_id: seller.id,
              species,
              fish_size,
              pricing_options: pricingOptions,
              weight_avail: weightAvail,
              photo_url: photoUrl,
              listed_date: new Date().toISOString().split("T")[0],
              is_available: true,
              pickup_loc: "",
              buyer_daily_qty_limit: buyerDaily,
              oos_threshold: oosThreshold,
            } as any);

            invalidateSellerListingIdsCache(seller.id);
            showToast("Listing created!", "success");
            setTimeout(() => {
              window.location.href = "/dashboard/listings";
            }, 800);
          } catch (err: any) {
            showToast(err.message || "Failed to create listing.", "error");
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Create listing";
              submitBtn.style.opacity = "1";
            }
          }
        });
      }

      function showToast(message: string, type: "success" | "error" = "success") {
        let toast = document.getElementById("toast");
        if (!toast) { toast = document.createElement("div"); toast.id = "toast"; document.body.appendChild(toast); }
        toast.textContent = message;
        toast.style.cssText = `position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;color:white;box-shadow:0 4px 20px rgba(0,0,0,0.15);transition:opacity 0.3s;background:${type === "success" ? "var(--green)" : "var(--red)"};`;
        setTimeout(() => { toast!.style.opacity = "0"; setTimeout(() => { toast!.style.display = "none"; }, 300); }, 3000);
      }

      function showError(msg: string) {
        showToast(msg, "error");
      }

      init();
    </script>
    <VercelAnalytics />
  </body>
</html>
