---
export const prerender = false;
import AppShell from "../../../components/ui/AppShell.astro";
import ListingForm from "../../../components/ListingForm.astro";
import Toast from "../../../components/ui/atoms/Toast.astro";
import { getListingById } from "../../../lib/supabase";

const { id } = Astro.params;
let listing: any = null;
try { listing = await getListingById(id!); } catch {}
const speciesName = listing?.species || "Listing";
---
<AppShell
  title={`Edit ${speciesName} · Seller Dashboard`}
  description="Edit your fish listing"
  header={{ variant: "page", title: `Edit ${speciesName}`, backHref: "/dashboard/listings" }}
  nav={{ active: "listings" as any, mode: "seller" }}
>
  <Toast />
  <div style="padding:16px;">
    <p style="font:400 13px Inter;color:var(--v2-ink-3);margin:0 0 16px;line-height:1.5;">
      Update pricing tiers, stock, or availability. Buyers see updated info instantly.
    </p>
    <div id="v2-form-mount">
      <ListingForm sellerId={listing?.seller_id || ""} listing={listing} />
    </div>
    <div id="v2-edit-denied" style="display:none;padding:16px 0;">
      <div style="background:var(--v2-red-l);border:1px solid var(--v2-red);border-radius:var(--v2-radius);padding:16px;text-align:center;">
        <div style="font:800 15px Inter;color:var(--v2-red);">You don't own this listing</div>
        <div style="font:500 12px Inter;color:var(--v2-ink-2);margin-top:6px;">Sign in as the owner, or go back to your listings.</div>
        <a href="/dashboard/listings" class="v2-btn v2-btn-primary v2-btn-sm" style="margin-top:12px;display:inline-block;">Back to my listings</a>
      </div>
    </div>
  </div>

  <script define:vars={{ ownerId: listing?.seller_id || "", listingId: listing?.id || "" }}>
    // Ownership gate
    try {
      const me = localStorage.getItem("rlf_seller_id");
      const form = document.getElementById("listing-form");
      const denied = document.getElementById("v2-edit-denied");
      if (!me) {
        location.href = "/dashboard/login";
      } else if (ownerId && me !== ownerId) {
        if (form) form.style.display = "none";
        if (denied) denied.style.display = "block";
      }
    } catch {}
  </script>
  <script>
    import { updateListing, uploadFishPhoto } from "../../../lib/supabase";
    import { validateSellerListingForm, focusListingField } from "../../../lib/listing-form-validation";
    import { supabase } from "../../../lib/supabase";

    const sellerId = localStorage.getItem("rlf_seller_id");
    if (sellerId) {
      const form = document.getElementById("listing-form") as HTMLFormElement | null;
      if (form) {
        const lid = form.dataset.listingId;
        if (lid && form.dataset.sellerId === sellerId) {
          let sellerMinOrder = 0;
          try {
            const { data: s } = await supabase.from("sellers").select("min_order_amount").eq("id", sellerId).single();
            sellerMinOrder = Number(s?.min_order_amount) || 0;
          } catch {}

          form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const species = formData.get("species") as string;
            const fishSizeRaw = (formData.get("fish_size") as string)?.trim() || "";
            const fish_size = ["small", "medium", "large"].includes(fishSizeRaw) ? fishSizeRaw : null;
            const photoFile = formData.get("photo") as File;

            const validated = validateSellerListingForm({
              species,
              weightAvailStr: (formData.get("weight_avail") as string) ?? "",
              pricingOptionsJson: (formData.get("pricing_options_json") as string) ?? "[]",
              buyerDailyStr: formData.get("buyer_daily_qty_limit")?.toString() ?? "",
              oosThresholdStr: formData.get("oos_threshold")?.toString() ?? "",
              sellerMinOrderAmount: sellerMinOrder,
            });
            if (!validated.ok) {
              (window as any).v2Toast?.("error", "Validation error", validated.message);
              focusListingField(validated.focusId);
              return;
            }
            const { weightAvail, buyerDaily, oosThreshold, pricingOptions } = validated.data;

            const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
            if (btn) { btn.disabled = true; btn.textContent = "Saving…"; }

            try {
              let photoUrl: string | null | undefined = undefined;
              if (photoFile?.size > 0) {
                if (photoFile.size > 5 * 1024 * 1024) {
                  (window as any).v2Toast?.("error", "Too large", "Photo must be under 5MB");
                  if (btn) { btn.disabled = false; btn.textContent = "Save listing"; }
                  return;
                }
                const upForm = new FormData();
                upForm.append("seller_id", sellerId);
                upForm.append("file", photoFile);
                const upRes = await fetch("/api/seller/upload-listing-photo", { method: "POST", body: upForm });
                const upData = await upRes.json();
                if (!upRes.ok) {
                  (window as any).v2Toast?.("error", "Photo upload failed", upData.error || "Unknown error");
                  if (btn) { btn.disabled = false; btn.textContent = "Save listing"; }
                  return;
                }
                photoUrl = upData.url;
              }

              const isPreorderEnabled = (formData.get("is_preorder_enabled") as string) === "true";
              const isOrderPaused = (formData.get("is_order_paused") as string) === "true";

              await updateListing(
                lid,
                {
                  species,
                  fish_size,
                  pricing_options: pricingOptions,
                  weight_avail: weightAvail,
                  ...(photoUrl !== undefined ? { photo_url: photoUrl } : {}),
                  buyer_daily_qty_limit: buyerDaily,
                  oos_threshold: oosThreshold,
                  is_preorder_enabled: isPreorderEnabled,
                  is_order_paused: isOrderPaused,
                },
                sellerId
              );

              (window as any).v2Toast?.("success", "Listing saved!", "Buyers see updated info");
              setTimeout(() => { window.location.href = "/dashboard/listings"; }, 800);
            } catch (err: any) {
              (window as any).v2Toast?.("error", "Failed", err.message || "Could not save listing");
              if (btn) { btn.disabled = false; btn.textContent = "Save listing"; }
            }
          });
        }
      }
    }
  </script>

  <style is:global>
    /* same V2 form overrides as new.astro */
    #v2-form-mount label,
    #v2-form-mount .form-label {
      font-family: var(--v2-font) !important;
      font-weight: 600 !important;
      font-size: 13px !important;
      color: var(--v2-ink-2) !important;
    }
    #v2-form-mount input[type="text"],
    #v2-form-mount input[type="number"],
    #v2-form-mount input[type="email"],
    #v2-form-mount select,
    #v2-form-mount textarea {
      font-family: var(--v2-font) !important;
      font-size: 14px !important;
      padding: 12px 14px !important;
      border: 1.5px solid var(--v2-border) !important;
      border-radius: var(--v2-radius-sm) !important;
      background: var(--v2-bg) !important;
      color: var(--v2-ink) !important;
      width: 100% !important;
      box-sizing: border-box !important;
      min-height: 44px !important;
    }
    #v2-form-mount input:focus,
    #v2-form-mount select:focus,
    #v2-form-mount textarea:focus {
      outline: none !important;
      border-color: var(--v2-brand) !important;
      box-shadow: 0 0 0 3px rgba(0, 102, 255, 0.1) !important;
    }
    #v2-form-mount button.btn,
    #v2-form-mount button[type="submit"] {
      font-family: var(--v2-font) !important;
      font-weight: 700 !important;
      font-size: 14px !important;
      padding: 12px 24px !important;
      border-radius: var(--v2-radius-sm) !important;
      min-height: 44px !important;
      background: var(--v2-brand) !important;
      color: #fff !important;
      border: none !important;
      cursor: pointer !important;
    }
    #v2-form-mount .btn-green { background: var(--v2-green) !important; }
    #v2-form-mount .btn-red { background: var(--v2-red) !important; }

    /* Dark mode: override ALL V1 listing form hardcoded colors */
    #v2-form-mount .listing-card {
      background: var(--v2-bg) !important;
      border-color: var(--v2-border) !important;
      box-shadow: none !important;
    }
    #v2-form-mount .listing-lead {
      background: var(--v2-bg-2) !important;
      border-color: var(--v2-border) !important;
      color: var(--v2-ink-2) !important;
    }
    #v2-form-mount .listing-section-title {
      color: var(--v2-ink) !important;
    }
    #v2-form-mount .listing-section-intro,
    #v2-form-mount .listing-opt,
    #v2-form-mount .listing-hint,
    #v2-form-mount .listing-stock-hint,
    #v2-form-mount .listing-stock-info,
    #v2-form-mount .listing-photo-preview-label,
    #v2-form-mount .form-hint,
    #v2-form-mount p {
      color: var(--v2-ink-3) !important;
    }
    #v2-form-mount .listing-field label {
      color: var(--v2-ink) !important;
    }
    #v2-form-mount .listing-file-input {
      background: var(--v2-bg-2) !important;
      border-color: var(--v2-border) !important;
      color: var(--v2-ink-2) !important;
    }
    #v2-form-mount .listing-pricing-row,
    #v2-form-mount .listing-price-row,
    #v2-form-mount .pricing-row-grid {
      background: var(--v2-bg-2) !important;
      border-color: var(--v2-border) !important;
    }
    #v2-form-mount .listing-pricing-row label,
    #v2-form-mount .listing-price-row label {
      color: var(--v2-ink-2) !important;
    }
    #v2-form-mount .btn-add-price,
    #v2-form-mount .listing-add-price-btn {
      background: var(--v2-bg-2) !important;
      color: var(--v2-brand) !important;
      border-color: var(--v2-border) !important;
    }
    #v2-form-mount .btn-remove-price {
      background: var(--v2-bg-3) !important;
      color: var(--v2-ink-3) !important;
    }
    #v2-form-mount .listing-radio-group label,
    #v2-form-mount .listing-checkbox label {
      color: var(--v2-ink) !important;
    }
    #v2-form-mount .listing-inline-error {
      color: var(--v2-red) !important;
    }
    #v2-form-mount .listing-card--pricing {
      border-color: var(--v2-brand) !important;
    }
    #v2-form-mount .current-photo {
      border-color: var(--v2-border) !important;
    }
    #v2-form-mount .listing-req {
      color: var(--v2-red) !important;
    }
    /* Deal/discount section inline-styled elements */
    #v2-form-mount .pricing-row-deal {
      background: var(--v2-bg-2) !important;
      border-color: var(--v2-border) !important;
    }
    #v2-form-mount .pricing-row-deal div,
    #v2-form-mount .pricing-row-deal span,
    #v2-form-mount .pricing-row-deal label {
      color: var(--v2-ink-2) !important;
    }
    #v2-form-mount .pricing-row-deal p {
      color: var(--v2-ink-3) !important;
    }
    #v2-form-mount .pricing-row-deal input[type="number"],
    #v2-form-mount .pricing-row-deal input[type="text"],
    #v2-form-mount .price-compare-inp,
    #v2-form-mount .discount-pct-inp,
    #v2-form-mount .discount-amt-inp {
      background: var(--v2-bg) !important;
      border-color: var(--v2-border) !important;
      color: var(--v2-ink) !important;
    }
    #v2-form-mount .deal-preview-line {
      background: var(--v2-bg) !important;
      border-color: var(--v2-border) !important;
      color: var(--v2-ink-2) !important;
    }
    #v2-form-mount .btn-apply-deal {
      background: var(--v2-green) !important;
      color: #fff !important;
    }
    /* Pricing row inputs (label, qty, price) */
    #v2-form-mount .pricing-row input[type="text"],
    #v2-form-mount .pricing-row input[type="number"],
    #v2-form-mount .price-label-inp {
      background: var(--v2-bg) !important;
      border-color: var(--v2-border) !important;
      color: var(--v2-ink) !important;
    }
    #v2-form-mount .pricing-row label,
    #v2-form-mount .pricing-row span {
      color: var(--v2-ink-2) !important;
    }
    /* Sell-by basis select */
    #v2-form-mount .listing-pricing-basis {
      background: var(--v2-bg) !important;
      border-color: var(--v2-border) !important;
      color: var(--v2-ink) !important;
    }
    #v2-form-mount .listing-pricing-mode > div {
      background: var(--v2-bg-2) !important;
      border-color: var(--v2-border) !important;
    }
    #v2-form-mount .listing-pricing-mode label {
      color: var(--v2-ink) !important;
    }
    #v2-form-mount .listing-pricing-kg-hint {
      color: var(--v2-ink-3) !important;
    }
  </style>
</AppShell>
