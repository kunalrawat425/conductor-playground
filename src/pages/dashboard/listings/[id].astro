---
export const prerender = false;

import Header from "../../../components/Header.astro";
import DashboardGate from "../../../components/DashboardGate.astro";
import ListingForm from "../../../components/ListingForm.astro";
import VercelAnalytics from "../../../components/VercelAnalytics.astro";
import "../../../styles/global.css";

const { id } = Astro.params;
const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066cc" />
    <title>{`Edit Listing - ${brandName}`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <DashboardGate />
    <Header showDashboardLink={false} />

    <main>
      <div style="margin-bottom:16px;">
        <a href="/dashboard/listings" style="font-size:14px;">← Back to Listings</a>
      </div>
      <h1 style="font-size:24px;font-weight:700;margin-bottom:24px;">Edit Listing</h1>

      <div id="form-container">
        <p class="text-muted">Loading listing...</p>
      </div>

      <div id="error-msg" style="display:none;color:var(--red);margin-top:12px;"></div>
      <div id="listing-data" data-listing-id={id} style="display:none;"></div>
    </main>

    <script>
      import { getSession, signOut } from "../../../lib/seller-auth";
      import { getSellerById, getListingById, updateListing, uploadFishPhoto } from "../../../lib/supabase";
      import { getSpeciesDisplay, SPECIES_LIST, PRICE_UNITS } from "../../../lib/species";

      const listingId = document.getElementById("listing-data")!.dataset.listingId!;

      (async () => {

        const session = getSession();
        if (!session) {
          window.location.href = "/dashboard/login";
          return;
        }

        try {
          const seller = await getSellerById(session.seller_id);
          const listing = await getListingById(listingId);

          if (listing.seller_id !== seller.id) {
            document.getElementById("form-container")!.innerHTML = '<p style="color:var(--red);">Not your listing.</p>';
            return;
          }

          const container = document.getElementById("form-container")!;
          const unitLabel = listing.price_unit;

          container.innerHTML = `
            <form id="edit-form" style="max-width:500px;">
              <div class="form-group">
                <label for="species">Species</label>
                <select id="species" name="species" required>
                  ${SPECIES_LIST.map((s) => `<option value="${s.id}" ${listing.species === s.id ? "selected" : ""} data-unit="${s.defaultUnit}">${s.english} (${s.marathi})</option>`).join("")}
                </select>
              </div>
              <div style="display:grid;grid-template-columns:2fr 1fr;gap:12px;">
                <div class="form-group">
                  <label for="price">Price</label>
                  <input type="number" id="price" name="price" min="1" step="0.01" value="${listing.price}" required />
                </div>
                <div class="form-group">
                  <label for="price_unit">Unit</label>
                  <select id="price_unit" name="price_unit" required>
                    ${PRICE_UNITS.map((u) => `<option value="${u.value}" ${listing.price_unit === u.value ? "selected" : ""}>${u.label}</option>`).join("")}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="weight_avail">Stock (how much you have)</label>
                <input type="number" id="weight_avail" name="weight_avail" min="0" step="0.1" value="${listing.weight_avail}" required />
              </div>
              <div class="form-group">
                <label for="photo">Photo</label>
                <input type="file" id="photo" name="photo" accept="image/*" />
                ${listing.photo_url ? `<img src="${listing.photo_url}" alt="Current" style="width:120px;height:90px;object-fit:cover;border-radius:8px;margin-top:8px;" loading="lazy" />` : ""}
              </div>
              <div class="form-group">
                <label for="max_qty_per_order">Max quantity per order (optional)</label>
                <input type="number" id="max_qty_per_order" name="max_qty_per_order" min="0.5" step="0.5" value="${listing.max_qty_per_order || ""}" placeholder="e.g. 5 — leave empty for no limit" />
                <div style="font-size:11px;color:var(--gray-500);margin-top:4px;">Buyer sees: "Max 5/kg per order". Prevents one buyer from buying all your stock.</div>
              </div>
              <div class="form-group">
                <label for="oos_threshold">Show "Out of stock" when stock falls below (optional)</label>
                <input type="number" id="oos_threshold" name="oos_threshold" min="0" step="0.5" value="${listing.oos_threshold || ""}" placeholder="Default: 10% of stock" />
                <div style="font-size:11px;color:var(--gray-500);margin-top:4px;">Buyer sees: "📦 Out of stock" + PRE-ORDER button. Orders still come in as pre-orders.</div>
              </div>
              <div class="form-group">
                <label for="max_orders_per_day">Max orders per day (optional)</label>
                <input type="number" id="max_orders_per_day" name="max_orders_per_day" min="1" step="1" value="${listing.max_orders_per_day || ""}" placeholder="e.g. 20 — leave empty for no limit" />
                <div style="font-size:11px;color:var(--gray-500);margin-top:4px;">Buyer sees error when daily limit reached. Resets at midnight.</div>
              </div>
              <div style="display:flex;gap:12px;margin-top:20px;">
                <button type="submit" class="btn btn-primary">Update Listing</button>
              </div>
            </form>
          `;

          function showToast(message: string, type: "success" | "error" = "success") {
            let toast = document.getElementById("toast");
            if (!toast) { toast = document.createElement("div"); toast.id = "toast"; document.body.appendChild(toast); }
            toast.textContent = message;
            toast.style.cssText = `position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;color:white;box-shadow:0 4px 20px rgba(0,0,0,0.15);transition:opacity 0.3s;background:${type === "success" ? "var(--green)" : "var(--red)"};`;
            setTimeout(() => { toast!.style.opacity = "0"; setTimeout(() => { toast!.style.display = "none"; }, 300); }, 3000);
          }

          document.getElementById("edit-form")!.addEventListener("submit", async (e) => {
            e.preventDefault();
            const form = e.target as HTMLFormElement;
            const formData = new FormData(form);
            const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
            submitBtn.disabled = true; submitBtn.textContent = "Updating..."; submitBtn.style.opacity = "0.6";

            try {
              const photoFile = formData.get("photo") as File;
              let photoUrl = listing.photo_url;
              if (photoFile && photoFile.size > 0) {
                if (photoFile.size > 5 * 1024 * 1024) {
                  showToast("Photo must be under 5MB", "error");
                  submitBtn.disabled = false; submitBtn.textContent = "Update Listing"; submitBtn.style.opacity = "1";
                  return;
                }
                photoUrl = await uploadFishPhoto(photoFile, seller.id);
              }

              const maxQtyVal = formData.get("max_qty_per_order") as string;
              const maxOrdersVal = formData.get("max_orders_per_day") as string;
              const oosVal = formData.get("oos_threshold") as string;
              await updateListing(listingId, {
                species: formData.get("species") as string,
                price: parseFloat(formData.get("price") as string),
                price_unit: formData.get("price_unit") as any,
                weight_avail: parseFloat(formData.get("weight_avail") as string),
                photo_url: photoUrl,
                max_qty_per_order: maxQtyVal ? parseFloat(maxQtyVal) : null,
                max_orders_per_day: maxOrdersVal ? parseInt(maxOrdersVal) : null,
                oos_threshold: oosVal ? parseFloat(oosVal) : null,
              }, seller.id);

              showToast("Listing updated!");
              setTimeout(() => { window.location.href = "/dashboard/listings"; }, 800);
            } catch (err) {
              showToast((err as any).message || "Update failed.", "error");
              submitBtn.disabled = false; submitBtn.textContent = "Update Listing"; submitBtn.style.opacity = "1";
            }
          });

        } catch (err: any) {
          if (err?.message?.includes("coerce") || err?.code === "PGRST116") {
            signOut();
            window.location.href = "/dashboard/login";
          } else {
            document.getElementById("form-container")!.innerHTML = '<p style="color:var(--red);">Listing not found.</p>';
          }
        }
      })();
    </script>
    <VercelAnalytics />
  </body>
</html>
