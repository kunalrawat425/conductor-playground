---
export const prerender = false;

import { createClient } from "@supabase/supabase-js";
import Header from "../../../components/Header.astro";
import DashboardGate from "../../../components/DashboardGate.astro";
import ListingForm from "../../../components/ListingForm.astro";
import VercelAnalytics from "../../../components/VercelAnalytics.astro";
import "../../../styles/global.css";
import type { FishListing } from "../../../lib/supabase";

const { id } = Astro.params;
const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || "";
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "";

let initialListing: FishListing | null = null;
if (id && supabaseUrl && supabaseAnonKey) {
  const sb = createClient(supabaseUrl, supabaseAnonKey);
  const { data, error } = await sb.from("fish_listings").select("*").eq("id", id).single();
  if (!error && data) initialListing = data as FishListing;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066cc" />
    <title>{`Edit Listing - ${brandName}`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <DashboardGate />
    <Header showDashboardLink={false} />

    <main>
      <div style="margin-bottom:16px;">
        <a href="/dashboard/listings" style="font-size:14px;">← Back to Listings</a>
      </div>
      <h1 style="font-size:24px;font-weight:700;margin-bottom:24px;">Edit Listing</h1>

      <div id="form-container">
        {
          initialListing ? (
            <ListingForm sellerId={initialListing.seller_id} listing={initialListing} />
          ) : (
            <p class="text-muted">Listing not found.</p>
          )
        }
      </div>

      <div id="error-msg" style="display:none;color:var(--red);margin-top:12px;"></div>
    </main>

    <script>
      import { getSession, signOut } from "../../../lib/seller-auth";
      import { getSellerById, updateListing, uploadFishPhoto } from "../../../lib/supabase";
      import type { PriceUnit } from "../../../lib/species";
      import type { ListingPriceOption } from "../../../lib/listing-pricing";

      async function init() {
        const session = getSession();
        if (!session) {
          window.location.href = "/dashboard/login";
          return;
        }

        const form = document.getElementById("listing-form") as HTMLFormElement | null;
        if (!form) return;

        const listingId = form.dataset.listingId;
        if (!listingId) return;

        let seller;
        try {
          seller = await getSellerById(session.seller_id);
        } catch {
          signOut();
          window.location.href = "/dashboard/login";
          return;
        }

        if (seller.id !== form.dataset.sellerId) {
          document.getElementById("form-container")!.innerHTML =
            '<p style="color:var(--red);">Not your listing.</p>';
          return;
        }

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const formData = new FormData(form);

          const species = formData.get("species") as string;
          const fishSizeRaw = (formData.get("fish_size") as string)?.trim() || "";
          const fish_size =
            fishSizeRaw === "small" || fishSizeRaw === "medium" || fishSizeRaw === "large"
              ? fishSizeRaw
              : null;
          const weightAvail = parseFloat(formData.get("weight_avail") as string);
          const photoFile = formData.get("photo") as File;
          const buyerDaily = formData.get("buyer_daily_qty_limit")?.toString().trim()
            ? parseFloat(formData.get("buyer_daily_qty_limit") as string)
            : null;
          const oosThreshold = formData.get("oos_threshold")
            ? parseFloat(formData.get("oos_threshold") as string)
            : null;

          let pricingOptions: ListingPriceOption[] = [];
          try {
            const raw = formData.get("pricing_options_json") as string;
            pricingOptions = JSON.parse(raw || "[]");
          } catch {
            showError("Invalid pricing options.");
            return;
          }
          if (!Array.isArray(pricingOptions) || pricingOptions.length === 0) {
            showError("Add at least one valid price (₹).");
            return;
          }
          const first = pricingOptions[0];
          const price = Number(first.price);
          const priceUnit = (first.unit === "dozen" ? "dozen" : "piece") as PriceUnit;
          if (!species || !Number.isFinite(price) || price <= 0) {
            showError("Please fill in all required fields.");
            return;
          }

          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Updating...";
            submitBtn.style.opacity = "0.6";
          }

          try {
            let photoUrl: string | null | undefined = undefined;
            if (photoFile && photoFile.size > 0) {
              if (photoFile.size > 5 * 1024 * 1024) {
                showToast("Photo must be under 5MB", "error");
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.textContent = "Update Listing";
                  submitBtn.style.opacity = "1";
                }
                return;
              }
              photoUrl = await uploadFishPhoto(photoFile, seller.id);
            }

            await updateListing(
              listingId,
              {
                species,
                fish_size,
                price,
                price_unit: priceUnit,
                pricing_options: pricingOptions,
                weight_avail: weightAvail,
                ...(photoUrl !== undefined ? { photo_url: photoUrl } : {}),
                buyer_daily_qty_limit: buyerDaily,
                oos_threshold: oosThreshold,
              },
              seller.id
            );

            showToast("Listing updated!", "success");
            setTimeout(() => {
              window.location.href = "/dashboard/listings";
            }, 800);
          } catch (err: any) {
            showToast(err.message || "Update failed.", "error");
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Update Listing";
              submitBtn.style.opacity = "1";
            }
          }
        });
      }

      function showToast(message: string, type: "success" | "error" = "success") {
        let toast = document.getElementById("toast");
        if (!toast) {
          toast = document.createElement("div");
          toast.id = "toast";
          document.body.appendChild(toast);
        }
        toast.textContent = message;
        toast.style.cssText = `position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;color:white;box-shadow:0 4px 20px rgba(0,0,0,0.15);transition:opacity 0.3s;background:${type === "success" ? "var(--green)" : "var(--red)"};`;
        setTimeout(() => {
          toast!.style.opacity = "0";
          setTimeout(() => {
            toast!.style.display = "none";
          }, 300);
        }, 3000);
      }

      function showError(msg: string) {
        showToast(msg, "error");
      }

      init();
    </script>
    <VercelAnalytics />
  </body>
</html>
