---
export const prerender = true;
const SITE = "https://www.relifish.store";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Relifish — Fresh Fish Delivered from Mumbai's Local Sellers</title>
  <meta name="description" content="Order fresh fish directly from local Mumbai fish sellers. Pre-order tonight, pick up tomorrow morning. Pomfret, Surmai, Bangda, Prawns — no middleman, market-fresh prices." />
  <link rel="canonical" href={SITE} />
  <meta property="og:title" content="Relifish — Fresh Fish from Mumbai's Local Sellers" />
  <meta property="og:description" content="Order fresh fish directly from local fish sellers. Pre-order tonight, get it tomorrow morning." />
  <meta property="og:image" content={`${SITE}/og-image.png`} />
  <meta property="og:url" content={SITE} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Relifish" />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Relifish — Fresh Fish from Mumbai's Local Sellers" />
  <meta name="twitter:description" content="Order fresh fish directly from local fish sellers. Pre-order tonight, get it tomorrow morning." />
  <meta name="twitter:image" content={`${SITE}/og-image.png`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "@id": `${SITE}/#org`, "name": "Relifish", "url": SITE, "logo": `${SITE}/icon-192.svg`, "description": "Mumbai's fresh fish marketplace.", "areaServed": { "@type": "City", "name": "Mumbai" } },
      { "@type": "WebSite", "@id": `${SITE}/#web`, "name": "Relifish", "url": SITE, "potentialAction": { "@type": "SearchAction", "target": `${SITE}/search?q={search_term_string}`, "query-input": "required name=search_term_string" } },
      { "@type": "FAQPage", "mainEntity": [
        { "@type": "Question", "name": "How does Relifish work?", "acceptedAnswer": { "@type": "Answer", "text": "Browse local fish sellers near you, pre-order tonight's catch before the cutoff, and collect it fresh tomorrow morning or get home delivery." } },
        { "@type": "Question", "name": "What fish can I order on Relifish?", "acceptedAnswer": { "@type": "Answer", "text": "Pomfret, Surmai, Bangda, Prawns, Rawas, Crab and more — updated daily based on the morning catch." } },
        { "@type": "Question", "name": "Is Relifish available in Mumbai?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — currently serving Versova, Andheri West and expanding across Mumbai." } },
        { "@type": "Question", "name": "How do I become a seller on Relifish?", "acceptedAnswer": { "@type": "Answer", "text": "Sign up at relifish.store/dashboard/login with your mobile number. List fish, set prices, receive orders same day. Free to start." } }
      ]}
    ]
  })} />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{--brand:#0066FF;--brand-dark:#0047CC;--brand-light:#EBF3FF;--ink:#0F172A;--ink-2:#475569;--ink-3:#94A3B8;--bg:#fff;--bg-2:#F8FAFC;--border:#E2E8F0;--max:1100px;--r:16px}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;color:var(--ink);background:var(--bg);line-height:1.5;-webkit-font-smoothing:antialiased}
    a{color:inherit;text-decoration:none}
    img{max-width:100%;display:block}

    .nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
    .nav-inner{max-width:var(--max);margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:14px 24px}
    .logo{font:800 20px Inter;color:var(--ink)}
    .logo span{color:var(--brand)}
    .nav-links{display:flex;align-items:center;gap:8px}
    .nav-link{font:500 14px Inter;color:var(--ink-2);padding:8px 14px;border-radius:8px;transition:background .15s}
    .nav-link:hover{background:var(--bg-2)}
    .btn{display:inline-flex;align-items:center;gap:8px;font:700 15px Inter;padding:12px 24px;border-radius:12px;transition:all .15s;cursor:pointer;border:none}
    .btn-primary{background:var(--brand);color:#fff;box-shadow:0 4px 16px rgba(0,102,255,.28)}
    .btn-primary:hover{background:var(--brand-dark);transform:translateY(-1px)}
    .btn-secondary{background:#fff;color:var(--ink);border:2px solid var(--border)}
    .btn-secondary:hover{border-color:var(--brand);color:var(--brand)}
    .btn-lg{font-size:17px;padding:16px 32px}
    @media(max-width:640px){.nav-links .nav-link{display:none}}

    .hero{background:linear-gradient(135deg,#EBF3FF 0%,#F0FDF4 100%);padding:88px 24px 72px;text-align:center}
    .badge{display:inline-flex;align-items:center;gap:6px;background:var(--brand-light);color:var(--brand);font:600 12px Inter;padding:6px 14px;border-radius:100px;border:1px solid #BFDBFE;margin-bottom:24px}
    h1{font:900 54px/1.1 Inter;color:var(--ink);max-width:680px;margin:0 auto 20px;letter-spacing:-1.5px}
    h1 em{color:var(--brand);font-style:normal}
    .hero-sub{font:400 20px/1.6 Inter;color:var(--ink-2);max-width:520px;margin:0 auto 36px}
    .ctas{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
    .stats{display:flex;justify-content:center;gap:48px;flex-wrap:wrap;margin-top:56px;padding-top:40px;border-top:1px solid var(--border)}
    .stat-num{font:800 30px Inter;color:var(--ink)}
    .stat-lbl{font:400 13px Inter;color:var(--ink-3);margin-top:2px}
    @media(max-width:680px){h1{font-size:36px}.hero-sub{font-size:16px}}

    .wrap{max-width:var(--max);margin:0 auto;padding:80px 24px}
    .alt{background:var(--bg-2)}
    .label{font:700 12px Inter;color:var(--brand);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px}
    h2{font:800 36px/1.2 Inter;color:var(--ink);margin-bottom:16px;letter-spacing:-.5px}
    .sub{font:400 18px/1.6 Inter;color:var(--ink-2);max-width:520px}
    @media(max-width:680px){h2{font-size:26px}.sub{font-size:15px}}

    .steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-top:48px}
    .step{background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:28px 24px}
    .step-num{width:36px;height:36px;border-radius:50%;background:var(--brand-light);color:var(--brand);font:800 16px Inter;display:flex;align-items:center;justify-content:center;margin-bottom:14px}
    .step h3{font:700 17px Inter;color:var(--ink);margin-bottom:8px}
    .step p{font:400 14px/1.6 Inter;color:var(--ink-2)}
    .step-icon{font-size:26px;margin-bottom:10px}

    .fish-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:14px;margin-top:48px}
    .fish-card{background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:20px 14px;text-align:center;transition:box-shadow .15s,transform .15s}
    .fish-card:hover{box-shadow:0 8px 24px rgba(0,0,0,.08);transform:translateY(-2px)}
    .fish-emoji{font-size:32px;margin-bottom:8px}
    .fish-name{font:700 13px Inter;color:var(--ink);margin-bottom:3px}
    .fish-mr{font:400 12px Inter;color:var(--ink-3)}

    .features{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:48px}
    .feature{display:flex;gap:16px;align-items:flex-start;background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:24px}
    .feat-icon{width:44px;height:44px;border-radius:12px;background:var(--brand-light);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
    .feature h3{font:700 15px Inter;color:var(--ink);margin-bottom:6px}
    .feature p{font:400 13px/1.6 Inter;color:var(--ink-2)}

    .dark-cta{background:linear-gradient(135deg,#0F172A,#1E3A5F);border-radius:24px;padding:56px 40px;text-align:center;color:#fff;max-width:var(--max);margin:0 auto}
    .dark-cta h2{color:#fff;margin-bottom:16px}
    .dark-cta .sub{color:#94A3B8;margin:0 auto 32px}
    .btn-white{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--ink);font:700 16px Inter;padding:16px 32px;border-radius:12px;transition:background .15s}
    .btn-white:hover{background:#F1F5F9}
    .perks{display:flex;justify-content:center;gap:28px;margin-top:28px;flex-wrap:wrap}
    .perk{font:500 13px Inter;color:#CBD5E1;display:flex;align-items:center;gap:6px}
    @media(max-width:600px){.dark-cta{padding:40px 20px}}

    .faqs{display:flex;flex-direction:column;gap:10px;margin-top:48px}
    .faq{background:#fff;border:1px solid var(--border);border-radius:var(--r);overflow:hidden}
    .faq summary{font:600 15px Inter;color:var(--ink);padding:20px 24px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center}
    .faq summary::-webkit-details-marker{display:none}
    .faq summary::after{content:"+";font:700 20px Inter;color:var(--ink-3)}
    .faq[open] summary::after{content:"−";color:var(--brand)}
    .faq p{font:400 14px/1.7 Inter;color:var(--ink-2);padding:0 24px 20px}

    footer{background:var(--ink);color:#64748B;padding:48px 24px 32px}
    .ft{max-width:var(--max);margin:0 auto}
    .ft-top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:32px;margin-bottom:40px}
    .ft-brand{font:800 22px Inter;color:#fff;margin-bottom:8px}
    .ft-brand span{color:#60A5FA}
    .ft-links{display:flex;gap:48px;flex-wrap:wrap}
    .ft-col h4{font:600 13px Inter;color:#fff;margin-bottom:12px}
    .ft-col a{display:block;font:400 13px Inter;color:#64748B;margin-bottom:8px;transition:color .15s}
    .ft-col a:hover{color:#fff}
    .ft-bottom{border-top:1px solid #1E293B;padding-top:24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font:400 12px Inter;color:#475569}
  </style>
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="logo">🐟 <span>Relifish</span></a>
    <div class="nav-links">
      <a href="#how" class="nav-link">How it works</a>
      <a href="#fish" class="nav-link">Our fish</a>
      <a href="#sell" class="nav-link">Sell with us</a>
      <a href="/dashboard/login" class="nav-link">Seller login</a>
      <a href="/shop" class="btn btn-primary" style="padding:10px 20px;font-size:14px;">Order now →</a>
    </div>
    <a href="/shop" class="btn btn-primary" id="m-cta" style="display:none;padding:10px 18px;font-size:14px;">Order →</a>
  </div>
</nav>
<script>document.getElementById('m-cta').style.display=window.innerWidth<=640?'inline-flex':'none'</script>

<section class="hero">
  <div class="badge">🎣 Mumbai's freshest fish marketplace</div>
  <h1>Fresh fish from<br /><em>local sellers.</em><br />Ready by morning.</h1>
  <p class="hero-sub">Pre-order tonight's catch directly from trusted Mumbai fish sellers. Pickup or delivery — straight from the source, zero middleman markup.</p>
  <div class="ctas">
    <a href="/shop" class="btn btn-primary btn-lg">🐟 Order fresh fish</a>
    <a href="#how" class="btn btn-secondary btn-lg">How it works ↓</a>
  </div>
  <div class="stats">
    <div><div class="stat-num">10+</div><div class="stat-lbl">Local sellers</div></div>
    <div><div class="stat-num">15+</div><div class="stat-lbl">Fish varieties</div></div>
    <div><div class="stat-num">0%</div><div class="stat-lbl">Middleman markup</div></div>
    <div><div class="stat-num">Mumbai</div><div class="stat-lbl">Starting here</div></div>
  </div>
</section>

<div class="alt" id="how">
  <div class="wrap">
    <div class="label">How it works</div>
    <h2>Fresh fish in 3 steps</h2>
    <p class="sub">No subscription. No minimum. Order as little or as much as you need.</p>
    <div class="steps">
      <div class="step"><div class="step-icon">📍</div><div class="step-num">1</div><h3>Set your location</h3><p>Share your area once. We show sellers who deliver or offer pickup near you.</p></div>
      <div class="step"><div class="step-icon">🌙</div><div class="step-num">2</div><h3>Pre-order tonight</h3><p>Browse today's menu, pick your fish, and place your order before the cutoff.</p></div>
      <div class="step"><div class="step-icon">🌅</div><div class="step-num">3</div><h3>Collect fresh in the morning</h3><p>Your seller preps from the morning catch. Pickup or home delivery — your choice.</p></div>
    </div>
  </div>
</div>

<div class="wrap" id="fish">
  <div class="label">Available fish</div>
  <h2>What's on the menu</h2>
  <p class="sub">Availability changes daily based on the catch. Pre-order to reserve your portion.</p>
  <div class="fish-grid">
    {[
      {e:"🐟",n:"Pomfret",m:"पापलेट"},
      {e:"🐠",n:"Surmai (Kingfish)",m:"सुरमई"},
      {e:"🐡",n:"Bangda (Mackerel)",m:"बांगडा"},
      {e:"🦐",n:"Prawns",m:"कोळंबी"},
      {e:"🐟",n:"Rawas (Salmon)",m:"रावस"},
      {e:"🦀",n:"Crab",m:"खेकडा"},
      {e:"🐠",n:"Halwa",m:"हलवा"},
      {e:"🐡",n:"Bombay Duck",m:"बोंबील"},
    ].map(f=>(
      <a href="/shop" class="fish-card">
        <div class="fish-emoji">{f.e}</div>
        <div class="fish-name">{f.n}</div>
        <div class="fish-mr">{f.m}</div>
      </a>
    ))}
  </div>
</div>

<div class="alt">
  <div class="wrap">
    <div class="label">Why Relifish</div>
    <h2>Better than the market.<br/>Fresher than delivery apps.</h2>
    <div class="features">
      {[
        {i:"💰",t:"No middleman markup",d:"Buy directly from the seller. Zepto and Blinkit add 25–30% margin. We don't."},
        {i:"🌊",t:"Truly fresh",d:"Pre-orders are filled from the next morning's catch — not 3-day-old cold storage stock."},
        {i:"📍",t:"Hyper-local sellers",d:"Your neighbourhood fish seller, now online. Same quality, same trust, easier ordering."},
        {i:"🌙",t:"Pre-order tonight",d:"Place before the cutoff and your seller reserves your fish before it sells out."},
        {i:"🛵",t:"Pickup or delivery",d:"Collect from the seller or get home delivery — your choice, seller's terms."},
        {i:"💬",t:"Direct seller contact",d:"WhatsApp your seller directly. Ask about cuts, freshness, and build a real relationship."},
      ].map(f=>(
        <div class="feature">
          <div class="feat-icon">{f.i}</div>
          <div><h3>{f.t}</h3><p>{f.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</div>

<div style="padding:64px 24px" id="sell">
  <div class="dark-cta">
    <h2>Sell your catch on Relifish</h2>
    <p class="sub">List your fish online in minutes. Get pre-orders every evening so you know exactly what to bring in tomorrow morning. Zero commission to start.</p>
    <a href="/dashboard/login" class="btn-white">🐟 Start selling free →</a>
    <div class="perks">
      <div class="perk">✓ Free to list</div>
      <div class="perk">✓ Keep your customers</div>
      <div class="perk">✓ No app to download</div>
      <div class="perk">✓ WhatsApp notifications</div>
    </div>
  </div>
</div>

<div class="alt">
  <div class="wrap">
    <div class="label">FAQ</div>
    <h2>Common questions</h2>
    <div class="faqs">
      {[
        {q:"How does Relifish work?",a:"Browse local fish sellers near you, pre-order tonight's catch before the seller's cutoff, and collect it fresh tomorrow morning or receive home delivery."},
        {q:"What fish can I order?",a:"Pomfret, Surmai, Bangda, Prawns, Rawas, Crab, Halwa, Bombay Duck and more — updated daily based on the morning catch from sellers near you."},
        {q:"Is Relifish available near me?",a:"Currently serving Mumbai — Versova, Andheri West, and expanding fast. Set your location in the app to see sellers who cover your area."},
        {q:"What if my order can't be fulfilled?",a:"If a seller can't fulfil your order, they'll decline and you get a full refund within 7 days. You can also WhatsApp the seller directly before the morning."},
        {q:"How do I become a seller?",a:"Sign up at relifish.store/dashboard/login with your mobile number. Add your listings with photos and prices. Buyers in your area can order the same day. Free to start."},
        {q:"Is there a minimum order?",a:"Each seller sets their own minimum. You'll see it clearly on the seller's page before adding to cart."},
      ].map(item=>(
        <details class="faq">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</div>

<footer>
  <div class="ft">
    <div class="ft-top">
      <div>
        <div class="ft-brand">🐟 <span>Relifish</span></div>
        <div>Mumbai's fresh fish marketplace.<br/>Direct from local sellers.</div>
      </div>
      <div class="ft-links">
        <div class="ft-col">
          <h4>For buyers</h4>
          <a href="/shop">Browse sellers</a>
          <a href="/shop">Order fish</a>
          <a href="/me">My account</a>
          <a href="/track">Track order</a>
        </div>
        <div class="ft-col">
          <h4>For sellers</h4>
          <a href="/dashboard/login">Seller login</a>
          <a href="/dashboard/listings">My listings</a>
          <a href="/dashboard/orders">My orders</a>
        </div>
        <div class="ft-col">
          <h4>Company</h4>
          <a href="/privacy">Privacy policy</a>
          <a href="mailto:relifishstore@gmail.com">Contact us</a>
        </div>
      </div>
    </div>
    <div class="ft-bottom">
      <div>© 2026 Relifish. Made with 🐟 in Mumbai.</div>
      <div>Fresh fish, direct from source.</div>
    </div>
  </div>
</footer>

</body>
</html>
