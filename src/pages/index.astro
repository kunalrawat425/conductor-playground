<script>
(function(){
  const TOTAL = 9;
  const DURATION = 3200; // ms per step
  let current = 0;
  let timer = null;
  let barTimer = null;
  let barStart = null;
  let paused = false;

  const screens = document.querySelectorAll('.demo-screen');
  const dots = document.querySelectorAll('.demo-dot');
  const bar = document.getElementById('demo-bar');
  const phone = document.getElementById('demo-phone');

  function goTo(idx, direction) {
    const prev = current;
    current = ((idx % TOTAL) + TOTAL) % TOTAL;

    // exit prev
    screens[prev].classList.remove('active');
    screens[prev].classList.add('exit');
    setTimeout(() => screens[prev].classList.remove('exit'), 380);

    // enter next — direction: 1=forward, -1=back
    screens[current].style.transform = direction >= 0 ? 'translateX(24px)' : 'translateX(-24px)';
    screens[current].classList.add('active');
    // force reflow then animate
    screens[current].getBoundingClientRect();
    screens[current].style.transform = '';

    // dots
    dots.forEach((d, i) => d.classList.toggle('active', i === current));

    // restart progress bar
    startBar();
  }

  function startBar() {
    if (barTimer) cancelAnimationFrame(barTimer);
    barStart = performance.now();
    function tick(now) {
      if (paused) { barTimer = requestAnimationFrame(tick); return; }
      const pct = Math.min(((now - barStart) / DURATION) * 100, 100);
      bar.style.width = pct + '%';
      if (pct >= 100) {
        goTo(current + 1, 1);
      } else {
        barTimer = requestAnimationFrame(tick);
      }
    }
    barTimer = requestAnimationFrame(tick);
  }

  // tap phone to advance
  phone.addEventListener('click', () => {
    // reset bar and go forward
    if (barTimer) cancelAnimationFrame(barTimer);
    goTo(current + 1, 1);
  });

  // dot clicks — jump to step
  dots.forEach((dot, i) => {
    dot.addEventListener('click', (e) => {
      e.stopPropagation();
      if (barTimer) cancelAnimationFrame(barTimer);
      const dir = i >= current ? 1 : -1;
      // update current before goTo so goTo can compute properly
      goTo(i, dir);
    });
  });

  // pause on hover
  phone.addEventListener('mouseenter', () => { paused = true; });
  phone.addEventListener('mouseleave', () => { paused = false; barStart = performance.now() - (parseFloat(bar.style.width || '0') / 100 * DURATION); });

  // touch swipe
  let touchStartX = 0;
  phone.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, {passive:true});
  phone.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 30) {
      if (barTimer) cancelAnimationFrame(barTimer);
      goTo(dx < 0 ? current + 1 : current - 1, dx < 0 ? 1 : -1);
    }
  }, {passive:true});

  // start
  startBar();
})();
</script>

