---
export const prerender = false;
import Analytics from "@vercel/analytics/astro";
import { supabase } from "../lib/supabase";
const SITE = "https://www.relifish.store";

let areaListings: any[] = [];
const speciesMap = new Map<string, { min: number; max: number; count: number }>();

try {
  const { data: listData } = await supabase
    .from("fish_listings")
    .select("*, seller:sellers(*)")
    .or("is_available.eq.true,is_preorder_enabled.eq.true");

  if (listData) {
    areaListings = listData.filter(l => l.seller?.is_active && l.seller?.name !== "New Seller");
    
    // Calculate dynamic price ranges per species
    for (const l of areaListings) {
      const species = (l.species || "").toLowerCase().trim();
      if (!species) continue;

      const rawOpts = Array.isArray(l.pricing_options) ? l.pricing_options : [];
      let pMin = Number(l.price) || 0;
      let pMax = Number(l.price) || 0;

      if (rawOpts.length > 0) {
        pMin = Infinity;
        pMax = -Infinity;
        for (const o of rawOpts) {
          const p = Number(o?.price ?? o?.preorder_price_min ?? o?.preorder_price_max ?? l.price) || 0;
          if (p < pMin) pMin = p;
          if (p > pMax) pMax = p;
        }
      }

      const exist = speciesMap.get(species);
      if (exist) {
        exist.min = Math.min(exist.min, pMin);
        exist.max = Math.max(exist.max, pMax);
        exist.count += 1;
      } else {
        speciesMap.set(species, { min: pMin, max: pMax, count: 1 });
      }
    }
  }
} catch (err) {
  console.error("Error fetching listings for index page:", err);
}

const schemaProducts = Array.from(speciesMap.entries()).map(([species, data]) => {
  const title = species.charAt(0).toUpperCase() + species.slice(1);
  return {
    "@type": "Product",
    "@id": `${SITE}/#product-${species}`,
    "name": `Fresh ${title} Online`,
    "description": `Buy fresh ${title} online in Mumbai. Sourced direct from verified local sellers. Same-day pickup or home delivery with zero platform markup.`,
    "category": "Seafood",
    "brand": { "@type": "Brand", "name": "Relifish" },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "INR",
      "lowPrice": String(data.min),
      "highPrice": String(data.max),
      "offerCount": String(data.count),
      "priceValidUntil": "2027-12-31",
      "availability": "https://schema.org/InStock",
      "url": SITE
    }
  };
});
