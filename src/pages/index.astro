    .nav.scrolled{background:rgba(5,9,26,.94);backdrop-filter:blur(20px);border-bottom:1px solid var(--dark-border)}
    .nav-inner{max-width:var(--max);margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:16px 28px}
    .logo{font:800 22px/1 Inter;color:#fff;letter-spacing:-.5px}
    .logo span{color:var(--teal)}
    .logo-img {
      height: 44px;
      width: auto;
      display: block;
      filter: brightness(0) invert(1);
      transition: height 0.15s ease;
    }
    @media (min-width: 768px) {
      .logo-img {
        height: 50px;
      }
    }
    .nav-links{display:flex;align-items:center;gap:2px}
    .nl{font:500 14px Inter;color:rgba(255,255,255,.6);padding:8px 13px;border-radius:8px;transition:all .15s}
    .nl:hover{color:#fff;background:rgba(255,255,255,.07)}
    .btn-nav{display:inline-flex;align-items:center;gap:6px;font:700 14px Inter;padding:10px 20px;border-radius:10px;background:var(--blue);color:#fff;transition:all .15s;white-space:nowrap;border:none;cursor:pointer}
    .btn-nav:hover{background:var(--blue-dark);transform:translateY(-1px)}
    @media(max-width:760px){.nav-links .nl{display:none}}

    /* ── Hero ── */
    .hero{min-height:100svh;background:var(--dark);position:relative;display:flex;align-items:center;overflow:hidden;padding-top:72px}
    .hero-orb1{position:absolute;width:600px;height:400px;top:-80px;left:-150px;background:radial-gradient(ellipse,rgba(37,99,235,.16) 0%,transparent 70%);pointer-events:none}
    .hero-orb2{position:absolute;width:500px;height:350px;bottom:-40px;right:-80px;background:radial-gradient(ellipse,rgba(37,99,235,.1) 0%,transparent 70%);pointer-events:none}
    .hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);background-size:56px 56px;pointer-events:none}
    .hero-inner{max-width:var(--max);margin:0 auto;padding:60px 28px 80px;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;position:relative;z-index:2;width:100%}

    h1{font:900 58px/1.04 Inter;color:#fff;letter-spacing:-2px;margin-bottom:20px}
    h1 .blu{color:var(--blue-light)}
    h1 .dim{color:rgba(255,255,255,.7)}
    .hero-sub{font:400 18px/1.65 Inter;color:rgba(255,255,255,.52);max-width:440px;margin-bottom:28px}
    .hero-sub strong{color:rgba(255,255,255,.82);font-weight:600}
    .hero-cite{font:400 13px/1.6 Inter;color:rgba(255,255,255,.5);max-width:440px;margin-bottom:20px}

    /* fish chips */
    .fish-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
    .ftag{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:100px;padding:6px 14px;font:500 13px Inter;color:#fff}

    .hero-ctas{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:24px}
    .btn-primary{display:inline-flex;align-items:center;gap:8px;font:700 16px Inter;padding:14px 28px;border-radius:12px;background:var(--blue);color:#fff;box-shadow:0 8px 32px var(--blue-glow);transition:all .2s;border:none;cursor:pointer}
    .btn-primary:hover{background:var(--blue-dark);transform:translateY(-2px);box-shadow:0 16px 48px var(--blue-glow)}
    .btn-ghost{display:inline-flex;align-items:center;gap:8px;font:600 16px Inter;padding:13px 24px;border-radius:12px;background:rgba(255,255,255,.05);color:rgba(255,255,255,.78);border:1px solid rgba(255,255,255,.14);transition:all .2s}
    .btn-ghost:hover{background:rgba(255,255,255,.09);color:#fff;border-color:rgba(255,255,255,.24)}

    .hero-urgency{display:flex;align-items:center;gap:8px;font:500 13px Inter;color:rgba(255,255,255,.38)}
    .udot{width:6px;height:6px;border-radius:50%;background:#F87171;animation:blink 1.5s infinite;flex-shrink:0}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

    .hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--dark-border);border-radius:14px;overflow:hidden;border:1px solid var(--dark-border);margin-top:36px}
    .hs{background:rgba(255,255,255,.03);padding:16px 12px;text-align:center}
    .hs-n{font:800 24px Inter;color:#fff;letter-spacing:-1px}
    .hs-l{font:400 11px Inter;color:rgba(255,255,255,.3);margin-top:2px}

    @media(max-width:940px){.hero-inner{grid-template-columns:1fr}.hero-right{display:none}h1{font-size:42px}}
    @media(max-width:480px){h1{font-size:34px;letter-spacing:-1.4px}.hero-sub{font-size:16px}}

    /* ── Hero right — interactive phone demo ── */
    .hero-right{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px}

    /* phone shell */
    .demo-phone{
      width:270px;
      background:linear-gradient(175deg,#1E2D4A,#0D1629);
      border-radius:44px;
      border:2px solid rgba(255,255,255,.15);
      box-shadow:0 48px 96px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.05),inset 0 1px 0 rgba(255,255,255,.08);
      overflow:hidden;
      position:relative;
      cursor:pointer;
      user-select:none;
    }
    .demo-notch{height:28px;background:#000;display:flex;align-items:center;justify-content:center}
    .demo-pill{width:72px;height:9px;background:#111;border-radius:100px}

    /* progress bar */
    .demo-progress{height:2px;background:rgba(255,255,255,.08)}
    .demo-progress-fill{height:100%;background:var(--blue);width:0%;transition:width .1s linear;border-radius:1px}

    /* screen container */
    .demo-screens{height:500px;overflow:hidden;position:relative}
    .demo-screen{
      position:absolute;inset:0;
      opacity:0;
      transform:translateX(24px);
      transition:opacity .35s ease,transform .35s ease;
      pointer-events:none;
    }
    .demo-screen.active{opacity:1;transform:translateX(0);pointer-events:auto}
    .demo-screen.exit{opacity:0;transform:translateX(-24px)}

    /* step dots */
    .demo-dots{display:flex;align-items:center;gap:6px;justify-content:center}
    .demo-dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.2);cursor:pointer;transition:all .2s}
    .demo-dot.active{background:var(--blue);width:18px;border-radius:3px}

    /* nav hint */
    .demo-hint{font:500 11px Inter;color:rgba(255,255,255,.3);text-align:center}

    /* ── Screen styles ── */
    /* all screens share base bg */
    .ds-light{background:#F7F8FC;height:100%;position:relative}
    .ds-dark{background:#050D1A;height:100%;position:relative}

    /* screen header */
    .dh{background:#fff;border-bottom:1px solid #EAECF0;padding:10px 13px}
    .dh-title{font:700 11px Inter;color:#0A0F1E}
    .dh-sub{font:400 8px Inter;color:#9CA3AF;margin-top:1px}
