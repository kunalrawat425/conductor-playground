<script>
  // Header menu: close after a jump link or an outside tap.
  const menu = document.getElementById("nav-menu") as HTMLDetailsElement | null;
  menu?.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) menu.open = false; });
  document.addEventListener("click", (e) => { if (menu?.open && !menu.contains(e.target as Node)) menu.open = false; });

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ── Photo dial: drag/swipe with inertia, snaps like a phone dial, slow auto-turn when idle ──
  const dial = document.getElementById("dial") as HTMLElement;
  const cards = Array.from(dial.querySelectorAll<HTMLElement>(".dc"));
  const STEP = 13, SPAN = cards.length * STEP, IDLE_MS = 2500;
  let ang = 0, vel = 0, drag = false, moved = false, hover = false, startX = 0, lastX = 0, idleAt = -IDLE_MS, raf = 0, onScreen = false;
  function lay() {
    cards.forEach((c, i) => {
      let a = (((i * STEP + ang) % SPAN) + SPAN) % SPAN;
      if (a > SPAN / 2) a -= SPAN;
      c.style.visibility = Math.abs(a) < 48 ? "" : "hidden";
      c.style.transform = `rotate(${a}deg)`;
      c.style.zIndex = String(100 - Math.round(Math.abs(a)));
    });
  }
  function tick(t: number) {
    raf = 0;
    if (!drag) {
      const settling = t - idleAt < IDLE_MS;
      if (Math.abs(vel) > 0.05) { ang += vel; vel *= 0.94; }
      else if (!settling && !reduce && !hover) ang -= 0.12;
      if (Math.abs(vel) < 0.3 && settling) { const tgt = Math.round(ang / STEP) * STEP; ang += (tgt - ang) * 0.12; }
      lay();
      // Reduced motion: stop once the snap has settled instead of turning on its own.
      if (reduce && !settling && Math.abs(vel) <= 0.05) return;
    }
    if (onScreen) raf = requestAnimationFrame(tick);
  }
  const kick = () => { if (!raf && onScreen) raf = requestAnimationFrame(tick); };
  new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; if (onScreen) kick(); }).observe(dial);
  dial.addEventListener("pointerdown", (e) => { drag = true; moved = false; startX = lastX = e.clientX; vel = 0; kick(); });
  dial.addEventListener("pointermove", (e) => {
    if (!drag) return;
    // Capture only once it is a real drag, so a plain tap still clicks the card under the finger.
    if (!moved && Math.abs(e.clientX - startX) > 6) { moved = true; dial.setPointerCapture(e.pointerId); dial.classList.add("grabbing"); }
    if (moved) { const dx = e.clientX - lastX; ang += dx * 0.35; vel = dx * 0.35; lay(); }
    lastX = e.clientX;
  });
  const release = () => { if (!drag) return; drag = false; idleAt = performance.now(); dial.classList.remove("grabbing"); kick(); };
  dial.addEventListener("pointerup", release);
  dial.addEventListener("pointercancel", release);
  dial.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") hover = true; });
  dial.addEventListener("pointerleave", () => { hover = false; });
  dial.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    e.preventDefault();
    ang = Math.round(ang / STEP) * STEP + (e.key === "ArrowLeft" ? STEP : -STEP);
    vel = 0; idleAt = performance.now(); lay(); kick();
  });

  // ── Claim this spot ──
  const sheet = document.getElementById("claim-sheet") as HTMLDialogElement;
  const el = (id: string) => document.getElementById(id) as HTMLElement;
  let completed: Promise<any> | null = null;
  const buyerId = () => { try { return localStorage.getItem("rlf_buyer_id") && localStorage.getItem("rlf_phone") ? localStorage.getItem("rlf_buyer_id") : null; } catch { return null; } };
  // The buyer's latest delivered / picked-up order, via the same API /track uses (newest first).
  const latestCompleted = (id: string) => (completed ??= fetch(`/api/buyer/orders?buyer_id=${encodeURIComponent(id)}&scope=past&page_size=20`)
    .then((r) => (r.ok ? r.json() : { orders: [] }))
    .then((b) => (b.orders || []).find((o: any) => o.status === "completed" || o.status === "picked_up") || null)
    .catch(() => null));
  async function openClaim() {
    const id = buyerId();
    const order = id ? await latestCompleted(id) : null;
    const state = order ? "can_claim" : id ? "no_completed_order" : "guest";
    const ic = el("claim-ic"), go = el("claim-go") as HTMLAnchorElement;
    if (order) {
      ic.textContent = "★★★★★"; ic.classList.add("stars");
      el("claim-t").textContent = "Claim your spot";
      const seller = order.listing?.seller?.name;
      el("claim-p").textContent = `${seller ? `Your order from ${seller}` : "Your order"} was delivered. Rate it and add a photo of your plate.`;
      go.href = `/track/${encodeURIComponent(order.id)}`; go.textContent = "Rate it & add a photo →";
      el("claim-x").textContent = "Maybe later";
    } else {
      ic.textContent = "🐟"; ic.classList.remove("stars");
      el("claim-t").textContent = "This spot is waiting for you";
      el("claim-p").textContent = "Order your first fresh fish. After it's delivered, post your plate and your review here.";
      go.href = "/shop"; go.textContent = "Shop now →";
      el("claim-x").textContent = "Keep browsing";
    }
    (window as any).gtag?.("event", "claim_spot_tap", { state });
    if (!sheet.open) sheet.showModal();
  }
  document.addEventListener("click", (e) => {
    const b = (e.target as Element).closest("[data-claim]");
    if (!b || (moved && b.closest("#dial"))) return;
    openClaim();
  });
  el("claim-x").addEventListener("click", () => sheet.close());
  sheet.addEventListener("click", (e) => { if (e.target === sheet) sheet.close(); });

  // ── What buyers say: rotate slides (paused on hover/focus, off for reduced motion) ──
  const rv = el("rv");
  const slides = Array.from(rv.querySelectorAll<HTMLElement>(".rv-slide"));
  const dots = Array.from(document.querySelectorAll<HTMLElement>("#rv-dots i"));
  let r = 0;
  if (!reduce && slides.length > 1) setInterval(() => {
    if (document.hidden || rv.matches(":hover, :focus-within")) return;
    slides[r].hidden = true; dots[r].classList.remove("on");
    r = (r + 1) % slides.length;
    slides[r].hidden = false; dots[r].classList.add("on");
  }, 4000);
</script>

