    .demo-cta-btn{background:var(--blue);border-radius:9px;padding:10px;text-align:center;font:700 10px Inter;color:#fff;width:100%;box-sizing:border-box}
    .demo-cta-sub{text-align:center;font:400 7px Inter;color:#9CA3AF;padding:4px 0 0}
    /* legacy kept for screen 8 reuse */
    .d0-btn{display:none}
    .d0-sticky{display:none}

    /* screen 1 — location */
    .d1-area{display:flex;align-items:center;gap:8px;padding:8px 9px;border-radius:8px;border:1px solid #EAECF0;background:#fff;margin:0 10px 5px}
    .d1-area.tap{border-color:var(--blue);background:#EFF6FF;animation:d1tap .4s ease}
    @keyframes d1tap{0%,100%{transform:scale(1)}40%{transform:scale(.97)}}
    .d1-icon{font-size:13px}
    .d1-name{font:700 9px Inter;color:#0A0F1E}
    .d1-dist{font:400 7px Inter;color:#9CA3AF}
    .d1-check{width:14px;height:14px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:7px;color:#fff;margin-left:auto}

    /* screen 2 — sellers */
    .d2-tabs{display:flex;background:#fff;border-bottom:1px solid #EAECF0}
    .d2t{font:600 8px Inter;padding:7px 10px;border-bottom:2px solid transparent;color:#9CA3AF}
    .d2t.on{color:var(--blue);border-bottom-color:var(--blue)}
    .d2-list{padding:7px 8px;display:flex;flex-direction:column;gap:6px}
    .d2-card{background:#fff;border-radius:9px;border:1px solid #EAECF0;overflow:hidden}
    .d2-card.tap{border-color:var(--blue);animation:d1tap .4s ease}
    .d2-img{height:36px;display:flex;align-items:center;justify-content:center;font-size:18px;position:relative}
    .d2-badge{position:absolute;top:3px;right:4px;font:700 6px Inter;padding:1px 5px;border-radius:100px}
    .d2-badge.op{background:#2563EB;color:#fff}
    .d2-badge.pr{background:#7C3AED;color:#fff}
    .d2-info{padding:5px 7px}
    .d2-name{font:700 9px Inter;color:#0A0F1E}
    .d2-sub{font:400 7px Inter;color:#9CA3AF;margin-top:1px}

    /* screen 3 — fish menu */
    .d3-item{display:flex;align-items:center;justify-content:space-between;padding:7px 8px;background:#fff;border-bottom:1px solid #F3F4F6}
    .d3-item.tap{background:#EFF6FF;animation:d1tap .4s ease}
    .d3-emoji{font-size:18px;margin-right:6px}
    .d3-name{font:700 9px Inter;color:#0A0F1E}
    .d3-cut{font:400 7px Inter;color:#9CA3AF;margin-top:1px}
    .d3-lock{font:600 7px Inter;color:var(--blue);display:flex;align-items:center;gap:2px}
    .d3-add{background:var(--blue);color:#fff;font:700 7px Inter;padding:4px 8px;border-radius:6px}
    .d3-add.added{background:#059669}
    .d3-bar{background:var(--blue);border-radius:9px;padding:8px 10px;display:flex;justify-content:space-between;align-items:center;width:100%;box-sizing:border-box}
    .d3-bar-t{font:700 9px Inter;color:#fff}
    .d3-bar-p{font:800 10px Inter;color:rgba(255,255,255,.8)}

    /* screen 4 — cart */
    .d4-item{display:flex;align-items:center;justify-content:space-between;padding:7px 10px;background:#fff;border-bottom:1px solid #F3F4F6}
    .d4-name{font:600 9px Inter;color:#0A0F1E}
    .d4-lock{font:500 7px Inter;color:var(--blue)}
    .d4-qty{display:flex;align-items:center;gap:5px}
    .d4-q{width:18px;height:18px;background:#EFF6FF;border-radius:5px;display:flex;align-items:center;justify-content:center;font:700 10px Inter;color:var(--blue)}
    .d4-summary{margin:6px 9px;background:#EFF6FF;border:1px solid #BFDBFE;border-radius:9px;padding:8px 10px}
    .d4-row{display:flex;justify-content:space-between;font:500 8px Inter;color:#1E40AF;margin-bottom:3px}
    @keyframes pulseblue{0%,100%{box-shadow:0 0 0 0 rgba(37,99,235,.4)}50%{box-shadow:0 0 0 5px rgba(37,99,235,0)}}

    /* screen 5 — payment */
    .d5-amount{text-align:center;padding:16px 10px 10px}
    .d5-to{font:400 8px Inter;color:#9CA3AF}
    .d5-seller{font:700 11px Inter;color:#0A0F1E;margin:3px 0}
    .d5-amt-label{font:400 9px Inter;color:#9CA3AF}
    .d5-amt{font:800 22px Inter;color:#0A0F1E;letter-spacing:-1px}
    .d5-amt span{font-size:14px;font-weight:500;color:#9CA3AF}
    .d5-upi-apps{display:flex;justify-content:center;gap:8px;padding:6px 10px}
    .d5-app{display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px;border-radius:9px;background:#F3F4F6;border:1px solid #E5E7EB;width:52px}
    .d5-app.tap{border-color:var(--blue);background:#EFF6FF;animation:d1tap .4s ease}
    .d5-app-icon{font-size:18px}
    .d5-app-name{font:600 7px Inter;color:#374151}
    .d5-pay-btn{background:var(--blue);border-radius:9px;padding:9px;text-align:center;font:700 10px Inter;color:#fff}
    .d5-pay-sticky{position:absolute;bottom:0;left:0;right:0;padding:8px 10px 20px;background:#F7F8FC}

    /* screen 6 — confirmed */
    .d6-center{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:16px;text-align:center;gap:8px}
    .d6-icon{width:52px;height:52px;border-radius:50%;background:#EFF6FF;border:2px solid #BFDBFE;display:flex;align-items:center;justify-content:center;font-size:26px;animation:popcheck .5s ease both}
    @keyframes popcheck{0%{transform:scale(0)}80%{transform:scale(1.15)}100%{transform:scale(1)}}
    .d6-title{font:800 13px Inter;color:#0A0F1E}
    .d6-sub{font:400 9px/1.4 Inter;color:#6B7280}
    .d6-eta{background:#EFF6FF;border:1px solid #BFDBFE;border-radius:8px;padding:7px 10px;width:100%}
    .d6-eta-t{font:700 9px Inter;color:var(--blue)}
    .d6-eta-s{font:400 7px Inter;color:#93C5FD;margin-top:1px}

    /* screen 7 — tracking */
    .d7-step{display:flex;align-items:flex-start;gap:10px;padding:8px 10px}
    .d7-dot-wrap{display:flex;flex-direction:column;align-items:center}
    .d7-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
    .d7-dot.done{background:var(--blue)}
    .d7-dot.active{background:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.2);animation:trackpulse 1.5s infinite}
    @keyframes trackpulse{0%,100%{box-shadow:0 0 0 3px rgba(37,99,235,.2)}50%{box-shadow:0 0 0 6px rgba(37,99,235,0)}}
    .d7-dot.pending{background:#E5E7EB}
    .d7-line{width:1px;height:20px;background:#E5E7EB;margin:2px 0}
    .d7-line.done{background:var(--blue)}
    .d7-label{font:700 9px Inter;color:#0A0F1E;margin-bottom:1px}
    .d7-sub{font:400 7px Inter;color:#9CA3AF}
    .d7-sub.blue{color:var(--blue)}

    /* screen 8 — delivered */
    .d8-center{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:16px;text-align:center;gap:8px}
    .d8-icon{font-size:48px;animation:wiggle 1s .2s ease both}
    @keyframes wiggle{0%,100%{transform:rotate(0deg)}25%{transform:rotate(-8deg)}75%{transform:rotate(8deg)}}
    .d8-title{font:800 14px Inter;color:#0A0F1E}
    .d8-sub{font:400 9px/1.5 Inter;color:#6B7280}
    .d8-rate{background:#FFF7ED;border:1px solid #FED7AA;border-radius:8px;padding:7px 10px;width:100%}
    .d8-rate-t{font:600 8px Inter;color:#92400E}
    .d8-stars{font-size:14px;margin-top:3px}

    /* floating fish badges */
    .fish3d{
      position:absolute;border-radius:14px;display:flex;align-items:center;gap:9px;padding:9px 13px;
      background:rgba(13,22,41,.92);border:1px solid rgba(255,255,255,.1);box-shadow:0 14px 36px rgba(0,0,0,.5);
      backdrop-filter:blur(12px);z-index:10;animation:floatfish 4s ease-in-out infinite;
    }
    .fish3d:nth-child(1){top:20px;right:-10px;animation-delay:0s}
    .fish3d:nth-child(2){bottom:80px;right:-20px;animation-delay:1.4s}
    .fish3d:nth-child(3){top:180px;right:-15px;animation-delay:2.8s}
    @keyframes floatfish{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
    .fish3d-e{font-size:28px;filter:drop-shadow(0 3px 6px rgba(0,0,0,.5));transform:scaleX(-1)}
    .fish3d-n{font:700 10px Inter;color:#fff}
    .fish3d-t{font:400 8px Inter;color:rgba(255,255,255,.4);margin-top:1px}
    .fish3d-f{font:700 7px Inter;color:var(--blue-light);background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.25);border-radius:100px;padding:2px 6px;margin-top:3px;display:inline-block}

    /* ── Ticker ── */
    .ticker{background:var(--dark-3);border-top:1px solid var(--dark-border);border-bottom:1px solid var(--dark-border);overflow:hidden;padding:10px 0}
    .ticker-track{display:flex;animation:marquee 30s linear infinite;width:max-content}
    .ticker-track:hover{animation-play-state:paused}
    @keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
    .ti{display:inline-flex;align-items:center;gap:8px;padding:0 20px;font:500 12px Inter;color:rgba(255,255,255,.45);white-space:nowrap}
    .ti .fish{color:var(--blue-light);font-weight:700}
    .ti .dot{width:3px;height:3px;border-radius:50%;background:rgba(255,255,255,.15)}

    /* ── Sections ── */
    .sec{padding:96px 28px}
    .sec-alt{background:var(--bg)}
    .sec-dark{background:var(--dark)}
    .sec-grad{background:linear-gradient(160deg,#050915,#0A1628,#050915)}
    .wrap{max-width:var(--max);margin:0 auto}
    .slabel{font:700 11px Inter;color:var(--blue-light);text-transform:uppercase;letter-spacing:2px;margin-bottom:14px}
    h2{font:800 42px/1.1 Inter;color:var(--ink);letter-spacing:-1.2px;margin-bottom:18px}
    h2 .hl{color:var(--blue)}
    .ssub{font:400 18px/1.65 Inter;color:var(--ink-2);max-width:520px}
    .dk h2{color:#fff}
    .dk .ssub{color:rgba(255,255,255,.5)}
    .dk .slabel{color:var(--blue-light)}
    .dk h2 .hl{color:var(--blue-light)}
    @media(max-width:640px){h2{font-size:30px}.ssub{font-size:16px}.sec{padding:72px 20px}}

    /* ── How it works — phone mockups ── */
    /* ── How it works — phone mockups ── */
    .flow-phones{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;margin-top:56px;align-items:flex-start}
    .flow-step{display:flex;flex-direction:column;align-items:center}
    .flow-step-num{
      width:36px;height:36px;border-radius:50%;
      background:var(--blue);color:#fff;font:800 15px Inter;
      display:flex;align-items:center;justify-content:center;
      margin-bottom:14px;box-shadow:0 4px 14px var(--blue-glow);
    }
    .flow-step h3{font:700 15px Inter;color:var(--ink);margin:14px 0 5px;text-align:center}
    .flow-step p{font:400 13px/1.55 Inter;color:var(--ink-2);text-align:center;max-width:175px}

    /* ── phone shell — bigger & premium ── */
    .fp{
      width:100%;max-width:200px;
      border-radius:34px;
      background:linear-gradient(175deg,#1E2D4A,#0D1629);
      border:1.5px solid rgba(255,255,255,.15);
      box-shadow:0 32px 72px rgba(0,0,0,.32),0 0 0 1px rgba(255,255,255,.05),inset 0 1px 0 rgba(255,255,255,.08);
      overflow:hidden;
    }
    .fp-notch{height:24px;background:#000;display:flex;align-items:center;justify-content:center}
    .fp-pill{width:70px;height:8px;background:#191919;border-radius:100px}
    .fp-screen{overflow:hidden;position:relative;height:360px;background:#F7F8FC}

    /* status bar inside each screen */
    .sbar{display:flex;justify-content:space-between;align-items:center;padding:5px 12px 4px;background:rgba(255,255,255,.98);border-bottom:1px solid rgba(0,0,0,.04)}
    .sbar-t{font:700 8px Inter;color:#0A0F1E}
    .sbar-i{display:flex;align-items:center;gap:3px;font-size:8px;color:#0A0F1E}

    /* ─ Screen 1: location ─ */
    .s1-hero{background:linear-gradient(135deg,#2563EB,#1D4ED8);padding:14px 13px 20px;position:relative;overflow:hidden}
    .s1-hero::before{content:'';position:absolute;bottom:-30px;right:-30px;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,.06)}
    .s1-hero-ttl{font:800 13px Inter;color:#fff;margin-bottom:2px}
    .s1-hero-sub{font:400 9px Inter;color:rgba(255,255,255,.65)}
    .s1-srch{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);border-radius:8px;padding:7px 10px;font:400 9px Inter;color:rgba(255,255,255,.65);margin-top:9px;display:flex;align-items:center;gap:5px}
    .s1-list{padding:8px 10px;display:flex;flex-direction:column;gap:6px}
    .s1-row{display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:10px;border:1px solid #E5E7EB;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.06)}
    .s1-row.sel{border-color:#2563EB;background:#EFF6FF;box-shadow:0 0 0 2px rgba(37,99,235,.1)}
    .s1-pin{width:26px;height:26px;border-radius:7px;background:#F3F4F6;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}
    .s1-row.sel .s1-pin{background:#DBEAFE}
    .s1-rn{font:700 10px Inter;color:#0A0F1E}
    .s1-rd{font:400 8px Inter;color:#9CA3AF;margin-top:1px}
    .s1-ck{width:16px;height:16px;border-radius:50%;background:#2563EB;display:flex;align-items:center;justify-content:center;font-size:8px;color:#fff;margin-left:auto;flex-shrink:0}
    .s1-btn{position:absolute;bottom:0;left:0;right:0;background:#2563EB;padding:10px;text-align:center;font:700 10px Inter;color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.35)}
    .s1-row.sel{animation:taprow .5s ease}
    @keyframes taprow{0%,100%{transform:scale(1)}40%{transform:scale(.975)}}

    /* ─ Screen 2: sellers ─ */
    .s2-top{background:#fff;padding:9px 12px;border-bottom:1px solid #F0F0F0}
    .s2-loc{display:flex;align-items:center;gap:3px;font:400 8px Inter;color:#6B7280}
    .s2-area{font:700 10px Inter;color:#0A0F1E;margin-left:2px}
    .s2-srch{background:#F3F4F6;border-radius:8px;padding:6px 9px;font:400 9px Inter;color:#9CA3AF;margin-top:7px;display:flex;align-items:center;gap:4px}
    .s2-tabs{display:flex;background:#fff;border-bottom:1px solid #F0F0F0}
    .s2t{font:600 9px Inter;padding:7px 11px;border-bottom:2px solid transparent;color:#9CA3AF}
    .s2t.on{color:#2563EB;border-bottom-color:#2563EB}
    .s2-list{padding:8px 9px;display:flex;flex-direction:column;gap:7px;animation:scrollup 5s ease-in-out 1s infinite}
    @keyframes scrollup{0%,35%,100%{transform:translateY(0)}55%,80%{transform:translateY(-52px)}}
    .s2-card{background:#fff;border-radius:10px;border:1px solid #EAECF0;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.07);transition:all .2s}
    .s2-card:first-child{border-color:#2563EB;box-shadow:0 0 0 1.5px rgba(37,99,235,.2),0 4px 12px rgba(37,99,235,.1)}
    .s2-cover{height:46px;display:flex;align-items:center;justify-content:center;font-size:20px;position:relative}
    .s2-cover.g{background:linear-gradient(135deg,#0D3B2E,#0A5940)}
    .s2-cover.p{background:linear-gradient(135deg,#1A0D4A,#2A3080)}
    .s2-cover.t{background:linear-gradient(135deg,#002828,#004040)}
    .s2-st{position:absolute;top:5px;right:6px;font:700 7px Inter;padding:2px 6px;border-radius:100px}
    .s2-st.op{background:#2563EB;color:#fff}
    .s2-st.pr{background:#7C3AED;color:#fff}
    .s2-bd{padding:7px 9px}
    .s2-nm{font:700 10px Inter;color:#0A0F1E}
    .s2-sub{font:400 8px Inter;color:#9CA3AF;margin-top:1px}
    .s2-chips{display:flex;gap:3px;margin-top:5px;flex-wrap:wrap}
    .s2-chip{background:#EFF6FF;border:1px solid #BFDBFE;border-radius:5px;padding:2px 6px;font:600 7px Inter;color:#2563EB}

    /* ─ Screen 3: checkout ─ */
    .s3-top{background:#fff;padding:9px 12px;border-bottom:1px solid #F0F0F0}
    .s3-bk{font:500 8px Inter;color:#2563EB;margin-bottom:3px;display:flex;align-items:center;gap:2px}
    .s3-ttl{font:800 12px Inter;color:#0A0F1E}
    .s3-seller{display:flex;align-items:center;gap:7px;margin:8px 10px 6px;padding:7px 9px;background:#F8F9FA;border-radius:9px;border:1px solid #E5E7EB}
    .s3-s-icon{width:24px;height:24px;border-radius:6px;background:linear-gradient(135deg,#0D3B2E,#0A5940);display:flex;align-items:center;justify-content:center;font-size:12px}
    .s3-s-name{font:700 9px Inter;color:#0A0F1E}
    .s3-s-sub{font:400 7px Inter;color:#9CA3AF}
    .s3-items{margin:0 10px;background:#fff;border:1px solid #EAECF0;border-radius:10px;overflow:hidden}
    .s3-item{display:flex;align-items:center;justify-content:space-between;padding:9px 10px;border-bottom:1px solid #F3F4F6}
    .s3-il{display:flex;align-items:center;gap:7px}
    .s3-ie{width:26px;height:26px;border-radius:7px;background:#F3F4F6;display:flex;align-items:center;justify-content:center;font-size:13px}
    .s3-in{font:700 9px Inter;color:#0A0F1E}
    .s3-id{font:400 7px Inter;color:#9CA3AF;margin-top:1px}
    .s3-lock{display:flex;align-items:center;gap:3px;font:600 8px Inter;color:#2563EB;background:#EFF6FF;border:1px solid #BFDBFE;border-radius:6px;padding:3px 7px}
    .s3-tot{padding:8px 10px;display:flex;justify-content:space-between;align-items:center}
    .s3-tot-l{font:700 10px Inter;color:#0A0F1E}
    .s3-tot-r{font:600 9px Inter;color:#2563EB}
    .s3-pay{background:#2563EB;border-radius:10px;padding:10px;text-align:center;font:700 10px Inter;color:#fff;display:flex;align-items:center;justify-content:center;gap:5px;animation:pulsebtn 2s infinite}
    .s3-pay-sticky{position:absolute;bottom:0;left:0;right:0;padding:8px 10px 10px;background:#fff}
    @keyframes pulsebtn{0%,100%{box-shadow:0 4px 14px rgba(37,99,235,.4)}50%{box-shadow:0 4px 28px rgba(37,99,235,.7)}}
    .s3-nt{text-align:center;font:400 8px Inter;color:#9CA3AF;padding:6px}

    /* ─ Screen 4: confirmed ─ */
    .s4-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:20px 16px;text-align:center;gap:11px;background:#fff}
    .s4-ring{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#2563EB,#1D4ED8);display:flex;align-items:center;justify-content:center;font-size:30px;box-shadow:0 8px 28px rgba(37,99,235,.45);animation:popscale .6s ease both}
    @keyframes popscale{0%{transform:scale(0);opacity:0}70%{transform:scale(1.12)}100%{transform:scale(1);opacity:1}}
    .s4-ttl{font:800 15px Inter;color:#0A0F1E;letter-spacing:-.3px}
    .s4-sub{font:400 10px/1.5 Inter;color:#6B7280;max-width:155px}
    .s4-eta{background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border:1.5px solid #BFDBFE;border-radius:12px;padding:10px 14px;width:100%}
    .s4-eta-m{font:800 11px Inter;color:#1D4ED8}
    .s4-eta-s{font:400 8px Inter;color:#93C5FD;margin-top:2px}
    .s4-stepper{display:flex;align-items:center;width:100%}
    .s4st{display:flex;flex-direction:column;align-items:center;flex:1;gap:3px}
    .s4st-d{width:11px;height:11px;border-radius:50%}
    .s4st-d.dn{background:#2563EB}
    .s4st-d.ac{background:#2563EB;box-shadow:0 0 0 3px rgba(37,99,235,.2)}
    .s4st-d.pe{background:#E5E7EB}
    .s4st-ln{flex:1;height:1.5px;margin-top:-8px}
    .s4st-ln.dn{background:#2563EB}
    .s4st-ln.pe{background:#E5E7EB}
    .s4st-lb{font:500 7px Inter;color:#9CA3AF}
    .s4st-lb.ac{color:#2563EB;font-weight:700}

    /* tap ripple */
    .tap-zone{position:relative;overflow:hidden}
    .tap-zone::after{content:'';position:absolute;width:32px;height:32px;border-radius:50%;background:rgba(37,99,235,.2);transform:scale(0);animation:rpl 2.5s 1.5s ease-in-out infinite;pointer-events:none;top:50%;left:50%;margin:-16px 0 0 -16px}
    @keyframes rpl{0%{transform:scale(0);opacity:1}100%{transform:scale(4);opacity:0}}

    @media(max-width:960px){.flow-phones{grid-template-columns:1fr 1fr;gap:20px}}
    @media(max-width:520px){.flow-phones{display:flex;overflow-x:auto;gap:14px;padding-bottom:10px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}.flow-step{scroll-snap-align:start;flex-shrink:0;width:185px}.fp .fp-screen{height:320px}}

    /* ── Fish grid ── */
    .fish-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin-top:48px}
    .fish-card{background:#fff;border:1px solid var(--border);border-radius:18px;overflow:hidden;transition:all .22s;cursor:pointer;position:relative}
    .fish-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,.1);border-color:rgba(37,99,235,.3)}
    .fish-img{height:220px;display:flex;align-items:center;justify-content:center;font-size:56px;position:relative}
    .fish-img img{width:100%;height:100%;object-fit:cover;display:block}
    .fi1{background:linear-gradient(135deg,#0D3B2E,#0A5940)}
    .fi2{background:linear-gradient(135deg,#1A0D4A,#2A3080)}
    .fi3{background:linear-gradient(135deg,#0D2040,#1A3A5F)}
    .fi4{background:linear-gradient(135deg,#2D1B00,#5C3800)}
    .fi5{background:linear-gradient(135deg,#1A0020,#3A0050)}
    .fi6{background:linear-gradient(135deg,#002020,#00403A)}
    .fi7{background:linear-gradient(135deg,#200D00,#402000)}
    .fi8{background:linear-gradient(135deg,#0A0A20,#1A1A40)}
    .ftag-badge{position:absolute;top:8px;left:8px;font:600 8px Inter;padding:3px 8px;border-radius:100px}
    .ftag-badge.in{background:rgba(37,99,235,.85);color:#000}
    .ftag-badge.pre{background:rgba(124,58,237,.85);color:#fff}
    .fish-body{padding:8px 14px 10px}
    .fish-name{font:700 14px Inter;color:var(--ink);margin-bottom:1px}
    .fish-marathi{font:400 11px Inter;color:var(--ink-3);margin-bottom:6px}
    .fish-login{display:flex;align-items:center;gap:6px;background:var(--blue-dim);border:1px solid rgba(37,99,235,.2);border-radius:9px;padding:6px 10px;font:600 12px Inter;color:var(--blue)}
    .fish-cta{display:block;margin-top:6px;background:#F8FAFC;border:1px solid var(--border);border-radius:9px;padding:5px;text-align:center;font:600 12px Inter;color:var(--ink-2);transition:all .15s}
    .fish-card:hover .fish-cta{background:var(--blue);color:#fff;border-color:var(--blue)}

    /* ── Why ── */
    .why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}
    .why-card{background:rgba(255,255,255,.04);border:1px solid var(--dark-border);border-radius:20px;padding:24px;transition:all .25s}
    .why-card:hover{background:rgba(255,255,255,.07);border-color:rgba(37,99,235,.3);transform:translateY(-3px)}
    .why-icon{width:48px;height:48px;border-radius:13px;background:var(--blue-dim);border:1px solid rgba(37,99,235,.2);display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:14px}
    .why-card h3{font:700 15px Inter;color:#fff;margin-bottom:8px}
    .why-card p{font:400 13px/1.6 Inter;color:rgba(255,255,255,.44)}
    .why-vs{display:flex;align-items:center;gap:8px;margin-top:12px;padding-top:12px;border-top:1px solid var(--dark-border)}
    .wvg{font:600 11px Inter;color:var(--teal)}
    .wvsep{width:1px;height:10px;background:var(--dark-border)}
    .wvb{font:500 11px Inter;color:rgba(255,255,255,.2)}
    @media(max-width:800px){.why-grid{grid-template-columns:1fr 1fr}}
    @media(max-width:500px){.why-grid{grid-template-columns:1fr}}

    /* ── Stats ── */
    .stats-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--dark-border);border-radius:14px;overflow:hidden;border:1px solid var(--dark-border);margin-top:48px}
    .sb{background:rgba(255,255,255,.03);padding:20px 14px;text-align:center}
    .sb-n{font:800 32px Inter;color:#fff;letter-spacing:-1px}
    .sb-n .a{color:var(--blue-light)}
    .sb-l{font:400 12px Inter;color:rgba(255,255,255,.3);margin-top:3px}
    @media(max-width:640px){.stats-bar{grid-template-columns:1fr 1fr}}

    /* ── Testimonials ── */
    .testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:48px}
    .testi-card{background:#fff;border:1px solid var(--border);border-radius:20px;padding:22px;transition:all .2s}
    .testi-card:hover{box-shadow:0 12px 40px rgba(0,0,0,.08);transform:translateY(-2px)}
    .testi-stars{color:#FFD60A;font-size:13px;margin-bottom:10px;letter-spacing:2px}
