<script>
import { whatsappLink } from "../lib/brand";
(function(){
  const waLink=document.getElementById('wl-wa'),areaIn=document.getElementById('wl-area');
  areaIn?.addEventListener('input',()=>{const a=areaIn.value.trim();waLink.href=whatsappLink(`Hi Relifish, please tell me when you deliver to ${a||'my area'}`);});
  const form=document.getElementById('wl-form'),btn=document.getElementById('wl-btn'),
        suc=document.getElementById('wl-success'),msg=document.getElementById('wl-msg');
  if(!form)return;
  form.addEventListener('submit',async e=>{
    e.preventDefault();btn.disabled=true;btn.textContent='Joining...';
    const phone=document.getElementById('wl-phone').value,area=document.getElementById('wl-area').value,
          fish_wanted=document.getElementById('wl-fish').value,frequency=document.getElementById('wl-freq').value;
    try{
      const res=await fetch('/api/waitlist/join',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone,area,fish_wanted,frequency})});
      const d=await res.json();
      if(d.success||res.ok){
        form.style.display='none';
        if(d.area_count>1)msg.textContent=`${d.area_count} people near you are waiting. We'll WhatsApp you when we launch.`;
        suc.classList.add('show');
      }else{btn.disabled=false;btn.textContent="📋 Join the waitlist — free";alert(d.error||'Something went wrong.');}
    }catch{btn.disabled=false;btn.textContent="📋 Join the waitlist — free";alert('Network error. Try again.');}
  });
})();
</script>

