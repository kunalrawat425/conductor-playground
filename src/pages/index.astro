---
import UtmCapture from "../components/UtmCapture.astro";
import WatiChatButton from "../components/WatiChatButton.astro";
import { LOGO_URL, whatsappLink } from "../lib/brand";
import { jsonLdString } from "../lib/html";
import { SOCIAL_ICONS } from "../lib/social-icons";
export const prerender = false;
import Footer from "../components/Footer.astro";
import DiwaliDecor from "../components/DiwaliDecor.astro";
import { festiveTheme } from "../lib/festive";
const SITE = "https://www.relifish.com";
const enableTracking = import.meta.env.PUBLIC_ENABLE_TRACKING === "true";
const festive = festiveTheme() === "diwali";
const homeFaqs = [
  { q: "How does Relifish work?", a: "Local fish sellers list the fish they have each day. You order same-day during a seller's opening hours, or pre-order before the seller's cutoff (shown on their page) for tomorrow. You pay online when you order, the seller confirms, then delivers or keeps it ready for pickup. No subscription." },
  { q: "How do I know the fish is fresh?", a: "Each seller lists only what they have that day, and you choose how it is prepared (whole, cleaned or cut). Before cooking, check for clear eyes, red gills, firm flesh and a clean sea smell." },
  { q: "Can I see prices before I log in?", a: "Yes. Each seller's live prices are shown on their page and on our fish price today page. Prices vary by seller and change daily. You log in with your mobile number (OTP, no password) only when you place an order." },
  { q: "What fish can I order?", a: "It depends on what each seller lists that day: commonly pomfret, surmai, bangda, prawns, rawas, crab, halwa and bombil." },
  { q: "What if my order can't be fulfilled?", a: "If the seller declines, or you cancel before they confirm, the full amount is refunded to your original payment method, usually within 5 to 7 working days." },
  { q: "Is there a minimum order?", a: "Each seller sets their own minimum. You will see it on the seller's page before ordering." },
  { q: "Which areas does Relifish serve?", a: "Sellers on Relifish currently serve parts of Thane, South Mumbai and Kamothe in Navi Mumbai. Each seller sets their own delivery radius; set your location to see who serves you." },
];

// Home v2 (Grüns-style, founder-approved mock s11). Gold wordmark during Diwali.
const logoSrc = festive ? "/logo-gold.png" : "/logo-wordmark.png";
const footerLogo = festive ? "/logo-gold.png" : "/logo-white.png";
const SOCIAL = [
  { label: "Instagram @relifish_", href: "https://www.instagram.com/relifish_/", path: SOCIAL_ICONS.instagram },
  { label: "Facebook", href: "https://www.facebook.com/p/ReliFish-61589987936346/", path: SOCIAL_ICONS.facebook },
  { label: "WhatsApp", href: whatsappLink("Hi Relifish, I have a question"), path: SOCIAL_ICONS.whatsapp },
];

// Photo dial: real seller/listing photos with a glass "claim this spot" card after every second photo.
const SB = "https://witoghpdfocywiosmrzv.supabase.co/storage/v1";
const LP = `${SB}/render/image/public/fish-photos/listings/`;
const LST = `${SB}/render/image/public/fish-photos/listings/2f39dfce-15c0-4f9a-a5b3-e95280479dbd`;
const DIAL_PHOTOS = [
  { src: `${LST}/fishtokri-site-silver-pomfret-cut.png?width=500&quality=80`, cap: "Silver pomfret, cut your way" },
  { src: `${SB}/object/public/fish-photos/sellers/bd8efaae-69e1-4dcb-bdcb-75d1874b96ed/store.jpg`, cap: "The Nomadic Catch · Sassoon Dock" },
  { src: `${LST}/fishtokri-site-white-prawns.png?width=500&quality=80`, cap: "Seawater white prawns" },
  { src: `${LST}/fishtokri-silver-pomfret-combo-collage.png?width=500&quality=80`, cap: "Pomfret combo for the weekend" },
  { src: `${LST}/fishtokri-site-bombil-frycut.png?width=500&quality=80`, cap: "Bombil fry cut, ready to fry" },
  // The Nomadic Catch's own listing photos (founder 31 Oct)
  { src: `${LP}bd8efaae-69e1-4dcb-bdcb-75d1874b96ed/1792432940278.png?width=500&quality=80`, cap: "Surmai steaks, Sassoon Dock" },
  { src: `${LP}bd8efaae-69e1-4dcb-bdcb-75d1874b96ed/1792435387098.png?width=500&quality=80`, cap: "Bangda, same-morning catch" },
  { src: `${LP}bd8efaae-69e1-4dcb-bdcb-75d1874b96ed/1792436014060.png?width=500&quality=80`, cap: "Halwa, cleaned and cut" },
];
const DIAL: ({ src: string; cap: string } | null)[] = [];
DIAL_PHOTOS.forEach((p, i) => { DIAL.push(p); if (i % 2 === 1) DIAL.push(null); });
DIAL.push(null);
// Same maths as the client script (STEP must match), so the first paint already shows the fan: no layout shift.
const STEP = 13;
const SPAN = DIAL.length * STEP;
const pose = (i: number) => {
  let a = ((i * STEP) % SPAN + SPAN) % SPAN;
  if (a > SPAN / 2) a -= SPAN;
  return `transform:rotate(${a}deg);z-index:${100 - Math.round(Math.abs(a))};${Math.abs(a) < 48 ? "" : "visibility:hidden"}`;
};
// ponytail: no public reviews feed yet, so the card only rotates placeholders; feed real orders.rating rows in here when one exists.
const REVIEW_SLOTS = [
  { t: "Your review goes here. Order, enjoy your fish, then tap ＋ on the wheel to claim your spot.", n: "You?" },
  { t: "Loved the cut? Fresh enough? Tell Thane. Your review can be the first one on this wall.", n: "Claim this spot" },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <UtmCapture />
  <title>Fresh Fish Online in Thane &amp; Mumbai | Relifish</title>
  <meta name="description" content="Order fresh fish online from local sellers in Thane and Mumbai. Order same-day or pre-order for tomorrow or later — surmai, pomfret, rawas &amp; prawns, home delivery or pickup." />
  <link rel="canonical" href={SITE} />
  <meta property="og:title" content="Fresh Fish Online in Thane &amp; Mumbai | Relifish" />
  <meta property="og:description" content="Order fresh fish online from local sellers in Thane and Mumbai. Order same-day or pre-order for tomorrow or later — surmai, pomfret, rawas &amp; prawns, home delivery or pickup." />
  <meta property="og:image" content={`${SITE}/og-image.jpg`} />
  <meta property="og:url" content={SITE} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Relifish" />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Fresh Fish Online in Thane &amp; Mumbai | Relifish" />
  <meta name="twitter:description" content="Order fresh fish online from local sellers in Thane and Mumbai. Order same-day or pre-order for tomorrow or later — surmai, pomfret, rawas &amp; prawns, home delivery or pickup." />
  <meta name="twitter:image" content={`${SITE}/og-image.jpg`} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700;800&display=swap" /></noscript>
  <script type="application/ld+json" set:html={jsonLdString({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${SITE}/#org`,
        "name": "Relifish",
        "alternateName": ["Reli Fish", "Relifish Store"],
        "url": SITE,
        "logo": { "@type": "ImageObject", "url": `${SITE}/icon-512.png` },
        "description": "Hyperlocal fish marketplace: buy fish online from local sellers in Thane, South Mumbai and Navi Mumbai. Order same-day or pre-order for tomorrow; sellers deliver or keep it ready for pickup.",
        "foundingDate": "2025",
        "areaServed": [
          { "@type": "City", "name": "Mumbai" },
          { "@type": "City", "name": "Navi Mumbai" },
          { "@type": "City", "name": "Thane" }
        ],
        "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "telephone": "+91-9152207607", "email": "relifishstore@gmail.com", "areaServed": "IN", "availableLanguage": ["en", "hi", "mr"] },
        "sameAs": ["https://www.instagram.com/relifish_/", "https://www.facebook.com/p/ReliFish-61589987936346/"],
        "hasMerchantReturnPolicy": { "@type": "MerchantReturnPolicy", "applicableCountry": "IN", "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted", "merchantReturnLink": "https://www.relifish.com/refund-policy" }
      },
      {
        "@type": "WebSite",
        "@id": `${SITE}/#web`,
        "name": "Relifish",
        "url": SITE,
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": `${SITE}/search?q={search_term_string}` },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": homeFaqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
      }
    ]
  })} />
  <style is:global>
    :root{
      /* legacy tokens, still used by the phone mock-ups */
      --blue:#0066FF;--blue-dark:#0052CC;--blue-light:#60A5FA;--blue-dim:rgba(0,102,255,.12);--blue-glow:rgba(0,102,255,.3);
      --teal:#0066FF;--ink:#0B1B3F;--ink-2:#475569;--ink-3:#94A3B8;--border:rgba(10,15,30,.08);--dark-border:rgba(255,255,255,.08);
      /* home v2 */
      /* normal (not Diwali): blue + white only, founder 31 Oct; cream/beige only in the Diwali palette below */
      --cream:#FFFFFF;--cream-2:#F0F6FF;--navy:#0A2472;--yellow:#FFD166;--muted:#475569;--max:1160px;
      --display:'Archivo Black','Arial Black',Impact,sans-serif;
      --line:var(--navy);--accent:#0066FF;--cta:#0066FF;--cta-fg:#fff;--cta-shadow:var(--navy);
      --dk:var(--navy);--dk-accent:var(--yellow);--ann:var(--navy);--ann-fg:#fff;--ann-b:var(--yellow);--pill:#E6EEFF;--chip:var(--navy);
    }
    /* Diwali (src/lib/festive.ts): same layout, maroon + gold palette */
    body.festive-diwali{
      /* Diwali only in the top announcement bar (founder 31 Oct): page, buttons, dark sections and footer stay blue/white */
      --ann:linear-gradient(135deg,#B3123B,#8B0A2E);--ann-fg:#FDE7B0;--ann-b:#F5D27A;
    }
    body.home{font-family:'Inter',system-ui,sans-serif;color:var(--ink);background:var(--cream);-webkit-font-smoothing:antialiased;overflow-x:hidden;margin:0}
    html{scroll-behavior:smooth}
    /* Footer component restyle (its own styles are scoped, these outrank them) */
    body.home footer{background:var(--navy);padding-bottom:110px}
    /* .ft .ft-top chains: the scoped rules are .x[cid] y[cid] (0,4,0) */
    body.home .ft .ft-top .ft-brand img{filter:none;height:auto;width:150px}
    body.home .ft-desc,body.home .ft .ft-top .ft-col a,body.home .ft-phone{color:#CBD5E1}
    body.home .ft .ft-top .ft-col a{padding:4px 0;margin-bottom:4px}
    body.home .ft .ft-top .ft-col a:hover{color:#fff}
    body.home .ft .ft-top .ft-col h4{color:#fff}
    body.home .ft-bottom{color:rgba(255,255,255,.65);border-top-color:rgba(255,255,255,.15)}
    body.home .ft-social-link{width:44px;height:44px;border-radius:12px}
    /* Diwali decor sits inside the announcement bar and the hero */
    body.home .ann .fd-lights{top:0}
    body.festive-diwali .hero .fd-banner{margin:0 auto 18px;max-width:440px}
    @media(min-width:940px){body.festive-diwali .hero .fd-banner{margin:0 0 20px}}
    .claim-sheet::backdrop{background:rgba(10,20,50,.5)}
      .dc-claim{background:radial-gradient(circle at 25% 25%,rgba(0,102,255,.28),transparent 55%),radial-gradient(circle at 80% 75%,rgba(255,209,102,.55),transparent 55%),radial-gradient(circle at 70% 20%,rgba(236,72,153,.18),transparent 50%),rgba(255,255,255,.55)!important}
</style>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    a{color:inherit;text-decoration:none}
    img{max-width:100%;display:block}
    .wrap{max-width:var(--max);margin:0 auto}
    section[id]{scroll-margin-top:84px}
    .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    a:focus-visible,button:focus-visible,summary:focus-visible,.dial:focus-visible{outline:3px solid var(--accent);outline-offset:2px}

    /* ── Announcement bar ── */
    .ann{position:relative;display:flex;align-items:center;justify-content:center;min-height:44px;background:var(--ann);color:var(--ann-fg);text-align:center;padding:10px 14px;font:600 13px/1.4 Inter}
    .ann b{color:var(--ann-b)}
    .ann u{text-underline-offset:3px}
    :global(.festive-diwali) .ann{padding-top:20px;border-bottom:2px solid #D4A24C}

    /* ── Pill header ── */
    .nav{position:sticky;top:0;z-index:200;background:var(--cream);transition:box-shadow .2s}
    .nav.scrolled{box-shadow:0 2px 0 var(--line)}
    .nav-inner{max-width:var(--max);margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px}
    .logo{display:flex;align-items:center;background:var(--pill);border-radius:999px;padding:12px 18px;min-height:48px}
    .logo img{width:96px;height:auto}
    :global(.festive-diwali) .logo{background:linear-gradient(135deg,#B3123B,#8B0A2E);border:2px solid #D4A24C}
    .nav-links{display:none;gap:2px}
    .nl{display:inline-flex;align-items:center;min-height:44px;font:700 14px Inter;color:var(--ink);padding:0 14px;border-radius:999px}
    .nl:hover{background:var(--pill)}
    .pill{display:flex;align-items:center;gap:2px;background:var(--pill);border-radius:999px;padding:4px}
    .btn-shop{display:inline-flex;align-items:center;justify-content:center;min-height:44px;background:#0066FF;color:#fff;font:800 14px Inter;padding:0 18px;border-radius:999px;white-space:nowrap}
    .icon-btn{width:44px;height:44px;border-radius:999px;display:flex;align-items:center;justify-content:center;color:var(--navy);cursor:pointer;list-style:none}
    .icon-btn::-webkit-details-marker{display:none}
    .icon-btn svg{width:22px;height:22px}
    .icon-btn:hover{background:rgba(255,255,255,.6)}
    .menu{position:relative}
    .menu-pop{position:absolute;right:0;top:54px;background:#fff;border:2px solid var(--line);border-radius:18px;box-shadow:5px 5px 0 var(--line);padding:8px;display:grid;min-width:210px}
    .menu-pop a{display:flex;align-items:center;min-height:44px;font:700 15px Inter;padding:0 14px;border-radius:12px}
    .menu-pop a:hover{background:var(--pill)}
    @media(min-width:900px){.nav-links{display:flex}.menu{display:none}.logo img{width:124px}.nav-inner{padding:12px 28px}}

    /* ── Hero ── */
    .hero{padding:22px 16px 10px;text-align:center}
    .hero-inner{max-width:var(--max);margin:0 auto;display:grid;gap:22px;align-items:center}
    h1{font:400 44px/.98 var(--display);letter-spacing:-1.5px;text-transform:uppercase;color:var(--ink)}
    h1 .blu{color:var(--accent)}
    .hero-sub{font:600 16px/1.5 Inter;color:#334155;margin:16px auto 0;max-width:430px}
    .hero-sub strong{color:var(--ink);font-weight:800}
    .hero-cite{font:500 13px/1.6 Inter;color:var(--muted);margin:12px auto 0;max-width:440px}
    .fish-tags{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:16px}
    .ftag{display:inline-flex;align-items:center;gap:6px;min-height:44px;background:#fff;border:2px solid var(--line);border-radius:999px;padding:4px 14px 4px 4px;font:700 13px Inter;color:var(--ink);box-shadow:2px 2px 0 var(--line)}
    .ftag-img{width:32px;height:32px;border-radius:50%;object-fit:cover}
    .hero-ctas{margin-top:20px}
    .btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;background:var(--cta);color:var(--cta-fg);font:800 17px Inter;padding:14px 30px;border-radius:999px;border:0;box-shadow:0 6px 0 var(--cta-shadow);transition:transform .15s,box-shadow .15s;cursor:pointer}
    .btn-primary:hover{transform:translateY(2px);box-shadow:0 4px 0 var(--cta-shadow)}
    .btn-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:50px;background:#fff;color:var(--ink);border:2px solid var(--line);border-radius:999px;padding:12px 22px;font:800 15px Inter}
    .hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:24px}
    .hs{background:#fff;border:2px solid var(--line);border-radius:14px;padding:12px 6px;box-shadow:3px 3px 0 var(--line);text-align:center}
    .hs-n{font:400 28px var(--display);color:var(--accent)}
    .hs-l{font:700 11px/1.35 Inter;color:#334155;margin-top:4px}

    /* ── Hero right — interactive phone demo ── */
    .hero-right{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px}

    /* phone shell */
    .demo-phone{
      width:270px;
      background:linear-gradient(175deg,#1E2D4A,#0D1629);
      border-radius:44px;
      border:2px solid rgba(255,255,255,.15);
      box-shadow:0 48px 96px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.05),inset 0 1px 0 rgba(255,255,255,.08);
      overflow:hidden;
      position:relative;
      cursor:pointer;
      user-select:none;
    }
    .demo-notch{height:28px;background:#000;display:flex;align-items:center;justify-content:center}
    .demo-pill{width:72px;height:9px;background:#111;border-radius:100px}

    /* progress bar */
    .demo-progress{height:2px;background:rgba(255,255,255,.08)}
    .demo-progress-fill{height:100%;background:var(--blue);width:0%;transition:width .1s linear;border-radius:1px}

    /* screen container */
    .demo-screens{height:500px;overflow:hidden;position:relative}
    .demo-screen{
      position:absolute;inset:0;
      opacity:0;
      transform:translateX(24px);
      transition:opacity .35s ease,transform .35s ease;
      pointer-events:none;
    }
    .demo-screen.active{opacity:1;transform:translateX(0);pointer-events:auto}
    .demo-screen.exit{opacity:0;transform:translateX(-24px)}

    /* step dots */
    .demo-dots{display:flex;align-items:center;gap:6px;justify-content:center}
    .demo-dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.2);cursor:pointer;transition:all .2s}
    .demo-dot.active{background:var(--blue);width:18px;border-radius:3px}

    /* nav hint */
    .demo-hint{font:500 11px Inter;color:rgba(255,255,255,.3);text-align:center}

    /* ── Screen styles ── */
    /* all screens share base bg */
    .ds-light{background:#F7F8FC;height:100%;position:relative}
    .ds-dark{background:#050D1A;height:100%;position:relative}

    /* screen header */
    .dh{background:#fff;border-bottom:1px solid #EAECF0;padding:10px 13px}
    .dh-title{font:700 11px Inter;color:#0A0F1E}
    .dh-sub{font:400 8px Inter;color:#9CA3AF;margin-top:1px}
    .dh-back{font:500 8px Inter;color:var(--blue);margin-bottom:3px}
    .dh-search{background:#F3F4F6;border-radius:7px;padding:6px 9px;font:400 8px Inter;color:#9CA3AF;margin-top:6px;display:flex;align-items:center;gap:4px}

    /* screen 0 — welcome */
    .d0-center{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:12px;text-align:center;padding:24px}
    .d0-logo{font:800 20px Inter;color:#fff;letter-spacing:-.5px}
    .d0-logo span{color:var(--teal)}
    .d0-tagline{font:400 12px/1.5 Inter;color:rgba(255,255,255,.5)}
    /* Shared CTA pattern — matches screen 5 "Pay via UPI" reference */
    .demo-cta{position:absolute;bottom:0;left:0;right:0;padding:8px 10px 20px;background:#F7F8FC}
    .demo-cta-dark{background:rgba(13,17,23,.97)}
    .demo-cta-white{background:#fff}
    .demo-cta-btn{background:var(--blue);border-radius:9px;padding:10px;text-align:center;font:700 10px Inter;color:#fff;width:100%;box-sizing:border-box}
    .demo-cta-sub{text-align:center;font:400 7px Inter;color:#9CA3AF;padding:4px 0 0}
    /* legacy kept for screen 8 reuse */
    .d0-btn{display:none}
    .d0-sticky{display:none}

    /* screen 1 — location */
    .d1-area{display:flex;align-items:center;gap:8px;padding:8px 9px;border-radius:8px;border:1px solid #EAECF0;background:#fff;margin:0 10px 5px}
    .d1-area.tap{border-color:var(--blue);background:#EFF6FF;animation:d1tap .4s ease}
    @keyframes d1tap{0%,100%{transform:scale(1)}40%{transform:scale(.97)}}
    .d1-icon{font-size:13px}
    .d1-name{font:700 9px Inter;color:#0A0F1E}
    .d1-dist{font:400 7px Inter;color:#9CA3AF}
    .d1-check{width:14px;height:14px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:7px;color:#fff;margin-left:auto}

    /* screen 2 — sellers */
    .d2-tabs{display:flex;background:#fff;border-bottom:1px solid #EAECF0}
    .d2t{font:600 8px Inter;padding:7px 10px;border-bottom:2px solid transparent;color:#9CA3AF}
    .d2t.on{color:var(--blue);border-bottom-color:var(--blue)}
    .d2-list{padding:7px 8px;display:flex;flex-direction:column;gap:6px}
    .d2-card{background:#fff;border-radius:9px;border:1px solid #EAECF0;overflow:hidden}
    .d2-card.tap{border-color:var(--blue);animation:d1tap .4s ease}
    .d2-img{height:36px;display:flex;align-items:center;justify-content:center;font-size:18px;position:relative}
    .d2-badge{position:absolute;top:3px;right:4px;font:700 6px Inter;padding:1px 5px;border-radius:100px}
    .d2-badge.op{background:#2563EB;color:#fff}
    .d2-badge.pr{background:#7C3AED;color:#fff}
    .d2-info{padding:5px 7px}
    .d2-name{font:700 9px Inter;color:#0A0F1E}
    .d2-sub{font:400 7px Inter;color:#9CA3AF;margin-top:1px}

    /* screen 3 — fish menu */
    .d3-item{display:flex;align-items:center;justify-content:space-between;padding:7px 8px;background:#fff;border-bottom:1px solid #F3F4F6}
    .d3-item.tap{background:#EFF6FF;animation:d1tap .4s ease}
    .d3-emoji{font-size:18px;margin-right:6px}
    .d3-img{width:22px;height:22px;border-radius:50%;object-fit:cover;margin-right:6px;flex-shrink:0}
    .d3-name{font:700 9px Inter;color:#0A0F1E}
    .d3-cut{font:400 7px Inter;color:#9CA3AF;margin-top:1px}
    .d3-lock{font:600 7px Inter;color:var(--blue);display:flex;align-items:center;gap:2px}
    .d3-add{background:var(--blue);color:#fff;font:700 7px Inter;padding:4px 8px;border-radius:6px}
    .d3-add.added{background:#059669}
    .d3-bar{background:var(--blue);border-radius:9px;padding:8px 10px;display:flex;justify-content:space-between;align-items:center;width:100%;box-sizing:border-box}
    .d3-bar-t{font:700 9px Inter;color:#fff}
    .d3-bar-p{font:800 10px Inter;color:rgba(255,255,255,.8)}

    /* screen 4 — cart */
    .d4-item{display:flex;align-items:center;justify-content:space-between;padding:7px 10px;background:#fff;border-bottom:1px solid #F3F4F6}
    .d4-name{font:600 9px Inter;color:#0A0F1E}
    .d4-lock{font:500 7px Inter;color:var(--blue)}
    .d4-qty{display:flex;align-items:center;gap:5px}
    .d4-q{width:18px;height:18px;background:#EFF6FF;border-radius:5px;display:flex;align-items:center;justify-content:center;font:700 10px Inter;color:var(--blue)}
    .d4-summary{margin:6px 9px;background:#EFF6FF;border:1px solid #BFDBFE;border-radius:9px;padding:8px 10px}
    .d4-row{display:flex;justify-content:space-between;font:500 8px Inter;color:#1E40AF;margin-bottom:3px}
    @keyframes pulseblue{0%,100%{box-shadow:0 0 0 0 rgba(37,99,235,.4)}50%{box-shadow:0 0 0 5px rgba(37,99,235,0)}}

    /* screen 5 — payment */
    .d5-amount{text-align:center;padding:16px 10px 10px}
    .d5-to{font:400 8px Inter;color:#9CA3AF}
    .d5-seller{font:700 11px Inter;color:#0A0F1E;margin:3px 0}
    .d5-amt-label{font:400 9px Inter;color:#9CA3AF}
    .d5-amt{font:800 22px Inter;color:#0A0F1E;letter-spacing:-1px}
    .d5-amt span{font-size:14px;font-weight:500;color:#9CA3AF}
    .d5-upi-apps{display:flex;justify-content:center;gap:8px;padding:6px 10px}
    .d5-app{display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px;border-radius:9px;background:#F3F4F6;border:1px solid #E5E7EB;width:52px}
    .d5-app.tap{border-color:var(--blue);background:#EFF6FF;animation:d1tap .4s ease}
    .d5-app-icon{font-size:18px}
    .d5-app-name{font:600 7px Inter;color:#374151}
    .d5-pay-btn{background:var(--blue);border-radius:9px;padding:9px;text-align:center;font:700 10px Inter;color:#fff}
    .d5-pay-sticky{position:absolute;bottom:0;left:0;right:0;padding:8px 10px 20px;background:#F7F8FC}

    /* screen 6 — confirmed */
    .d6-center{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:16px;text-align:center;gap:8px}
    .d6-icon{width:52px;height:52px;border-radius:50%;background:#EFF6FF;border:2px solid #BFDBFE;display:flex;align-items:center;justify-content:center;font-size:26px;animation:popcheck .5s ease both}
    @keyframes popcheck{0%{transform:scale(0)}80%{transform:scale(1.15)}100%{transform:scale(1)}}
    .d6-title{font:800 13px Inter;color:#0A0F1E}
    .d6-sub{font:400 9px/1.4 Inter;color:#6B7280}
    .d6-eta{background:#EFF6FF;border:1px solid #BFDBFE;border-radius:8px;padding:7px 10px;width:100%}
    .d6-eta-t{font:700 9px Inter;color:var(--blue)}
    .d6-eta-s{font:400 7px Inter;color:#93C5FD;margin-top:1px}

    /* screen 7 — tracking */
    .d7-step{display:flex;align-items:flex-start;gap:10px;padding:8px 10px}
    .d7-dot-wrap{display:flex;flex-direction:column;align-items:center}
    .d7-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
    .d7-dot.done{background:var(--blue)}
    .d7-dot.active{background:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.2);animation:trackpulse 1.5s infinite}
    @keyframes trackpulse{0%,100%{box-shadow:0 0 0 3px rgba(37,99,235,.2)}50%{box-shadow:0 0 0 6px rgba(37,99,235,0)}}
    .d7-dot.pending{background:#E5E7EB}
    .d7-line{width:1px;height:20px;background:#E5E7EB;margin:2px 0}
    .d7-line.done{background:var(--blue)}
    .d7-label{font:700 9px Inter;color:#0A0F1E;margin-bottom:1px}
    .d7-sub{font:400 7px Inter;color:#9CA3AF}
    .d7-sub.blue{color:var(--blue)}

    /* screen 8 — delivered */
    .d8-center{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:16px;text-align:center;gap:8px}
    .d8-icon{font-size:48px;animation:wiggle 1s .2s ease both}
    @keyframes wiggle{0%,100%{transform:rotate(0deg)}25%{transform:rotate(-8deg)}75%{transform:rotate(8deg)}}
    .d8-title{font:800 14px Inter;color:#0A0F1E}
    .d8-sub{font:400 9px/1.5 Inter;color:#6B7280}
    .d8-rate{background:#FFF7ED;border:1px solid #FED7AA;border-radius:8px;padding:7px 10px;width:100%}
    .d8-rate-t{font:600 8px Inter;color:#92400E}
    .d8-stars{font-size:14px;margin-top:3px}

    /* floating fish badges */
    .fish3d{
      position:absolute;border-radius:14px;display:flex;align-items:center;gap:9px;padding:9px 13px;
      background:rgba(13,22,41,.92);border:1px solid rgba(255,255,255,.1);box-shadow:0 14px 36px rgba(0,0,0,.5);
      backdrop-filter:blur(12px);z-index:10;animation:floatfish 4s ease-in-out infinite;
      text-decoration:none;color:inherit;cursor:pointer;
    }
    .fish3d:hover{border-color:rgba(96,165,250,.6)}
    .fish3d:nth-child(1){top:20px;right:-10px;animation-delay:0s}
    .fish3d:nth-child(2){bottom:80px;right:-20px;animation-delay:1.4s}
    .fish3d:nth-child(3){top:180px;right:-15px;animation-delay:2.8s}
    @keyframes floatfish{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
    .fish3d-e{font-size:28px;filter:drop-shadow(0 3px 6px rgba(0,0,0,.5));transform:scaleX(-1)}
    .ftag-img{width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:8px;vertical-align:middle;flex-shrink:0}
    .fish3d-img{width:38px;height:38px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(255,255,255,.85);box-shadow:0 3px 8px rgba(0,0,0,.45)}
    .fish3d-n{font:700 10px Inter;color:#fff}
    .fish3d-t{font:400 8px Inter;color:rgba(255,255,255,.4);margin-top:1px}
    .fish3d-f{font:700 7px Inter;color:var(--blue-light);background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.25);border-radius:100px;padding:2px 6px;margin-top:3px;display:inline-block}
    /* phone demo: mobile shows the three fish chips only (the phone is desktop-only, as before) */
    .hero-right::before{content:"";position:absolute;inset:8% 0;border-radius:50%;background:radial-gradient(circle at 30% 40%,rgba(0,102,255,.22),transparent 60%),radial-gradient(circle at 70% 70%,rgba(255,209,102,.5),transparent 55%);pointer-events:none}
    .demo-hint{color:var(--muted)}
    .demo-dot{background:rgba(10,36,114,.25)}
    .fish-mini{display:contents}
    @media(max-width:939px){
      .hero-right{display:block}
      .hero-right::before,.demo-phone,.demo-dots,.demo-hint{display:none}
      .fish-mini{display:flex;gap:8px;overflow-x:auto;padding:2px 2px 8px;scroll-snap-type:x mandatory;text-align:left}
      .fish3d{position:static;animation:none;flex:none;scroll-snap-align:start;background:var(--chip);border:0;box-shadow:none;backdrop-filter:none;min-height:44px}
      .fish3d-t{color:rgba(255,255,255,.75);font-size:10px}
      .fish3d-f{color:var(--yellow);background:transparent;border:0;padding:0;font-size:10px}
    }
    @media(min-width:940px){
      .hero{padding:44px 28px 36px;text-align:left}
      .hero-inner{grid-template-columns:1.1fr .9fr;gap:56px}
      h1{font-size:50px;letter-spacing:-1.5px}
      .hero-sub,.hero-cite{margin-left:0}
      .fish-tags{justify-content:flex-start}
      .hero-stats{max-width:520px}
      .fish3d{background:#fff;border:2px solid var(--line);box-shadow:4px 4px 0 var(--line);backdrop-filter:none}
      .fish3d-n{color:var(--ink);font-size:12px}
      .fish3d-t{color:var(--muted);font-size:10px}
      .fish3d-img{border-color:var(--line)}
      .demo-phone{border:3px solid var(--line);box-shadow:8px 8px 0 var(--line)}
    }
    @media(min-width:1200px){h1{font-size:56px}}

    /* ── Fish photo marquee ── */
    .ticker{overflow:hidden;padding:16px 0 8px}
    .ticker-track{display:flex;width:max-content;animation:marquee 34s linear infinite}
    .ticker-track:hover{animation-play-state:paused}
    @keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
    .ti{flex:none;width:136px;margin-right:10px;background:#fff;border:2px solid var(--line);border-radius:16px;overflow:hidden}
    .ti-img{width:100%;height:110px;object-fit:cover}
    .ti .fish{display:block;font:800 13px Inter;color:var(--ink);padding:6px 9px 0}
    .ti-t{display:block;font:600 11px Inter;color:#64748B;padding:0 9px 8px}

    /* ── Social proof wall ── */
    .wall{padding:34px 16px 10px;text-align:center}
    .wall h2{margin-bottom:12px}
    .soc{display:flex;justify-content:center;gap:10px}
    .soc a{width:46px;height:46px;border-radius:12px;background:var(--cta);color:var(--cta-fg);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 0 var(--cta-shadow)}
    .soc svg{width:22px;height:22px}
    .dial{background:none!important;--cw:clamp(170px,26vw,330px);--ch:calc(var(--cw)*1.38);position:relative;height:calc(var(--ch)*.82 + 70px);width:100vw;max-width:none;margin:22px 0 0 calc(50% - 50vw);touch-action:pan-y;cursor:grab;overflow:hidden;user-select:none;-webkit-user-select:none;border-radius:0;
      background:radial-gradient(circle at 20% 60%,rgba(0,102,255,.35),transparent 38%),radial-gradient(circle at 80% 40%,rgba(255,209,102,.55),transparent 36%),radial-gradient(circle at 55% 85%,rgba(236,72,153,.28),transparent 34%)}
    .dial.grabbing{cursor:grabbing}
    .dc{position:absolute;left:50%;top:56px;width:var(--cw);height:var(--ch);margin-left:calc(var(--cw)/-2);border-radius:clamp(18px,2.4vw,30px);overflow:hidden;box-shadow:0 14px 34px rgba(10,36,114,.22);transform-origin:50% calc(var(--ch)*3.1);background:#fff;will-change:transform}
    .dc img{width:100%;height:100%;object-fit:cover;pointer-events:none}
    .dc figcaption{position:absolute;left:0;right:0;bottom:0;padding:24px 10px 10px;background:linear-gradient(transparent,rgba(0,0,0,.72));color:#fff;font:700 12px/1.3 Inter;text-align:left}
    .dc-claim{border:1.5px solid rgba(255,255,255,.75);background:rgba(255,255,255,.24);-webkit-backdrop-filter:blur(14px) saturate(160%);backdrop-filter:blur(14px) saturate(160%);box-shadow:0 8px 32px rgba(10,36,114,.18),inset 0 1px 0 rgba(255,255,255,.7);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:var(--ink);padding:12px;cursor:pointer;font:inherit}
    .dc-claim .pl{width:56px;height:56px;border-radius:50%;background:var(--cta);color:var(--cta-fg);font:800 30px/1 Inter;display:flex;align-items:center;justify-content:center;animation:pulse 1.6s infinite}
    .dc-claim b{font:400 17px/1.05 var(--display);text-transform:uppercase;margin-top:10px}
    .dc-claim .st{color:#D97706;font-size:15px;letter-spacing:2px;margin-top:6px}
    .dc-claim .dc-s{font:600 11px/1.35 Inter;color:#334155;margin-top:6px}
    @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(0,102,255,.5)}70%{box-shadow:0 0 0 14px rgba(0,102,255,0)}100%{box-shadow:0 0 0 0 rgba(0,102,255,0)}}
    .hint{font:700 12px Inter;color:#64748B;margin-top:6px}
    .post{margin:22px auto 0;max-width:560px;background:var(--dk);color:#fff;border-radius:20px;padding:18px 16px;text-align:center}
    .post-t{display:block;font:400 20px var(--display);text-transform:uppercase}
    .post p{font:500 14px/1.5 Inter;color:#E2E8F0;margin:6px 0 12px}
    .post p b{color:var(--dk-accent)}
    .rv{position:relative;margin:26px auto 0;max-width:560px}
    .rv::before{content:"";position:absolute;inset:40px 10px 0;background:radial-gradient(circle at 25% 40%,rgba(0,102,255,.35),transparent 45%),radial-gradient(circle at 80% 70%,rgba(255,209,102,.6),transparent 45%);filter:blur(6px);z-index:0}
    .rv h3{position:relative;font:400 22px var(--display);text-transform:uppercase;margin:0 0 10px;color:var(--ink)}
    .rvc{position:relative;z-index:1;min-height:176px;text-align:left;border-radius:18px;padding:16px;background:rgba(255,255,255,.3);-webkit-backdrop-filter:blur(16px) saturate(170%);backdrop-filter:blur(16px) saturate(170%);border:1.5px solid rgba(255,255,255,.75);box-shadow:0 8px 32px rgba(10,36,114,.15),inset 0 1px 0 rgba(255,255,255,.8)}
    .rvc .st{color:#D97706;font-size:18px}
    .rvc p{font:600 15px/1.45 Inter;color:#334155;margin:8px 0}
    .rvc small{display:block;color:#475569;font:600 12px Inter}
    .claimbtn{display:inline-flex;align-items:center;min-height:44px;margin-top:8px;background:var(--cta);color:var(--cta-fg);border:0;border-radius:999px;padding:0 16px;font:800 13px Inter;cursor:pointer}
    .dots{position:relative;display:flex;justify-content:center;gap:6px;margin-top:12px}
    .dots i{width:8px;height:8px;border-radius:5px;background:#C7D2FE;transition:width .2s}
    .dots i.on{background:var(--accent);width:20px}
    @media(min-width:900px){
      .wall{padding:64px 28px 24px}
      .wall-grid{display:block}
      .wall-grid>div:last-child{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:start;max-width:1000px;margin:8px auto 0}
      .wall-grid>div:last-child .rv{margin-top:0}

      .post{margin-top:0}
    }
    @media(prefers-reduced-motion:reduce){.dc-claim .pl,.ticker-track,.fish3d{animation:none}}

    /* ── Claim sheet (native <dialog>) ── */
    .claim-sheet{border:0;padding:0;background:transparent;width:100%;max-width:100%;max-height:100%;margin:auto 0 0}
    .sh{background:var(--cream);max-width:480px;margin:0 auto;border:2px solid var(--line);border-bottom:0;border-radius:22px 22px 0 0;padding:22px 18px calc(24px + env(safe-area-inset-bottom));text-align:center;color:var(--ink)}
    .sh-ic{font-size:44px;line-height:1.1}
    .sh-ic.stars{font-size:34px;color:#D97706;letter-spacing:6px}
    .sh-t{font:400 24px/1.05 var(--display);text-transform:uppercase;margin:8px 0 6px}
    .sh-p{font:600 14px/1.5 Inter;color:#334155;margin:0 0 16px}
    .sh .btn-primary{display:flex;width:100%}
    .sh-x{display:block;width:100%;min-height:44px;margin-top:10px;background:none;border:0;font:700 14px Inter;color:#475569;cursor:pointer}
    @media(min-width:900px){.claim-sheet{margin:auto}.sh{border-bottom:2px solid var(--line);border-radius:22px;box-shadow:6px 6px 0 var(--line)}}

    /* ── Sections ── */
    .sec{padding:44px 16px}
    .sec-alt{background:var(--cream-2)}
    .dk{background:var(--dk);color:#fff}
    .slabel{font:800 11px Inter;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);text-align:center}
    .dk .slabel{color:var(--dk-accent)}
    h2{font:400 32px/1.02 var(--display);text-transform:uppercase;text-align:center;margin:8px 0 10px;letter-spacing:-.5px;color:var(--ink)}
    h2 .hl{color:var(--accent)}
    .dk h2{color:#fff}
    .dk h2 .hl{color:var(--dk-accent)}
    .ssub{text-align:center;font:500 15px/1.55 Inter;color:var(--muted);max-width:540px;margin:0 auto 20px}
    .dk .ssub{color:#CBD5E1}
    .btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:24px}
    @media(min-width:900px){.sec{padding:80px 28px}h2{font-size:48px}.ssub{font-size:17px}}

    /* ── How it works ── */
    .flow-phones{display:grid;gap:12px}
    .flow-step{background:#fff;border:2px solid var(--line);border-radius:18px;padding:14px;box-shadow:4px 4px 0 var(--line);display:flex;gap:12px;align-items:flex-start;text-align:left}
    .flow-step-num{flex:none;width:44px;height:44px;border-radius:12px;background:var(--cta);color:var(--cta-fg);font:400 22px var(--display);display:flex;align-items:center;justify-content:center}
    .flow-step h3{font:800 16px Inter;margin:0 0 4px;color:var(--ink)}
    .flow-step p{font:500 14px/1.5 Inter;color:var(--muted)}
    .flow-step .fp{display:none}
    /* ── phone shell — bigger & premium ── */
    .fp{
      width:100%;max-width:200px;
      border-radius:34px;
      background:linear-gradient(175deg,#1E2D4A,#0D1629);
      border:1.5px solid rgba(255,255,255,.15);
      box-shadow:0 32px 72px rgba(0,0,0,.32),0 0 0 1px rgba(255,255,255,.05),inset 0 1px 0 rgba(255,255,255,.08);
      overflow:hidden;
    }
    .fp-notch{height:24px;background:#000;display:flex;align-items:center;justify-content:center}
    .fp-pill{width:70px;height:8px;background:#191919;border-radius:100px}
    .fp-screen{overflow:hidden;position:relative;height:360px;background:#F7F8FC}

    /* status bar inside each screen */
    .sbar{display:flex;justify-content:space-between;align-items:center;padding:5px 12px 4px;background:rgba(255,255,255,.98);border-bottom:1px solid rgba(0,0,0,.04)}
    .sbar-t{font:700 8px Inter;color:#0A0F1E}
    .sbar-i{display:flex;align-items:center;gap:3px;font-size:8px;color:#0A0F1E}

    /* ─ Screen 1: location ─ */
    .s1-hero{background:linear-gradient(135deg,#2563EB,#1D4ED8);padding:14px 13px 20px;position:relative;overflow:hidden}
    .s1-hero::before{content:'';position:absolute;bottom:-30px;right:-30px;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,.06)}
    .s1-hero-ttl{font:800 13px Inter;color:#fff;margin-bottom:2px}
    .s1-hero-sub{font:400 9px Inter;color:rgba(255,255,255,.65)}
    .s1-srch{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);border-radius:8px;padding:7px 10px;font:400 9px Inter;color:rgba(255,255,255,.65);margin-top:9px;display:flex;align-items:center;gap:5px}
    .s1-list{padding:8px 10px;display:flex;flex-direction:column;gap:6px}
    .s1-row{display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:10px;border:1px solid #E5E7EB;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.06)}
    .s1-row.sel{border-color:#2563EB;background:#EFF6FF;box-shadow:0 0 0 2px rgba(37,99,235,.1)}
    .s1-pin{width:26px;height:26px;border-radius:7px;background:#F3F4F6;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0}
    .s1-row.sel .s1-pin{background:#DBEAFE}
    .s1-rn{font:700 10px Inter;color:#0A0F1E}
    .s1-rd{font:400 8px Inter;color:#9CA3AF;margin-top:1px}
    .s1-ck{width:16px;height:16px;border-radius:50%;background:#2563EB;display:flex;align-items:center;justify-content:center;font-size:8px;color:#fff;margin-left:auto;flex-shrink:0}
    .s1-btn{position:absolute;bottom:0;left:0;right:0;background:#2563EB;padding:10px;text-align:center;font:700 10px Inter;color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.35)}
    .s1-row.sel{animation:taprow .5s ease}
    @keyframes taprow{0%,100%{transform:scale(1)}40%{transform:scale(.975)}}

    /* ─ Screen 2: sellers ─ */
    .s2-top{background:#fff;padding:9px 12px;border-bottom:1px solid #F0F0F0}
    .s2-loc{display:flex;align-items:center;gap:3px;font:400 8px Inter;color:#6B7280}
    .s2-area{font:700 10px Inter;color:#0A0F1E;margin-left:2px}
    .s2-srch{background:#F3F4F6;border-radius:8px;padding:6px 9px;font:400 9px Inter;color:#9CA3AF;margin-top:7px;display:flex;align-items:center;gap:4px}
    .s2-tabs{display:flex;background:#fff;border-bottom:1px solid #F0F0F0}
    .s2t{font:600 9px Inter;padding:7px 11px;border-bottom:2px solid transparent;color:#9CA3AF}
    .s2t.on{color:#2563EB;border-bottom-color:#2563EB}
    .s2-list{padding:8px 9px;display:flex;flex-direction:column;gap:7px;animation:scrollup 5s ease-in-out 1s infinite}
