---
// /s/<slug>/reviews → same page as /seller/<id>/reviews (seller resolved like /s/[slug]).
// Static segment, so it wins over /s/[slug]/[species].
export const prerender = false;

import { getSellerBySlug } from "../../../lib/supabase";
import { sellerHref } from "../../../lib/seller-display";

const slug = (Astro.params.slug || "").toLowerCase();
let seller: any = null;
try {
  seller = await getSellerBySlug(slug);
} catch {
  // DB outage: the /seller/ page renders the 503 state.
}
if (seller) {
  const clean = sellerHref(seller.name, seller.id);
  if (clean !== `/s/${slug}`) return Astro.redirect(`${clean}/reviews${Astro.url.search}`, 308); // old slug
}
return Astro.rewrite(`/seller/${seller?.id || "-"}/reviews${Astro.url.search}`);
---
