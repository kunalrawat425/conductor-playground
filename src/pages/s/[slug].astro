---
// /s/[slug] → resolves seller by name-derived slug, renders same page as /seller/[id]
// e.g. /s/bombay-sea-food → same content as /seller/f3339b19-...
// Canonical is always /s/[slug] for SEO; /seller/[id] kept for backward compat
export const prerender = false;

import AppShell from "../../components/ui/AppShell.astro";
import EmptyState from "../../components/ui/molecules/EmptyState.astro";
import { getSellerBySlug } from "../../lib/supabase";

const { slug } = Astro.params;

let seller: any = null;
let unavailable = false;
try {
  seller = await getSellerBySlug(slug!.toLowerCase());
} catch {
  unavailable = true; // DB error: not the same as "no such seller"
}

if (seller) return Astro.rewrite(`/seller/${seller.id}`);

// No 302 to /shop (Google reads that as a soft 404). Astro.rewrite("/404") is not
// allowed here (404 page is prerendered), so render the state inline:
// 404 when the seller doesn't exist / is inactive, 503 on a DB outage so Google retries
// instead of dropping the page.
Astro.response.status = unavailable ? 503 : 404;
if (unavailable) Astro.response.headers.set("Retry-After", "120");
---
<AppShell
  title={unavailable ? "Temporarily unavailable · Relifish" : "Seller not found · Relifish"}
  description="This seller isn't taking orders on Relifish right now."
  noindex={true}
  header={{ variant: "page", title: unavailable ? "Relifish" : "Not found", backHref: "/shop" }}
  nav={{ active: "home" }}
>
  <div style="padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title={unavailable ? "Couldn't load this seller" : "Seller not found"}
      description={unavailable ? "Please try again in a minute." : "This seller isn't taking orders on Relifish right now. Browse other local sellers."}
      ctaText="Browse sellers"
      ctaHref="/shop"
    />
  </div>
</AppShell>
