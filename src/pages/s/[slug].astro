---
// /s/[slug] → resolves seller by name-derived slug, renders same page as /seller/[id]
// e.g. /s/bombay-sea-food → same content as /seller/f3339b19-...
// Canonical is always /s/[slug] for SEO; /seller/[id] kept for backward compat
export const prerender = false;

import AppShell from "../../components/ui/AppShell.astro";
import SellerHero from "../../components/ui/organisms/SellerHero.astro";
import EmptyState from "../../components/ui/molecules/EmptyState.astro";
import LoginSheet from "../../components/ui/organisms/LoginSheet.astro";
import CheckoutSheet from "../../components/ui/organisms/CheckoutSheet.astro";
import CartStackSheet from "../../components/ui/organisms/CartStackSheet.astro";
import AddressPickerSheet from "../../components/ui/organisms/AddressPickerSheet.astro";
import Toast from "../../components/ui/atoms/Toast.astro";
import Modal from "../../components/ui/atoms/Modal.astro";
import { getSellerBySlug, getSellerListings, sellerNameToSlug } from "../../lib/supabase";
import { getSpeciesDisplay } from "../../lib/species";
import { formatBuyerMenuUnitSuffix, getListingPriceOptions } from "../../lib/listing-pricing";

const { slug } = Astro.params;
const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";

let seller: any = null;
let listings: any[] = [];
let notFound = false;
try {
  seller = await getSellerBySlug(slug!);
  if (seller) {
    listings = await getSellerListings(seller.id);
    listings = listings.filter((l: any) => !!(l.pricing_options?.length));
  } else notFound = true;
} catch { notFound = true; }

if (notFound) {
  return Astro.redirect("/shop", 302);
}

// Flag so /seller/[id].astro knows this is a rewrite, not direct access
Astro.locals.fromSlugRoute = true;
return Astro.rewrite(`/seller/${seller.id}`);
---
