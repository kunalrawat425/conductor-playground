---
// /s/[slug] → resolves seller by name-derived slug, renders same page as /seller/[id]
// e.g. /s/bombay-sea-food → same content as /seller/f3339b19-...
// Canonical is always /s/[slug] for SEO; /seller/[id] kept for backward compat
export const prerender = false;

import AppShellV2 from "../../components/v2/AppShellV2.astro";
import SellerHero from "../../components/v2/organisms/SellerHero.astro";
import EmptyState from "../../components/v2/molecules/EmptyState.astro";
import LoginSheet from "../../components/v2/organisms/LoginSheet.astro";
import CheckoutSheet from "../../components/v2/organisms/CheckoutSheet.astro";
import CartStackSheet from "../../components/v2/organisms/CartStackSheet.astro";
import AddressPickerSheet from "../../components/v2/organisms/AddressPickerSheet.astro";
import Toast from "../../components/v2/atoms/Toast.astro";
import Modal from "../../components/v2/atoms/Modal.astro";
import { getSellerBySlug, getSellerListings, sellerNameToSlug } from "../../lib/supabase";
import { getSpeciesDisplay } from "../../lib/species";
import { formatBuyerMenuUnitSuffix, getListingPriceOptions } from "../../lib/listing-pricing";

const { slug } = Astro.params;
const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";

let seller: any = null;
let listings: any[] = [];
let notFound = false;
try {
  seller = await getSellerBySlug(slug!);
  if (seller) {
    listings = await getSellerListings(seller.id);
    listings = listings.filter((l: any) => !!(l.pricing_options?.length));
  } else notFound = true;
} catch { notFound = true; }

if (notFound) {
  return Astro.redirect("/shop", 302);
}

// Canonical URL is /s/[slug]
const SITE = "https://www.relifish.store";
const canonicalSlug = sellerNameToSlug(seller?.name || "");
const canonicalUrl = `${SITE}/s/${canonicalSlug}`;

// Rewrite to /seller/[id] — keeps slug URL in browser, no redirect
return Astro.rewrite(`/seller/${seller.id}`);
---
