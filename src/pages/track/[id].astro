---
export const prerender = false;
import AppShell from "../../components/ui/AppShell.astro";
import Toast from "../../components/ui/atoms/Toast.astro";
import EmptyState from "../../components/ui/molecules/EmptyState.astro";

const { id } = Astro.params;
---
<AppShell
  noindex={true}
  title="Order details | Relifish"
  description="View order details, status, and seller contact."
  header={{
    variant: "page",
    title: "Order details",
    backHref: "/track",
  }}
  nav={{ active: "orders" }}
>
  <Toast />

  <div id="v2-od-loading" style="padding:24px;text-align:center;">
    <span class="v2-spinner v2-spinner-md"></span>
  </div>

  <div id="v2-od-not-found" style="display:none;padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Order not found"
      description="This order doesn't exist or you don't have access."
      ctaText="See all orders"
      ctaHref="/track"
    />
  </div>

  <div id="v2-od-content" style="display:none;padding:0 16px 24px;">
    <!-- Status hero -->
    <div class="v2-od-hero">
      <div style="display:flex; justify-content:center; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:8px;">
        <div class="v2-od-status" id="v2-od-status" style="margin:0;">—</div>
        <div id="v2-od-payment-pill" style="display:none; padding:3px 10px; border-radius:999px; font:700 11px Inter; text-transform:uppercase; letter-spacing:0.02em; background:#FFFBEB; color:#B45309;">—</div>
      </div>
      <div class="v2-od-id" style="margin-top:0;">Order <span id="v2-od-shortid">—</span></div>
      <div class="v2-od-time" id="v2-od-time">—</div>
    </div>

    <!-- Stepper -->
    <div class="v2-od-section">
      <div class="v2-od-stepper" id="v2-od-stepper"></div>
      <div class="v2-od-steplabels">
        <span>Placed</span><span>Confirmed</span><span>Ready</span><span>Done</span>
      </div>
    </div>

    <!-- Seller -->
    <div class="v2-od-section">
      <div class="v2-od-section-h">From</div>
      <div class="v2-od-row">
        <div>
          <div class="v2-od-seller" id="v2-od-seller">—</div>
          <div class="v2-od-sub" id="v2-od-seller-loc">—</div>
        </div>
        <!-- Call option removed per user request -->
      </div>
    </div>

    <!-- Items -->
    <div class="v2-od-section">
      <div class="v2-od-section-h">Items</div>
      <div id="v2-od-items"></div>
    </div>

    <!-- Pre-order info (shown only for pre_order status) -->
    <div id="v2-od-preorder-info" style="display:none;"></div>

    <!-- Delivery / Pickup -->
    <div class="v2-od-section" id="v2-od-fulfill"></div>

    <!-- Bill -->
    <div class="v2-od-section">
      <div class="v2-od-section-h">Bill summary</div>
      <div class="v2-od-bill" id="v2-od-bill"></div>
    </div>

    <!-- Actions -->
    <div id="v2-od-actions" style="margin-top:16px;"></div>
    <!-- Scheduled-order cancel (confirmed+); separate from #v2-od-actions so prefs form re-renders do not wipe it -->
    <div id="v2-od-extra-payment"></div>
  </div>
</AppShell>

<style is:global>
  .v2-od-hero {
    background: linear-gradient(135deg, var(--v2-brand), #3B82F6);
    color: #fff;
    padding: 20px 16px;
    margin: 16px 0;
    border-radius: var(--v2-radius-lg);
    text-align: center;
  }
  .v2-od-status { font: 800 18px Inter; }
  .v2-od-id { font: 600 12px Inter; opacity: .9; margin-top: 4px; }
  .v2-od-time { font: 400 11px Inter; opacity: .8; margin-top: 2px; }
  .v2-od-section {
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius);
    padding: 14px;
    margin-bottom: 12px;
  }
  .v2-od-section-h { font: 700 11px Inter; color: var(--v2-ink-3); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 8px; }
  .v2-od-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .v2-od-seller { font: 700 14px Inter; color: var(--v2-ink); }
  .v2-od-sub { font: 400 12px Inter; color: var(--v2-ink-2); margin-top: 2px; }
  .v2-od-call {
    background: var(--v2-green);
    color: #fff;
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 9999px;
    font: 700 12px Inter;
    flex-shrink: 0;
  }
  .v2-od-item-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--v2-border);
    font: 500 13px Inter;
  }
  .v2-od-item-row:last-child { border-bottom: none; }
  .v2-od-item-name { color: var(--v2-ink); font-weight: 600; }
  .v2-od-item-qty { color: var(--v2-ink-3); font-size: 11px; margin-top: 2px; }
  .v2-od-bill div { display: flex; justify-content: space-between; padding: 4px 0; font: 500 13px Inter; color: var(--v2-ink-2); }
  .v2-od-bill .total { font: 800 15px Inter; color: var(--v2-ink); padding-top: 8px; border-top: 1px solid var(--v2-border); margin-top: 4px; }
  .v2-od-stepper {
    display: flex; align-items: center; gap: 4px;
    margin-bottom: 6px;
  }
  .v2-od-stepper .dot {
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--v2-ink-4); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font: 700 11px Inter; flex-shrink: 0;
  }
  .v2-od-stepper .dot.done { background: var(--v2-green); }
  .v2-od-stepper .line { flex: 1; height: 2px; background: var(--v2-bg-3); }
  .v2-od-stepper .line.done { background: var(--v2-green); }
  .v2-od-steplabels {
    display: flex; justify-content: space-between;
    font: 500 9px Inter; color: var(--v2-ink-3);
  }
  .v2-od-cancel {
    width: 100%;
    background: var(--v2-bg);
    color: var(--v2-red);
    border: 1px solid var(--v2-red-l);
    padding: 14px;
    border-radius: var(--v2-radius);
    font: 700 13px Inter;
    cursor: pointer;
  }
</style>

<script>
  import { wasActuallyPaid, refundableAmount, paymentMethodLabel, refundStatus } from "../../lib/order-payment-state";
  import { buyerCancelRule, cancelledByText, cancelReasonText } from "../../lib/order-cancel";
  import { createClient } from "@supabase/supabase-js";
  import { isPreorderCatchFlow, resolveBuyerStepper } from "../../lib/buyer-order-stepper";
  import { cleanSellerName } from "../../lib/seller-display";
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL || "",
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || ""
  );
  const RAZORPAY_KEY_ID  = import.meta.env.PUBLIC_RAZORPAY_KEY_ID  || "";
  // Extract order ID from URL path: /track/{id}
  const orderId = window.location.pathname.split("/").filter(Boolean).pop() || "";
  function escape(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  }
  function stars(n) {
    const rating = Math.max(0, Math.min(5, Number(n) || 0));
    return [1, 2, 3, 4, 5].map(i => i <= rating ? "★" : "☆").join(" ");
  }
  function statusLabel(s) {
    const pendingLabel = "Complete payment";
    return ({
      pending: pendingLabel,
      pending_payment: pendingLabel,
      pre_order: "Pre-order placed",
      scheduled: "Scheduled pickup",
      confirmed: "Confirmed ✓",
      paid: "Paid — waiting for seller to confirm",
      payment_required: "Additional payment needed",
      ready_for_pickup: "Ready for pickup",
      out_for_delivery: "Out for delivery",
      picked_up: "Picked up",
      completed: "Completed",
      declined: "Declined by seller",
      cancelled: "Cancelled",
      refunded: "Refund processed",
    })[s] || s;
  }
  function billPaymentFootnote(o) {
    return paymentMethodLabel(o) || "Payment pending";
  }
  // Same rule the server enforces (refund policy): see src/lib/order-cancel.ts.
  function isCancellable(o) {
    return buyerCancelRule(o, o.listing?.seller || o.seller || null).ok;
  }
  /** Cancel button + handler; any paid amount is refunded in full by the server. */
  function attachCancelButton(o, container) {
    const paid = wasActuallyPaid(o);
    const wrap = document.createElement("div");
    wrap.innerHTML = `<button class="v2-od-cancel" style="margin-top:10px;">Cancel order${paid ? " · full refund" : ""}</button>`;
    container.appendChild(wrap);
    wrap.querySelector("button").addEventListener("click", async () => {
      const msg = paid
        ? "Cancel this order? Your payment is refunded in full to your original payment method (5–7 working days)."
        : "Cancel this order? This cannot be undone.";
      if (!confirm(msg)) return;
      const reason = prompt("Why are you cancelling? The seller sees this (optional).", "");
      if (reason === null) return;
      try {
        const buyerId = localStorage.getItem("rlf_buyer_id") || "";
        const res = await fetch("/api/orders/cancel", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ order_id: o.id, buyer_id: buyerId, action: "cancel", cancel_reason: reason.trim() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Cancel failed");
        window.v2Toast?.("success", "Order cancelled", paid ? "Refund started" : "");
        setTimeout(() => load(), 600);
      } catch (err) {
        window.v2Toast?.("error", "Could not cancel", err.message);
      }
    });
  }

  let pollTimer = null;

  async function load() {
    const phone = (() => { try { return localStorage.getItem("rlf_phone") || ""; } catch { return ""; } })();
    const buyerId = (() => { try { return localStorage.getItem("rlf_buyer_id") || ""; } catch { return ""; } })();
    if (!phone || !buyerId) {
      window.location.href = "/track";
      return;
    }
    try {
      const res = await fetch(`/api/orders/detail?id=${encodeURIComponent(orderId)}&buyer_id=${encodeURIComponent(buyerId)}`);
      if (res.status === 404 || res.status === 403) {
        document.getElementById("v2-od-loading").style.display = "none";
        document.getElementById("v2-od-not-found").style.display = "block";
        return;
      }
      if (!res.ok) throw new Error("Load failed");
      const { order } = await res.json();
      render(order);
    } catch (err) {
      document.getElementById("v2-od-loading").style.display = "none";
      document.getElementById("v2-od-not-found").style.display = "block";
    }
  }

  function render(o) {
    document.getElementById("v2-od-loading").style.display = "none";
    document.getElementById("v2-od-content").style.display = "block";
    const extraPaySlot = document.getElementById("v2-od-extra-payment");
    if (extraPaySlot) extraPaySlot.innerHTML = "";

    document.getElementById("v2-od-status").textContent = statusLabel(o.status);
    document.getElementById("v2-od-shortid").textContent = "#" + String(o.id).slice(0,8).toUpperCase();
    document.getElementById("v2-od-time").textContent = new Date(o.created_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" });
    
    // Payment Pill
    const payPill = document.getElementById("v2-od-payment-pill");
    const isPaidViaRazorpay = o.payment_method === 'razorpay' && o.razorpay_payment_id;
    // Never show "Paid" when order is still awaiting payment — statusLabel handles that
    const awaitingPayment = ['pending_payment', 'pending'].includes(o.status);
    let payStatusText = "";
    if (o.status === 'refunded') payStatusText = "Refunded";
    else if (['declined', 'cancelled'].includes(o.status) && wasActuallyPaid(o)) payStatusText = "Refund pending";
    else if (!awaitingPayment && (wasActuallyPaid(o) || isPaidViaRazorpay || ['confirmed', 'paid', 'ready_for_pickup', 'out_for_delivery', 'picked_up', 'completed'].includes(o.status))) {
      // BUG-43: a pre-order that priced in cheaper than the buyer paid now stays
      // `confirmed` with the difference in refund_amt, instead of being flipped
      // to `refunded` (which restored stock on a live order). Surface the amount
      // owed, or the buyer never learns money is coming back.
      const dueBack = Number(o.refund_amt) || 0;
      payStatusText = dueBack > 0 && !o.refund_sent_at
        ? `Paid · ₹${dueBack.toLocaleString("en-IN")} refund due`
        : "Paid";
    }
    
    if (payPill) {
      if (payStatusText) {
        payPill.style.display = "inline-block";
        payPill.textContent = payStatusText;
        if (payStatusText === "Paid") {
          payPill.style.background = "#DCFCE7";
          payPill.style.color = "#059669";
        } else if (payStatusText.includes("Refund")) {
          payPill.style.background = "#FEE2E2";
          payPill.style.color = "#DC2626";
        } else {
          payPill.style.background = "#FFFBEB";
          payPill.style.color = "#B45309";
        }
      } else {
        payPill.style.display = "none";
      }
    }

    // Hero colour: green for confirmed/done, red for declined/cancelled, orange for payment actions
    const hero = document.querySelector(".v2-od-hero");
    if (hero) {
      if (["confirmed","paid","ready_for_pickup","out_for_delivery","picked_up","completed"].includes(o.status)) {
        hero.style.background = "linear-gradient(135deg,#059669,#10B981)";
      } else if (["declined","cancelled"].includes(o.status)) {
        hero.style.background = "linear-gradient(135deg,#DC2626,#EF4444)";
      } else if (["pending_payment","payment_required"].includes(o.status)) {
        hero.style.background = "linear-gradient(135deg,#D97706,#F59E0B)";
      } else if (o.status === "refunded") {
        hero.style.background = "linear-gradient(135deg,#6366F1,#818CF8)";
      } else if (o.status === "pre_order") {
        hero.style.background = "linear-gradient(135deg,#7C3AED,#A78BFA)";
      }
    }

    // Stepper — simple (4) vs same-day (5, no Price set) vs catch pre-order (5 + Price set)
    const orderType = (o.order_type || "pickup") === "delivery" ? "delivery" : "pickup";
    const { labels: stepLabels, step } = resolveBuyerStepper(o, orderType);
    const stepper = document.getElementById("v2-od-stepper");
    const stepLabelEl = document.querySelector(".v2-od-steplabels");
    const isRefundStepper = ["declined","cancelled"].includes(o.status) && wasActuallyPaid(o);
    if (isRefundStepper) {
      const refundStep = o.refund_sent_at ? 2 : 1;
      const refundLabels = ["Placed", o.status === "declined" ? "Declined" : "Cancelled", "Refund"];
      stepper.innerHTML = [0,1,2].map(i =>
        `<div class="dot${i <= refundStep ? ' done' : ''}" style="${i === 1 ? 'background:var(--v2-red);' : ''}">${i <= refundStep ? '✓' : i+1}</div>` +
        (i < 2 ? `<div class="line${i < refundStep ? ' done' : ''}"></div>` : '')
      ).join("");
      if (stepLabelEl) stepLabelEl.innerHTML = refundLabels.map(l => `<span>${l}</span>`).join("");
    } else {
      const terminalMeta = {
        declined: { label: "Declined", color: "#DC2626", icon: "✕" },
        cancelled: { label: "Cancelled", color: "#DC2626", icon: "✕" },
      };
      const terminal = terminalMeta[o.status];
      if (terminal) {
        stepper.innerHTML = `
          <div class="dot done">✓</div>
          <div class="line done"></div>
          <div class="dot" style="background:${terminal.color};color:#fff;font-size:11px;">${terminal.icon}</div>
        `;
        if (stepLabelEl) stepLabelEl.innerHTML = `<span>Placed</span><span style="color:${terminal.color};font-weight:700;margin-left:auto;">${terminal.label}</span>`;
      } else {
        stepper.innerHTML = Array.from({ length: stepLabels.length }, (_, i) =>
          `<div class="dot${i <= step ? ' done' : ''}">${i <= step ? '✓' : i+1}</div>` +
          (i < stepLabels.length - 1 ? `<div class="line${i < step ? ' done' : ''}"></div>` : '')
        ).join("");
        if (stepLabelEl) stepLabelEl.innerHTML = stepLabels.map(l => `<span>${l}</span>`).join("");
      }
    }

    // Seller
    const seller = o.seller || {};
    document.getElementById("v2-od-seller").textContent = cleanSellerName(seller.name) || "Seller";
    document.getElementById("v2-od-seller-loc").textContent = seller.location_name || seller.location || "";
    // Call option removed per user request

    // Items
    const items = (o.items && o.items.length > 0) ? o.items : [{
      species: o.listing?.species || o.species,
      quantity: o.quantity,
      quantity_unit: o.quantity_unit,
      total_price: o.total_price,
    }];
    // Cut style & notes (may be on order directly or on individual items)
    const cutStyle = o.cut_style || "";
    const buyerNotes = o.buyer_notes || "";

    const pricingOpts = o.listing?.pricing_options || [];
    const opt = pricingOpts.find((x: any) => x?.id && x.id === o.pricing_option_id) || null;
    const bundle = opt?.bundle_size && opt.bundle_size > 0 ? Number(opt.bundle_size) : 1;
    document.getElementById("v2-od-items").innerHTML = items.map(it => {
      const unit = it.quantity_unit || 'kg';
      const qtyLabel = unit === "piece" && bundle > 1 ? `${Math.round(Number(it.quantity) / bundle)} pack` : (unit === "kg" && Number(it.quantity) > 0 && Number(it.quantity) < 1 ? `${Math.round(Number(it.quantity) * 1000)} grams` : `${escape(it.quantity)} ${escape(unit)}`);
      return `
      <div class="v2-od-item-row">
        <div>
          <div class="v2-od-item-name" style="text-transform:capitalize;">${escape(it.species || "Fish")}</div>
          <div class="v2-od-item-qty">${qtyLabel}</div>
        </div>
        <div style="font-weight:700;">₹${(it.total_price || 0).toLocaleString("en-IN")}</div>
      </div>`;
    }).join("")
      + (cutStyle ? `<div style="font:600 12px Inter;color:var(--v2-ink-2);margin-top:8px;">✂️ ${escape(cutStyle.split(",").map(c => ({whole:"Whole",cleaned:"Cleaned",cut:"Cut"})[c] || c).join(", "))}</div>` : "")
      + (buyerNotes ? `<div style="font:400 12px Inter;color:var(--v2-ink-3);margin-top:4px;">📝 ${escape(buyerNotes)}</div>` : "");

    // Fulfillment
    const fulfillEl = document.getElementById("v2-od-fulfill");
    if (o.order_type === "delivery" && o.address) {
      const a = o.address;
      const text = [a.flat, a.building, a.landmark, a.location_name].filter(Boolean).map(escape).join(", ");
      fulfillEl.innerHTML = `
        <div class="v2-od-section-h">Deliver to</div>
        <div style="font:600 13px Inter;color:var(--v2-ink);">${escape(a.label || "Address")}</div>
        <div class="v2-od-sub">${text || "Saved address"}</div>`;
    } else {
      fulfillEl.innerHTML = `
        <div class="v2-od-section-h">Pickup at</div>
        <div style="font:600 13px Inter;color:var(--v2-ink);">${escape(seller.location_name || seller.location || "Seller location")}</div>
        ${o.scheduled_for ? `<div class="v2-od-sub">Scheduled: ${new Date(o.scheduled_for).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" })}</div>` : ''}`;
    }

    // Pre-order info box
    const preorderEl = document.getElementById("v2-od-preorder-info");
    if (preorderEl) {
      const awaitingFinal =
        Number(o.paid_amount) > 0 &&
        (o.final_price == null || o.final_price === "");
      if (
        isPreorderCatchFlow(o) &&
        (["pending_payment", "payment_required", "pre_order"].includes(o.status) || awaitingFinal)
      ) {
        const amountDue = o.paid_amount ? `₹${Number(o.paid_amount).toLocaleString("en-IN")}` : "";
        // Per-unit preorder range from pricing_options (matched by pricing_option_id used on this order)
        const popts: any[] = o.listing?.pricing_options || [];
        const matchedOpt = popts.find((p: any) => p?.id && p.id === o.pricing_option_id) || popts[0] || {};
        const priceMin = matchedOpt.preorder_price_min;
        const priceMax = matchedOpt.preorder_price_max;
        const rangeHtml = priceMin && priceMax
          ? `<div style="font:700 13px Inter;color:#7C3AED;margin:8px 0 4px;">Expected price range: ₹${Number(priceMin).toLocaleString("en-IN")} – ₹${Number(priceMax).toLocaleString("en-IN")}</div>`
          : priceMin ? `<div style="font:700 13px Inter;color:#7C3AED;margin:8px 0 4px;">Min estimate: ₹${Number(priceMin).toLocaleString("en-IN")}</div>` : "";
        preorderEl.innerHTML = `
          <div style="background:#F5F3FF;border:1.5px solid #C4B5FD;border-radius:var(--v2-radius-sm);padding:14px;margin-bottom:12px;">
            <div style="font:700 13px Inter;color:#7C3AED;margin-bottom:6px;">🌙 Next-day catch pre-order</div>
            ${rangeHtml}
            <div style="font:400 12px Inter;color:#6D28D9;line-height:1.6;margin-top:6px;">Pay via Razorpay to place your pre-order, then the seller will set the final price after the morning catch.${amountDue ? ` Amount: <strong>${amountDue}</strong>.` : ""}</div>
            <div style="font:400 11px Inter;color:#8B5CF6;margin-top:6px;line-height:1.5;">If the final price is <strong>lower</strong> than you paid → <strong>the difference is refunded automatically</strong> to your original payment method (5–7 working days). If <strong>higher</strong> → you'll approve the difference.</div>
          </div>`;
        preorderEl.style.display = "block";
      } else {
        preorderEl.style.display = "none";
        preorderEl.innerHTML = "";
      }
    }

    // Bill
    const subtotal = o.total_price || 0;
    const delivery = o.delivery_fee || 0;
    const grand = subtotal + delivery;
    const finalPrice = o.final_price ? Number(o.final_price) : null;
    const paidAmount = o.paid_amount ? Number(o.paid_amount) : null;
    // Only show "You paid" after actual payment — not for pending_payment (paid_amount is pre-set at creation)
    const paymentConfirmed = o.status !== "pending_payment" && o.status !== "pending" && o.payment_verified_at;
    const showPaidAmount = paidAmount && paymentConfirmed;
    const balance = finalPrice && showPaidAmount ? finalPrice - paidAmount : null;
    document.getElementById("v2-od-bill").innerHTML = `
      <div><span>Subtotal</span><span>₹${subtotal.toLocaleString("en-IN")}</span></div>
      ${delivery > 0 ? `<div><span>Delivery</span><span>₹${delivery.toLocaleString("en-IN")}</span></div>` : ''}
      <div class="total"><span>Total</span><span>₹${grand.toLocaleString("en-IN")}</span></div>
      ${finalPrice ? `<div style="padding-top:6px;border-top:1px solid var(--v2-border);margin-top:4px;"><span style="color:var(--v2-ink-2);">Final price (seller)</span><span style="font-weight:700;color:var(--v2-ink);">₹${finalPrice.toLocaleString("en-IN")}</span></div>` : ''}
      ${showPaidAmount ? `<div><span style="color:var(--v2-ink-2);">You paid</span><span style="color:var(--v2-green);">₹${paidAmount.toLocaleString("en-IN")}</span></div>` : ''}
      ${balance && balance > 0 ? `<div><span style="color:var(--v2-red);">Balance due</span><span style="font-weight:700;color:var(--v2-red);">₹${balance.toLocaleString("en-IN")}</span></div>` : ''}
      ${balance && balance < 0 ? `<div><span style="color:var(--v2-green);">Refund</span><span style="font-weight:700;color:var(--v2-green);">₹${Math.abs(balance).toLocaleString("en-IN")}</span></div>` : ''}
      <div style="font:400 11px Inter;color:var(--v2-ink-3);margin-top:4px;">${escape(billPaymentFootnote(o))}</div>
      ${o.razorpay_payment_id ? `<div style="font:400 11px Inter;color:var(--v2-ink-3);margin-top:2px;">Payment ref: <span style="font-family:monospace;user-select:all;">${escape(o.razorpay_payment_id)}</span></div>` : ''}`;

    // Actions
    const actions = document.getElementById("v2-od-actions");
    if (o.status === "pending_payment" || o.status === "pending") {
      // Razorpay pay button — pending_payment is the normal pay-first flow;
      // pending covers legacy orders created before the pending_payment migration.
      renderPaymentUpload(o, "pending");
      const pre = isPreorderCatchFlow(o);
      const cancelLabel = pre ? "Cancel pre-order" : "Cancel order";
      const cancelConfirm = pre ? "Cancel this pre-order?" : "Cancel this order?";
      const cancelToast = pre ? "Pre-order cancelled" : "Order cancelled";
      const cancelHtml = `<button class="v2-od-cancel" id="v2-od-cancel-btn" style="margin-top:8px;">${cancelLabel}</button>`;
      // Don't use `innerHTML += ...` here. It re-parses the whole subtree and drops
      // the event listeners we just attached inside renderPaymentUpload().
      actions.insertAdjacentHTML("beforeend", cancelHtml);
      document.getElementById("v2-od-cancel-btn")?.addEventListener("click", async () => {
        if (!confirm(cancelConfirm)) return;
        try {
          const buyerId = localStorage.getItem("rlf_buyer_id") || "";
          const res = await fetch("/api/orders/cancel", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ order_id: o.id, buyer_id: buyerId, action: "cancel" }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Cancel failed");
          window.v2Toast?.("success", cancelToast);
          setTimeout(() => load(), 600);
        } catch (err) {
          window.v2Toast?.("error", "Failed", err.message);
        }
      });
    } else if (isCancellable(o) && !["confirmed", "paid", "payment_required"].includes(o.status)) {
      actions.innerHTML = "";
      attachCancelButton(o, actions);
    } else if (["completed", "picked_up", "cancelled", "declined"].includes(o.status)) {
      // Finished/cancelled order — show refund notice if paid, ask rating for completed/picked_up, then offer re-order.
      // BUG-42: gate on real payment, not the pre-set paid_amount.
      const paidForRefund = refundableAmount(o);
      let refundHtml = "";
      const isDelivered = ["completed", "picked_up"].includes(o.status);
      const existingFeedback = o.buyer_feedback || null;
      const isClosed = ["cancelled", "declined"].includes(o.status);
      const whoText = cancelledByText(o.cancelled_by, "buyer", o.cancel_reason);
      const label = o.status === "declined" ? whoText.replace(/^Cancelled/, "Declined") : whoText;
      const why = cancelReasonText(o.cancel_reason);
      const whyHtml = why ? `<div style="font:500 13px Inter;color:var(--v2-ink-2);margin-bottom:8px;">Reason: ${escape(why)}</div>` : "";
      if (isClosed && paidForRefund <= 0) {
        refundHtml = `
          <div style="background:var(--v2-bg);border:1.5px solid #FCA5A5;border-radius:var(--v2-radius);padding:16px;margin-top:8px;margin-bottom:8px;">
            <div style="font:800 14px Inter;color:#DC2626;margin-bottom:6px;">❌ ${escape(label)}</div>
            ${whyHtml}
          </div>`;
      }
      if (paidForRefund > 0 && isClosed) {
        const rs = refundStatus(o);
        const rsColor = rs.state === "refunded" ? "#059669" : rs.state === "delayed" ? "#B45309" : "#7C3AED";
        const rsTitle = rs.state === "refunded"
          ? `✓ Refunded on ${new Date(o.refund_sent_at).toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata" })}`
          : rs.state === "delayed" ? "Refund delayed — retrying" : "Refund processing";
        refundHtml = `
          <div style="background:var(--v2-bg);border:1.5px solid #FCA5A5;border-radius:var(--v2-radius);padding:16px;margin-top:8px;margin-bottom:8px;">
            <div style="font:800 14px Inter;color:#DC2626;margin-bottom:8px;">❌ ${escape(label)}</div>
            ${whyHtml}
            <div style="font:700 13px Inter;color:var(--v2-ink);margin-bottom:4px;">Refund: ₹${paidForRefund.toLocaleString("en-IN")}</div>
            <div style="font:700 12px Inter;color:${rsColor};margin-bottom:4px;">${rsTitle}</div>
            <div style="font:600 11px Inter;color:${rsColor};padding:8px 10px;background:#F5F3FF;border-radius:var(--v2-radius-sm);">⏱ ${escape(rs.text)}</div>
          </div>`;
      }
      const feedbackHtml = isDelivered
        ? `
          <div style="background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:var(--v2-radius);padding:14px;margin-top:8px;margin-bottom:8px;">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;">
              <div style="font:700 13px Inter;color:var(--v2-ink);">⭐ Rate your order</div>
              ${existingFeedback ? `<div style="font:700 12px Inter;color:#D97706;">${stars(existingFeedback.rating)}</div>` : ""}
            </div>
            <div id="v2-od-rate-stars" style="display:flex;gap:6px;margin-bottom:10px;">
              ${[1, 2, 3, 4, 5].map((r) =>
                `<button type="button" class="v2-od-rate-star" data-rating="${r}" aria-label="Rate ${r} star" style="border:1px solid var(--v2-border);background:${existingFeedback && Number(existingFeedback.rating) >= r ? "#FEF3C7" : "var(--v2-bg)"};color:${existingFeedback && Number(existingFeedback.rating) >= r ? "#D97706" : "var(--v2-ink-3)"};border-radius:8px;padding:6px 8px;font:700 14px Inter;cursor:pointer;">★</button>`
              ).join("")}
            </div>
            <textarea id="v2-od-feedback" rows="2" placeholder="Share your feedback (optional)" style="width:100%;padding:10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 13px Inter;color:var(--v2-ink);background:var(--v2-bg);resize:vertical;outline:none;box-sizing:border-box;">${escape(existingFeedback?.feedback || "")}</textarea>
            <button id="v2-od-feedback-save" class="v2-btn v2-btn-primary v2-btn-sm v2-btn-full" style="margin-top:10px;">${existingFeedback ? "Update rating" : "Submit rating"}</button>
            ${existingFeedback ? `<div style="font:500 11px Inter;color:var(--v2-ink-3);margin-top:6px;">Thanks for your feedback on ${new Date(existingFeedback.updated_at || existingFeedback.created_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" })}</div>` : ""}
          </div>`
        : "";
      actions.innerHTML = refundHtml + feedbackHtml;
      if (isDelivered) {
        let selectedRating = Number(existingFeedback?.rating) || 0;
        const paint = () => {
          actions.querySelectorAll(".v2-od-rate-star").forEach((el) => {
            const star = el as HTMLButtonElement;
            const r = Number(star.dataset.rating || 0);
            const on = r <= selectedRating;
            star.style.background = on ? "#FEF3C7" : "var(--v2-bg)";
            star.style.color = on ? "#D97706" : "var(--v2-ink-3)";
            star.style.borderColor = on ? "#FCD34D" : "var(--v2-border)";
          });
        };
        actions.querySelectorAll(".v2-od-rate-star").forEach((el) => {
          el.addEventListener("click", () => {
            selectedRating = Number((el as HTMLButtonElement).dataset.rating || 0);
            paint();
          });
        });
        paint();
        document.getElementById("v2-od-feedback-save")?.addEventListener("click", async () => {
          if (!selectedRating) {
            window.v2Toast?.("error", "Please rate", "Tap 1-5 stars before submitting");
            return;
          }
          const btn = document.getElementById("v2-od-feedback-save") as HTMLButtonElement;
          const note = (document.getElementById("v2-od-feedback") as HTMLTextAreaElement)?.value?.trim() || "";
          btn.disabled = true;
          btn.textContent = "Saving...";
          try {
            const buyerId = localStorage.getItem("rlf_buyer_id") || "";
            const res = await fetch("/api/orders/feedback", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                order_id: o.id,
                buyer_id: buyerId,
                rating: selectedRating,
                feedback: note,
              }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Failed to save feedback");
            window.v2Toast?.("success", "Thanks for rating", "Your feedback helps improve seller quality");
            setTimeout(() => load(), 500);
          } catch (err: any) {
            window.v2Toast?.("error", "Failed", err.message || "Could not save feedback");
            btn.disabled = false;
            btn.textContent = existingFeedback ? "Update rating" : "Submit rating";
          }
        });
      }
      const sellerIdForReorder = o.seller?.id || o.listing?.seller_id || "";
      if (sellerIdForReorder) {
        // insertAdjacentHTML preserves existing nodes — innerHTML += re-parses the whole
        // actions block and drops rating/submit listeners.
        actions.insertAdjacentHTML(
          "beforeend",
          `<button class="v2-od-cancel" id="v2-od-reorder-btn" style="background:var(--v2-brand);color:#fff;border:none;">Re-order from ${escape(cleanSellerName(seller.name) || "this seller")}</button>`
        );
        document.getElementById("v2-od-reorder-btn")?.addEventListener("click", () => {
          const Cart = window.RelifishCart;
          if (Cart) {
            items.forEach((it) => {
              Cart.addItem({
                listing_id: o.listing_id || "",
                seller_id: sellerIdForReorder,
                seller_name: cleanSellerName(seller.name) || "Seller",
                name: it.species || "Fish",
                qty_unit: it.quantity_unit || "kg",
                price: it.total_price || 0,
                qty: it.quantity || 1,
              });
            });
          }
          try { if (typeof gtag === "function") gtag("event", "reorder_clicked", { seller_id: sellerIdForReorder, seller_name: seller.name, order_id: o.id }); } catch {}
          const sellerSlug = (seller.name||"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
          window.location.href = `/s/${sellerSlug}`;
        });
      }
    } else if (o.status === "ready_for_pickup" || o.status === "out_for_delivery") {
      // Order in transit or ready — preferences locked, show read-only
      const savedCuts2 = (o.cut_style || "").split(",").filter(Boolean);
      const cutLabels2: Record<string, string> = { whole: "🐟 Whole", cleaned: "✂️ Cleaned", cut: "🔪 Cut" };
      const cutDisplay2 = savedCuts2.map(c => cutLabels2[c] || c).join(", ");
      const statusMsg = o.status === "out_for_delivery"
        ? "🛵 On the way — preferences locked"
        : "✅ Order ready — preferences locked";
      const hasAnyPref = cutDisplay2 || o.buyer_notes;
      actions.innerHTML = `
        <div style="background:var(--v2-bg);border:1px solid #86EFAC;border-radius:var(--v2-radius);padding:14px;margin-top:8px;">
          <div style="font:700 13px Inter;color:#059669;margin-bottom:6px;">${statusMsg}</div>
          ${hasAnyPref
            ? `${cutDisplay2 ? `<div style="font:500 13px Inter;color:var(--v2-ink);margin-bottom:4px;">Cut: ${cutDisplay2}</div>` : ""}
               ${o.buyer_notes ? `<div style="font:400 12px Inter;color:var(--v2-ink-3);">📝 ${escape(o.buyer_notes)}</div>` : ""}`
            : `<div style="font:400 12px Inter;color:var(--v2-ink-3);">No preference added</div>`}
          <div style="font:400 11px Inter;color:var(--v2-ink-3);margin-top:8px;">No changes possible after this point.</div>
        </div>`;
    } else if (["confirmed", "paid", "scheduled"].includes(o.status)) {
      const hasCut = !!o.cut_style;
      const hasNotes = !!o.buyer_notes;
      const alreadySaved = hasCut || hasNotes;

      const savedCuts = (o.cut_style || "").split(",").filter(Boolean);
      const cutOptions = [
        { value: "whole", label: "🐟 Whole" },
        { value: "cleaned", label: "✂️ Cleaned" },
        { value: "cut", label: "🔪 Cut" },
      ];

      if (alreadySaved) {
        const cutDisplay = savedCuts.map(c => cutOptions.find(x => x.value === c)?.label || c).join(", ") || "Not set";
        actions.innerHTML = `
          <div style="background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:var(--v2-radius);padding:14px;margin-top:8px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
              <div style="font:700 13px Inter;color:var(--v2-ink);">✅ Preferences saved</div>
              <button id="v2-od-edit-prefs" type="button" style="background:none;border:none;font:600 12px Inter;color:var(--v2-brand);cursor:pointer;">Edit</button>
            </div>
            <div style="font:500 13px Inter;color:var(--v2-ink);margin-bottom:4px;">${cutDisplay}</div>
            ${hasNotes ? `<div style="font:400 12px Inter;color:var(--v2-ink-3);margin-top:4px;">📝 ${escape(o.buyer_notes)}</div>` : ''}
          </div>`;
        document.getElementById("v2-od-edit-prefs")?.addEventListener("click", () => showPrefsForm(o));
      } else {
        showPrefsForm(o);
      }

      function showPrefsForm(o) {
        const sc = (o.cut_style || "").split(",").filter(Boolean);
        actions.innerHTML = `
          <div style="background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:var(--v2-radius);padding:14px;margin-top:8px;">
            <div style="font:700 13px Inter;color:var(--v2-ink);margin-bottom:10px;">✂️ Add preferences</div>
            <div style="font:400 11px Inter;color:var(--v2-ink-3);margin-bottom:12px;">Select how you want your fish prepared. You can choose multiple.</div>
            <div style="margin-bottom:10px;">
              <label style="font:600 12px Inter;color:var(--v2-ink-2);display:block;margin-bottom:6px;">Cut style</label>
              <div style="display:flex;gap:8px;" id="v2-od-cut-opts">
                ${cutOptions.map(opt => {
                  const checked = sc.includes(opt.value);
                  return `<label style="flex:1;display:flex;align-items:center;gap:6px;padding:10px;border:1.5px solid ${checked ? 'var(--v2-brand)' : 'var(--v2-border)'};border-radius:var(--v2-radius-sm);cursor:pointer;background:${checked ? 'var(--v2-brand-l)' : 'var(--v2-bg)'};font:500 12px Inter;color:var(--v2-ink);">
                    <input type="checkbox" name="v2-od-cut" value="${opt.value}" ${checked ? 'checked' : ''} style="display:none;" /> ${opt.label}
                  </label>`;
                }).join("")}
              </div>
            </div>
            <div style="margin-bottom:12px;">
              <label style="font:600 12px Inter;color:var(--v2-ink-2);display:block;margin-bottom:6px;">Special request (optional)</label>
              <textarea id="v2-od-notes" rows="2" placeholder="e.g. medium pieces, no head" style="width:100%;padding:10px;border:1.5px solid var(--v2-border);border-radius:var(--v2-radius-sm);font:400 13px Inter;color:var(--v2-ink);background:var(--v2-bg);resize:vertical;outline:none;box-sizing:border-box;">${escape(o.buyer_notes || "")}</textarea>
            </div>
            <button id="v2-od-save-notes" class="v2-btn v2-btn-primary v2-btn-sm v2-btn-full">${alreadySaved ? 'Update preferences' : 'Save preferences'}</button>
          </div>`;

        actions.querySelectorAll('input[name="v2-od-cut"]').forEach(cb => {
          cb.addEventListener("change", () => {
            actions.querySelectorAll('#v2-od-cut-opts label').forEach(l => {
              const inp = l.querySelector('input') as HTMLInputElement;
              l.style.borderColor = inp?.checked ? 'var(--v2-brand)' : 'var(--v2-border)';
              l.style.background = inp?.checked ? 'var(--v2-brand-l)' : 'var(--v2-bg)';
            });
          });
        });

        document.getElementById("v2-od-save-notes")?.addEventListener("click", async () => {
          const checked = Array.from(actions.querySelectorAll('input[name="v2-od-cut"]:checked')).map((c: any) => c.value);
          const cut = checked.join(",") || "";
          const notes = (document.getElementById("v2-od-notes") as HTMLTextAreaElement)?.value?.trim() || "";
          const btn = document.getElementById("v2-od-save-notes") as HTMLButtonElement;
          btn.disabled = true;
          btn.textContent = "Saving...";
          try {
            const res = await fetch("/api/orders/update-notes", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ order_id: o.id, buyer_id: localStorage.getItem("rlf_buyer_id"), cut_style: cut, buyer_notes: notes }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Failed");
            window.v2Toast?.("success", "Preferences saved", "Seller will see your request");
            load();
          } catch (err) {
            window.v2Toast?.("error", "Failed", err.message || "Could not save");
            btn.disabled = false;
            btn.textContent = "Save preferences";
          }
        });
      }

      const paySlot = document.getElementById("v2-od-extra-payment");
      if (paySlot && o.status === "scheduled") {
        paySlot.innerHTML = `<button type="button" class="v2-od-cancel" id="v2-od-cancel-sched" style="margin-bottom:10px;">Cancel order</button>`;
        document.getElementById("v2-od-cancel-sched")?.addEventListener("click", async () => {
          if (!confirm("Cancel this scheduled order?")) return;
          try {
            const buyerId = localStorage.getItem("rlf_buyer_id") || "";
            const res = await fetch("/api/orders/cancel", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ order_id: o.id, buyer_id: buyerId, action: "cancel", cancel_reason: reason.trim() }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Cancel failed");
            window.v2Toast?.("success", "Order cancelled");
            setTimeout(() => load(), 600);
          } catch (err: any) {
            window.v2Toast?.("error", "Failed", err.message);
          }
        });
      }
      if (isCancellable(o)) attachCancelButton(o, actions);
    } else if (o.status === "payment_required") {
      renderPaymentUpload(o, "balance");
      if (isCancellable(o)) attachCancelButton(o, actions);
    } else if (o.status === "refunded") {
      const paidAmt = Number(o.paid_amount) || 0;
      const finalAmt = Number(o.final_price) || 0;
      const refundAmt = finalAmt > 0 ? Math.max(0, paidAmt - finalAmt) : paidAmt;
      // `refunded` used to also mean "pre-order priced in cheaper, difference
      // refunded" while the order stayed live (pre BUG-43). Since then it means
      // the whole order was refunded and is off — don't tell that buyer their
      // fish is "being prepared".
      const stillLive = finalAmt > 0 && refundAmt < paidAmt;
      const refundBadge = stillLive
        ? `<div style="font:700 10px Inter;color:#059669;background:#DCFCE7;padding:3px 8px;border-radius:4px;display:inline-block;margin-bottom:8px;">✅ Your order is confirmed — being prepared</div>`
        : `<div style="font:700 10px Inter;color:#B45309;background:#FEF3C7;padding:3px 8px;border-radius:4px;display:inline-block;margin-bottom:8px;">Order closed — payment refunded</div>`;
      const refundEta = `Razorpay refunds reach your original payment method within <strong>5–7 working days</strong>.`;
      const sentAt = o.refund_sent_at ? new Date(o.refund_sent_at).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" }) : null;
      const note = o.refund_note || "";
      if (sentAt) {
        actions.innerHTML = `
          <div style="background:var(--v2-bg);border:1.5px solid #6366F1;border-radius:var(--v2-radius);padding:16px;margin-top:8px;">
            ${refundBadge}
            <div style="font:800 14px Inter;color:#6366F1;margin-bottom:6px;">↩ Refund: ₹${refundAmt.toLocaleString("en-IN")} sent back</div>
            <div style="font:400 12px Inter;color:var(--v2-ink-2);margin-bottom:4px;">Refund initiated on ${sentAt}</div>
            <div style="font:600 11px Inter;color:#7C3AED;margin-top:10px;padding:8px 10px;background:#F5F3FF;border-radius:var(--v2-radius-sm);">⏱ ${refundEta}</div>
          </div>`;
      } else {
        actions.innerHTML = `
          <div style="background:var(--v2-bg);border:1.5px solid #A78BFA;border-radius:var(--v2-radius);padding:16px;margin-top:8px;">
            ${refundBadge}
            <div style="font:800 14px Inter;color:#7C3AED;margin-bottom:6px;">↩ Refund ₹${refundAmt.toLocaleString("en-IN")} pending</div>
            <div style="font:600 11px Inter;color:#7C3AED;padding:8px 10px;background:#F5F3FF;border-radius:var(--v2-radius-sm);">⏱ ${refundEta}</div>
          </div>`;
      }
    } else {
      actions.innerHTML = "";
    }

    function renderPaymentUpload(o, kind) {
      const root = document.getElementById("v2-od-actions");
      if (!root) return;
      // BUG-47: payment_required (balance) must get a Pay button too, or the
      // order is unpayable from the UI.
      const balance = kind === "balance"
        ? Math.max(0, Number(o.final_price || 0) - Number(o.paid_amount || 0))
        : Number(o.total_price) + Number(o.delivery_fee || 0);
      // Nothing actually owed — render nothing rather than a ₹0 Pay button.
      if (balance > 0) renderRazorpayButton(o, balance, root);
    }
  }

  // ── Razorpay payment UI ────────────────────────────────────────────

  function loadRazorpayScript(): Promise<void> {
    return new Promise((resolve, reject) => {
      if ((window as any).Razorpay) { resolve(); return; }
      const s = document.createElement("script");
      s.src = "https://checkout.razorpay.com/v1/checkout.js";
      s.onload = () => resolve();
      s.onerror = () => reject(new Error("Payment SDK failed to load. Check your internet connection."));
      document.head.appendChild(s);
    });
  }

  function renderRazorpayButton(o: any, balance: number, root: HTMLElement) {
    const fmt = (n: number) => n.toLocaleString("en-IN");
    root.innerHTML = `
      <div style="background:var(--v2-bg);border:1.5px solid var(--v2-brand);border-radius:var(--v2-radius);padding:16px;margin-top:8px;">
        <div style="font:800 14px Inter;color:var(--v2-ink);margin-bottom:4px;">💳 Complete payment</div>
        <div style="font:400 12px Inter;color:var(--v2-ink-2);margin-bottom:12px;">
          Pay securely via Razorpay (UPI, cards, netbanking). Your order confirms instantly.
        </div>
        <div style="font:900 22px Inter;color:var(--v2-brand);margin-bottom:16px;">₹${fmt(balance)}</div>
        <button type="button" id="v2-rzp-pay-btn" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full">
          Pay ₹${fmt(balance)} →
        </button>
        <div id="v2-rzp-loading" style="display:none;text-align:center;padding:12px;font:500 12px Inter;color:var(--v2-ink-3);">
          <span class="v2-spinner v2-spinner-sm"></span> Opening payment...
        </div>
        <div id="v2-rzp-err" style="font:500 11px Inter;color:var(--v2-red);margin-top:8px;display:none;"></div>
        <div style="font:400 10px Inter;color:var(--v2-ink-3);text-align:center;margin-top:10px;">
          🔒 Secured by Razorpay
        </div>
      </div>`;

    const btn = root.querySelector<HTMLButtonElement>("#v2-rzp-pay-btn")!;
    const loadingEl = root.querySelector<HTMLElement>("#v2-rzp-loading")!;
    const errEl = root.querySelector<HTMLElement>("#v2-rzp-err")!;

    function showErr(msg: string) {
      errEl.textContent = msg;
      errEl.style.display = "block";
      btn.style.display = "block";
      btn.disabled = false;
      btn.textContent = `Pay ₹${fmt(balance)} →`;
      loadingEl.style.display = "none";
    }

    btn.addEventListener("click", async () => {
      btn.disabled = true;
      btn.style.display = "none";
      loadingEl.style.display = "block";
      errEl.style.display = "none";

      const buyerId = (() => { try { return localStorage.getItem("rlf_buyer_id") || ""; } catch { return ""; } })();

      // Fetch buyer email for prefill + receipt (non-blocking, best-effort)
      let buyerEmail = "";
      if (buyerId) {
        try {
          const pRes = await fetch(`/api/buyer/profile?buyer_id=${encodeURIComponent(buyerId)}`);
          if (pRes.ok) { const pd = await pRes.json(); buyerEmail = pd.profile?.email || ""; }
        } catch { /* ignore */ }
      }

      // Step 1: Create Razorpay order server-side
      let createData: any;
      try {
        const createRes = await fetch("/api/payments/razorpay-create-order", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ order_id: o.id, buyer_id: buyerId }),
        });
        createData = await createRes.json();
        if (createRes.status === 409 && createData.error_code === "already_paid") {
          window.v2Toast?.("success", "Payment received", "Your earlier payment went through.");
          setTimeout(() => load(), 400);
          return;
        }
        if (!createRes.ok) throw new Error(createData.error || "Could not initiate payment");
      } catch (err: any) {
        showErr(err.message || "Payment failed to start. Please try again.");
        return;
      }

      // Step 2: Load Razorpay SDK
      try {
        await loadRazorpayScript();
      } catch (err: any) {
        showErr(err.message || "Could not load payment SDK. Check your internet connection.");
        return;
      }

      loadingEl.style.display = "none";

      // Step 3: Open Razorpay modal
      const rzp = new (window as any).Razorpay({
        key: RAZORPAY_KEY_ID,
        order_id: createData.razorpay_order_id,
        amount: createData.amount,
        currency: createData.currency,
        name: "Relifish",
        description: `Order #${String(o.id).slice(0, 8).toUpperCase()}`,
        theme: { color: "#0066FF" },
        prefill: {
          contact: (() => { try { return localStorage.getItem("rlf_phone") || ""; } catch { return ""; } })(),
          email: buyerEmail,
        },
        handler: async function(response: any) {
          // Step 4: Verify payment server-side
          btn.disabled = true;
          btn.style.display = "none";
          loadingEl.style.display = "block";
          loadingEl.innerHTML = `<span class="v2-spinner v2-spinner-sm"></span> Confirming payment...`;
          errEl.style.display = "none";

          try {
            const verifyRes = await fetch("/api/payments/razorpay-verify", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                razorpay_order_id:  response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature:  response.razorpay_signature,
                order_id: o.id,
                buyer_id: buyerId,
                buyer_email: buyerEmail || undefined,
              }),
            });
            const verifyData = await verifyRes.json();
            if (!verifyRes.ok) throw new Error(verifyData.error || "Payment verification failed");

            // Success — show confirmation and reload
            root.innerHTML = `
              <div style="background:#f0fdf4;border:1.5px solid #86EFAC;border-radius:var(--v2-radius);padding:16px;margin-top:8px;text-align:center;">
                <div style="font-size:32px;margin-bottom:8px;">✅</div>
                <div style="font:800 15px Inter;color:#15803d;margin-bottom:4px;">Payment confirmed!</div>
                <div style="font:400 12px Inter;color:#166534;">Your order is confirmed. The seller has been notified.</div>
              </div>`;
            (window as any).v2Toast?.("success", "Payment confirmed!", "Your order is confirmed.");
            setTimeout(() => load(), 1200);

          } catch (err: any) {
            // Verify failed — show payment ID so buyer can contact support
            const payId = response.razorpay_payment_id || "";
            root.innerHTML = `
              <div style="background:var(--v2-bg);border:1.5px solid var(--v2-red);border-radius:var(--v2-radius);padding:16px;margin-top:8px;">
                <div style="font:800 14px Inter;color:var(--v2-red);margin-bottom:6px;">⚠️ Payment received but confirmation failed</div>
                <div style="font:400 12px Inter;color:var(--v2-ink-2);margin-bottom:8px;">Your money was deducted. Please contact us immediately and share your payment ID.</div>
                ${payId ? `<div style="font:600 11px Inter;color:var(--v2-ink-3);background:var(--v2-bg-2);padding:8px;border-radius:var(--v2-radius-sm);margin-bottom:8px;word-break:break-all;">Payment ID: ${payId}</div>` : ""}
                <div style="font:500 12px Inter;color:var(--v2-ink);">📞 9152207607 (10:30 AM – 7:30 PM) &nbsp;·&nbsp; ✉️ relifishstore@gmail.com</div>
              </div>`;
          }
        },
        modal: {
          ondismiss: async function() {
            // The in-page handler does not fire when the modal is closed or a UPI
            // app takes over — ask the server whether the payment went through.
            if (await syncPayment(o.id)) return;
            btn.disabled = false;
            btn.style.display = "block";
            btn.textContent = `Pay ₹${fmt(balance)} →`;
            loadingEl.style.display = "none";
          },
        },
      });

      rzp.open();
    });
  }

  /** Ask the server to settle a captured-but-unrecorded payment. true = order changed. */
  async function syncPayment(orderId: string): Promise<boolean> {
    try {
      const buyerId = localStorage.getItem("rlf_buyer_id") || "";
      const res = await fetch("/api/payments/razorpay-sync", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ order_id: orderId, buyer_id: buyerId }),
      });
      const data = await res.json();
      if (res.ok && data.changed) {
        window.v2Toast?.("success", "Payment received", "Waiting for the seller to confirm.");
        load();
        return true;
      }
    } catch { /* fall through */ }
    return false;
  }

  let syncedOnce = false;
  function initPage() {
    load();
    // Returning to an order still awaiting payment (tab closed mid-checkout, UPI
    // app came back): check once whether Razorpay already has the money.
    setTimeout(() => { if (!syncedOnce) { syncedOnce = true; syncPayment(orderId); } }, 1500);
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPage);
  } else {
    initPage();
  }

  // Supabase Realtime: instant order status updates
  const terminalStatuses = ["picked_up", "completed", "cancelled", "declined", "refunded"];
  const channel = supabase
    .channel(`order-${orderId}`)
    .on("postgres_changes", {
      event: "UPDATE",
      schema: "public",
      table: "orders",
      filter: `id=eq.${orderId}`,
    }, (payload: any) => {
      load(); // re-render with new data
      const newStatus = payload.new?.status;
      if (newStatus && terminalStatuses.includes(newStatus)) {
        channel.unsubscribe();
      }
    })
    .subscribe();

  // Fallback poll every 30s in case realtime connection drops
  pollTimer = setInterval(() => {
    const statusEl = document.getElementById("v2-od-status");
    const text = statusEl?.textContent || "";
    if (text.includes("Picked up") || text.includes("Cancelled") || text.includes("Declined") || text.includes("Completed")) {
      clearInterval(pollTimer);
      return;
    }
    load();
  }, 30000);
</script>
