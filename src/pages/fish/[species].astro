---
import { RETURN_POLICY } from "../../lib/product-offer";
// /fish/<species> — every seller on Relifish that lists this fish, with live price and availability.
// Indexable per hubIndexable (2+ sellers, or 1+ seller with a written guide); otherwise noindex,follow.
export const prerender = false;

import SeoLinks from "../../components/ui/molecules/SeoLinks.astro";
import AppShell from "../../components/ui/AppShell.astro";
import EmptyState from "../../components/ui/molecules/EmptyState.astro";
import { supabase } from "../../lib/supabase";
import { SPECIES, getSpeciesDisplay } from "../../lib/species";
import { SITE_URL, canonicalFor } from "../../lib/brand";
import { hubIndexable, hubPriceRange, hubPriceText, hubRows, type HubRow } from "../../lib/fish-hub";
import { SPECIES_GUIDES } from "../../lib/species-guides";

const species = (Astro.params.species || "").toLowerCase();
const known = Object.hasOwn(SPECIES, species) ? SPECIES[species] : undefined;
const guide = Object.hasOwn(SPECIES_GUIDES, species) ? SPECIES_GUIDES[species] : null;

let rows: HubRow[] = [];
let unavailable = false;
if (known) {
  try {
    const [sellersRes, listingsRes] = await Promise.all([
      supabase.from("sellers").select("id, name, location_name, lat, lng").eq("is_active", true).or("is_test.is.null,is_test.eq.false"),
      supabase
        .from("fish_listings")
        .select("seller_id, species, is_available, is_preorder_enabled, is_order_paused, weight_avail, pricing_options").is("deleted_at", null)
        .eq("species", species),
    ]);
    if (sellersRes.error || listingsRes.error) throw sellersRes.error || listingsRes.error;
    rows = hubRows(sellersRes.data ?? [], (listingsRes.data ?? []) as any, species);
  } catch {
    unavailable = true;
  }
}

if (!known) Astro.response.status = 404;
else if (unavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "120");
}

const name = known ? getSpeciesDisplay(species) : "Fish";
const english = known?.english || "Fish";
// "Surmai" (what buyers search) and "Kingfish" (from "Surmai (Kingfish)") for titles and FAQs.
const local = species.charAt(0).toUpperCase() + species.slice(1);
const englishOnly = english.match(/\(([^)]+)\)/)?.[1] || english;
const SHELLFISH = new Set(["prawns", "crab", "lobster", "squid", "oyster", "clam"]);
const freshTips = SHELLFISH.has(species)
  ? ["Shells are firm and intact, not slimy or soft.", "Heads (if on) are firmly attached, with no black patches.", "The meat is firm and translucent, not mushy.", "It smells of the sea, not sour or of ammonia."]
  : ["Eyes are clear and full, not cloudy or sunken.", "Gills are bright red or pink, not brown or grey.", "Flesh is firm and springs back when pressed.", "Skin is shiny and moist, not dull or dry.", "It smells mildly of the sea, not sour or of ammonia."];
const indexable = !!known && !unavailable && hubIndexable(species, rows.length);
const url = canonicalFor(`/fish/${species}`);
const updatedAt = new Date().toLocaleString("en-IN", { timeZone: "Asia/Kolkata", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
const today = new Date().toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata", day: "numeric", month: "long", year: "numeric" });
// Today's price = sellers with this fish in stock today (live listing); Thane first, where buyers search.
const live = rows.filter((r) => r.offer.availability === "InStock");
const thane = live.filter((r) => r.area === "Thane");
const thaneRange = hubPriceRange(thane);
const liveRange = hubPriceRange(live);
const names = (rs: HubRow[]) => rs.map((r) => r.seller).join(", ");
const thanePriceAnswer = thaneRange
  ? `On ${today}, ${local} in Thane is listed at ${hubPriceText(thaneRange)} on Relifish by ${names(thane)} (live listing, updated ${updatedAt} IST). Each seller sets the price, and it changes daily with the catch.`
  : liveRange
    ? `No seller in Thane has ${local} in stock on Relifish right now (${today}). Other local sellers list it at ${hubPriceText(liveRange)} today: ${names(live)}.`
    : `No seller on Relifish has ${local} in stock right now (${today}), so there is no live price to show. The shop page lists what is available today.`;
// Other names buyers search for (English and local names), without repeating the page name.
const localNames = [englishOnly, ...(guide?.alsoCalled ?? [])].filter((n, i, a) => n.toLowerCase() !== local.toLowerCase() && a.findIndex((m) => m.toLowerCase() === n.toLowerCase()) === i);
const statusText = { InStock: "Available today", PreOrder: "Pre-order for tomorrow", OutOfStock: "Not today" } as const;
const priceText = (r: HubRow) => (r.offer.lowPrice === r.offer.highPrice ? `₹${r.offer.lowPrice}` : `₹${r.offer.lowPrice}–₹${r.offer.highPrice}`);
const kgText = (k: { low: number; high: number }) => hubPriceText({ ...k, unit: "kg" });
const areasList = [...new Set(rows.map((r) => r.area).filter(Boolean))];
const faqs = known && rows.length ? [
  { q: `What is the ${local} price today in Thane?`, a: thanePriceAnswer },
  ...(englishOnly.toLowerCase() !== local.toLowerCase() ? [{ q: `What is ${local} called in English?`, a: `${local} is ${englishOnly} in English.${localNames.length > 1 ? ` It is also called ${localNames.filter((n) => n !== englishOnly).join(", ")}.` : ""}` }] : []),
  { q: `How do I know if ${local} is fresh?`, a: freshTips.join(" ") },
  { q: `Where can I order ${local} online?`, a: `${rows.length === 1 ? "One local seller lists" : `${rows.length} local sellers list`} ${local} on Relifish${areasList.length ? `, in ${areasList.join(", ")}` : ""}. Order same-day while the seller is open, or pre-order for tomorrow; the seller delivers or keeps it ready for pickup.` },
] : [];
const description = rows.length
  ? `${local} price today from ${rows.length} local ${rows.length === 1 ? "seller" : "sellers"} in Thane & Mumbai, per kg. ${guide ? guide.summary + " " : ""}Order same-day or pre-order; the seller delivers.`
  : `${english} is not listed by any seller on Relifish right now.`;
---
<AppShell
  title={known ? `${local}${englishOnly.toLowerCase() !== local.toLowerCase() ? ` (${englishOnly})` : ""} Price Today in Thane & Mumbai | Relifish` : "Fish not found · Relifish"}
  description={description}
  canonical={url}
  noindex={!indexable}
  header={{ variant: "page", backHref: "/shop", title: "Relifish" }}
  nav={{ active: "shop" }}
  jsonLd={known && rows.length ? {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ItemList",
        "name": `${english} from local sellers on Relifish`,
        "itemListElement": rows.map((r, i) => ({ "@type": "ListItem", "position": i + 1, "name": `${english} — ${r.seller}`, "url": SITE_URL + r.href })),
      },
      ...(live.length ? [{
        "@type": "Product",
        "@id": `${url}#product`,
        "name": english,
        "description": description,
        "url": url,
        ...(["pomfret", "surmai", "rawas", "prawns", "bangda", "crab"].includes(species) ? { "image": `${SITE_URL}/fish/${species}.jpg` } : {}),
        "brand": { "@type": "Brand", "name": "Relifish" },
        // One Offer per seller with it in stock today, at the price the table shows (₹/kg when sold by weight).
        "offers": live.map((r) => {
          const price = r.perKg ? r.perKg.low : r.offer.lowPrice;
          return {
            "@type": "Offer",
            "price": price,
            "priceCurrency": "INR",
            "availability": "https://schema.org/InStock",
            "url": SITE_URL + r.href,
            "seller": { "@type": "Organization", "name": r.seller },
            "hasMerchantReturnPolicy": RETURN_POLICY,
            ...(r.perKg ? { "priceSpecification": { "@type": "UnitPriceSpecification", "price": price, "priceCurrency": "INR", "referenceQuantity": { "@type": "QuantitativeValue", "value": 1, "unitCode": "KGM" } } } : {}),
          };
        }),
      }] : []),
      ...(faqs.length ? [{
        "@type": "FAQPage",
        "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
      }] : []),
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
          { "@type": "ListItem", "position": 2, "name": english, "item": url },
        ],
      },
    ],
  } : undefined}
>
  {!known ? (
    <div style="padding:24px 16px;"><EmptyState variant="server-error" title="Fish not found" description="We don't have a page for this fish." ctaText="Browse sellers" ctaHref="/shop" /></div>
  ) : (
    <article style="padding:16px;display:flex;flex-direction:column;gap:16px;">
      <header>
        <h1 style="font:800 22px/1.3 Inter;margin:0 0 6px;">{local} price today in Thane &amp; Mumbai</h1>
        {localNames.length > 0 && <p style="font:400 13px/1.5 Inter;margin:0 0 6px;color:var(--v2-ink-3);">Also called {localNames.join(", ")}.</p>}
        <p style="font:400 14px/1.6 Inter;margin:0;color:var(--v2-ink-2);">
          {rows.length
            ? `${english} from ${rows.length === 1 ? "one local seller" : `${rows.length} local sellers`} on Relifish. Prices and availability come from each seller's live listing. Updated ${updatedAt} IST.`
            : unavailable
              ? "We couldn't load sellers right now. Please try again in a minute."
              : `No seller on Relifish lists ${english.toLowerCase()} right now.`}
        </p>
      </header>

      {!unavailable && (
        <section style="border:1px solid var(--v2-border);border-radius:12px;padding:12px;">
          <h2 style="font:700 16px Inter;margin:0 0 6px;">Today's price in Thane · {today}</h2>
          {thaneRange ? (
            <>
              <p style="font:800 20px/1.3 Inter;margin:0 0 4px;">{hubPriceText(thaneRange)}</p>
              <p style="font:400 13px/1.5 Inter;margin:0;color:var(--v2-ink-2);">
                From {thane.map((r, i) => <>{i > 0 && ", "}<a href={r.shopHref} style="font-weight:700;color:var(--v2-brand);">{r.seller}</a></>)}, live listing updated {updatedAt} IST. Prices change daily with the catch.
              </p>
            </>
          ) : (
            <p style="font:400 14px/1.6 Inter;margin:0;color:var(--v2-ink-2);">
              No seller in Thane has {local} in stock on Relifish right now.{liveRange && ` Other local sellers list it at ${hubPriceText(liveRange)} today (see below).`} <a href="/shop" style="font-weight:700;color:var(--v2-brand);">See what's available today →</a>
            </p>
          )}
        </section>
      )}

      {rows.length > 0 && (
        <section>
          <h2 style="font:700 16px Inter;margin:0 0 8px;">Who sells {english.toLowerCase()} on Relifish</h2>
          <table style="width:100%;border-collapse:collapse;font:400 13px Inter;">
            <thead>
              <tr style="text-align:left;color:var(--v2-ink-3);">
                <th style="padding:6px 4px;">Seller</th><th style="padding:6px 4px;">Today</th><th style="padding:6px 4px;">Price</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr style="border-top:1px solid var(--v2-border);">
                  <td style="padding:8px 4px;"><a href={r.href} style="font-weight:700;color:var(--v2-brand);">{r.seller}</a>{r.area && <div style="color:var(--v2-ink-3);font-size:12px;">{r.area}</div>}</td>
                  <td style="padding:8px 4px;">{statusText[r.offer.availability]}</td>
                  <td style="padding:8px 4px;white-space:nowrap;">{r.perKg ? kgText(r.perKg) : `${priceText(r)} / pack`}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p style="font:400 12px/1.5 Inter;color:var(--v2-ink-3);margin:8px 0 0;">Prices by weight are shown per kg (packs converted); fish sold by the piece shows the pack price. Open a seller to see each option. Pre-order prices are a range: you pay the top, and the difference is refunded once the seller sets the final price.</p>
        </section>
      )}

      {guide && (
        <section>
          <h2 style="font:700 16px Inter;margin:0 0 8px;">{local} buying guide</h2>
          <p style="font:400 14px/1.7 Inter;margin:0 0 8px;color:var(--v2-ink-2);"><strong>{guide.summary}</strong></p>
          <dl style="font:400 14px/1.6 Inter;margin:0;color:var(--v2-ink-2);display:grid;grid-template-columns:auto 1fr;gap:4px 12px;">
            <dt style="font-weight:700;color:var(--v2-ink);">Taste</dt><dd style="margin:0;">{guide.taste}</dd>
            <dt style="font-weight:700;color:var(--v2-ink);">Bones</dt><dd style="margin:0;">{guide.bones}</dd>
            <dt style="font-weight:700;color:var(--v2-ink);">Cuts</dt><dd style="margin:0;">{guide.cuts.join(" · ")}</dd>
            <dt style="font-weight:700;color:var(--v2-ink);">Cook it as</dt><dd style="margin:0;">{guide.dishes.join(" · ")}</dd>
            <dt style="font-weight:700;color:var(--v2-ink);">When</dt><dd style="margin:0;">{guide.availability}</dd>
            <dt style="font-weight:700;color:var(--v2-ink);">Tip</dt><dd style="margin:0;">{guide.buyingTip}</dd>
          </dl>
        </section>
      )}

      <section>
        <h2 style="font:700 16px Inter;margin:0 0 8px;">How to pick {local} fresh</h2>
        <ol style="font:400 14px/1.7 Inter;margin:0;padding-left:20px;color:var(--v2-ink-2);">
          {freshTips.map((t) => <li>{t}</li>)}
        </ol>
      </section>

      {faqs.length > 0 && (
        <section>
          <h2 style="font:700 16px Inter;margin:0 0 8px;">{local}: questions buyers ask</h2>
          {faqs.map((f) => (
            <details style="border-top:1px solid var(--v2-border);padding:8px 0;">
              <summary style="font:600 14px/1.5 Inter;cursor:pointer;">{f.q}</summary>
              <p style="font:400 14px/1.6 Inter;color:var(--v2-ink-2);margin:6px 0 0;">{f.a}</p>
            </details>
          ))}
        </section>
      )}

      <p style="font:400 13px/1.5 Inter;margin:0;"><a href="/area/thane">Fish delivery in Thane →</a> · <a href="/blog/first-relifish-order-guide-thane">How ordering works →</a></p>
    </article>
  )}
  <SeoLinks />
</AppShell>
