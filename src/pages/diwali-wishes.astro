---
import AppShell from "../components/ui/AppShell.astro";

// [class key, name, style] — same 10 designs as the approved mockup (.context/mock/s8.html).
const THEMES: [string, string, string][] = [
  ["goldblack", "Gold & Black", "Premium"], ["classic", "Red & Gold", "Classic"], ["minimal", "Ivory", "Minimal"],
  ["royal", "Royal Purple", "Royal"], ["midnight", "Midnight Glow", "Event"], ["marigold", "Marigold", "Festive"],
  ["emerald", "Emerald", "Classy"], ["rangoli", "Rangoli", "Playful"], ["glow", "Diya Glow", "Warm"],
  ["rosegold", "Rose Gold", "Elegant"],
];
const MESSAGE = "May this Diwali fill your home with light, joy and endless sweetness.";
---
<AppShell
  title="Make a Diwali Greeting Card | Relifish"
  description="Pick a design, write your wish and share your own Happy Diwali greeting card on WhatsApp as an image. Free, takes a minute."
  header={{ variant: "page", title: "Relifish", backHref: "/shop" }}
  hideNav={true}
  ogImage="/wa/diwali-card-og.jpg"
>
  <!-- Card fonts. crossorigin lets html-to-image read and embed them in the PNG. -->
  <link rel="stylesheet" crossorigin="anonymous" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,600&family=Cinzel:wght@600;800&family=Great+Vibes&family=Poppins:wght@500;700&display=swap" />

  <div class="dw">
    <div class="dw-got" id="dw-got" hidden>
      <b id="dw-got-t">🎁 You got a Diwali card!</b>
      <span>Make your own in seconds and send it to your family. Free.</span>
      <button type="button" id="dw-got-make">Make yours too ✨</button>
    </div>
    <div id="dw-card" class="dw-card t-goldblack">
      <div class="deco"></div>
      <div class="orn">🪔</div>
      <div class="h">Happy Diwali</div>
      <div class="sub">Festival of lights</div>
      <div class="m" id="dw-cm">{MESSAGE}</div>
      <div class="rule"></div>
      <div class="f" id="dw-cf">With love</div>
    </div>

    <div class="lab">Choose a design</div>
    <div class="themes" id="dw-themes" role="radiogroup" aria-label="Card design">
      {THEMES.map(([k, n, s], i) => (
        <button type="button" class:list={["th", i === 0 && "on"]} data-theme={k} role="radio" aria-checked={i === 0 ? "true" : "false"}>
          <span class={`sw t-${k}`}><span class="h">Happy<br />Diwali</span></span>
          {n}<br /><span class="st">{s}</span>
        </button>
      ))}
    </div>

    <label class="lab" for="dw-im">Your message</label>
    <textarea class="inp" id="dw-im" maxlength="400">{MESSAGE}</textarea>
    <div class="cnt" id="dw-cnt" aria-live="polite">{MESSAGE.length}/400</div>
    <label class="lab" for="dw-if">Own the card</label>
    <input class="inp" id="dw-if" maxlength="40" value="With love" />

    <div class="btns">
      <button type="button" class="wa" id="dw-share">Start wishing 🪔</button>
    </div>
    <p class="dw-paste" id="dw-paste" hidden>✅ Card copied. In WhatsApp, pick a chat and press <b id="dw-paste-key">Ctrl+V</b> to add it, then send.</p>
  </div>

  <style is:global>
    .dw-got{margin:0 0 14px;padding:14px;border-radius:14px;background:var(--v2-brand-l,#EEF4FF);text-align:center}
    .dw-got[hidden]{display:none}
    .dw-got b{display:block;font:800 16px Inter;color:var(--v2-ink,#0B1B3F)}.dw-got span{display:block;font:500 13px/1.45 Inter;color:var(--v2-ink-2,#334155);margin:4px 0 10px}
    .dw-got button{background:#0066FF;color:#fff;border:0;border-radius:999px;padding:12px 20px;font:800 15px Inter;min-height:44px;cursor:pointer}
    .dw { padding: 14px; max-width: 430px; margin: 0 auto; font-family: Inter, sans-serif; color: var(--v2-ink, #0F172A); }
    /* the card: 4:5, exported as the image */
    .dw .dw-card { position: relative; width: 100%; aspect-ratio: 4/5; border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 28px 26px; box-shadow: 0 10px 30px rgba(0,0,0,.18); }
    .dw .dw-card .orn { font-size: 34px; letter-spacing: 10px; }
    .dw .dw-card .h { margin: 8px 0 2px; line-height: 1.05; }
    .dw .dw-card .sub { font-size: 12px; letter-spacing: .35em; text-transform: uppercase; opacity: .85; margin-bottom: 16px; }
    .dw .dw-card .m { font-size: 16px; line-height: 1.5; max-width: 92%; white-space: pre-wrap; overflow-wrap: anywhere; }
    .dw .dw-card .f { margin-top: 16px; font-size: 16px; overflow-wrap: anywhere; }
    .dw .dw-card .rule { width: 56px; height: 2px; margin: 14px auto 0; opacity: .8; }
    .dw .dw-card .deco { position: absolute; inset: 0; pointer-events: none; }
    /* themes */
    .dw .t-goldblack { background: radial-gradient(circle at 50% 30%, #1c1c1c, #000); color: #E8D5A3; border: 0; }
    .dw .t-goldblack .h { font: 700 46px 'Playfair Display'; background: linear-gradient(180deg, #F9E7B0, #C9A24B 55%, #8C6A1F); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .dw .t-goldblack .deco { box-shadow: inset 0 0 0 10px #000, inset 0 0 0 11.5px #C9A24B; }
    .dw .t-goldblack .rule { background: #C9A24B; }
    .dw .t-goldblack .f { font: 400 30px 'Great Vibes'; color: #E8D5A3; }
    .dw .t-classic { background: radial-gradient(circle at 50% 20%, #B91C1C, #7F1D1D 70%); color: #FDE68A; }
    .dw .t-classic .h { font: 800 44px Cinzel; color: #FCD34D; text-shadow: 0 2px 0 #7C2D12; }
    .dw .t-classic .deco { box-shadow: inset 0 0 0 8px #7F1D1D, inset 0 0 0 10px #FCD34D; }
    .dw .t-classic .rule { background: #FCD34D; }
    .dw .t-classic .f { font: italic 600 18px 'Playfair Display'; }
    .dw .t-minimal { background: #FFFDF8; color: #1F2937; }
    .dw .t-minimal .h { font: italic 600 42px 'Playfair Display'; color: #111827; }
    .dw .t-minimal .orn { font-size: 26px; letter-spacing: 0; }
    .dw .t-minimal .rule { background: #D4A373; }
    .dw .t-minimal .sub { color: #B08968; }
    .dw .t-minimal .f { font: 400 28px 'Great Vibes'; color: #7F5539; }
    .dw .t-royal { background: linear-gradient(160deg, #3B0764, #581C87 55%, #7E22CE); color: #F5D0FE; }
    .dw .t-royal .h { font: 800 42px Cinzel; background: linear-gradient(180deg, #FDE68A, #F59E0B); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .dw .t-royal .deco { background: radial-gradient(circle at 15% 15%, rgba(253,230,138,.25) 0 3px, transparent 4px) 0 0/40px 40px; }
    .dw .t-royal .rule { background: #FCD34D; }
    .dw .t-royal .f { font: 400 30px 'Great Vibes'; color: #FDE68A; }
    .dw .t-midnight { background: radial-gradient(circle at 50% 110%, #1E3A8A, #0B1023 60%); color: #E0E7FF; }
    .dw .t-midnight .h { font: 700 44px Poppins; color: #FFF; text-shadow: 0 0 18px #F59E0B, 0 0 32px #F97316; }
    .dw .t-midnight .deco { background: radial-gradient(#fff 1px, transparent 1.5px) 0 0/22px 22px; opacity: .25; }
    .dw .t-midnight .rule { background: #F59E0B; }
    .dw .t-midnight .f { font: 600 16px Poppins; color: #FCD34D; }
    .dw .t-marigold { background: linear-gradient(160deg, #FDE047, #F59E0B 50%, #EA580C); color: #7C2D12; }
    .dw .t-marigold .h { font: 800 44px Poppins; color: #7C2D12; }
    .dw .t-marigold .deco { box-shadow: inset 0 0 0 10px rgba(255,255,255,.35); }
    .dw .t-marigold .rule { background: #7C2D12; }
    .dw .t-marigold .f { font: 700 17px Poppins; }
    .dw .t-emerald { background: radial-gradient(circle at 50% 25%, #065F46, #022C22 75%); color: #D1FAE5; }
    .dw .t-emerald .h { font: 700 44px 'Playfair Display'; background: linear-gradient(180deg, #FEF3C7, #D4AF37); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .dw .t-emerald .deco { box-shadow: inset 0 0 0 12px #022C22, inset 0 0 0 13px #D4AF37; }
    .dw .t-emerald .rule { background: #D4AF37; }
    .dw .t-emerald .f { font: 400 30px 'Great Vibes'; color: #FDE68A; }
    .dw .t-rangoli { background: #FFF1F2; color: #831843; }
    .dw .t-rangoli .h { font: 800 42px Poppins; color: #BE185D; }
    .dw .t-rangoli .deco { background: radial-gradient(circle at 0 0, #FBCFE8 0 60px, transparent 61px), radial-gradient(circle at 100% 100%, #FED7AA 0 70px, transparent 71px), radial-gradient(circle at 100% 0, #DDD6FE 0 40px, transparent 41px), radial-gradient(circle at 0 100%, #BBF7D0 0 45px, transparent 46px); }
    .dw .t-rangoli .rule { background: #F472B6; }
    .dw .t-rangoli .f { font: 600 17px Poppins; color: #9D174D; }
    .dw .t-glow { background: radial-gradient(circle at 50% 0%, #FDE68A, #F59E0B 30%, #B45309 70%, #7C2D12); color: #FFFBEB; }
    .dw .t-glow .h { font: 700 44px 'Playfair Display'; text-shadow: 0 2px 0 rgba(0,0,0,.25); }
    .dw .t-glow .rule { background: #FFFBEB; }
    .dw .t-glow .f { font: 700 17px Inter; }
    .dw .t-rosegold { background: linear-gradient(160deg, #FFF1EB, #F5D0C5 60%, #E8B4A6); color: #7A3E3E; }
    .dw .t-rosegold .h { font: italic 600 44px 'Playfair Display'; background: linear-gradient(180deg, #B76E79, #8E4B53); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .dw .t-rosegold .deco { box-shadow: inset 0 0 0 10px rgba(255,255,255,.55), inset 0 0 0 11px #B76E79; }
    .dw .t-rosegold .rule { background: #B76E79; }
    .dw .t-rosegold .f { font: 400 30px 'Great Vibes'; }
    /* picker */
    .dw .lab { display: block; font: 800 14px Inter, sans-serif; margin: 24px 2px 10px; }
    .dw .themes { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; }
    .dw .th { flex: none; width: 78px; padding: 0; border: 0; background: none; text-align: center; font: 600 11px Inter, sans-serif; color: var(--v2-ink-3, #475569); cursor: pointer; }
    .dw .th .sw { position: relative; overflow: hidden; width: 78px; height: 98px; margin-bottom: 4px; border-radius: 12px; border: 2px solid transparent; display: flex; align-items: center; justify-content: center; }
    .dw .th .sw .h { font-size: 13px; line-height: 1.1; }
    .dw .th .st { color: var(--v2-ink-4, #94A3B8); font-weight: 500; }
    .dw .th.on .sw { border-color: #0066FF; box-shadow: 0 0 0 2px #fff inset; }
    .dw .th.on { color: #0066FF; }
    .dw #dw-im { height: 185px; resize: none; }
    .dw .cnt { text-align: right; font: 500 12px Inter, sans-serif; color: var(--v2-ink-3, #64748B); margin-top: 4px; }
    .dw .inp { width: 100%; min-height: 48px; line-height: 1.5; border: 1px solid var(--v2-border, #E2E8F0); border-radius: 10px; padding: 10px; font: 500 14px Inter, sans-serif; background: var(--v2-bg, #fff); color: var(--v2-ink, #0F172A); resize: vertical; }
    .dw .dw-paste { margin: -12px 0 20px; padding: 12px 14px; border-radius: 12px; background: #FEF3C7; color: #78350F; font: 600 13px/1.5 Inter, sans-serif; text-align: center; }
    .dw .dw-paste[hidden] { display: none; }
    .dw .btns { display: flex; gap: 10px; margin: 28px 0 24px; }
    .dw .wa { flex: 1; min-height: 52px; background: linear-gradient(135deg, #B91C1C, #7F1D1D 55%, #B45309); color: #FDE68A; border: 1.5px solid #F59E0B; border-radius: 14px; padding: 14px; font: 800 16px Inter, sans-serif; letter-spacing: .2px; cursor: pointer; box-shadow: 0 6px 18px rgba(245,158,11,.35), inset 0 1px 0 rgba(255,255,255,.15); }
  </style>

  <script>
  // Opened from checkout (?back=/seller/<id>): Back returns there with checkout open (?checkout=1).
  // Client-side because this page is pre-built (no query string on the server).
  const back = new URLSearchParams(location.search).get("back") || "";
  if (/^\/(seller|s)\/[\w-]+$/.test(back)) document.querySelector<HTMLAnchorElement>("a.v2-back")?.setAttribute("href", `${back}?checkout=1`);
</script>
<script>
    import { celebrate } from "../lib/fireworks";
    import { setButtonLoading } from "../lib/button-loading";

    // The card image stays clean (founder: no brand on the card); the caption carries the
    // "make your own" link so everyone who receives a card can make and send theirs.
    // The link carries the card (design, message, signature): whoever opens it sees this exact card,
    // then "Make yours too" (founder 31 Oct). Text is only ever set with textContent.
    const SHORT = "https://www.relifish.com/diwali-wishes"; // relifish.com links only (founder 31 Oct)
    // Each shared card gets its own short link (relifish.com/w/<id>) so whoever opens it sees this card,
    // "<name> sent you a Diwali card! Make yours too", and can pass theirs on (founder 31 Oct).
    // If saving fails, the general card-maker link still works.
    let cardLink = SHORT;
    async function saveCard() {
      try {
        const r = await fetch("/api/greeting-card", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ t: theme, m: msgIn.value.trim().slice(0, 400), f: signIn.value.trim().slice(0, 40) }) });
        const j = await r.json();
        cardLink = r.ok && j.id ? `https://www.relifish.com/w/${j.id}` : SHORT;
      } catch { cardLink = SHORT; }
    }
    function shareText() {
      const wish = msgIn.value.trim().slice(0, 400), sign = signIn.value.trim().slice(0, 40);
      return `Happy Diwali! 🪔\n${wish}${sign ? `\n${sign}` : ""}\n\nOpen my card and make yours 👉 ${cardLink}`;
    }
    const card = document.getElementById("dw-card") as HTMLElement;
    const picker = document.getElementById("dw-themes") as HTMLElement;
    const msgIn = document.getElementById("dw-im") as HTMLTextAreaElement;
    const signIn = document.getElementById("dw-if") as HTMLInputElement;
    const shareBtn = document.getElementById("dw-share") as HTMLButtonElement;
    let theme = "goldblack";
    const track = (name: string) => { try { (window as any).gtag?.("event", name, { theme }); } catch {} };

    picker.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".th");
      if (!btn) return;
      picker.querySelectorAll(".th").forEach((b) => { b.classList.remove("on"); b.setAttribute("aria-checked", "false"); });
      btn.classList.add("on");
      btn.setAttribute("aria-checked", "true");
      theme = btn.dataset.theme!;
      card.className = `dw-card t-${theme}`;
    });
    // Long wishes (up to 400 characters) shrink to stay inside the card.
    const fitMsg = () => { const n = msgIn.value.length; document.getElementById("dw-cnt")!.textContent = `${n}/400`; document.getElementById("dw-cm")!.style.fontSize = n > 320 ? "11px" : n > 240 ? "13px" : n > 160 ? "14.5px" : ""; };
    msgIn.addEventListener("input", () => { document.getElementById("dw-cm")!.textContent = msgIn.value; fitMsg(); });
    signIn.addEventListener("input", () => { document.getElementById("dw-cf")!.textContent = signIn.value; });

    // Logged-in buyer: sign the card with their first name.
    try {
      const first = localStorage.getItem("rlf_buyer_id") && (localStorage.getItem("rlf_buyer_first_name") || "").trim();
      if (first) {
        signIn.value = `With love, ${first}`.slice(0, 40);
        document.getElementById("dw-cf")!.textContent = signIn.value;
      }
    } catch {}

    const setTheme = (k: string) => {
      const btn = picker.querySelector<HTMLButtonElement>(`.th[data-theme="${CSS.escape(k)}"]`);
      if (btn) btn.click();
    };
    // Opened from a shared card (?t=&m=&f=): show that card, then offer to make their own.
    const got = new URLSearchParams(location.search);
    const gotTheme = got.get("t") || "";
    if (gotTheme && picker.querySelector(`.th[data-theme="${CSS.escape(gotTheme)}"]`)) {
      setTheme(gotTheme);
      const m = (got.get("m") || "").slice(0, 400), f = (got.get("f") || "").slice(0, 40);
      if (m) { msgIn.value = m; document.getElementById("dw-cm")!.textContent = m; fitMsg(); }
      if (f) { signIn.value = f; document.getElementById("dw-cf")!.textContent = f; }
      const name = f.replace(/^with love,?\s*/i, "").trim();
      document.getElementById("dw-got-t")!.textContent = name ? `🎁 ${name} sent you a Diwali card!` : "🎁 You got a Diwali card!";
      document.getElementById("dw-got")!.hidden = false;
      track("diwali_card_opened");
      document.getElementById("dw-got-make")!.addEventListener("click", () => {
        track("diwali_card_make_own");
        document.getElementById("dw-got")!.hidden = true;
        signIn.value = "With love"; document.getElementById("dw-cf")!.textContent = signIn.value;
        picker.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    async function renderPng(): Promise<Blob> {
      const { toBlob } = await import("html-to-image");
      await document.fonts.ready;
      const blob = await toBlob(card, { pixelRatio: 3, cacheBust: true });
      if (!blob) throw new Error("Could not make the image");
      return blob;
    }

    function download(blob: Blob) {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "happy-diwali.png";
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 10_000);
    }

    shareBtn.addEventListener("click", async () => {
      setButtonLoading(shareBtn, true, "Start wishing 🪔");
      // The share menu (phones, and Mac/Windows with the WhatsApp app) sends the card image + text
      // together (founder 31 Oct). Only where it can't share images: copy the card to the clipboard
      // (paste it into the chat) and open WhatsApp with the text. Started inside the click so the
      // browser allows the clipboard write.
      const canShareImage = !!navigator.canShare?.({ files: [new File([""], "x.png", { type: "image/png" })] });
      const png = renderPng();
      let copied: Promise<boolean> = Promise.resolve(false);
      if (!canShareImage && typeof ClipboardItem !== "undefined" && navigator.clipboard?.write) {
        copied = navigator.clipboard.write([new ClipboardItem({ "image/png": png })]).then(() => true, () => false);
      }
      try {
        const [blob] = await Promise.all([png, saveCard()]);
        track("diwali_greeting_share");
        const file = new File([blob], "happy-diwali.png", { type: "image/png" });
        if (canShareImage && navigator.canShare?.({ files: [file] })) {
          try { await navigator.share({ files: [file], text: shareText() }); return; }
          catch (err) { if ((err as Error).name === "AbortError") return; } // share blocked: fall through
        }
        if (await copied) {
          document.getElementById("dw-paste-key")!.textContent = /Mac/i.test(navigator.platform || navigator.userAgent) ? "⌘V" : "Ctrl+V";
          document.getElementById("dw-paste")!.hidden = false;
        } else download(blob);
        const wa = "https://api.whatsapp.com/send?text=" + encodeURIComponent(shareText());
        if (!window.open(wa, "_blank")) location.href = wa;
      } catch {
        alert("Could not make the image. Please try again.");
      } finally {
        setButtonLoading(shareBtn, false, "Start wishing 🪔");
      }
    });

    // They just tapped "Happy Diwali": fireworks on open (sound only if the browser allows it).
    celebrate(3000);
  
</script>
</AppShell>
