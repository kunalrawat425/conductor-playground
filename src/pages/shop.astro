---
import { LOGO_URL } from "../lib/brand";
import AppShell from "../components/ui/AppShell.astro";
import SellerCard from "../components/ui/molecules/SellerCard.astro";
import PreorderBanner from "../components/ui/molecules/PreorderBanner.astro";
import CategoryStrip from "../components/ui/molecules/CategoryStrip.astro";
import EmptyState from "../components/ui/molecules/EmptyState.astro";
import SeoLinks from "../components/ui/molecules/SeoLinks.astro";
import Toast from "../components/ui/atoms/Toast.astro";
import LocationPickerSheet from "../components/ui/organisms/LocationPickerSheet.astro";
import DiwaliDecor from "../components/DiwaliDecor.astro";
// Category strip is built dynamically from live listings data (see script below).
// SSR renders only "All Fish" as a placeholder; JS fills the rest after data loads.
// First paint before the seller data arrives (founder 31 Oct): our plate photos, replaced by the real strip on load.
const categories = [
  { id: "all", name: "All Fish", emoji: "🐟", photo: "/fish/platter.jpg?v=2", active: true },
  ...(["surmai", "prawns", "pomfret", "crab", "rawas", "bangda"] as const).map((id) => ({ id, name: id[0].toUpperCase() + id.slice(1), emoji: "🐟", photo: `/fish/${id}.jpg?v=2` })),
];
---
<AppShell
  title="Order Fresh Fish Online from Verified Sellers in Thane and Mumbai | Relifish"
  description="Order fresh fish online from verified sellers in Thane and Mumbai. Same-day catch or pre-order for tomorrow or later — pomfret, surmai, rawas, prawns, home delivery or pickup."
  needsMap={true}
  header={{
    locationLabel: "Set location",
    locationSub: "Tap to choose your area",
    showSearch: false,
    showCart: false,
    cartCount: 0,
    festive: true,
  }}
  nav={{ active: "home" }}
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.relifish.com/#organization",
        "name": "Relifish",
        "url": "https://www.relifish.com",
        "logo": "https://www.relifish.com/icon-192.svg",
        "description": "Thane's fresh fish marketplace — order directly from verified sellers, pre-order for tomorrow or later, pickup or delivery.",
        "areaServed": [{ "@type": "City", "name": "Thane" }, { "@type": "City", "name": "Mumbai" }],
        "contactPoint": { "@type": "ContactPoint", "contactType": "customer support", "availableLanguage": ["English", "Marathi"] }
      },
      {
        "@type": "LocalBusiness",
        "@id": "https://www.relifish.com/#localbusiness",
        "name": "Relifish",
        "url": "https://www.relifish.com",
        "description": "Fresh fish marketplace connecting Thane buyers directly with verified fish sellers. Pre-order pomfret, surmai, bangda, prawns and more.",
        "image": "https://www.relifish.com/og-image.jpg",
        "priceRange": "₹₹",
        "servesCuisine": "Seafood",
        "areaServed": [{ "@type": "City", "name": "Thane" }, { "@type": "City", "name": "Mumbai" }],
        "hasMap": "https://www.relifish.com"
      },
      {
        "@type": "WebSite",
        "@id": "https://www.relifish.com/#website",
        "name": "Relifish",
        "url": "https://www.relifish.com",
        "potentialAction": { "@type": "SearchAction", "target": "https://www.relifish.com/search?q={search_term_string}", "query-input": "required name=search_term_string" }
      }
    ]
  }}
>
  <!-- SEO H1 — visually hidden on app, present for crawlers -->
  <h1 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;">
    Fresh Fish Delivery in Thane — Order from Verified Sellers
  </h1>
  <Toast />
  <LocationPickerSheet />
  <DiwaliDecor part="banner" />

  <!-- Sticky filter cluster — stays in view when scrolling cards -->
  <div id="v2-sticky-cluster" class="v2-sticky-cluster">
    <PreorderBanner variant="inline" href="javascript:void(0)" />

    <div style="margin-top: 6px;">
      <CategoryStrip items={categories} />
    </div>

    <!-- Filter chips: timing × fulfillment × top-rated -->
    <div class="v2-filter-chips" id="v2-filter-chips" role="tablist" aria-label="Filter sellers">
      <button type="button" class="v2-fchip v2-fchip-active" data-filter="all" data-group="all">All</button>
      <button type="button" class="v2-fchip" data-filter="open" data-group="time">Open now</button>
      <button type="button" class="v2-fchip" data-filter="preorder" data-group="time">Pre-order</button>
      <span class="v2-fchip-sep" aria-hidden="true"></span>
      <button type="button" class="v2-fchip" data-filter="pickup" data-group="fulfill">Pickup</button>
      <button type="button" class="v2-fchip" data-filter="delivery" data-group="fulfill">Delivery</button>
      <span class="v2-fchip-sep" aria-hidden="true"></span>
      <button type="button" class="v2-fchip" data-filter="topRated" data-group="toggle">Top rated ★</button>
    </div>
  </div>

  <div class="v2-section-head">
    <h2>Verified sellers near you</h2>
    <span id="v2-seller-count" class="v2-count-badge">…</span>
  </div>

  <!-- Loading skeletons -->
  <!-- Loading: a simple spinner while sellers load (founder 31 Oct; no skeleton cards) -->
  <div id="v2-loading" class="v2-shop-loading" role="status" aria-live="polite">
    <span class="v2-spinner" aria-hidden="true"></span>
    <span class="v2-shop-loading-t">Finding sellers near you…</span>
  </div>

  <!-- Cards grid (filled by JS) -->
  <div id="v2-sellers-grid" class="v2-cards-grid" style="display:none;"></div>

  <!-- Empty -->
  <div id="v2-empty" style="display:none;padding:16px 16px 0;">
    <EmptyState variant="no-area" ctaHref="/#wl-form" ghostCtaHref="#" whatsappText="Hi Relifish, please tell me when you deliver to my area" />
  </div>

  <!-- Markets closed -->
  <div id="v2-closed" style="display:none;padding: 0 16px;">
    <EmptyState variant="closed" ctaHref="/shop?mode=preorder" />
  </div>

  <SeoLinks />


  <!-- Sticky cart section (Swiggy-style, fixed above bottom nav) -->
  <div id="v2-home-carts" style="display:none;"></div>
  <style is:global>
    /* View-cart bubble (same as the seller page): floating pill above the bottom nav */
    .hc-wrap{position:fixed;left:0;right:0;bottom:calc(64px + env(safe-area-inset-bottom, 0px) + 12px);z-index:40;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none}
    .hc-pill{pointer-events:auto;display:flex;align-items:center;gap:10px;background:#0066FF;color:#fff;border:0;border-radius:999px;padding:7px 14px 7px 7px;min-width:240px;box-shadow:0 8px 24px rgba(0,102,255,.35);cursor:pointer;font:inherit;text-align:left;min-height:52px}
    .hc-th{display:flex}.hc-th img,.hc-th span{width:38px;height:38px;border-radius:50%;border:2px solid #fff;object-fit:cover;background:#fff;display:flex;align-items:center;justify-content:center;font-size:18px}
    .hc-th > * + *{margin-left:-14px}
    .hc-t{flex:1}.hc-t b{display:block;font:800 16px Inter}.hc-t span{font:500 12px Inter;opacity:.9}.hc-ch{font-size:22px}
    .hc-list{pointer-events:auto;width:min(92vw,420px);background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.18);padding:6px 14px;max-height:45vh;overflow:auto}
  </style>
</AppShell>

<style is:global>
  .v2-section-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 16px 10px;
  }
  .v2-section-head h2 {
    font-family: var(--v2-font); font-weight: 800; font-size: 18px;
    color: var(--v2-ink); margin: 0;
  }
  .v2-count-badge {
    background: var(--v2-brand);
    color: #fff;
    font-family: var(--v2-font); font-weight: 700; font-size: 12px;
    padding: 3px 10px;
    border-radius: 9999px;
  }
  .v2-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 0 16px;
    animation: v2-fade-in var(--v2-dur) var(--v2-ease-out);
  }
  @media (min-width: 600px) {
    .v2-cards-grid { grid-template-columns: 1fr 1fr; }
  }
  .v2-skel-card { border-radius: 12px; overflow: hidden; }
  .v2-shop-loading { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 48px 16px; color: var(--v2-ink-3); font: 600 14px Inter, sans-serif; }
  .v2-spinner { width: 36px; height: 36px; border-radius: 50%; border: 4px solid var(--v2-brand-l); border-top-color: var(--v2-brand); animation: v2-spin .8s linear infinite; }
  @keyframes v2-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .v2-spinner { animation-duration: 2s; } }
  .v2-badge-bold { font-weight: 800 !important; }

  /* Sticky filter cluster — pin nav controls below header */
  .v2-sticky-cluster {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--v2-bg-2);
    padding: 8px 0 4px;
    border-bottom: 1px solid var(--v2-border);
  }
  /* PreorderBanner needs its own horizontal margin since cluster has no h-padding */
  .v2-sticky-cluster .v2-pb-inline { margin: 0 16px 0; }

  /* Filter chips */
  .v2-filter-chips {
    display: flex; gap: 6px;
    padding: 6px 16px 8px;
    overflow-x: auto;
    scrollbar-width: none;
    align-items: center;
  }
  .v2-filter-chips::-webkit-scrollbar { display: none; }
  .v2-fchip {
    padding: 7px 14px;
    border: 1.5px solid var(--v2-border);
    background: var(--v2-bg);
    color: var(--v2-ink-2);
    font: 600 12px Inter;
    border-radius: 9999px;
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--v2-dur-fast) var(--v2-ease), color var(--v2-dur-fast) var(--v2-ease), border-color var(--v2-dur-fast) var(--v2-ease);
  }
  .v2-fchip:hover { border-color: var(--v2-brand-m); }
  .v2-fchip-active {
    background: var(--v2-brand);
    color: #fff;
    border-color: var(--v2-brand);
  }
  .v2-fchip-sep {
    width: 1px; height: 20px;
    background: var(--v2-border);
    flex-shrink: 0;
    margin: 0 2px;
  }
</style>

<script>
  import { SELLER_PUBLIC_COLUMNS, supabase } from "../lib/supabase";
  import { getSession } from "../lib/auth";
  import { subscribePush } from "../lib/push";
  import { getSpeciesDisplay } from "../lib/species";
  import { formatBuyerMenuUnitSuffix, getListingPriceOptions } from "../lib/listing-pricing";
  import { cleanSellerName, sellerHref } from "../lib/seller-display";
  import { LOGO_URL, whatsappLink } from "../lib/brand";
  import { isPreorderShoppingWindow, isSellerEffectivelyOpen, preorderStatusLabel, todayDayName } from "../lib/order-timing";
  import { closedStatusLabel } from "../lib/cart";
  import { menuBySeller } from "../lib/menu-order";
  import { readSavedLocation, saveGpsDefault } from "../lib/saved-location";
  import type { Seller, FishListing } from "../lib/supabase";

  type SellerHue = "sky" | "green" | "orange" | "indigo";

  function distanceKm(lat1: number, lng1: number, lat2: number, lng2: number) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLng/2)**2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  }


  // Same sources as the navbar map (lib/saved-location), so header, seller list and map agree.
  function getBuyerLocation() {
    try { return readSavedLocation((k) => localStorage.getItem(k)); } catch { return null; }
  }

  function getBuyerArea(): string {
    return getBuyerLocation()?.area || "Set location";
  }

  /** "Not delivering here yet" WhatsApp link, prefilled with the buyer's saved area. */
  function waitlistWaHtml(): string {
    const a = getBuyerArea();
    const href = whatsappLink(`Hi Relifish, please tell me when you deliver to ${a && a !== "Set location" ? a : "my area"}`);
    return `<a href="${escapeHtml(href)}" target="_blank" rel="noopener" class="v2-empty-ghost">💬 Ask us on WhatsApp →</a>`;
  }

  function pickHue(seed: string): SellerHue {
    const hues: SellerHue[] = ["sky", "green", "orange", "indigo"];
    let h = 0;
    for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
    return hues[h % hues.length];
  }

  function escapeHtml(s: unknown) {
    return String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
  }
  const DOMAIN_TLD = "(com|in|net|org|store|shop|co|io|biz|info|fish)";
  const DOMAIN_RE = new RegExp(`\\b([\\w-]+)\\.(?:[\\w-]+\\.)?${DOMAIN_TLD}\\b`, "i");
  const DOMAIN_STRIP_RE = new RegExp(`(?:www\\.|[\\w-]+\\.)*[\\w-]+\\.${DOMAIN_TLD}\\b`, "gi");
  function stripContactInfo(raw: string): string {
    return raw
      .replace(/\b\d{10,}\b/g, "")
      .replace(/\bhttps?:\/\/\S+/gi, "")
      .replace(DOMAIN_STRIP_RE, "")
      .replace(/[·•|,\s]+$/, "").replace(/^[·•|,\s]+/, "")
      .replace(/([·•|])\s*[·•|]/g, "$1").trim();
  }
  function cleanDisplayName(raw: string): string {
    const domainMatch = raw.match(DOMAIN_RE);
    const candidate = domainMatch?.[1];
    const skip = new Set(["www", "shop", "store", "mail", "app", "web", "m", "api"]);
    const nameBeforeDomain = candidate && !skip.has(candidate.toLowerCase()) ? candidate : null;
    const cleaned = stripContactInfo(raw);
    if (!cleaned && nameBeforeDomain) {
      return nameBeforeDomain.charAt(0).toUpperCase() + nameBeforeDomain.slice(1).toLowerCase();
    }
    return cleaned;
  }

  function listingChipHtml(l: any): string {
    const name = getSpeciesDisplay(l.species);
    const opts = getListingPriceOptions(l);
    const opt = opts[0];
    const price = opt?.price ?? (l.pricing_options as any[])?.[0]?.price ?? 0;
    // A seller-written size ("900–1000 g") is sold as a pack: show "/pack" like the menu, not "/pc" (founder 31 Oct).
    const unitPart = opt
      ? (l.size_label ? "pack" : formatBuyerMenuUnitSuffix(opt).replace(/^\//, ""))
      : escapeHtml(String((l.pricing_options as any[])?.[0]?.unit_label || "kg"));
    const sp = (l.species || "").toLowerCase();
    // Seller's own listing photo first; fall back to species stock photo (never another seller's photo)
    const chipPhoto = l.photo_url || speciesPhotos[sp] || speciesPhotos["all"] || "";
    const chipImg = chipPhoto
      ? `<img src="${escapeHtml(chipPhoto)}" alt="${escapeHtml(name)}" loading="lazy" class="v2-sc-m-img" />`
      : `<span class="v2-sc-m-emoji">${(sp.includes("prawn") ? "🦐" : sp.includes("crab") ? "🦀" : "🐟")}</span>`;
    return `<div class="v2-sc-chip">${chipImg}<div class="v2-sc-m-text"><div class="v2-sc-m-name">${escapeHtml(name)}</div><div class="v2-sc-m-price">₹${price}/${unitPart}</div></div></div>`;
  }

  /** The card's one item: the 3rd most expensive (founder 24 Oct). The seller page keeps the seller's own order. */
  function cardPick(lst: any[]): any {
    const price = (l: any) => getListingPriceOptions(l)[0]?.price ?? (l.pricing_options as any[])?.[0]?.price ?? Infinity;
    return [...lst].sort((a, b) => price(b) - price(a))[2] ?? lst[0];
  }

  /** 1 → 1 chip full-width. 2 → 2 chips. 3+ → 3rd most expensive + "+N more". */
  function sellerMenuChipsHtml(listings: any[] | undefined): string {
    const lst = listings || [];
    if (lst.length === 0) return "";
    const count = lst.length === 1 ? 1 : 2;
    const inner = lst.length === 1
      ? listingChipHtml(lst[0])
      : lst.length === 2
        ? lst.map(listingChipHtml).join("")
        : listingChipHtml(cardPick(lst)) + `<div class="v2-sc-chip v2-sc-chip-more"><span class="v2-sc-m-more">+${lst.length - 1} more</span></div>`;
    return `<div class="v2-sc-menu" data-chips="${count}">${inner}</div>`;
  }

  async function loadSellers() {
    const loading = document.getElementById("v2-loading")!;
    const grid = document.getElementById("v2-sellers-grid")!;
    const empty = document.getElementById("v2-empty")!;
    const closed = document.getElementById("v2-closed")!;
    const count = document.getElementById("v2-seller-count")!;
    const sticky = document.getElementById("v2-sticky-cluster");
    const sectionHead = document.querySelector(".v2-section-head") as HTMLElement | null;

    // Update header location label
    const locText = document.querySelector(".v2-loc-text") as HTMLElement | null;
    const locSub = document.getElementById("v2-loc-sub") as HTMLElement | null;
    const area = getBuyerArea();
    if (locText && area && area !== "Set location") {
      locText.textContent = area;
      if (locSub) locSub.style.display = "none";
    }

    // No location set — show prompt immediately, skip Supabase fetch entirely
    if (!getBuyerLocation()) {
      loading.style.display = "none";
      grid.style.display = "none";
      grid.innerHTML = "";
      sticky?.style && (sticky.style.display = "none");
      if (sectionHead) sectionHead.style.display = "none";
      empty.innerHTML = `
<div style="padding:40px 24px;text-align:center;background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:12px;">
  <div style="font-size:48px;margin-bottom:12px;">📍</div>
  <div style="font:700 17px Inter;color:var(--v2-ink);margin-bottom:8px;">Set your location</div>
  <div style="font:400 14px Inter;color:var(--v2-ink-3);margin-bottom:20px;max-width:320px;margin-left:auto;margin-right:auto;line-height:1.45;">
    Choose your area to see sellers who deliver or offer pickup near you.
  </div>
  <button type="button" id="v2-open-loc-empty" style="background:var(--v2-brand);color:#fff;border:none;font:700 14px Inter;padding:12px 28px;border-radius:var(--v2-radius-sm);cursor:pointer;">
    Choose area
  </button>
</div>`;
      empty.style.display = "block";
      document.getElementById("v2-open-loc-empty")?.addEventListener("click", () => {
        document.dispatchEvent(new CustomEvent("relifish:open-location-picker"));
      });
      // Still try geolocation silently in background
      let promptedKey = "v2_loc_prompted";
      let promptedThisSession = false;
      try { promptedThisSession = sessionStorage.getItem(promptedKey) === "1"; } catch {}
      // Only when location is already allowed. An automatic popup on page load mostly gets dismissed,
      // and after a few dismissals Chrome blocks the site, so "Use current location" can't ask any more.
      const geoAllowed = await (navigator.permissions?.query({ name: "geolocation" as PermissionName })
        .then((p) => p.state === "granted").catch(() => false) ?? Promise.resolve(false));
      if (!promptedThisSession && geoAllowed && navigator.geolocation) {
        try { sessionStorage.setItem(promptedKey, "1"); } catch {}
        navigator.geolocation.getCurrentPosition(
          async (pos) => {
            const { latitude, longitude } = pos.coords;
            try {
              const r = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`);
              const data = await r.json();
              const a = data.address?.suburb || data.address?.neighbourhood || data.address?.city_district || data.address?.city || data.display_name?.split(",")[0] || "Your area";
              // Picked on the map while GPS was resolving? Keep the buyer's pick.
              if (!saveGpsDefault((k) => localStorage.getItem(k), (k, v) => localStorage.setItem(k, v), { lat: latitude, lng: longitude, area: a })) return;
              if (locText) { locText.textContent = a; if (locSub) locSub.style.display = "none"; }
              loadSellers();
            } catch {}
          },
          () => {},
          { timeout: 7000, maximumAge: 60_000 * 5 }
        );
      }
      return;
    }

    try {
      const [{ data: listingsData }, { data: sellersData }] = await Promise.all([
        supabase
          .from("fish_listings")
          .select(`*, seller:sellers(${SELLER_PUBLIC_COLUMNS})`).is("deleted_at", null)
          .or("is_available.eq.true,is_preorder_enabled.eq.true"),
        supabase
          .from("sellers")
          .select(SELLER_PUBLIC_COLUMNS)
          .eq("is_active", true)
          .neq("name", "New Seller"),
      ]);

      const listings = (listingsData || []) as (FishListing & { seller: Seller })[];
      const sellers = (sellersData || []) as Seller[];

      // Group listings by seller, each in the seller's menu order (the first chips on a card).
      const sellerListings = menuBySeller(listings, (l) => (l as any).seller?.id);

      // Filter sellers: must have listings OR accept pre-orders
      const filtered = sellers.filter(s => {
        const hasListings = (sellerListings.get(s.id) || []).length > 0;
        return hasListings || s.accepts_preorder === true;
      });

      const buyerLoc = getBuyerLocation();
      const groups = filtered.map(s => {
        const dist = buyerLoc && s.lat != null && s.lng != null
          ? distanceKm(buyerLoc.lat, buyerLoc.lng, Number(s.lat), Number(s.lng))
          : null;
        const rawListings = sellerListings.get(s.id) || [];
        const preorderDays: string[] = Array.isArray((s as any).preorder_days) ? (s as any).preorder_days : [];
        const day = todayDayName();
        const openNow = isSellerEffectivelyOpen(s as any);
        // Same rule as checkout, incl. windows past midnight (a 1:30 AM pre-order is last night's window).
        const preorderMode = !openNow && isPreorderShoppingWindow(s as any);
        const isTodayPreorderDay = preorderMode || (preorderDays.length ? preorderDays.includes(day) : !!s.accepts_preorder);
        const preorderLine = s.accepts_preorder ? preorderStatusLabel(s as any) : null;
        // Pre-order mode follows the listing's pre-order switch; a pre-order price is optional
        // (checkout falls back to the regular price), so don't hide listings that lack one.
        const listings = rawListings.filter((l: any) =>
          preorderMode ? l?.is_preorder_enabled === true : l?.is_available === true
        );
        return {
          seller: s,
          listings,
          allListings: rawListings,
          dist,
          open: openNow,
          preorderMode,
          preorderAvailableToday: isTodayPreorderDay,
          preorderLine,
        };
      });

      // Sort: open first, then by distance, then rating
      groups.sort((a, b) => {
        if (a.open !== b.open) return a.open ? -1 : 1;
        if (a.dist != null && b.dist != null) return a.dist - b.dist;
        return (b.seller.rating_avg || 0) - (a.seller.rating_avg || 0);
      });

      loading.style.display = "none";

      // Cache for filter re-render
      (window as any).__v2allGroups = groups;
      if (getBuyerLocation()) {
        buildCategoryStrip(groups);
      } else {
        buildCategoryStrip([]);
      }
      renderFiltered();
    } catch (err) {
      console.error("v2: load failed", err);
      loading.innerHTML = `<div style="text-align:center;padding:40px;color:var(--v2-red);">Failed to load. Refresh to try again.</div>`;
    }
  }

  // Filter state — seeded from URL params so deep-links and CTAs (e.g. EmptyState's
  // "Pre-order tomorrow", search trending cards `?species=prawns`) actually filter.
  const initialParams = new URLSearchParams(window.location.search);
  const initialMode = initialParams.get("mode");
  const initialCat = initialParams.get("species") || initialParams.get("cat");
  const filterState = {
    time: (initialMode === "preorder" || initialMode === "open" ? initialMode : null) as null | "open" | "preorder",
    fulfill: null as null | "pickup" | "delivery",
    topRated: false,
    category: (initialCat || "all") as string, // category strip species filter
    maxKm: 25, // distance cap (km) when buyer location available
  };

  // Species photos — same images as the landing page flyer (index.astro). No seller-specific photos.
  const BASE_P = "https://witoghpdfocywiosmrzv.supabase.co/storage/v1/object/public/fish-photos";
  const FLYER_POMFRET = "/fish/pomfret.jpg?v=2";
  const speciesPhotos: Record<string, string> = {
    all:     "/fish/platter.jpg?v=2", // mixed seafood platter (founder 31 Oct)
    pomfret: FLYER_POMFRET,
    surmai:  "/fish/surmai.jpg?v=2",
    prawns:  "/fish/prawns.jpg?v=2",
    bangda:  "/fish/bangda.jpg?v=2",
    rawas:   "/fish/rawas.jpg?v=2",
    crab:    "/fish/crab.jpg?v=2",
    bombil:  BASE_P + "/ocean/11_bombil.jpg",
    "silver pomfret":       "/fish/silver-pomfret.jpg",
    "silver pomfret combo": "/fish/silver-pomfret.jpg",
    shark:   BASE_P + "/bombay/shark.webp",
    salmon:  BASE_P + "/bombay/salmon.webp",
    halwa:   BASE_P + "/bombay/halwa.jpg",
    rohu:    BASE_P + "/bombay/rohu.jpg",
    basa:    BASE_P + "/bombay/basa.jpg",
    bhetki:  BASE_P + "/bombay/bhetki.avif",
    ghol:    BASE_P + "/bombay/ghol.png",
    boi:     BASE_P + "/bombay/boi.jpg",
  };

  // Fallback emoji for species not in photos map
  const speciesEmoji: Record<string, string> = {
    pomfret: "🐠", surmai: "🐟", rawas: "🐟", bangda: "🐟",
    bombil: "🐡", prawns: "🦐", crab: "🦀", squid: "🦑",
    lobster: "🦞", oyster: "🦪", clam: "🐚", sardine: "🐟",
    sole: "🐟", hilsa: "🐟", rohu: "🐟",
  };

  // Species id → display name for category strip
  const speciesLabel: Record<string, string> = {
    pomfret: "Pomfret", surmai: "Surmai", rawas: "Rawas",
    bangda: "Bangda", bombil: "Bombil", prawns: "Prawns",
    crab: "Crab", squid: "Squid", lobster: "Lobster",
    oyster: "Oyster", clam: "Clam", sardine: "Sardine",
    sole: "Sole", hilsa: "Hilsa", rohu: "Rohu",
  };

  // Map category id → species substrings to match in listings
  // Each species key matches its own name exactly; "all" matches everything.
  const categorySpecies: Record<string, string[]> = { all: [] };
  for (const id of Object.keys(speciesLabel)) {
    categorySpecies[id] = [id];
  }

  // Build category strip from actual listings, sorted by listing count descending.
  // Called once after data loads; ordering is fixed after that (doesn't re-sort on filter).
  function buildCategoryStrip(groups: any[]) {
    const counts: Record<string, number> = {};
    for (const g of groups) {
      for (const l of (g.listings || [])) {
        const sp = (l.species || "").toLowerCase().trim();
        if (sp && sp !== "all") counts[sp] = (counts[sp] || 0) + 1;
      }
    }
    // Priority species always first (if they have listings), then others by count
    const priority = ["surmai", "prawns", "pomfret", "crab"];
    const priorityWithListings = priority.filter(sp => counts[sp] > 0);
    const rest = Object.entries(counts)
      .filter(([id]) => !priority.includes(id))
      .sort((a, b) => b[1] - a[1])
      .map(([id]) => id);
    const sorted = [...priorityWithListings, ...rest].slice(0, 7);
    // ?species=X from a link: keep its chip even when it isn't in the top 7.
    const linked = filterState.category;
    if (linked !== "all" && counts[linked] && !sorted.includes(linked)) sorted.push(linked);

    const strip = document.querySelector(".v2-cat-strip");
    if (!strip) return;

    const activeCat = filterState.category;
    // Rebuild strip: All Fish first, then sorted species that have listings
    const items = [
      { id: "all", name: "All Fish", photo: speciesPhotos["all"] || "", emoji: "🐟" },
      ...sorted.map(id => ({
        id,
        name: speciesLabel[id] || id.charAt(0).toUpperCase() + id.slice(1),
        photo: speciesPhotos[id] || "",
        emoji: speciesEmoji[id] || "🐟",
      })),
    ];

    strip.innerHTML = items.map(item => {
      const active = item.id === activeCat;
      const tileContent = item.photo
        ? `<img src="${escapeHtml(item.photo)}" alt="${escapeHtml(item.name)}" loading="lazy" decoding="async" />`
        : `<span class="v2-cat-emoji-fallback" aria-hidden="true">${item.emoji}</span>`;
      // Species names come from seller listings — escape (stored XSS on /shop).
      return `<button type="button" class="v2-cat-item${active ? " v2-cat-active" : ""}" data-cat="${escapeHtml(item.id)}" role="tab" aria-selected="${active}">
        <div class="v2-cat-tile">${tileContent}</div>
        <div class="v2-cat-name">${escapeHtml(item.name)}</div>
      </button>`;
    }).join("");
    // Bring the linked species into view: scroll the strip sideways only (scrollIntoView would jump the page).
    const activeEl = strip.querySelector<HTMLElement>(".v2-cat-active");
    if (activeEl && activeCat !== "all") {
      const a = activeEl.getBoundingClientRect(), s = strip.getBoundingClientRect();
      strip.scrollLeft += a.left - s.left - (s.width - a.width) / 2;
    }

    // Re-wire click handlers for rebuilt strip
    strip.querySelectorAll<HTMLElement>(".v2-cat-item").forEach(cat => {
      cat.addEventListener("click", () => {
        const catId = cat.dataset.cat || "all";
        filterState.category = catId;
        strip.querySelectorAll(".v2-cat-item").forEach(c => {
          c.classList.remove("v2-cat-active");
          c.setAttribute("aria-selected", "false");
        });
        cat.classList.add("v2-cat-active");
        cat.setAttribute("aria-selected", "true");
        renderFiltered();
      });
    });
  }

  function applyFilters(groups: any[]) {
    const buyerLoc = getBuyerLocation();
    if (!buyerLoc) return [];

    return groups.filter((g) => {
      const s = g.seller;
      // Buyer has coordinates but seller missing map pin — cannot verify service area
      if (g.dist == null) return false;

      const rad = Number(s.delivery_rad);
      const capKm =
        rad > 0
          ? rad
          : s.has_delivery
            ? Math.min(10, filterState.maxKm)
            : filterState.maxKm;
      if (g.dist > capKm) return false;

      // Time
      if (filterState.time === "open" && !g.open) return false;
      if (filterState.time === "preorder" && !g.preorderAvailableToday) return false;
      // Fulfill (delivery filter is the only meaningful one)
      if (filterState.fulfill === "delivery" && !s.has_delivery) return false;
      // Category — filter by species substrings in seller's listings
      const cat = filterState.category;
      if (cat && cat !== "all") {
        const subs = categorySpecies[cat] || [];
        const hasMatch = (g.listings || []).some((l: any) => {
          const sp = (l.species || "").toLowerCase();
          return subs.some((needle) => sp.includes(needle));
        });
        if (!hasMatch) return false;
      }
      return true;
    });
  }

  function renderFiltered() {
    const allGroups = (window as any).__v2allGroups || [];
    const grid = document.getElementById("v2-sellers-grid")!;
    const empty = document.getElementById("v2-empty")!;
    const closed = document.getElementById("v2-closed")!;
    const count = document.getElementById("v2-seller-count")!;
    const sticky = document.getElementById("v2-sticky-cluster");
    const sectionHead = document.querySelector(".v2-section-head") as HTMLElement | null;

    empty.style.display = "none";
    closed.style.display = "none";

    if (!getBuyerLocation()) {
      sticky?.style && (sticky.style.display = "none");
      if (sectionHead) sectionHead.style.display = "none";
      grid.style.display = "none";
      grid.innerHTML = "";
      empty.innerHTML = `
<div style="padding:40px 24px;text-align:center;background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:12px;margin:0 16px;">
  <div style="font-size:48px;margin-bottom:12px;">📍</div>
  <div style="font:700 17px Inter;color:var(--v2-ink);margin-bottom:8px;">Set your location</div>
  <div style="font:400 14px Inter;color:var(--v2-ink-3);margin-bottom:20px;max-width:320px;margin-left:auto;margin-right:auto;line-height:1.45;">
    Choose your area to see sellers who deliver or offer pickup near you. We only show sellers that serve your distance.
  </div>
  <button type="button" id="v2-open-loc-empty" style="background:var(--v2-brand);color:#fff;border:none;font:700 14px Inter;padding:12px 28px;border-radius:var(--v2-radius-sm);cursor:pointer;">
    Choose area
  </button>
</div>`;
      empty.style.display = "block";
      return;
    }

    sticky?.style && (sticky.style.display = "");
    if (sectionHead) sectionHead.style.display = "";

    let filtered = applyFilters(allGroups);
    if (filterState.topRated) {
      filtered = [...filtered].sort((a, b) => (b.seller.rating_avg || 0) - (a.seller.rating_avg || 0));
    }

    if (allGroups.length === 0) {
      count.textContent = "0";
      empty.innerHTML = `<div style="padding:32px 24px;text-align:center;background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:12px;margin:0 16px;"><div style="margin-bottom:12px;"><img src="${LOGO_URL}" alt="Relifish" style="height:40px;width:auto;display:block;margin:8px auto;" /></div><div style="font:700 16px Inter;color:var(--v2-ink);margin-bottom:6px;">No sellers in your area yet</div><div style="font:400 13px Inter;color:var(--v2-ink-3);margin-bottom:18px;line-height:1.5;">We're expanding fast. Join the waitlist and we'll notify you when a seller goes live near you.</div><a href="/#wl-form" style="display:inline-block;background:var(--v2-brand);color:#fff;font:700 14px Inter;padding:12px 28px;border-radius:100px;text-decoration:none;">Join waitlist →</a>${waitlistWaHtml()}</div>`;
      empty.style.display = "block";
      grid.style.display = "none";
      return;
    }

    if (filtered.length === 0) {
      count.textContent = "0";
      grid.style.display = "none";
      grid.innerHTML = "";
      const noMatch = `<div style="padding:32px 24px;text-align:center;background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:12px;margin:0 16px;"><div style="font-size:44px;margin-bottom:12px;">🎣</div><div style="font:700 15px Inter;color:var(--v2-ink);margin-bottom:6px;">Not serviceable in your area yet</div><div style="font:400 12px Inter;color:var(--v2-ink-3);line-height:1.5;margin-bottom:16px;">We're adding new sellers. Join the waitlist and we'll notify you when a seller goes live near you.</div><a href="/#wl-form" style="display:inline-block;background:var(--v2-brand);color:#fff;font:700 13px Inter;padding:10px 22px;border-radius:100px;text-decoration:none;">Join waitlist →</a>${waitlistWaHtml()}</div>`;
      empty.innerHTML = noMatch;
      empty.style.display = "block";
      return;
    }

    count.textContent = String(filtered.length);
    grid.style.display = "grid";

    grid.innerHTML = filtered.map((g: any, index: number) => {
        const s = g.seller;
        const top = sellerMenuChipsHtml((g as any).allListings || g.listings);

        const hue = pickHue(s.id);
        const hueColors: Record<SellerHue, string> = {
          sky: "linear-gradient(135deg,#E0F2FE,#BAE6FD)",
          green: "linear-gradient(135deg,#ECFDF5,#D1FAE5)",
          orange: "linear-gradient(135deg,#FFF7ED,#FED7AA)",
          indigo: "linear-gradient(135deg,#EEF2FF,#E0E7FF)",
        };

        // Status: open / closed-preorder (still active for pre-orders) / closed / pre-order-only
        const status = !g.open
          ? (g.preorderMode ? "closed-preorder" : "closed")
          : (g.listings.length === 0 && g.preorderAvailableToday ? "pre-order-only" : "open");

        // ONE short status badge per card (founder: small text, no "morning"), e.g.
        // "Open now · same day", "Pre-order · delivers Sat", "Pre-order · next day", "Opens 6 AM".
        const [statusText, statusColor] = status === "open"
          ? ["Open now · same day", "v2-badge-green"]
          : status === "closed-preorder"
            ? [g.preorderLine || "Pre-order", "v2-badge-indigo"]
            : status === "closed"
              ? [closedStatusLabel(s), "v2-badge-green"]
              : ["Pre-order only", "v2-badge-indigo"];
        const statusBadge = statusText
          ? `<span class="v2-badge v2-badge-tag ${statusColor} v2-badge-size-md v2-badge-bold">${escapeHtml(statusText)}</span>` : "";

        const pickupTag = !s.has_delivery
          ? `<span class="v2-badge v2-badge-tag v2-badge-size-md">Pickup only</span>` : "";

        const rating = s.rating_avg ? Number(s.rating_avg).toFixed(1) : null;
        const ratingBadge = rating ? `<span class="v2-badge v2-badge-rating v2-badge-green v2-badge-size-md">${rating} ★</span>` : "";

        const distStr = g.dist != null ? `${g.dist.toFixed(1)} km` : "";
        const subParts = [stripContactInfo(s.location_name || s.location || ""), distStr].filter(Boolean).join(" · ");

        // "Min ₹400 · free delivery over ₹1500" (sentence case), "Home delivery" with neither.
        const deliveryText = [
          Number(s.min_order_amount) > 0 ? `min ₹${s.min_order_amount}` : "",
          Number(s.free_delivery_above) > 0 ? `free delivery over ₹${s.free_delivery_above}` : "",
        ].filter(Boolean).join(" · ") || "home delivery";
        const deliveryBar = s.has_delivery
          ? `<div class="v2-sc-delivery">🚲 ${deliveryText.charAt(0).toUpperCase() + deliveryText.slice(1)}</div>`
          : "";

        const fullyClosed = false; // We no longer grey out or disable the card

        const sellerPath = sellerHref(s.name, s.id);

        // Card hero: store image if available, otherwise blue gradient + logo
        const cardPhoto: string | null = (s as any).store_image_url || null;

        return `
        <a href="${sellerPath}" class="v2-seller-card">
          <div class="v2-sc-img" style="background:${hueColors[hue]};">
            ${cardPhoto
              ? `<img src="${escapeHtml(cardPhoto as string)}" alt="" loading="lazy" decoding="async" /><div class="v2-sc-img-overlay"></div>`
              : `<img src="${LOGO_URL}" alt="Relifish" class="v2-sc-relifish-logo" />`
            }
            <div class="v2-sc-img-badges">
              ${ratingBadge}
            </div>
          </div>
          <div class="v2-sc-body">
            <div class="v2-sc-name-row">
              <div class="v2-sc-name">${escapeHtml(cleanDisplayName(s.name))}</div>
              ${statusBadge}
            </div>
            ${subParts ? `<div class="v2-sc-loc">${escapeHtml(subParts)}</div>` : ""}
            ${pickupTag ? `<div style="margin-top:5px;">${pickupTag}</div>` : ""}
          </div>
          ${top || ""}
          ${deliveryBar}
        </a>`;
      }).join("");
  }

  // Wire filter chips
  document.querySelectorAll<HTMLButtonElement>("#v2-filter-chips .v2-fchip").forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter!;
      const group = btn.dataset.group!;

      if (filter === "all") {
        // Reset
        filterState.time = null;
        filterState.fulfill = null;
        filterState.topRated = false;
      } else if (group === "time") {
        // Toggle off if active, else select
        filterState.time = filterState.time === filter ? null : (filter as any);
      } else if (group === "fulfill") {
        filterState.fulfill = filterState.fulfill === filter ? null : (filter as any);
      } else if (group === "toggle") {
        filterState.topRated = !filterState.topRated;
      }

      // Update chip styles
      const noFilters = !filterState.time && !filterState.fulfill && !filterState.topRated;
      document.querySelectorAll<HTMLButtonElement>("#v2-filter-chips .v2-fchip").forEach((b) => {
        const f = b.dataset.filter!;
        const g = b.dataset.group!;
        let active = false;
        if (f === "all") active = noFilters;
        else if (g === "time") active = filterState.time === f;
        else if (g === "fulfill") active = filterState.fulfill === f;
        else if (g === "toggle") active = filterState.topRated;
        b.classList.toggle("v2-fchip-active", active);
      });

      renderFiltered();
    });
  });

  // Category strip click handlers are wired inside buildCategoryStrip() after data loads.

  // PreorderBanner click — activate the preorder filter chip on this page
  (document.querySelector('.v2-pb-inline') as HTMLAnchorElement | null)?.addEventListener('click', (e) => {
    e.preventDefault();
    // While notifications are undecided the banner asks for them (see showNotifyBanner).
    const mode = (e.currentTarget as HTMLElement).dataset.mode;
    if (mode === "notify") { askNotifications(); return; }
    if (mode === "blocked") {
      (window as any).v2Toast?.("info", "Turn on notifications", "Tap the lock icon next to the address → Notifications → Allow, then reload.");
      return;
    }
    const preorderChip = document.querySelector('#v2-filter-chips .v2-fchip[data-filter="preorder"]') as HTMLButtonElement | null;
    if (preorderChip) preorderChip.click();
  });

  // Sync visual state with URL-seeded filterState on first paint
  function syncInitialChipState() {
    const noFilters = !filterState.time && !filterState.fulfill && !filterState.topRated;
    document.querySelectorAll<HTMLButtonElement>("#v2-filter-chips .v2-fchip").forEach((b) => {
      const f = b.dataset.filter!;
      const g = b.dataset.group!;
      let active = false;
      if (f === "all") active = noFilters;
      else if (g === "time") active = filterState.time === f;
      else if (g === "fulfill") active = filterState.fulfill === f;
      else if (g === "toggle") active = filterState.topRated;
      b.classList.toggle("v2-fchip-active", active);
    });
    // Category strip active state is set inside buildCategoryStrip() after data loads.
  }
  syncInitialChipState();

  loadSellers();

  // Notifications: while the choice is open, the top banner asks for it (founder, 24 Oct) and
  // its "Allow" button opens the browser's own popup.
  const canNotify = () => "Notification" in window && "serviceWorker" in navigator; // not iPhone Safari outside the home-screen app
  let asking = false;
  async function askNotifications() {
    if (!canNotify() || asking || Notification.permission !== "default") return;
    asking = true;
    try {
      const result = await Notification.requestPermission();
      if (result === "granted") {
        (window as any).v2Toast?.("success", "Notifications on", "We'll send you fresh listings and prices");
        if (getSession()) subscribePush(false).catch(() => {});
      } else if (result === "default") {
        // Chrome "quiet" mode hides the popup behind a bell in the address bar.
        (window as any).v2Toast?.("info", "One more tap", "Tap the bell or lock icon in the address bar, then Allow.");
      }
    } catch {}
    asking = false;
    if (Notification.permission !== "default") restorePreorderBanner();
  }
  let preorderBannerHtml = "";
  function showNotifyBanner() {
    const el = document.querySelector<HTMLElement>(".v2-pb-inline");
    if (!el) return;
    preorderBannerHtml = el.innerHTML;
    el.dataset.mode = "notify";
    el.innerHTML = `<div class="v2-pb-icon">🔔</div><div class="v2-pb-text"><h4>Allow notifications</h4><p>Get the latest updates on fresh listings and prices</p></div><span class="v2-pb-btn">Allow</span>`;
  }
  // Blocked earlier (by the buyer or by Chrome): only the buyer can switch it back on, so say how.
  function showBlockedBanner() {
    const el = document.querySelector<HTMLElement>(".v2-pb-inline");
    if (!el) return;
    preorderBannerHtml = el.innerHTML;
    el.dataset.mode = "blocked";
    el.innerHTML = `<div class="v2-pb-icon">🔕</div><div class="v2-pb-text"><h4>Notifications are off</h4><p>Turn them on to get fresh listings and prices first</p></div><span class="v2-pb-btn">How</span>`;
  }
  function restorePreorderBanner() {
    const el = document.querySelector<HTMLElement>(".v2-pb-inline");
    if (!el || !el.dataset.mode) return;
    el.innerHTML = preorderBannerHtml;
    delete el.dataset.mode;
  }
  function maybeAskNotifications() {
    if (!canNotify()) return;
    if (Notification.permission === "granted") {
      if (getSession()) subscribePush(false).catch(() => {});
      return;
    }
    if (Notification.permission === "denied") { showBlockedBanner(); return; } // the site can't ask again
    showNotifyBanner();
    // Asked only when the buyer taps "Allow" on the banner: Chrome hides (quiet-blocks) a popup
    // the page opens on its own, as seen on stage 24 Oct ("Notifications blocked … requests are
    // hidden"). A popup that follows the buyer's tap shows normally.
  }

  // After location set or skipped, prompt notifications
  document.addEventListener("v2-location-confirmed", () => {
    loadSellers();

  });
  // Location taken from the buyer's account (AppShell, first visit on this device).
  document.addEventListener("v2-location-restored", () => loadSellers());
  // Ask on every /shop visit (the banner only shows to logged-in buyers who haven't chosen yet).
  maybeAskNotifications();

  // Open location picker bridge — V2 native sheet
  document.addEventListener("relifish:open-location-picker", () => {
    (window as any).v2OpenSheet?.("v2-loc-picker");
  });

  document.getElementById("v2-empty")?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("#v2-open-loc-empty")) {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent("relifish:open-location-picker"));
    }
  });

  // === Inline "Your Carts" section (Swiggy-style) ===
  function renderHomeCarts() {
    const el = document.getElementById("v2-home-carts");
    if (!el) return;
    const Cart = (window as any).RelifishCart;
    if (!Cart) { el.style.display = "none"; return; }
    // Same-day and pre-order carts are separate: one row per seller per cart.
    const groups = (["same_day", "preorder"] as const).flatMap((mode) =>
      Cart.groupBySeller(Cart.getCart(mode)).map((g: any) => ({ ...g, mode })));
    if (groups.length === 0) { el.style.display = "none"; return; }

    el.style.display = "block";
    const imgFor = (g: any) => {
      let img = g.seller_image_url || null;
      const all = (window as any).__v2allGroups;
      if (!img && Array.isArray(all)) { const m = all.find((r: any) => r?.seller?.id === g.seller_id); img = m?.seller?.logo_url || m?.seller?.store_image_url || null; }
      return img;
    };
    const items = groups.reduce((n: number, g: any) => n + g.items.length, 0);
    const total = groups.reduce((n: number, g: any) => n + (g.subtotal || 0), 0);
    const thumbs = groups.slice(0, 2).map((g: any) => { const i = imgFor(g); return i ? `<img src="${escapeHtml(i)}" alt="" />` : `<span>🐟</span>`; }).join("");
    const one = groups.length === 1;
    const open = el.dataset.open === "1";
    el.innerHTML = `<div class="hc-wrap">
      ${!one && open ? `<div class="hc-list">
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;">
          <span style="font:800 14px Inter;color:var(--v2-ink);">Your carts</span>
          <button id="v2-home-clear-all" type="button" style="background:none;border:none;font:600 12px Inter;color:var(--v2-red);cursor:pointer;">Clear all</button>
        </div>
        ${groups.map((g: any) => `<div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--v2-border);">
          <div class="hc-th">${imgFor(g) ? `<img src="${escapeHtml(imgFor(g))}" alt="" />` : `<span>🐟</span>`}</div>
          <div style="flex:1;min-width:0;"><div style="font:700 13px Inter;color:var(--v2-ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escapeHtml(cleanSellerName(g.seller_name) || "Seller")}</div>
          <div style="font:400 11px Inter;color:var(--v2-ink-3);">${g.mode === "preorder" ? `<span style="color:#7C3AED;font-weight:600;">Pre-order</span> · ` : ""}${g.items.length} item${g.items.length !== 1 ? "s" : ""} · ₹${g.subtotal.toLocaleString("en-IN")}</div></div>
          <a href="/seller/${g.seller_id}" data-hc-go="${g.seller_id}" style="background:var(--v2-brand);color:#fff;font:800 12px Inter;padding:8px 12px;border-radius:999px;text-decoration:none;">View cart ›</a>
          <button data-hc-remove="${g.seller_id}" data-hc-mode="${g.mode}" style="background:none;border:none;color:var(--v2-ink-4);font-size:16px;cursor:pointer;padding:6px;" aria-label="Remove cart">✕</button>
        </div>`).join("")}
      </div>` : ""}
      <button type="button" class="hc-pill" id="hc-pill" aria-label="View cart">
        <span class="hc-th">${thumbs}</span>
        <span class="hc-t"><b>${one ? "View cart" : "View carts"}</b><span>${items} item${items !== 1 ? "s" : ""} · ₹${total.toLocaleString("en-IN")}${one ? "" : ` · ${groups.length} shops`}</span></span>
        <span class="hc-ch" aria-hidden="true">${!one && open ? "⌄" : "›"}</span>
      </button>
    </div>`;
    // One shop: straight to its checkout (the seller page reopens it). Several: show the list.
    const go = (sid: string) => { try { sessionStorage.setItem("rf_resume_checkout", JSON.stringify({ sid, t: Date.now() })); } catch {} window.location.href = `/seller/${encodeURIComponent(sid)}`; };
    document.getElementById("hc-pill")?.addEventListener("click", () => {
      if (one) return go(groups[0].seller_id);
      el.dataset.open = open ? "0" : "1"; renderHomeCarts();
    });
    el.querySelectorAll<HTMLAnchorElement>("[data-hc-go]").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); go(a.dataset.hcGo!); }));
    // Wire remove buttons
    el.querySelectorAll<HTMLButtonElement>("[data-hc-remove]").forEach(b => {
      b.addEventListener("click", () => {
        Cart.clearCart({ sellerId: b.dataset.hcRemove, mode: b.dataset.hcMode });
        renderHomeCarts();
        (window as any).v2Toast?.("success", "Cart removed");
      });
    });
    // Wire clear all
    document.getElementById("v2-home-clear-all")?.addEventListener("click", () => {
      groups.forEach((g: any) => Cart.clearCart({ sellerId: g.seller_id, mode: g.mode }));
      renderHomeCarts();
      (window as any).v2Toast?.("success", "All carts cleared");
    });
  }

  // Render carts on load and on changes
  function initHomeCarts() {
    if ((window as any).RelifishCart) {
      renderHomeCarts();
    }
    document.addEventListener("v2-cart-ready", () => renderHomeCarts());
    window.addEventListener("v2-cart-changed", () => renderHomeCarts());
    window.addEventListener("storage", (e) => {
      if (e.key === "v2_cart_global") renderHomeCarts();
    });
  }
  initHomeCarts();
</script>
