---
import LandingLayout from "../layouts/LandingLayout.astro";
import { BUSINESS_ADDRESS, BUSINESS_OPERATOR, SUPPORT_EMAIL, whatsappLink } from "../lib/brand";
const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";
---
<LandingLayout
  title={`Contact Us · ${brandName}`}
  description={`Contact ${brandName}: WhatsApp 9152207607, email relifishstore@gmail.com, 7:30 AM to 9 PM. Help with orders, payments, refunds and selling on ${brandName}.`}
>
  <div class="legal-page">
    <div class="legal-header">
      <h1>Contact Us</h1>
      <p class="legal-updated">Last updated: October 2026</p>
    </div>
    <div class="legal-body">
      <p>{brandName} is an online marketplace where buyers order fish from independent, verified sellers in Thane, South Mumbai and Navi Mumbai. For help with an order, a payment, a refund, or selling on {brandName}, contact us:</p>
      <ul>
        <li><strong>WhatsApp (fastest):</strong> <a href={whatsappLink("Hi Relifish, I have a question")} target="_blank" rel="noopener">Message us on WhatsApp, +91 91522 07607</a></li>
        <li><strong>Email:</strong> <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
        <li><strong>Hours:</strong> 7:30 AM to 9 PM, every day</li>
        <li><strong>Operated by:</strong> {BUSINESS_OPERATOR}</li>
        <li><strong>Based in:</strong> {BUSINESS_ADDRESS || "Mumbai, Maharashtra, India"}</li>
      </ul>
      <h2>Order questions</h2>
      <p>Open your order on the <a href="/track">orders page</a> and tap "Help with this order on WhatsApp": the chat opens with your order ID filled in. For delivery timing, message us and we'll check with the seller.</p>
      <h2>Payments and refunds</h2>
      <p>Payments are processed by Razorpay. See our <a href="/refund-policy">Refund &amp; Cancellation Policy</a> and <a href="/shipping-policy">Delivery Policy</a>.</p>
      <h2>Sellers</h2>
      <p>To sell on {brandName}, see <a href="/for-sellers">Sell on {brandName}</a> or <a href={whatsappLink("Hi Relifish, I want to sell fish on Relifish")} target="_blank" rel="noopener">message us on WhatsApp</a>.</p>
    </div>
  </div>
</LandingLayout>
