---
import AppShell from "../components/ui/AppShell.astro";
import EmptyState from "../components/ui/molecules/EmptyState.astro";
---
<AppShell
  title="Page not found · Relifish"
  description="The page you're looking for doesn't exist."
  header={{ variant: "page", title: "Not found", backHref: "/" }}
  nav={{ active: "home" }}
>
  <div style="padding:24px 16px;">
    <EmptyState
      variant="server-error"
      title="Page not found"
      description="The page you're looking for doesn't exist or has moved. Try going back home."
      ctaText="Back to home"
      ctaHref="/"
      ghostCtaText="View past orders"
      ghostCtaHref="/v2/track"
    />
  </div>
</AppShell>
