---
import AppShell from "../components/AppShell.astro";
import LoginModal from "../components/LoginModal.astro";
import LocationPicker from "../components/LocationPicker.astro";
export const prerender = false;
---

<AppShell title={`Profile - ${import.meta.env.PUBLIC_BRAND_NAME || "Zepto"}`} description="Your profile and order history." activeTab="me" showLocationBadge={false}>
  <!-- Toast notification -->
  <div id="toast" style="display:none;position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,0.15);transition:opacity 0.3s;"></div>
  <div id="me-container">
    <!-- Not logged in -->
    <div id="me-guest" style="display:none;text-align:center;padding:48px 16px;">
      <div style="font-size:48px;margin-bottom:16px;">👤</div>
      <h2 style="font-size:20px;font-weight:700;margin-bottom:8px;">Your profile</h2>
      <p class="text-muted" style="margin-bottom:24px;">Log in to save your preferences and track orders</p>
      <button class="btn btn-primary tap-target" id="me-login-btn" style="min-height:44px;padding:12px 32px;">
        Log in with phone
      </button>

      <div style="margin-top:32px;padding-top:24px;border-top:1px solid var(--gray-200);">
        <a href="/dashboard/login" class="text-muted" style="font-size:13px;">Are you a seller? Log in here →</a>
      </div>
    </div>

    <!-- Loading -->
    <div id="me-loading" style="padding:24px 0;">
      <div class="card"><div class="card-body"><div class="skeleton" style="height:24px;width:40%;margin-bottom:12px;"></div><div class="skeleton" style="height:16px;width:60%;"></div></div></div>
    </div>

    <!-- Profile -->
    <div id="me-profile" style="display:none;padding:16px 0;">
      <h2 class="section-title">Profile</h2>

      <div
        id="me-inactive-banner"
        style="display:none;margin-bottom:16px;padding:14px 16px;border-radius:12px;background:rgba(220,53,69,0.08);border:1px solid var(--red);color:var(--gray-900);font-size:14px;line-height:1.45;"
      >
        <strong>Ordering is disabled</strong> for this account. You can still use your profile and track past orders.
        If this looks wrong, contact support.
      </div>

      <div class="card" style="margin-bottom:16px;">
        <div class="card-body">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
            <div style="width:48px;height:48px;border-radius:50%;background:var(--blue);color:white;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;" id="me-avatar">?</div>
            <div style="min-width:0;">
              <div style="font-weight:700;font-size:18px;line-height:1.25;" id="me-display-name">—</div>
              <div class="text-muted" style="font-size:12px;margin-top:2px;">Your account</div>
            </div>
          </div>
          <h3 style="font-size:14px;font-weight:700;margin:0 0 10px;color:var(--gray-700);">Contact details</h3>
          <p class="text-muted" style="font-size:12px;margin:-4px 0 12px;line-height:1.35;">
            Phone is tied to your login and cannot be changed here. You can update your name and email.
          </p>
          <div id="me-contact-readonly" style="display:flex;flex-direction:column;gap:12px;">
            <div>
              <div class="text-muted" style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.02em;">First name</div>
              <div style="font-size:16px;font-weight:600;margin-top:4px;" id="me-first-name-display">—</div>
            </div>
            <div>
              <div class="text-muted" style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.02em;">Last name</div>
              <div style="font-size:16px;font-weight:600;margin-top:4px;" id="me-last-name-display">—</div>
            </div>
            <div>
              <div class="text-muted" style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.02em;">Phone</div>
              <div style="font-size:16px;font-weight:600;margin-top:4px;" id="me-contact-phone">—</div>
            </div>
            <div>
              <div class="text-muted" style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.02em;">Email</div>
              <div style="font-size:16px;font-weight:600;margin-top:4px;word-break:break-all;" id="me-contact-email">—</div>
            </div>
          </div>
          <div id="me-contact-edit" style="display:none;flex-direction:column;gap:12px;">
            <div class="form-group" style="margin-bottom:0;">
              <label for="me-first-name-input">First name</label>
              <input type="text" id="me-first-name-input" placeholder="First name" autocomplete="given-name" style="font-size:14px;" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label for="me-last-name-input">Last name</label>
              <input type="text" id="me-last-name-input" placeholder="Last name" autocomplete="family-name" style="font-size:14px;" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label for="me-email-input">Email</label>
              <input type="email" id="me-email-input" placeholder="you@example.com" autocomplete="email" style="font-size:14px;" />
            </div>
          </div>
          <div style="display:flex;gap:8px;margin-top:14px;justify-content:flex-end;flex-wrap:wrap;">
            <button type="button" id="me-edit-contact-btn" class="btn btn-primary" style="font-size:14px;padding:8px 14px;">Edit details</button>
            <button type="button" id="me-save-contact-btn" class="btn" style="display:none;background:var(--gray-100);color:var(--gray-700);font-size:14px;padding:8px 14px;min-width:80px;">Save details</button>
            <button type="button" id="me-cancel-contact-btn" class="btn" style="display:none;background:var(--gray-100);color:var(--gray-700);font-size:14px;padding:8px 14px;">Cancel</button>
          </div>
        </div>
      </div>

      <!-- Location -->
      <div class="card" style="margin-bottom:16px;">
        <div class="card-body">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <div>
              <div style="font-weight:600;font-size:14px;">📍 Location</div>
              <div class="text-muted" id="me-location">Not set</div>
            </div>
            <button class="btn tap-target" id="me-change-location" style="background:var(--gray-100);color:var(--blue);font-size:13px;padding:8px 16px;">
              Change
            </button>
          </div>
        </div>
      </div>

      <!-- Address book -->
      <div class="card" id="me-addresses-card" style="margin-bottom:16px;">
        <div class="card-body">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px;flex-wrap:wrap;">
            <div style="font-weight:700;font-size:16px;" id="addresses">Address book</div>
            <button
              type="button"
              class="btn tap-target"
              id="me-address-add-btn"
              style="width:auto;background:var(--gray-100);color:var(--blue);font-size:14px;padding:8px 14px;flex-shrink:0;"
            >
              + Add address
            </button>
          </div>
          <p class="text-muted" style="font-size:13px;margin-bottom:12px;line-height:1.4;">
            Saved addresses show up at checkout. They use the same map area as “Location” above when you save.
          </p>
          <div id="me-address-list"></div>
          <div
            id="me-address-editor"
            style="display:none;margin-top:12px;padding-top:14px;border-top:1px solid var(--gray-200);"
          >
            <input type="hidden" id="me-addr-edit-id" value="" />
            <div class="form-group" style="margin-bottom:10px;">
              <label for="me-addr-label">Label</label>
              <input type="text" id="me-addr-label" placeholder="e.g. Home, Mom's" style="font-size:14px;" />
            </div>
            <div class="form-group" style="margin-bottom:10px;">
              <label for="me-addr-flat">Flat / house no.</label>
              <input type="text" id="me-addr-flat" placeholder="402, A-wing" style="font-size:14px;" />
            </div>
            <div class="form-group" style="margin-bottom:10px;">
              <label for="me-addr-building">Building / society</label>
              <input type="text" id="me-addr-building" style="font-size:14px;" />
            </div>
            <div class="form-group" style="margin-bottom:10px;">
              <label for="me-addr-landmark">Landmark (optional)</label>
              <input type="text" id="me-addr-landmark" style="font-size:14px;" />
            </div>
            <div class="text-muted" id="me-addr-area-hint" style="font-size:13px;margin-bottom:8px;line-height:1.35;">
              Area: not set — use Location above or “Use current map area” below.
            </div>
            <div style="display:flex;justify-content:flex-end;margin-bottom:12px;">
              <button
                type="button"
                class="btn tap-target"
                id="me-addr-use-map"
                style="width:auto;max-width:100%;background:var(--gray-100);color:var(--blue);font-size:13px;padding:8px 12px;"
              >
                Use current map area (header / Location)
              </button>
            </div>
            <label
              for="me-addr-default"
              style="display:flex;align-items:flex-start;gap:10px;font-size:14px;font-weight:600;margin-bottom:12px;cursor:pointer;line-height:1.35;"
            >
              <input type="checkbox" id="me-addr-default" />
              <span style="flex:1;min-width:0;padding-top:1px;">Default for checkout</span>
            </label>
            <div style="display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;">
              <button type="button" class="btn tap-target" id="me-addr-cancel" style="width:auto;background:var(--gray-100);padding:10px 16px;font-size:14px;">
                Cancel
              </button>
              <button type="button" class="btn btn-primary tap-target" id="me-addr-save" style="width:auto;padding:10px 16px;font-size:14px;">
                Save address
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Buyer order push (not seller new-order alerts — those are in Dashboard → Profile) -->
      <div class="card" style="margin-bottom:16px;">
        <div class="card-body">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
            <div style="min-width:0;">
              <div style="font-weight:600;font-size:14px;">🔔 Order updates (buyer)</div>
              <div class="text-muted" style="font-size:12px;margin-top:4px;line-height:1.35;">
                Alerts when a seller confirms or changes <strong>your</strong> order. Turn on here — not on the seller dashboard.
              </div>
              <div class="text-muted" id="me-push-status" style="font-size:13px;font-weight:600;margin-top:8px;">Off</div>
            </div>
            <button
              type="button"
              id="me-notify-bell"
              class="btn tap-target notify-bell-btn"
              style="background:var(--gray-100);padding:8px 14px;font-size:20px;min-width:48px;min-height:44px;flex-shrink:0;"
              title="Turn buyer order alerts on or off"
              aria-label="Buyer order notifications"
            >
              🔕
            </button>
          </div>
        </div>
      </div>

      <!-- iOS install banner -->
      <div id="ios-install-hint" class="card" style="margin-bottom:16px;display:none;">
        <div class="card-body" style="background:var(--blue);color:white;">
          <div style="font-weight:600;font-size:14px;margin-bottom:4px;">📱 Add to Home Screen</div>
          <div style="font-size:13px;opacity:0.9;">Install Zepto for push notifications on iOS. Tap Share → Add to Home Screen.</div>
        </div>
      </div>

      <!-- Actions -->
      <div style="display:flex;justify-content:flex-end;margin-top:8px;">
        <button class="btn tap-target" id="me-logout" style="width:auto;background:var(--gray-100);color:var(--red);padding:10px 24px;">
          Log out
        </button>
      </div>
    </div>
  </div>

  <script>
    import { getSession, signOut } from "../lib/auth";
    import { isPushSubscribed, subscribePush, unsubscribePush } from "../lib/push";
    import { setBellLoading, setButtonLoading } from "../lib/button-loading";

    function formatContactPhone(phone: string | null | undefined): string {
      const p = (phone || "").trim();
      if (!p) return "—";
      if (p.startsWith("+")) return p;
      const digits = p.replace(/\s/g, "");
      if (digits.startsWith("91") && digits.length > 10) return `+${digits}`;
      return `+91 ${digits.replace(/^0+/, "")}`;
    }
    import { formatSavedBuyerAddress, formatAreaPart } from "../lib/buyer-address";
    import type { BuyerAddressRow } from "../lib/buyer-address";

    function showToast(message: string, type: "success" | "error" = "success") {
      const toast = document.getElementById("toast")!;
      toast.textContent = message;
      toast.style.display = "block";
      toast.style.opacity = "1";
      toast.style.background = type === "success" ? "var(--green)" : "var(--red)";
      toast.style.color = "white";
      setTimeout(() => {
        toast.style.opacity = "0";
        setTimeout(() => { toast.style.display = "none"; }, 300);
      }, 3000);
    }

    async function initProfile() {
      const guestEl = document.getElementById("me-guest")!;
      const loadingEl = document.getElementById("me-loading")!;
      const profileEl = document.getElementById("me-profile")!;

      // Reset all states
      guestEl.style.display = "none";
      loadingEl.style.display = "none";
      profileEl.style.display = "none";

      const session = getSession();

      if (!session) {
        guestEl.style.display = "block";

        document.getElementById("me-login-btn")?.addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("start-order"));
        });
        return;
      }

      loadingEl.style.display = "none";
      profileEl.style.display = "block";

      const avatarEl = document.getElementById("me-avatar")!;
      const displayNameEl = document.getElementById("me-display-name")!;
      const firstNameDisplay = document.getElementById("me-first-name-display")!;
      const lastNameDisplay = document.getElementById("me-last-name-display")!;
      const contactPhoneEl = document.getElementById("me-contact-phone")!;
      const contactEmailEl = document.getElementById("me-contact-email")!;
      const contactReadOnly = document.getElementById("me-contact-readonly") as HTMLDivElement;
      const contactEdit = document.getElementById("me-contact-edit") as HTMLDivElement;
      const firstNameInput = document.getElementById("me-first-name-input") as HTMLInputElement;
      const lastNameInput = document.getElementById("me-last-name-input") as HTMLInputElement;
      const emailInput = document.getElementById("me-email-input") as HTMLInputElement;
      const editContactBtn = document.getElementById("me-edit-contact-btn") as HTMLButtonElement;
      const saveContactBtn = document.getElementById("me-save-contact-btn") as HTMLButtonElement;
      const cancelContactBtn = document.getElementById("me-cancel-contact-btn") as HTMLButtonElement;

      type BuyerProfileRow = {
        first_name?: string | null;
        last_name?: string | null;
        email?: string | null;
        phone?: string | null;
        push_enabled?: boolean;
        is_active?: boolean | null;
      };
      let buyerProfile: BuyerProfileRow | null = null;

      function renderContactFromProfile(b: BuyerProfileRow | null, phoneFallback: string) {
        const phoneRaw = b?.phone || phoneFallback;
        const fn = (b?.first_name || "").trim();
        const ln = (b?.last_name || "").trim();
        const em = (b?.email || "").trim();
        firstNameDisplay.textContent = fn || "—";
        lastNameDisplay.textContent = ln || "—";
        contactPhoneEl.textContent = formatContactPhone(phoneRaw);
        contactEmailEl.textContent = em || "—";
        const fullName = [fn, ln].filter(Boolean).join(" ");
        displayNameEl.textContent = fullName || "Buyer";
        if (fn) {
          avatarEl.textContent = (fn[0] + (ln[0] || "")).toUpperCase();
        } else {
          const ph = (phoneRaw || phoneFallback || "").replace(/\D/g, "");
          avatarEl.textContent = ph.length >= 2 ? ph.slice(-2) : "?";
        }
      }

      function fillContactInputs() {
        firstNameInput.value = (buyerProfile?.first_name || "").trim();
        lastNameInput.value = (buyerProfile?.last_name || "").trim();
        emailInput.value = (buyerProfile?.email || "").trim();
      }

      function setContactEditMode(editing: boolean) {
        contactReadOnly.style.display = editing ? "none" : "flex";
        contactEdit.style.display = editing ? "flex" : "none";
        editContactBtn.style.display = editing ? "none" : "inline-flex";
        saveContactBtn.style.display = editing ? "inline-flex" : "none";
        cancelContactBtn.style.display = editing ? "inline-flex" : "none";
      }

      let serverPushEnabled = false;
      const inactiveBanner = document.getElementById("me-inactive-banner")!;
      try {
        const profileRes = await fetch(`/api/buyer/profile?buyer_id=${session.buyer_id}`);
        if (profileRes.ok) {
          const { buyer } = await profileRes.json();
          buyerProfile = buyer;
          serverPushEnabled = buyer.push_enabled === true;
          renderContactFromProfile(buyer, session.phone);
          if (buyer.is_active === false) {
            localStorage.setItem("zepto_buyer_active", "0");
            inactiveBanner.style.display = "block";
          } else {
            localStorage.setItem("zepto_buyer_active", "1");
            inactiveBanner.style.display = "none";
          }
        } else {
          buyerProfile = null;
          renderContactFromProfile(null, session.phone);
        }
      } catch {
        buyerProfile = null;
        renderContactFromProfile(null, session.phone);
      }

      fillContactInputs();
      setContactEditMode(false);

      editContactBtn.addEventListener("click", () => {
        fillContactInputs();
        setContactEditMode(true);
      });

      cancelContactBtn.addEventListener("click", () => {
        setContactEditMode(false);
      });

      saveContactBtn.addEventListener("click", async () => {
        const nextFn = firstNameInput.value.trim();
        const nextLn = lastNameInput.value.trim();
        const nextEmail = emailInput.value.trim();
        if (nextEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(nextEmail)) {
          showToast("Enter a valid email address", "error");
          return;
        }
        setButtonLoading(saveContactBtn, true, "Save details", "on-dark");
        try {
          const res = await fetch("/api/buyer/profile", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              buyer_id: session.buyer_id,
              updates: { first_name: nextFn, last_name: nextLn, email: nextEmail },
            }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || "Failed to save");
          const b = data.buyer as BuyerProfileRow;
          buyerProfile = { ...buyerProfile, ...b };
          renderContactFromProfile(buyerProfile, session.phone);
          setContactEditMode(false);
          showToast("Contact details saved!");
        } catch (e: any) {
          showToast(e.message || "Failed to save contact details", "error");
        } finally {
          setButtonLoading(saveContactBtn, false, "Save details", "on-dark");
        }
      });

      // This device is subscribed but DB was never updated (e.g. failed save) — re-sync so /api/push-notify works
      if ((await isPushSubscribed()) && !serverPushEnabled) {
        await subscribePush().catch(() => {});
      }

      // Location
      const savedLoc = localStorage.getItem("zepto_location");
      if (savedLoc) {
        try {
          const loc = JSON.parse(savedLoc);
          document.getElementById("me-location")!.textContent = loc.name || "Set";
        } catch {}
      }

      // Change location
      document.getElementById("me-change-location")?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("open-location-picker"));
      });

      // —— Address book ——
      let addressRows: BuyerAddressRow[] = [];
      const listEl = document.getElementById("me-address-list")!;
      const editorEl = document.getElementById("me-address-editor")!;
      const editIdInput = document.getElementById("me-addr-edit-id") as HTMLInputElement;
      const addrLabel = document.getElementById("me-addr-label") as HTMLInputElement;
      const addrFlat = document.getElementById("me-addr-flat") as HTMLInputElement;
      const addrBuilding = document.getElementById("me-addr-building") as HTMLInputElement;
      const addrLandmark = document.getElementById("me-addr-landmark") as HTMLInputElement;
      const addrAreaHint = document.getElementById("me-addr-area-hint")!;
      const addrDefaultCb = document.getElementById("me-addr-default") as HTMLInputElement;

      function refreshAddrAreaHintFromStorage() {
        try {
          const raw = localStorage.getItem("zepto_location");
          if (!raw) {
            addrAreaHint.textContent = "Area: not set — set Location above or open the map picker.";
            return;
          }
          const loc = JSON.parse(raw) as { name?: string; lat?: number; lng?: number };
          const area = formatAreaPart(loc.name ?? null, loc.lat ?? null, loc.lng ?? null);
          addrAreaHint.textContent = area ? `Area: ${area}` : "Area: not set";
        } catch {
          addrAreaHint.textContent = "Area: not set";
        }
      }

      function closeAddrEditor() {
        editorEl.style.display = "none";
        editIdInput.value = "";
      }

      function openAddrEditor(row: BuyerAddressRow | null) {
        editorEl.style.display = "block";
        if (row) {
          editIdInput.value = row.id;
          addrLabel.value = row.label || "";
          addrFlat.value = row.flat || "";
          addrBuilding.value = row.building || "";
          addrLandmark.value = row.landmark || "";
          addrDefaultCb.checked = !!row.is_default;
          if (row.location_name || row.lat != null) {
            const area = formatAreaPart(row.location_name, row.lat, row.lng);
            addrAreaHint.textContent = area ? `Saved area: ${area}` : "Saved area: not set";
          } else refreshAddrAreaHintFromStorage();
        } else {
          editIdInput.value = "";
          addrLabel.value = "";
          addrFlat.value = "";
          addrBuilding.value = "";
          addrLandmark.value = "";
          addrDefaultCb.checked = false;
          refreshAddrAreaHintFromStorage();
        }
      }

      async function loadAddresses() {
        const res = await fetch(`/api/buyer/addresses?buyer_id=${encodeURIComponent(session.buyer_id)}`);
        if (!res.ok) {
          listEl.innerHTML = `<p class="text-muted" style="font-size:13px;">Could not load addresses.</p>`;
          return;
        }
        const data = await res.json();
        addressRows = data.addresses || [];
        renderMeAddressList();
      }

      function renderMeAddressList() {
        if (!addressRows.length) {
          listEl.innerHTML = `<p class="text-muted" style="font-size:13px;">No saved addresses yet.</p>`;
          return;
        }
        listEl.innerHTML = addressRows
          .map(
            (row) => `
          <div class="me-addr-row" style="padding:12px 0;border-bottom:1px solid var(--gray-100);">
            <div style="font-weight:700;font-size:14px;">${esc(row.label || "Address")} ${row.is_default ? '<span style="font-size:11px;color:var(--blue);font-weight:600;">Default</span>' : ""}</div>
            <div class="text-muted" style="font-size:12px;margin-top:4px;line-height:1.35;">${esc(formatSavedBuyerAddress(row) || "—")}</div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;justify-content:flex-end;">
              <button type="button" class="btn tap-target me-addr-edit" data-id="${esc(row.id)}" style="font-size:12px;padding:6px 12px;background:var(--gray-100);color:var(--blue);">Edit</button>
              <button type="button" class="btn tap-target me-addr-del" data-id="${esc(row.id)}" style="font-size:12px;padding:6px 12px;background:var(--gray-100);color:var(--red);">Delete</button>
              ${!row.is_default ? `<button type="button" class="btn tap-target me-addr-def" data-id="${esc(row.id)}" style="font-size:12px;padding:6px 12px;background:var(--gray-100);">Set default</button>` : ""}
            </div>
          </div>
        `
          )
          .join("");

        listEl.querySelectorAll(".me-addr-edit").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = (btn as HTMLElement).dataset.id!;
            const row = addressRows.find((r) => r.id === id);
            if (row) openAddrEditor(row);
          });
        });
        listEl.querySelectorAll(".me-addr-del").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = (btn as HTMLElement).dataset.id!;
            if (!confirm("Remove this address?")) return;
            const res = await fetch("/api/buyer/addresses", {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ buyer_id: session.buyer_id, id }),
            });
            if (res.ok) {
              showToast("Address removed");
              await loadAddresses();
            } else showToast("Could not delete", "error");
          });
        });
        listEl.querySelectorAll(".me-addr-def").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const id = (btn as HTMLElement).dataset.id!;
            const res = await fetch("/api/buyer/addresses", {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                buyer_id: session.buyer_id,
                id,
                address: { is_default: true },
              }),
            });
            if (res.ok) {
              showToast("Default updated");
              await loadAddresses();
            } else showToast("Could not update", "error");
          });
        });
      }

      function esc(s: string) {
        const d = document.createElement("div");
        d.textContent = s;
        return d.innerHTML;
      }

      document.getElementById("me-address-add-btn")?.addEventListener("click", () => {
        openAddrEditor(null);
        editorEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });

      document.getElementById("me-addr-cancel")?.addEventListener("click", closeAddrEditor);

      document.getElementById("me-addr-use-map")?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("open-location-picker"));
      });

      document.getElementById("me-addr-save")?.addEventListener("click", async () => {
        const btn = document.getElementById("me-addr-save") as HTMLButtonElement;
        setButtonLoading(btn, true, "Save address", "on-dark");
        try {
          let loc: { name?: string; lat?: number; lng?: number } = {};
          try {
            const raw = localStorage.getItem("zepto_location");
            if (raw) loc = JSON.parse(raw);
          } catch {}

          const editingId = editIdInput.value.trim();
          const payload = {
            label: addrLabel.value.trim() || "Address",
            flat: addrFlat.value.trim(),
            building: addrBuilding.value.trim(),
            landmark: addrLandmark.value.trim(),
            location_name: (loc.name ?? "").trim(),
            lat: typeof loc.lat === "number" ? loc.lat : null,
            lng: typeof loc.lng === "number" ? loc.lng : null,
            is_default: addrDefaultCb.checked,
          };

          if (!payload.flat && !payload.building) {
            showToast("Enter flat or building", "error");
            return;
          }

          const url = "/api/buyer/addresses";
          const res = editingId
            ? await fetch(url, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ buyer_id: session.buyer_id, id: editingId, address: payload }),
              })
            : await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ buyer_id: session.buyer_id, address: payload }),
              });

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.error || "Save failed");
          }
          showToast("Address saved");
          closeAddrEditor();
          await loadAddresses();
        } catch (e: any) {
          showToast(e.message || "Save failed", "error");
        } finally {
          setButtonLoading(btn, false, "Save address", "on-dark");
        }
      });

      await loadAddresses();

      if (window.location.hash === "#addresses") {
        document.getElementById("me-addresses-card")?.scrollIntoView({ behavior: "smooth" });
      }

      window.addEventListener("location-updated", () => {
        if (editorEl.style.display === "block") refreshAddrAreaHintFromStorage();
      });

      // Push notifications (bell = loading spinner while working)
      const notifyBell = document.getElementById("me-notify-bell") as HTMLButtonElement;
      const pushStatus = document.getElementById("me-push-status")!;

      const subscribedInit = await isPushSubscribed();
      notifyBell.textContent = subscribedInit ? "🔔" : "🔕";
      pushStatus.textContent = subscribedInit ? "On for this device" : "Off";

      notifyBell.addEventListener("click", async () => {
        const wasOn = await isPushSubscribed();
        const idleIcon = wasOn ? "🔔" : "🔕";
        setBellLoading(notifyBell, true, idleIcon);
        try {
          if (wasOn) {
            await unsubscribePush();
            setBellLoading(notifyBell, false, "🔕");
            pushStatus.textContent = "Off";
            showToast("Order alerts disabled");
          } else {
            const ok = await subscribePush();
            if (ok) {
              setBellLoading(notifyBell, false, "🔔");
              pushStatus.textContent = "On for this device";
              showToast("Order alerts enabled");
            } else {
              setBellLoading(notifyBell, false, "🔕");
              showToast("Could not enable notifications. Allow permissions or check VAPID setup.", "error");
            }
          }
        } catch {
          const on = await isPushSubscribed();
          setBellLoading(notifyBell, false, on ? "🔔" : "🔕");
          pushStatus.textContent = on ? "On for this device" : "Off";
          showToast("Failed to update notifications", "error");
        }
      });

      // iOS install hint
      const isIos = /iPad|iPhone|iPod/.test(navigator.userAgent);
      const isStandalone = window.matchMedia("(display-mode: standalone)").matches;
      if (isIos && !isStandalone) {
        document.getElementById("ios-install-hint")!.style.display = "block";
      }

      // Logout
      document.getElementById("me-logout")?.addEventListener("click", async () => {
        const logoutBtn = document.getElementById("me-logout") as HTMLButtonElement;
        setButtonLoading(logoutBtn, true, "Log out", "neutral");
        await signOut();
        window.location.href = "/";
      });
    }

    // Re-render profile after login
    window.addEventListener("buyer-logged-in", () => {
      initProfile();
    });

    // Listen for location updates
    window.addEventListener("location-updated", () => {
      const savedLoc = localStorage.getItem("zepto_location");
      if (savedLoc) {
        try {
          const loc = JSON.parse(savedLoc);
          const el = document.getElementById("me-location");
          if (el) el.textContent = loc.name || "Set";
        } catch {}
      }
    });

    initProfile();
  </script>

  <LoginModal />
  <LocationPicker />
</AppShell>

<style>
  .notify-bell-btn {
    position: relative;
  }
</style>
