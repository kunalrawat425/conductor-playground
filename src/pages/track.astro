---
export const prerender = false;
import AppShell from "../components/ui/AppShell.astro";
import EmptyState from "../components/ui/molecules/EmptyState.astro";
import LoginSheet from "../components/ui/organisms/LoginSheet.astro";
import Toast from "../components/ui/atoms/Toast.astro";
---
<AppShell
  noindex={true}
  title="Your Orders | Relifish"
  description="Track your fish orders and reorder favorites."
  header={{
    variant: "page",
    title: "Your Orders",
    backHref: "/shop",
  }}
  nav={{ active: "orders" }}
>
  <Toast />
  <LoginSheet id="v2-track-login" role="buyer" redirectTo="/track" />

  <div id="v2-track-loading" style="padding:24px;text-align:center;">
    <span class="v2-spinner v2-spinner-md"></span>
    <div style="margin-top:8px;font:500 12px Inter;color:var(--v2-ink-3);">Loading your orders...</div>
  </div>

  <div id="v2-track-guest" style="display:none;padding:0 16px;margin-top:16px;">
    <div class="v2-empty">
      <div class="v2-empty-icon">📋</div>
      <h3 class="v2-empty-title">Sign in to see your orders</h3>
      <p class="v2-empty-desc">Use your phone number to view past orders and track current ones.</p>
      <button id="v2-track-signin-btn" class="v2-btn v2-btn-primary v2-btn-md">Sign in</button>
    </div>
  </div>

  <div id="v2-track-empty" style="display:none;padding:0 16px;margin-top:16px;">
    <EmptyState
      variant="no-orders"
      ctaHref="/shop"
    />
  </div>

  <div id="v2-track-active" style="padding:12px 16px 0;"></div>
</AppShell>

<style is:global>
  .ol-tabs { display: flex; padding: 4px; border-radius: 12px; background: var(--v2-bg-3); margin-bottom: 4px; }
  .ol-tabs button { flex: 1; padding: 10px; border: 0; border-radius: 9px; background: none; font: 600 14px Inter; color: var(--v2-ink-3); cursor: pointer; }
  .ol-tabs button.on { background: var(--v2-bg); font-weight: 800; color: var(--v2-ink); }
  .ol-cap { margin: 16px 0 8px; font: 800 12px Inter; letter-spacing: .05em; color: var(--v2-ink-3); }
  .ol-card { display: block; margin-bottom: 12px; padding: 14px; background: var(--v2-bg); border: 1px solid var(--v2-border); border-radius: 16px; text-decoration: none; color: inherit; }
  .ol-top, .ol-row { display: flex; align-items: center; gap: 12px; }
  .ol-img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex: none; }
  .ol-main { flex: 1; min-width: 0; }
  .ol-main b { display: block; font: 800 16px Inter; color: var(--v2-ink); }
  .ol-main span { display: block; margin-top: 2px; font: 400 13px Inter; color: var(--v2-ink-3); text-transform: capitalize; }
  .ol-tags { display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }
  .ol-pill { border-radius: 999px; padding: 3px 9px; font: 700 12px Inter; white-space: nowrap; }
  .ol-pre { background: #F5F3FF; color: #7C3AED; } .ol-pod { background: #FFFBEB; color: #B45309; }
  html[data-theme="dark"] .ol-pre { background: rgba(124,58,237,.18); color: #C4B5FD; } html[data-theme="dark"] .ol-pod { background: rgba(217,119,6,.18); color: #FCD34D; }
  .ol-green { background: var(--v2-green-l); color: var(--v2-green); } .ol-red { background: var(--v2-red-l); color: var(--v2-red); }
  .ol-prog { display: flex; gap: 4px; margin-top: 14px; } .ol-prog i { flex: 1; height: 4px; border-radius: 2px; background: var(--v2-bg-3); } .ol-prog i.on { background: var(--v2-green); }
  .ol-line { margin-top: 12px; padding: 9px 12px; border-radius: 10px; background: var(--v2-brand-l); font: 700 13px Inter; color: var(--v2-brand); }
  .ol-btns { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
  .ol-btn { padding: 9px 14px; border-radius: 999px; border: 1.5px solid var(--v2-border); font: 700 13px Inter; color: var(--v2-ink); cursor: pointer; }
  .ol-btn.ol-primary { border-color: var(--v2-brand); color: var(--v2-brand); }
  .ol-empty { padding: 24px 0; text-align: center; font: 500 14px Inter; color: var(--v2-ink-3); }
  .v2-active-order {
    margin: 0 0 16px;
    background: linear-gradient(135deg, #E6F0FF, #DBEAFE);
    border: 1px solid #93C5FD;
    border-radius: var(--v2-radius-lg);
    padding: 16px;
  }
  .v2-active-order .label {
    font: 700 10px Inter;
    color: #1D4ED8;
    text-transform: uppercase; letter-spacing: .1em;
    margin-bottom: 6px;
  }
  .v2-active-order .label .v2-badge { font-size: 10px; }
  .v2-active-order h3 {
    font: 800 16px Inter; color: #1E293B; margin: 0 0 4px;
  }
  .v2-active-order .sub {
    font: 400 12px Inter; color: #475569; margin: 0 0 16px;
  }
  .v2-stepper {
    display: flex; align-items: center; gap: 4px;
  }
  .v2-stepper .dot {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: #CBD5E1;
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font: 700 11px Inter;
    flex-shrink: 0;
  }
  .v2-stepper .dot.done { background: #059669; }
  .v2-stepper .line { flex: 1; height: 2px; background: #CBD5E1; }
  .v2-stepper .line.done { background: #059669; }
  .v2-stepper-labels {
    display: flex; justify-content: space-between;
    margin-top: 6px;
    font: 500 11px Inter; color: #64748B;
  }

  .v2-section-head-light {
    padding: 16px 16px 8px;
    font: 700 12px Inter;
    color: var(--v2-ink-3);
    text-transform: uppercase; letter-spacing: .05em;
  }

  .v2-order-row {
    margin-bottom: 12px;
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius);
    padding: 14px;
    text-decoration: none; color: inherit;
    display: block;
    transition: box-shadow var(--v2-dur-fast) var(--v2-ease);
  }
  .v2-order-row:hover { box-shadow: var(--v2-shadow); }
  .v2-or-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .v2-or-seller { font: 700 14px Inter; color: var(--v2-ink); }
  .v2-or-meta { font: 400 11px Inter; color: var(--v2-ink-3); margin-top: 1px; }
  .v2-or-items { font: 400 12px Inter; color: var(--v2-ink-2); margin-top: 6px; line-height: 1.4; }
  .v2-or-bot {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--v2-border);
  }
  .v2-or-total { font: 800 14px Inter; color: var(--v2-ink); }
  .v2-or-reorder {
    background: var(--v2-bg); color: var(--v2-brand);
    border: 1.5px solid var(--v2-brand);
    font: 700 11px Inter;
    padding: 6px 14px;
    border-radius: var(--v2-radius-sm);
    cursor: pointer;
  }
</style>

<script>
  import { resolveBuyerStepper } from "../lib/buyer-order-stepper";
  import { wasActuallyPaid, refundableAmount } from "../lib/order-payment-state";
  import { orderSlotText } from "../lib/delivery-slots";

  function getBuyerPhone(): string | null {
    try { return localStorage.getItem("rlf_phone") || null; } catch { return null; }
  }


  // Immediately hide spinner and show guest if not logged in — don't wait for Supabase
  (function earlyAuthCheck() {
    if (getBuyerPhone()) return;
    const loading = document.getElementById("v2-track-loading");
    const guest = document.getElementById("v2-track-guest");
    if (loading) loading.style.display = "none";
    if (guest) {
      guest.style.display = "block";
      guest.querySelector<HTMLElement>("#v2-track-signin-btn")?.addEventListener("click", () => {
        (window as any).v2OpenSheet?.("v2-track-login");
      });
    }
  })();
  // Orders may have phone stored with or without +91 prefix
  function escapeHtml(s: string) {
    return String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!));
  }

  function statusToTag(status: string) {
    const map: Record<string, [string, string]> = {
      "pending": ["Pending", "v2-badge-tag v2-badge-orange"],
      "pending_payment": ["Payment pending", "v2-badge-tag v2-badge-orange"],
      "confirmed": ["Confirmed", "v2-badge-tag v2-badge-brand"],
      "paid": ["Paid", "v2-badge-tag v2-badge-brand"],
      "ready_for_pickup": ["Ready for pickup", "v2-badge-tag v2-badge-green"],
      "out_for_delivery": ["Out for delivery", "v2-badge-tag v2-badge-brand"],
      "picked_up": ["Picked up", "v2-badge-tag v2-badge-green"],
      "completed": ["Completed", "v2-badge-tag v2-badge-green"],
      "declined": ["Declined", "v2-badge-tag v2-badge-red"],
      "cancelled": ["Cancelled", "v2-badge-tag v2-badge-red"],
      "refunded": ["Refunded", "v2-badge-tag v2-badge-red"],
      "scheduled": ["Scheduled", "v2-badge-tag v2-badge-indigo"],
      "pre_order": ["Pre-order", "v2-badge-tag v2-badge-indigo"],
    };
    const [text, cls] = map[status] || [status, "v2-badge-tag"];
    return `<span class="v2-badge ${cls} v2-badge-size-md">${escapeHtml(text)}</span>`;
  }

  function paymentPillHtml(o: any) {
    const isPaidViaRazorpay = o.payment_method === 'razorpay' && o.razorpay_payment_id;
    // Never show "Paid" pill on orders still awaiting payment — statusToTag handles those
    const awaitingPayment = ['pending_payment', 'pending'].includes(o.status);
    let payStatusText = "";
    if (o.status === 'refunded') payStatusText = "Refunded";
    // BUG-42 again: paid_amount is pre-set at creation, so it is not evidence of payment.
    else if (['declined', 'cancelled'].includes(o.status) && wasActuallyPaid(o)) payStatusText = o.refund_sent_at ? "Refunded" : "Refund pending";
    else if (!awaitingPayment && (wasActuallyPaid(o) || isPaidViaRazorpay || ['confirmed', 'paid', 'ready_for_pickup', 'out_for_delivery', 'picked_up', 'completed'].includes(o.status))) payStatusText = "Paid";
    
    if (!payStatusText) return "";
    
    let bg = "#FFFBEB", color = "#B45309";
    if (payStatusText === "Paid") { bg = "#DCFCE7"; color = "#059669"; }
    else if (payStatusText.includes("Refund")) { bg = "#FEE2E2"; color = "#DC2626"; }
    
    return `<span style="font:700 10px Inter;text-transform:uppercase;letter-spacing:.04em;padding:2px 8px;border-radius:999px;margin-left:4px;background:${bg};color:${color};">${escapeHtml(payStatusText)}</span>`;
  }

  function isActive(status: string) {
    return ["pending", "pending_payment", "payment_required", "confirmed", "paid", "ready_for_pickup", "out_for_delivery", "scheduled", "pre_order"].includes(status);
  }
  function isTerminated(status: string) {
    return ["declined", "cancelled", "refunded"].includes(status);
  }

  function orderKindLabel(o: { is_preorder?: boolean | null; placement_kind?: string | null; status?: string }) {
    if (o.is_preorder === true || o.placement_kind === "preorder") return "Pre-order";
    if (o.status === "pre_order") return "Pre-order";
    return "Order";
  }

  function fmtDate(iso: string) {
    const d = new Date(iso);
    const today = new Date();
    const diffDays = Math.floor((today.getTime() - d.getTime()) / 86400000);
    if (diffDays === 0) return "Today";
    if (diffDays === 1) return "Yesterday";
    if (diffDays < 7) return `${diffDays} days ago`;
    return d.toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata", day: "numeric", month: "short" });
  }

  const PAGE_SIZE = 10;
  let currentPage = 1;

  // Orders list (preview "Orders list"; same as the app): Active · n / Past · n, arriving cards with progress,
  // status + slot line, Track / Call us / Help, Pre-order and Pay on delivery tags; past cards with Reorder
  // (rebuilds the cart on the order page) and Rate (finished, unrated); cancelled orders as compact rows.
  let tab: "active" | "past" = "active";
  let cache: { active: any[]; past: any[]; nA: number; nP: number } | null = null;
  const DONE = ["completed", "picked_up"];
  const STATUS: Record<string, string> = { pending: "Placed", pending_payment: "Waiting for payment", pre_order: "Pre-order placed", scheduled: "Scheduled", confirmed: "Confirmed", paid: "Paid, waiting for the seller", payment_required: "Final price is in", ready_for_pickup: "Ready for pickup", out_for_delivery: "Out for delivery" };
  const qtyOf = (o: any) => (o.quantity_unit === "kg" && Number(o.quantity) < 1 ? `${Math.round(Number(o.quantity) * 1000)} g` : `${o.quantity} ${o.quantity_unit === "kg" ? "kg" : o.quantity_unit || ""}`);
  const totalOf = (o: any) => `₹${(Number(o.total_price || 0) + Number(o.delivery_fee || 0)).toLocaleString("en-IN")}`;
  const dayOf = (iso: string) => new Date(iso).toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata", weekday: "short", day: "numeric", month: "short" });
  const fishImg = (o: any) => { const sp = String(o.species || o.listing?.species || "").toLowerCase(); return ["pomfret", "surmai", "prawns", "bangda", "rawas", "crab"].includes(sp) ? `/fish/${sp}.jpg` : "/fish/platter.jpg"; };
  const pill = (t: string, cls: string) => `<span class="ol-pill ${cls}">${escapeHtml(t)}</span>`;

  function activeCard(o: any) {
    const delivery = o.order_type === "delivery";
    const { labels, step } = resolveBuyerStepper(o, delivery ? "delivery" : "pickup");
    const pre = o.is_preorder === true || o.placement_kind === "preorder" || o.status === "pre_order";
    const slot = delivery ? orderSlotText(o) : null;
    return `<a class="ol-card" href="/track/${o.id}">
      <div class="ol-top"><img src="${fishImg(o)}" alt="" class="ol-img"><div class="ol-main"><b>${escapeHtml(o.listing?.seller?.name || "Seller")}</b><span>#${o.id.slice(0, 8).toUpperCase()} · ${escapeHtml(qtyOf(o))} ${escapeHtml(o.species || o.listing?.species || "")} · ${totalOf(o)}</span></div>
        <div class="ol-tags">${pre ? pill("Pre-order", "ol-pre") : ""}${o.pay_on_delivery && !o.razorpay_payment_id ? pill("Pay on delivery", "ol-pod") : ""}</div></div>
      <div class="ol-prog">${labels.map((_: string, i: number) => `<i class="${i <= step ? "on" : ""}"></i>`).join("")}</div>
      <div class="ol-line">${escapeHtml(STATUS[o.status] || labels[step] || o.status)}${slot ? ` · ${escapeHtml(slot.label.toLowerCase())} ${escapeHtml(slot.value)}` : ""}</div>
      <div class="ol-btns"><span class="ol-btn ol-primary">Track order</span><span class="ol-btn" data-href="tel:+919152207607">Call us</span><span class="ol-btn" data-href="/faq">Help</span></div>
    </a>`;
  }
  function pastCard(o: any) {
    if (isTerminated(o.status)) {
      const owed = !o.refund_sent_at ? refundableAmount(o) : 0;
      return `<a class="ol-card ol-row" href="/track/${o.id}"><img src="${fishImg(o)}" alt="" class="ol-img"><div class="ol-main"><b>${escapeHtml(o.listing?.seller?.name || "Seller")} · ${totalOf(o)}</b><span>${dayOf(o.created_at)} · ${owed > 0 ? `Refund ₹${owed.toLocaleString("en-IN")} on the way` : o.pay_on_delivery && !o.razorpay_payment_id ? "Not paid on delivery" : escapeHtml(`${o.species || o.listing?.species || ""} ${qtyOf(o)}`)}</span></div>${pill(o.status === "declined" ? "Declined" : o.status === "refunded" ? "Refunded" : "Cancelled", "ol-red")}</a>`;
    }
    return `<a class="ol-card" href="/track/${o.id}">
      <div class="ol-top"><img src="${fishImg(o)}" alt="" class="ol-img"><div class="ol-main"><b>${escapeHtml(o.listing?.seller?.name || "Seller")}</b><span>${dayOf(o.created_at)} · ${escapeHtml(`${o.species || o.listing?.species || ""} ${qtyOf(o)}`)} · ${totalOf(o)}</span></div>${pill(o.status === "picked_up" ? "Picked up" : "Delivered", "ol-green")}</div>
      <div class="ol-btns"><span class="ol-btn ol-primary" data-href="/track/${o.id}?reorder=1">Reorder</span>${DONE.includes(o.status) && !o.buyer_feedback ? `<span class="ol-btn">Rate</span>` : ""}</div>
    </a>`;
  }
  function render() {
    const root = document.getElementById("v2-track-active")!;
    if (!cache) return;
    const list = tab === "active" ? cache.active : cache.past;
    root.innerHTML = `<div class="ol-tabs"><button data-tab="active" class="${tab === "active" ? "on" : ""}">Active · ${cache.nA}</button><button data-tab="past" class="${tab === "past" ? "on" : ""}">Past · ${cache.nP}</button></div>`
      + (list.length ? `<div class="ol-cap">${tab === "active" ? "ARRIVING" : "PAST ORDERS"}</div>${list.map(tab === "active" ? activeCard : pastCard).join("")}` : `<div class="ol-empty">${tab === "active" ? "Nothing on the way." : "No orders yet."} <a href="/shop">Browse sellers</a></div>`);
    root.querySelectorAll<HTMLButtonElement>(".ol-tabs button").forEach((b) => b.onclick = () => { tab = b.dataset.tab as any; render(); });
    root.querySelectorAll<HTMLElement>(".ol-btn[data-href]").forEach((b) => b.onclick = (e) => { e.preventDefault(); location.href = b.dataset.href!; });
  }
  async function load() {
    const phone = getBuyerPhone();
    const loading = document.getElementById("v2-track-loading")!;
    const guest = document.getElementById("v2-track-guest")!;
    if (!phone) {
      loading.style.display = "none"; guest.style.display = "block";
      document.getElementById("v2-track-signin-btn")?.addEventListener("click", () => { (window as any).v2OpenSheet?.("v2-track-login"); });
      return;
    }
    try {
      const buyerId = (() => { try { return localStorage.getItem("rlf_buyer_id") || ""; } catch { return ""; } })();
      const q = async (scope: string) => { const r = await fetch(`/api/buyer/orders?buyer_id=${encodeURIComponent(buyerId)}&scope=${scope}&page=1&page_size=20`); const j = await r.json(); if (!r.ok) throw new Error(j.error || "Could not load orders"); return j; };
      const [a, p] = await Promise.all([q("active"), q("past")]);
      const first = !cache;
      cache = { active: a.orders || [], past: p.orders || [], nA: a.total || 0, nP: p.total || 0 };
      if (first && !cache.nA && cache.nP) tab = "past";
      loading.style.display = "none";
      if (!cache.nA && !cache.nP) { document.getElementById("v2-track-empty")!.style.display = "block"; return; }
      render();
    } catch (err) {
      console.error("track: load failed", err);
      loading.innerHTML = `<div style="text-align:center;padding:40px;color:var(--v2-red);">Failed to load orders.</div>`;
    }
  }

  function initTrack() {
    load();

    // Poll for status changes (browser realtime needed the open orders policy).
    setInterval(() => { if (cache) load(); }, 20000);
  }

  // Safety net: if load() never hides the spinner (e.g. script error), show guest after 3s
  const safetyTimer = setTimeout(() => {
    const loading = document.getElementById("v2-track-loading");
    if (loading && loading.style.display !== "none") {
      loading.style.display = "none";
      const guest = document.getElementById("v2-track-guest");
      if (guest) guest.style.display = "block";
      document.getElementById("v2-track-signin-btn")?.addEventListener("click", () => {
        (window as any).v2OpenSheet?.("v2-track-login");
      });
    }
  }, 3000);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => { clearTimeout(safetyTimer); initTrack(); });
  } else {
    clearTimeout(safetyTimer);
    initTrack();
  }
</script>
