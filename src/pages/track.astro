---
import AppShell from "../components/AppShell.astro";
import LoginModal from "../components/LoginModal.astro";
export const prerender = false;
---

<AppShell title={`My Orders - ${import.meta.env.PUBLIC_BRAND_NAME || "Relifish"}`} description="Track your fish orders in real-time." activeTab="orders" showLocationBadge={false}>
  <div id="track-container">
    <!-- Not logged in state -->
    <div id="track-login" style="display:none;text-align:center;padding:48px 16px;">
      <div style="font-size:48px;margin-bottom:16px;">🐟</div>
      <h2 style="font-size:20px;font-weight:700;margin-bottom:8px;">Track your orders</h2>
      <p class="text-muted" style="margin-bottom:24px;">Log in to see your order history and get live updates</p>
      <button class="btn btn-primary tap-target" id="track-login-btn" style="min-height:44px;padding:12px 32px;">
        Log in with phone
      </button>
    </div>

    <!-- Loading state -->
    <div id="track-loading" style="padding:24px 0;">
      <h2 class="section-title">My Orders</h2>
      <div class="card" style="margin-bottom:12px;"><div class="card-body"><div class="skeleton" style="height:20px;width:50%;margin-bottom:8px;"></div><div class="skeleton" style="height:16px;width:70%;"></div></div></div>
      <div class="card"><div class="card-body"><div class="skeleton" style="height:20px;width:50%;margin-bottom:8px;"></div><div class="skeleton" style="height:16px;width:70%;"></div></div></div>
    </div>

    <!-- Orders list -->
    <div id="track-orders" style="display:none;padding:16px 0;">
      <h2 class="section-title">My Orders</h2>
      <div id="orders-list"></div>
      <div id="track-pagination" class="track-pagination" style="display:none;"></div>
    </div>

    <!-- Empty state -->
    <div id="track-empty" style="display:none;text-align:center;padding:48px 16px;">
      <div style="font-size:48px;margin-bottom:16px;">📋</div>
      <h2 style="font-size:20px;font-weight:700;margin-bottom:8px;">No orders yet</h2>
      <p class="text-muted" style="margin-bottom:24px;">Browse fresh fish and place your first order</p>
      <a href="/" class="btn btn-primary tap-target" style="padding:12px 32px;">Browse Fish</a>
    </div>
  </div>

  <script>
    import { supabase, getBuyerOrdersPage } from "../lib/supabase";
    import { BUYER_TRACK_PAGE_SIZE } from "../lib/seller-orders-pagination";
    import { getSession } from "../lib/auth";
    import { getSpeciesDisplay } from "../lib/species";
    import { priceUnitShortLabel } from "../lib/listing-pricing";
    import type { PriceUnit } from "../lib/species";

    // Status display mapping
    const STATUS_LABELS: Record<string, { label: string; badge: string }> = {
      pre_order: { label: "Pending confirmation", badge: "badge-orange" },
      pending: { label: "Placed", badge: "badge-blue" },
      confirmed: { label: "Confirmed", badge: "badge-green" },
      paid: { label: "Paid", badge: "badge-green" },
      picked_up: { label: "Ready for pickup", badge: "badge-green" },
      completed: { label: "Completed", badge: "badge-green" },
      declined: { label: "Declined", badge: "badge-red" },
      cancelled: { label: "Cancelled", badge: "badge-red" },
      refunded: { label: "Refunded", badge: "badge-orange" },
      scheduled: { label: "Scheduled", badge: "badge-purple" },
    };

    function esc(str: string): string {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    function formatDate(dateStr: string): string {
      const d = new Date(dateStr);
      return d.toLocaleDateString("en-IN", {
        day: "numeric",
        month: "short",
        hour: "2-digit",
        minute: "2-digit",
      });
    }

    function renderOrder(order: any): string {
      const status = STATUS_LABELS[order.status] || { label: order.status, badge: "badge-blue" };
      const species = order.species
        ? getSpeciesDisplay(order.species)
        : order.listing?.species
          ? getSpeciesDisplay(order.listing.species)
          : "Fish";
      const sellerName = order.listing?.seller?.name || "Seller";
      const isPreOrder = order.status === "pre_order" || order.paid_amount != null;

      let priceDisplay = "";
      if (order.final_price) {
        priceDisplay = `₹${order.final_price}`;
        if (order.paid_amount && order.paid_amount > order.final_price) {
          const refund = order.paid_amount - order.final_price;
          priceDisplay += ` <span class="text-muted">(₹${refund} refund)</span>`;
        }
      } else if (order.total_price) {
        const df = Number(order.delivery_fee) || 0;
        const sub = order.total_price;
        priceDisplay =
          df > 0
            ? `₹${sub + df} <span class="text-muted" style="font-weight:400;">(₹${sub} + ₹${df} delivery)</span>`
            : `₹${sub}`;
      } else if (order.paid_amount) {
        priceDisplay = `Up to ₹${order.paid_amount}`;
      }

      const sellerPhone = order.listing?.seller?.phone || "";
      const sellerLocation = order.listing?.seller?.location_name || "";
      const orderAddr = order.buyer_addr || "";
      const orderType = order.order_type === "delivery" ? "🚚 Delivery" : "📦 Pickup";
      const orderId = order.id.substring(0, 8).toUpperCase();
      const qtyUnit =
        order.quantity_unit === "piece" ||
        order.quantity_unit === "kg" ||
        order.quantity_unit === "gram"
          ? priceUnitShortLabel(order.quantity_unit as PriceUnit)
          : String(order.quantity_unit ?? "");

      return `
        <div class="card" style="margin-bottom:12px;" data-order-id="${order.id}">
          <div class="card-body">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
              <div>
                <h3 style="font-size:16px;font-weight:700;">${esc(species)}</h3>
                <span class="text-muted">${esc(sellerName)}</span>
              </div>
              <span class="badge ${status.badge}">${status.label}</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <div>
                ${priceDisplay ? `<span style="font-weight:600;">${priceDisplay}</span>` : ""}
                ${order.quantity ? `<span class="text-muted"> · ${order.quantity} ${qtyUnit}</span>` : ""}
              </div>
              <span class="text-muted" style="font-size:12px;">${formatDate(order.created_at)}</span>
            </div>
            ${isPreOrder && order.status === "pre_order" ? `<p class="text-muted" style="font-size:12px;margin-top:8px;font-style:italic;">Waiting for seller to confirm with morning price</p>` : ""}
            ${order.scheduled_for ? `<p style="font-size:12px;font-weight:600;color:var(--blue);margin-top:6px;">🗓️ Scheduled: ${new Date(order.scheduled_for).toLocaleDateString("en-IN", { day: "numeric", month: "short" })} at ${new Date(order.scheduled_for).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })}</p>` : ""}
            <button type="button" class="order-detail-toggle" onclick="this.parentElement.querySelector('.order-details').classList.toggle('open');this.textContent=this.textContent.includes('▼')?'Less ▲':'Details ▼'">Details ▼</button>
            <div class="order-details">
              <div class="od-row"><span class="od-label">Order ID</span><span class="od-val">#${orderId}</span></div>
              <div class="od-row"><span class="od-label">Type</span><span class="od-val">${orderType}</span></div>
              ${orderAddr ? `<div class="od-row"><span class="od-label">Address</span><span class="od-val">${esc(orderAddr)}</span></div>` : ""}
              ${sellerLocation ? `<div class="od-row"><span class="od-label">Seller location</span><span class="od-val">${esc(sellerLocation)}</span></div>` : ""}
              ${sellerPhone ? `<div class="od-row"><span class="od-label">Seller contact</span><span class="od-val"><a href="tel:${esc(sellerPhone)}" style="color:var(--blue);font-weight:600;">${esc(sellerPhone)}</a></span></div>` : ""}
              ${order.cancelled_by ? `<div class="od-row"><span class="od-label">Cancelled by</span><span class="od-val" style="color:var(--red);">${order.cancelled_by === "buyer" ? "You" : "Seller"}</span></div>` : ""}
              ${order.cancel_reason ? `<div class="od-row"><span class="od-label">Reason</span><span class="od-val" style="font-style:italic;color:var(--gray-500);">${esc(order.cancel_reason)}</span></div>` : ""}
              ${order.status === "confirmed" && order.final_price && isPreOrder ? `
                <div class="price-confirm-box">
                  <p style="font-size:13px;margin:0 0 8px;">Seller proposed: <strong>₹${order.final_price}</strong>${order.paid_amount ? ` (you paid ₹${order.paid_amount} upfront)` : ""}</p>
                  <div style="display:flex;gap:8px;">
                    <button type="button" class="btn-accept-price" data-order-id="${order.id}">✅ Accept</button>
                    <button type="button" class="btn-reject-price" data-order-id="${order.id}">❌ Reject & Cancel</button>
                  </div>
                </div>
              ` : ""}
              ${["pending", "pre_order", "scheduled"].includes(order.status) ? `
                <button type="button" class="btn-cancel-order" data-order-id="${order.id}">Cancel Order</button>
              ` : ""}
            </div>
          </div>
        </div>
      `;
    }

    let trackPage = 1;

    function renderTrackPagination(total: number, page: number, onPage: (p: number) => void) {
      const el = document.getElementById("track-pagination")!;
      const totalPages = Math.max(1, Math.ceil(total / BUYER_TRACK_PAGE_SIZE));
      if (total <= BUYER_TRACK_PAGE_SIZE) {
        el.innerHTML = "";
        el.style.display = "none";
        return;
      }
      el.style.display = "flex";
      el.innerHTML = `
        <button type="button" class="track-pg-prev" ${page <= 1 ? "disabled" : ""}>← Prev</button>
        <span class="page-info">${page} / ${totalPages}</span>
        <button type="button" class="track-pg-next" ${page >= totalPages ? "disabled" : ""}>Next →</button>
      `;
      el.querySelector(".track-pg-prev")?.addEventListener("click", () => {
        if (page > 1) onPage(page - 1);
      });
      el.querySelector(".track-pg-next")?.addEventListener("click", () => {
        if (page < totalPages) onPage(page + 1);
      });
    }

    async function initTrack() {
      const loginEl = document.getElementById("track-login")!;
      const loadingEl = document.getElementById("track-loading")!;
      const ordersEl = document.getElementById("track-orders")!;
      const emptyEl = document.getElementById("track-empty")!;
      const ordersList = document.getElementById("orders-list")!;
      const paginationEl = document.getElementById("track-pagination")!;

      const session = getSession();

      if (!session) {
        loadingEl.style.display = "none";
        loginEl.style.display = "block";

        document.getElementById("track-login-btn")?.addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("start-order"));
        });
        return;
      }

      const buyerId = session.buyer_id;
      trackPage = 1;

      async function loadOrdersPage() {
        let { orders, total } = await getBuyerOrdersPage(buyerId, {
          page: trackPage,
          pageSize: BUYER_TRACK_PAGE_SIZE,
        });
        if (orders.length === 0 && total > 0 && trackPage > 1) {
          trackPage = 1;
          ({ orders, total } = await getBuyerOrdersPage(buyerId, {
            page: 1,
            pageSize: BUYER_TRACK_PAGE_SIZE,
          }));
        }
        return { orders, total };
      }

      async function loadAndRender() {
        try {
          const { orders, total } = await loadOrdersPage();
          loadingEl.style.display = "none";
          if (total === 0) {
            paginationEl.style.display = "none";
            paginationEl.innerHTML = "";
            emptyEl.style.display = "block";
            ordersEl.style.display = "none";
            return;
          }
          emptyEl.style.display = "none";
          ordersEl.style.display = "block";
          ordersList.innerHTML = orders.map(renderOrder).join("");
          renderTrackPagination(total, trackPage, (p) => {
            trackPage = p;
            void loadAndRender();
          });

          // Cancel order handlers
          function trackToast(msg: string, type: string = "success") {
            const t = document.getElementById("toast");
            if (!t) return;
            t.textContent = msg;
            t.style.display = "block";
            t.style.background = type === "error" ? "var(--red)" : "var(--green)";
            t.style.color = "white";
            setTimeout(() => { t.style.display = "none"; }, 3000);
          }

          ordersList.querySelectorAll(".btn-cancel-order").forEach((btn: any) => {
            btn.addEventListener("click", async () => {
              const reason = prompt("Why are you cancelling? (optional)");
              if (reason === null) return;
              btn.disabled = true; btn.textContent = "Cancelling...";
              try {
                const res = await fetch("/api/orders/cancel", {
                  method: "POST", headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ order_id: btn.dataset.orderId, buyer_id: buyerId, action: "cancel", cancel_reason: reason || "" }),
                });
                const d = await res.json();
                if (d.success) { trackToast("Order cancelled"); void loadAndRender(); }
                else { trackToast(d.error || "Failed to cancel", "error"); btn.disabled = false; btn.textContent = "Cancel Order"; }
              } catch (_) { trackToast("Network error. Try again.", "error"); btn.disabled = false; btn.textContent = "Cancel Order"; }
            });
          });

          ordersList.querySelectorAll(".btn-accept-price").forEach((btn: any) => {
            btn.addEventListener("click", async () => {
              btn.disabled = true; btn.textContent = "Accepting...";
              try {
                const res = await fetch("/api/orders/cancel", {
                  method: "POST", headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ order_id: btn.dataset.orderId, buyer_id: buyerId, action: "accept_price" }),
                });
                const d = await res.json();
                if (d.success) { trackToast("Price accepted!"); void loadAndRender(); }
                else { trackToast(d.error || "Failed", "error"); btn.disabled = false; btn.textContent = "✅ Accept"; }
              } catch (_) { trackToast("Network error", "error"); btn.disabled = false; btn.textContent = "✅ Accept"; }
            });
          });

          ordersList.querySelectorAll(".btn-reject-price").forEach((btn: any) => {
            btn.addEventListener("click", async () => {
              if (!confirm("Reject this price and cancel the order?")) return;
              btn.disabled = true; btn.textContent = "Rejecting...";
              try {
                const res = await fetch("/api/orders/cancel", {
                  method: "POST", headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ order_id: btn.dataset.orderId, buyer_id: buyerId, action: "reject_price" }),
                });
                const d = await res.json();
                if (d.success) { trackToast("Price rejected, order cancelled"); void loadAndRender(); }
                else { trackToast(d.error || "Failed", "error"); btn.disabled = false; btn.textContent = "❌ Reject & Cancel"; }
              } catch (_) { trackToast("Network error", "error"); btn.disabled = false; btn.textContent = "❌ Reject & Cancel"; }
            });
          });
        } catch (e) {
          console.error("Track orders:", e);
          loadingEl.style.display = "none";
        }
      }

      await loadAndRender();

      supabase
        .channel("buyer-orders")
        .on(
          "postgres_changes",
          {
            event: "UPDATE",
            schema: "public",
            table: "orders",
            filter: `buyer_id=eq.${buyerId}`,
          },
          (payload: any) => {
            const updated = payload.new;
            const card = document.querySelector(`#orders-list [data-order-id="${updated.id}"]`);
            if (card) {
              card.outerHTML = renderOrder(updated);
            }
          }
        )
        .subscribe();
    }

    void initTrack();
  </script>

  <style is:global>
    .order-detail-toggle {
      display: block;
      margin-top: 8px;
      font-size: 12px;
      font-weight: 600;
      color: var(--blue);
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px 0;
      font-family: inherit;
    }
    .order-details {
      display: none;
      margin-top: 8px;
      padding-top: 10px;
      border-top: 1px solid var(--gray-100);
    }
    .order-details.open { display: block; }
    .od-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 4px 0;
      font-size: 13px;
    }
    .od-label { color: var(--gray-500); font-weight: 500; }
    .od-val { color: var(--gray-800); font-weight: 600; text-align: right; max-width: 60%; }

    .btn-cancel-order {
      display: block;
      width: 100%;
      margin-top: 10px;
      padding: 10px;
      font-size: 13px;
      font-weight: 600;
      color: var(--red);
      background: #fff5f5;
      border: 1px solid #ffcdd2;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
    }
    .price-confirm-box {
      margin-top: 10px;
      padding: 12px;
      background: #fff8e1;
      border: 1px solid #ffe082;
      border-radius: 10px;
    }
    .btn-accept-price, .btn-reject-price {
      flex: 1;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      border: none;
    }
    .btn-accept-price { background: #e8f5e9; color: #2e7d32; }
    .btn-reject-price { background: #ffebee; color: #c62828; }

    .track-pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      margin-top: 16px;
      padding: 8px 0;
    }
    .track-pagination button {
      padding: 6px 14px;
      font-size: 13px;
      border: 1px solid var(--gray-200);
      border-radius: 8px;
      background: white;
      cursor: pointer;
    }
    .track-pagination button:disabled {
      opacity: 0.4;
      cursor: default;
    }
    .track-pagination .page-info {
      font-size: 13px;
      color: var(--gray-500);
    }
  </style>

  <LoginModal />
</AppShell>
