---
/**
 * Leaflet map showing seller locations.
 * Renders client-side only (no SSR for Leaflet).
 * Default center: Versova, Mumbai.
 */
---

<div id="seller-map" class="seller-map">
  <div class="map-loading text-muted">Loading map...</div>
</div>

<style>
  .seller-map {
    width: 100%;
    height: 300px;
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 24px;
    background: var(--gray-100);
  }

  .map-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }
</style>

<script>
  import { getSellersWithLocation } from "../lib/supabase";
  import type { Seller } from "../lib/supabase";

  async function initMap() {
    const mapEl = document.getElementById("seller-map");
    if (!mapEl) return;

    // Dynamic import Leaflet (avoids SSR issues)
    const L = await import("leaflet");

    // Leaflet CSS
    const link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
    document.head.appendChild(link);

    // Wait for CSS to load
    await new Promise((resolve) => {
      link.onload = resolve;
      setTimeout(resolve, 1000);
    });

    // Clear loading text
    mapEl.innerHTML = "";

    // Default center: Versova, Mumbai
    const defaultCenter: [number, number] = [19.1334, 72.8167];
    const map = L.map(mapEl).setView(defaultCenter, 13);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18,
    }).addTo(map);

    // Custom fish marker icon
    const fishIcon = L.divIcon({
      html: '<div style="font-size:24px;text-align:center;">🐟</div>',
      className: "fish-marker",
      iconSize: [32, 32],
      iconAnchor: [16, 16],
      popupAnchor: [0, -16],
    });

    try {
      const sellers = await getSellersWithLocation();

      if (sellers.length === 0) {
        // No sellers with location, show default view
        const defaultMarker = L.marker(defaultCenter, { icon: fishIcon }).addTo(map);
        defaultMarker.bindPopup("Versova Fish Market").openPopup();
        return;
      }

      const bounds: [number, number][] = [];

      for (const seller of sellers) {
        if (seller.lat === null || seller.lng === null) continue;

        const pos: [number, number] = [seller.lat, seller.lng];
        bounds.push(pos);

        const marker = L.marker(pos, { icon: fishIcon }).addTo(map);

        const deliveryInfo = seller.has_delivery && seller.delivery_rad
          ? `<br>🚚 Delivers within ${seller.delivery_rad} km`
          : "<br>📦 Pickup only";

        const ratingInfo = seller.rating_avg > 0
          ? `<br>⭐ ${seller.rating_avg}`
          : "";

        marker.bindPopup(`
          <div style="min-width:150px;">
            <strong><a href="/seller/${seller.id}">${seller.name}</a></strong>
            <br>📍 ${seller.location_name}
            ${deliveryInfo}
            ${ratingInfo}
          </div>
        `);

        // Draw delivery radius circle if seller delivers
        if (seller.has_delivery && seller.delivery_rad) {
          L.circle(pos, {
            radius: seller.delivery_rad * 1000, // km to meters
            color: "#25d366",
            fillColor: "#25d366",
            fillOpacity: 0.08,
            weight: 1,
          }).addTo(map);
        }
      }

      if (bounds.length > 0) {
        map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
      }
    } catch (err) {
      console.error("Failed to load sellers for map:", err);
    }
  }

  initMap();
</script>
