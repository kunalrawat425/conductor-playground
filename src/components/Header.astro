---
interface Props {
  showDashboardLink?: boolean;
}

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";
const { showDashboardLink = true } = Astro.props;
---

<header class="header">
  <a href="/" class="logo">🐟 {brandName}</a>
  <nav>
    {showDashboardLink && <a href="/dashboard/orders" class="nav-link">Seller Dashboard</a>}
  </nav>
</header>
