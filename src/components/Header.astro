---
interface Props {
  showDashboardLink?: boolean;
}

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";
const { showDashboardLink = true } = Astro.props;
---

<header class="header">
  <a href="/" class="logo"><img src="https://witoghpdfocywiosmrzv.supabase.co/storage/v1/object/public/meta/logo_horizontal.png" alt={brandName} class="logo-img" /></a>
  <nav class="header-nav">
    {showDashboardLink && <a href="/dashboard/orders" class="nav-link">Seller home</a>}
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--gray-200);
    width: 100%;
    max-width: var(--app-max-width);
    margin: 0 auto 24px;
    box-sizing: border-box;
    min-width: 0;
  }

  .logo {
    font-size: 20px;
    font-weight: 700;
    color: var(--gray-900);
    display: flex;
    align-items: center;
  }
  .logo-img {
    height: 40px;
    width: auto;
    display: block;
  }

  .logo:hover {
    text-decoration: none;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 500;
  }
</style>
