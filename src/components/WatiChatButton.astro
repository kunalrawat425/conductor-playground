---
/**
 * Floating "Chat with us" WhatsApp button (Wati's free chat widget, founder 30 Oct 2026).
 * Opens a WhatsApp chat with our business number (Wati inbox), message pre-filled with the page.
 * Loaded after the page is idle so it never slows the first paint. Buyer pages only (AppShell
 * skips it on the seller dashboard). Sits above the bottom nav and the cart bar.
 */
import { SUPPORT_WHATSAPP } from "../lib/brand";
/** marginBottom: 20 px (founder 31 Oct); app pages with the bottom nav pass 84 (64 px nav + 20). */
const { marginBottom = "20" } = Astro.props as { marginBottom?: string };
const options = {
  enabled: true,
  // Founder's Wati generator settings (30 Oct; button on the left since 31 Oct), except: marginBottom stays 150 so the button clears
  // the bottom nav and cart bar; our white-R app icon (the blue logo vanishes on blue); the number keeps its 91 country code.
  chatButtonSetting: { backgroundColor: "#0066FF", ctaText: "Get to know more!", borderRadius: "25", marginLeft: "20", marginRight: "0", marginBottom, ctaIconWATI: false, position: "left" },
  brandSetting: {
    brandName: "Relifish", brandSubTitle: "", brandImg: "https://www.relifish.com/icon-192.png", altText: "Relifish",
    welcomeText: "Hi there!\nHow can I help you?", messageText: "Hello,\n I have a question about {{page_link}}",
    backgroundColor: "#0066FF", ctaText: "Chat on WhatsApp", borderRadius: "25", autoShow: false, phoneNumber: SUPPORT_WHATSAPP,
  },
};
---
<script is:inline define:vars={{ options }}>
  (function () {
    function load() {
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://wati-integration-prod-service.clare.ai/v2/watiWidget.js?95221";
      s.onload = function () { if (window.CreateWhatsappChatWidget) window.CreateWhatsappChatWidget(options); };
      document.body.appendChild(s);
    }
    var idle = window.requestIdleCallback || function (f) { setTimeout(f, 2000); };
    if (document.readyState === "complete") idle(load); else window.addEventListener("load", function () { idle(load); });
  })();
</script>
<style is:global>
  /* No "Get to know more!" bubble next to the button (founder 31 Oct): just the round WhatsApp button. */
  #whatsapp-chat-widget .wa-chat-bubble { display: none !important; }
</style>
