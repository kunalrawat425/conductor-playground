---
import { LOGO_URL } from "../lib/brand";
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activeTab?: "home" | "orders" | "me";
  showLocationBadge?: boolean;
  needsMap?: boolean;
  jsonLd?: Record<string, unknown>;
}

import VercelAnalytics from "./VercelAnalytics.astro";

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";
const siteUrl = "https://www.relifish.store";
const defaultDescription = "Hyperlocal. Fresh. Affordable. Order fresh fish from verified local sellers in Mumbai — delivered to your doorstep in 2 hours.";
const { title = brandName, description = defaultDescription, ogImage = "/og-image.png", activeTab = "home", showLocationBadge = true, needsMap = false, jsonLd } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066cc" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    {needsMap && <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    
    {import.meta.env.PUBLIC_ENABLE_TRACKING === "true" && (
      <>
        <!-- Facebook Pixel -->
        <script is:inline>
          !function(f,b,e,v,n,t,s){
            if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window,document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init','1197248829088195');
          fbq('track','PageView');
        </script>
        <noscript><img height="1" width="1" style="display:none"
          src="https://www.facebook.com/tr?id=1197248829088195&ev=PageView&noscript=1"/></noscript>

        <!-- Firebase SDK & Analytics -->
        <script type="module" is:inline>
          import { initializeApp } from "https://www.gstatic.com/firebasejs/12.14.0/firebase-app.js";
          import { getAnalytics } from "https://www.gstatic.com/firebasejs/12.14.0/firebase-analytics.js";

          const firebaseConfig = {
            apiKey: "AIzaSyDYlmH764DU2ZJQJIfmnX-WpGBJ5hwV520",
            authDomain: "relifish.firebaseapp.com",
            projectId: "relifish",
            storageBucket: "relifish.firebasestorage.app",
            messagingSenderId: "881437398033",
            appId: "1:881437398033:web:982edeaf6e723a8ab04db0",
            measurementId: "G-7MXZDZ1S4N"
          };

          const app = initializeApp(firebaseConfig);
          const analytics = getAnalytics(app);
        </script>
      </>
    )}
  </head>
  <body>
    <div class="app-shell">
      <!-- Fixed header -->
      <header class="app-header">
        <div class="app-header-top">
          <a href="/" class="app-logo"><img src={LOGO_URL} alt={brandName} class="app-logo-img" /></a>
          {showLocationBadge && (
            <button class="location-badge" id="location-badge" aria-label="Change location">
              <span id="location-text">Set location</span>
            </button>
          )}
        </div>
        <slot name="header-extra" />
      </header>

      <!-- Scrollable content area -->
      <main class="app-content" id="app-content">
        <slot />
      </main>

      <!-- Fixed bottom navigation (layout matches SellerBottomNav: app-bottom-nav-inner) -->
      <nav class="bottom-nav" aria-label="Main navigation">
        <div class="app-bottom-nav-inner">
          <a href="/" class={`bottom-nav-item ${activeTab === "home" ? "active" : ""}`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>Home</span>
          </a>
          <a href="/track" class={`bottom-nav-item ${activeTab === "orders" ? "active" : ""}`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Orders</span>
          </a>
          <a href="/me" class={`bottom-nav-item ${activeTab === "me" ? "active" : ""}`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>Me</span>
          </a>
        </div>
      </nav>
    </div>

    <!-- Backdrop for modals/sheets -->
    <div class="backdrop" id="backdrop"></div>

    <!-- Service worker registration -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>

    <!-- Location badge hydration -->
    <script>
      const badge = document.getElementById("location-badge");
      const locationText = document.getElementById("location-text");

      function updateLocationBadge() {
        const saved = localStorage.getItem("rlf_location");
        if (saved) {
          try {
            const loc = JSON.parse(saved);
            if (locationText && loc.name) {
              locationText.textContent = loc.name;
            }
          } catch {}
        }
      }

      updateLocationBadge();

      if (badge) {
        badge.addEventListener("click", () => {
          // Dispatch custom event to open location picker
          window.dispatchEvent(new CustomEvent("open-location-picker"));
        });
      }

      // Listen for location changes
      window.addEventListener("location-updated", () => updateLocationBadge());
    </script>
    {import.meta.env.PUBLIC_ENABLE_TRACKING === "true" && <VercelAnalytics />}
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  /* ===== APP SHELL ===== */
  html, body {
    height: 100%;
    overflow: hidden;
    background: var(--gray-50);
  }

  .app-shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
  }

  /* ===== HEADER ===== */
  .app-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: white;
    border-bottom: 1px solid var(--gray-200);
    padding: 0 16px;
    padding-top: env(safe-area-inset-top);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: var(--app-max-width);
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
    min-width: 0;
  }

  .app-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    flex-shrink: 0;
    min-width: 0;
  }

  .app-logo {
    font-size: 18px;
    font-weight: 700;
    color: var(--gray-900);
    text-decoration: none;
    white-space: nowrap;
  }
  .app-logo-img {
    height: 44px;
    width: auto;
    display: block;
    transition: height 0.15s ease;
  }
  @media (min-width: 769px) {
    .app-logo-img {
      height: 50px;
    }
  }

  .app-logo:hover {
    text-decoration: none;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    color: var(--blue);
    cursor: pointer;
    min-height: 32px;
    transition: background 0.15s;
  }

  .location-badge::before {
    content: "\1F4CD"; /* 📍 */
  }

  .location-badge:hover {
    background: var(--gray-100);
  }

  /* ===== CONTENT ===== */
  .app-content {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0 16px calc(80px + env(safe-area-inset-bottom));
  }

  /* ===== BOTTOM NAV (same width + padding as .app-header) ===== */
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: var(--app-max-width);
    min-height: 56px;
    padding: 0 16px;
    padding-bottom: env(safe-area-inset-bottom);
    box-sizing: border-box;
    background: white;
    border-top: 1px solid var(--gray-200);
    z-index: 100;
    min-width: 0;
  }

  .bottom-nav .app-bottom-nav-inner {
    width: 100%;
    max-width: none;
    margin: 0;
    display: flex;
    justify-content: space-around;
    align-items: center;
    min-height: 56px;
    min-width: 0;
  }

  .bottom-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 11px;
    font-weight: 500;
    color: var(--gray-500);
    text-decoration: none;
    padding: 6px 16px;
    min-width: 64px;
    min-height: 44px;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s;
  }

  .bottom-nav-item:hover {
    text-decoration: none;
    color: var(--blue);
  }

  .bottom-nav-item.active {
    color: var(--blue);
  }

  .bottom-nav-item svg {
    width: 22px;
    height: 22px;
  }

  /* ===== BOTTOM SHEET ===== */
  .bottom-sheet {
    position: fixed;
    bottom: 0;
    left: 50%;
    right: auto;
    width: 100%;
    max-width: var(--app-max-width);
    background: white;
    border-radius: 16px 16px 0 0;
    max-height: 70vh;
    transform: translate(-50%, 100%);
    transition: transform 0.3s ease;
    z-index: 200;
    padding: 0 16px 16px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom));
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    overflow-y: auto;
  }

  .bottom-sheet.open {
    transform: translate(-50%, 0);
  }

  .bottom-sheet-handle {
    width: 36px;
    height: 4px;
    background: var(--gray-200);
    border-radius: 2px;
    margin: 8px auto 16px;
  }

  /* ===== BACKDROP ===== */
  .backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 199;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .backdrop.visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ===== FULL-SCREEN MODAL (login on mobile) ===== */
  .fullscreen-modal {
    position: fixed;
    inset: 0;
    background: white;
    z-index: 300;
    padding: 16px;
    padding-top: calc(16px + env(safe-area-inset-top));
    display: none;
    flex-direction: column;
    overflow-y: auto;
  }

  .fullscreen-modal.open {
    display: flex;
  }

  .fullscreen-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    font-size: 24px;
    color: var(--gray-700);
    cursor: pointer;
    border-radius: 50%;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .fullscreen-modal-close:hover {
    background: var(--gray-100);
  }

  /* ===== TAP FEEDBACK ===== */
  .tap-target {
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.1s, opacity 0.1s;
  }

  .tap-target:active {
    transform: scale(0.97);
    opacity: 0.8;
  }

  /* ===== MOBILE BREAKPOINTS ===== */
  @media (max-width: 768px) {
    body {
      padding: 0;
      max-width: 100%;
    }

    .app-content {
      padding: 0 12px calc(80px + env(safe-area-inset-bottom));
    }

    .grid-2 {
      grid-template-columns: 1fr;
    }

    .card-body {
      padding: 12px;
    }

    .section-title {
      font-size: 18px;
      margin: 16px 0 8px;
    }
  }

  @media (min-width: 769px) {
    /* Desktop: bottom nav becomes horizontal bar under header (aligned with .app-header) */
    .bottom-nav {
      position: static;
      left: auto;
      transform: none;
      height: auto;
      border-top: none;
      border-bottom: 1px solid var(--gray-200);
      padding-bottom: 0;
      width: 100%;
      max-width: var(--app-max-width);
      margin: 0 auto;
    }

    .bottom-nav .app-bottom-nav-inner {
      justify-content: center;
      gap: 8px;
      min-height: auto;
    }

    .bottom-nav-item {
      flex-direction: row;
      gap: 6px;
      padding: 10px 20px;
      font-size: 13px;
      min-height: auto;
    }

    .bottom-nav-item svg {
      width: 18px;
      height: 18px;
    }

    .app-content {
      max-width: var(--app-max-width);
      margin: 0 auto;
      padding-bottom: 24px;
    }

    /* Desktop: .app-header width already set in base rules */

    /* Desktop modal instead of fullscreen */
    .fullscreen-modal {
      inset: unset;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 400px;
      max-height: 90vh;
      border-radius: var(--radius);
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.2);
      padding: 24px;
    }

    .fullscreen-modal.open {
      display: flex;
    }
  }

  /* ===== PULL TO REFRESH INDICATOR ===== */
  .ptr-indicator {
    text-align: center;
    padding: 12px;
    color: var(--gray-500);
    font-size: 13px;
    display: none;
  }

  /* ===== iOS INSTALL BANNER ===== */
  .ios-install-banner {
    background: var(--blue);
    color: white;
    padding: 12px 16px;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .ios-install-banner button {
    background: rgba(255,255,255,0.2);
    color: white;
    padding: 4px 12px;
    font-size: 12px;
    border-radius: 4px;
    white-space: nowrap;
  }
</style>
