---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activeTab?: "home" | "orders" | "me";
  showLocationBadge?: boolean;
}

import VercelAnalytics from "./VercelAnalytics.astro";

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Zepto";
const defaultDescription = "Order fresh fish from local Mumbai sellers. Pre-order tonight, pick up tomorrow morning.";
const { title = brandName, description = defaultDescription, ogImage = "/og-image.png", activeTab = "home", showLocationBadge = true } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066cc" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  </head>
  <body>
    <div class="app-shell">
      <!-- Fixed header -->
      <header class="app-header">
        <div class="app-header-top">
          <a href="/" class="app-logo">🐟 {brandName}</a>
          {showLocationBadge && (
            <button class="location-badge" id="location-badge" aria-label="Change location">
              <span id="location-text">Set location</span>
            </button>
          )}
        </div>
        <slot name="header-extra" />
      </header>

      <!-- Scrollable content area -->
      <main class="app-content" id="app-content">
        <slot />
      </main>

      <!-- Fixed bottom navigation -->
      <nav class="bottom-nav" aria-label="Main navigation">
        <a href="/" class={`bottom-nav-item ${activeTab === "home" ? "active" : ""}`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Home</span>
        </a>
        <a href="/track" class={`bottom-nav-item ${activeTab === "orders" ? "active" : ""}`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          <span>Orders</span>
        </a>
        <a href="/me" class={`bottom-nav-item ${activeTab === "me" ? "active" : ""}`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Me</span>
        </a>
      </nav>
    </div>

    <!-- Backdrop for modals/sheets -->
    <div class="backdrop" id="backdrop"></div>

    <!-- Service worker registration -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>

    <!-- Location badge hydration -->
    <script>
      const badge = document.getElementById("location-badge");
      const locationText = document.getElementById("location-text");

      function updateLocationBadge() {
        const saved = localStorage.getItem("zepto_location");
        if (saved) {
          try {
            const loc = JSON.parse(saved);
            if (locationText && loc.name) {
              locationText.textContent = loc.name;
            }
          } catch {}
        }
      }

      updateLocationBadge();

      if (badge) {
        badge.addEventListener("click", () => {
          // Dispatch custom event to open location picker
          window.dispatchEvent(new CustomEvent("open-location-picker"));
        });
      }

      // Listen for location changes
      window.addEventListener("location-updated", () => updateLocationBadge());
    </script>
    <VercelAnalytics />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  /* ===== APP SHELL ===== */
  html, body {
    height: 100%;
    overflow: hidden;
    background: var(--gray-50);
  }

  .app-shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
  }

  /* ===== HEADER ===== */
  .app-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: white;
    border-bottom: 1px solid var(--gray-200);
    padding: 0 16px;
    padding-top: env(safe-area-inset-top);
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .app-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    flex-shrink: 0;
  }

  .seller-recruit-strip {
    padding: 0 0 10px;
    border-top: 1px solid var(--gray-100);
    margin-top: 2px;
  }

  .seller-recruit-strip p {
    font-size: 12px;
    line-height: 1.45;
    color: var(--gray-700);
    margin: 0;
    padding-top: 8px;
  }

  .seller-recruit-strip a {
    font-weight: 700;
    color: var(--blue);
    text-decoration: none;
  }

  .seller-recruit-strip a:hover {
    text-decoration: underline;
  }

  .seller-recruit-strip .seller-recruit-sub {
    display: block;
    font-size: 11px;
    font-weight: 500;
    color: var(--gray-500);
    margin-top: 4px;
  }

  .app-logo {
    font-size: 18px;
    font-weight: 700;
    color: var(--gray-900);
    text-decoration: none;
    white-space: nowrap;
  }

  .app-logo:hover {
    text-decoration: none;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    background: var(--gray-50);
    border: 1px solid var(--gray-200);
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    color: var(--blue);
    cursor: pointer;
    min-height: 32px;
    transition: background 0.15s;
  }

  .location-badge::before {
    content: "\1F4CD"; /* 📍 */
  }

  .location-badge:hover {
    background: var(--gray-100);
  }

  /* ===== CONTENT ===== */
  .app-content {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0 16px calc(80px + env(safe-area-inset-bottom));
  }

  /* ===== BOTTOM NAV ===== */
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    min-height: 56px;
    background: white;
    border-top: 1px solid var(--gray-200);
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 100;
    padding-bottom: env(safe-area-inset-bottom);
    box-sizing: content-box;
  }

  .bottom-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 11px;
    font-weight: 500;
    color: var(--gray-500);
    text-decoration: none;
    padding: 6px 16px;
    min-width: 64px;
    min-height: 44px;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s;
  }

  .bottom-nav-item:hover {
    text-decoration: none;
    color: var(--blue);
  }

  .bottom-nav-item.active {
    color: var(--blue);
  }

  .bottom-nav-item svg {
    width: 22px;
    height: 22px;
  }

  /* ===== BOTTOM SHEET ===== */
  .bottom-sheet {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    border-radius: 16px 16px 0 0;
    max-height: 70vh;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    z-index: 200;
    padding: 0 16px 16px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom));
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    overflow-y: auto;
  }

  .bottom-sheet.open {
    transform: translateY(0);
  }

  .bottom-sheet-handle {
    width: 36px;
    height: 4px;
    background: var(--gray-200);
    border-radius: 2px;
    margin: 8px auto 16px;
  }

  /* ===== BACKDROP ===== */
  .backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 199;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .backdrop.visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ===== FULL-SCREEN MODAL (login on mobile) ===== */
  .fullscreen-modal {
    position: fixed;
    inset: 0;
    background: white;
    z-index: 300;
    padding: 16px;
    padding-top: calc(16px + env(safe-area-inset-top));
    display: none;
    flex-direction: column;
    overflow-y: auto;
  }

  .fullscreen-modal.open {
    display: flex;
  }

  .fullscreen-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    font-size: 24px;
    color: var(--gray-700);
    cursor: pointer;
    border-radius: 50%;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .fullscreen-modal-close:hover {
    background: var(--gray-100);
  }

  /* ===== TAP FEEDBACK ===== */
  .tap-target {
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.1s, opacity 0.1s;
  }

  .tap-target:active {
    transform: scale(0.97);
    opacity: 0.8;
  }

  /* ===== MOBILE BREAKPOINTS ===== */
  @media (max-width: 768px) {
    body {
      padding: 0;
      max-width: 100%;
    }

    .app-content {
      padding: 0 12px calc(80px + env(safe-area-inset-bottom));
    }

    .grid-2 {
      grid-template-columns: 1fr;
    }

    .card-body {
      padding: 12px;
    }

    .section-title {
      font-size: 18px;
      margin: 16px 0 8px;
    }
  }

  @media (min-width: 769px) {
    /* Desktop: bottom nav becomes horizontal top nav */
    .bottom-nav {
      position: static;
      height: auto;
      border-top: none;
      border-bottom: 1px solid var(--gray-200);
      justify-content: center;
      gap: 8px;
      padding-bottom: 0;
      max-width: 832px;
      margin: 0 auto;
    }

    .bottom-nav-item {
      flex-direction: row;
      gap: 6px;
      padding: 10px 20px;
      font-size: 13px;
      min-height: auto;
    }

    .bottom-nav-item svg {
      width: 18px;
      height: 18px;
    }

    .app-content {
      max-width: 800px;
      margin: 0 auto;
      padding-bottom: 24px;
    }

    .app-header {
      max-width: 832px;
      margin: 0 auto;
      border-bottom: 1px solid var(--gray-200);
    }

    /* Desktop modal instead of fullscreen */
    .fullscreen-modal {
      inset: unset;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 400px;
      max-height: 90vh;
      border-radius: var(--radius);
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.2);
      padding: 24px;
    }

    .fullscreen-modal.open {
      display: flex;
    }
  }

  /* ===== PULL TO REFRESH INDICATOR ===== */
  .ptr-indicator {
    text-align: center;
    padding: 12px;
    color: var(--gray-500);
    font-size: 13px;
    display: none;
  }

  /* ===== iOS INSTALL BANNER ===== */
  .ios-install-banner {
    background: var(--blue);
    color: white;
    padding: 12px 16px;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .ios-install-banner button {
    background: rgba(255,255,255,0.2);
    color: white;
    padding: 4px 12px;
    font-size: 12px;
    border-radius: 4px;
    white-space: nowrap;
  }
</style>
