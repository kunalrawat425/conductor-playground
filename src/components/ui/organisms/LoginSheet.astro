---
import BottomSheet from "./BottomSheet.astro";
import PhoneInput from "../atoms/PhoneInput.astro";
import OTPInput from "../atoms/OTPInput.astro";
import { festiveTheme } from "../../../lib/festive";
const festive = festiveTheme() === "diwali";
interface Props {
  id?: string;
  role?: "buyer" | "seller";
  redirectTo?: string;
  /** false = login wall (store page + checkout): no drag/swipe/backdrop close; only logging in closes it. */
  dismissible?: boolean;
}
const { id = "v2-login", role = "buyer", redirectTo = "/shop", dismissible = true } = Astro.props;
const title = role === "seller" ? "Seller sign in" : "Sign in";
const termsHref = role === "seller" ? "/terms#sellers" : "/terms";
const termsLabel = role === "seller" ? "Terms (incl. seller responsibilities)" : "Terms";
const SESSION_KEY = `otp_session_${role}`;
const RESEND_COOLDOWN = 30;
const MAX_ATTEMPTS = 3;
---
<!-- No ✕ (founder): back out by tapping outside, swiping down, or the phone's back button.
     dismissible={false}: none of those close it; Back just leaves the page. -->
<BottomSheet id={id} title={title} showClose={false} dismissible={dismissible}>
  <!-- Blinkit-style login (preview "Login redesign"): fish collage behind (backdrop), white panel with the logo badge. -->
  <div class:list={["lg-root", festive && "lg-diwali"]}>
    <div class="lg-badge" aria-hidden="true"><img src={festive ? "/logo-gold.png" : "/logo-white.png"} alt="" width="152" height="36" /></div>

    <!-- Step 1: phone entry -->
    <div id={`${id}-step1`}>
      <div class="lg-tag">{role === "seller" ? <>Your shop on Relifish,<br />orders straight to your phone</> : <>Fresh fish from verified sellers,<br />cleaned &amp; cut</>}</div>
      <div class="lg-sub">{festive ? "Happy Diwali · Thane & Mumbai, delivered" : "Thane & Mumbai · delivered to your door"}</div>
      <div class="lg-or">{role === "seller" ? "Seller sign in" : "Log in or sign up"}</div>
      <form id={`${id}-phone-form`} autocomplete="off">
        <PhoneInput id={`${id}-phone`} required={true} />
        <button type="submit" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full lg-cta" id={`${id}-send-otp`}>Continue</button>
        {role === "buyer" && (
          <label class="lg-wa">
            <input type="checkbox" id={`${id}-wa-optin`} />
            <span>Send me order updates and fresh-catch alerts on WhatsApp. Reply STOP anytime.</span>
          </label>
        )}
        <p class="lg-terms">By continuing, you agree to our <a href={termsHref} target="_blank">{termsLabel}</a> &amp; <a href="/privacy" target="_blank">Privacy policy</a></p>
      </form>
    </div>

    <!-- Step 2: OTP entry -->
    <div id={`${id}-step2`} style="display:none;">
      <div class="otp-head">
        <button type="button" class="otp-back" aria-label="Change number" onclick={`document.getElementById('${id}-change-phone').click()`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 5l-7 7 7 7"></path></svg>
        </button>
        <b>OTP verification</b>
      </div>
      <div class="otp-sent">Sent by SMS to <b id={`${id}-phone-display`}></b> · <button type="button" id={`${id}-change-phone`} class="otp-change">Change</button></div>
      <form id={`${id}-otp-form`} autocomplete="off">
        <OTPInput id={`${id}-otp`} length={6} autoSubmitFormId={`${id}-otp-form`} />
        <div class="otp-auto" id={`${id}-auto`} hidden><span class="otp-dot"></span>Reading the code from SMS…</div>
        <p id={`${id}-hint`} class="otp-hint"></p>
        <button type="submit" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full lg-cta" id={`${id}-verify-otp`}>Verify &amp; continue</button>
        <button type="button" class="otp-resend" id={`${id}-resend`} disabled><span id={`${id}-resend-label`}>Didn't get it? Resend SMS in <b>0:30</b></span></button>
        <a class="otp-help" href="tel:+919152207607">Need help? Call us</a>
      </form>
    </div>
  </div>
</BottomSheet>

<style is:global>
  /* Login redesign: the collage fills the screen behind the sheet (public/login-collage.jpg, rendered from the mockup). */
  .v2-sheet-backdrop:has(.lg-root) { background: linear-gradient(to bottom, rgba(15,23,42,0) 30%, rgba(15,23,42,.35) 70%), url(/login-collage.jpg) center top / cover no-repeat, var(--v2-bg-3); backdrop-filter: none; -webkit-backdrop-filter: none; }
  html[data-theme="dark"] .v2-sheet-backdrop:has(.lg-root) { background: linear-gradient(to bottom, rgba(15,23,42,.35) 20%, rgba(15,23,42,.7) 70%), url(/login-collage.jpg) center top / cover no-repeat, #0F172A; }
  .v2-sheet:has(.lg-root) { position: relative; overflow: visible; border-radius: 24px 24px 0 0; box-shadow: 0 -10px 30px rgba(0,0,0,.18); }
  .v2-sheet:has(.lg-root) .v2-sheet-head { display: none; }
  .v2-sheet:has(.lg-root) .v2-sheet-body { padding: 46px 22px max(18px, env(safe-area-inset-bottom, 0px)); text-align: center; }
  .lg-badge { position: absolute; left: 50%; top: -30px; transform: translateX(-50%); display: flex; align-items: center; justify-content: center; width: 200px; height: 60px; border-radius: 18px; background: var(--v2-brand); box-shadow: 0 10px 24px rgba(0,102,255,.30); z-index: 2; }
  .lg-diwali .lg-badge { background: linear-gradient(135deg, #B3123B, #8B0A2E); border: 2px solid #D4A24C; box-shadow: 0 10px 24px rgba(139,10,46,.35); }
  .lg-badge img { width: 152px; height: auto; }
  .lg-tag { font: 800 20px/1.25 var(--v2-font); letter-spacing: -.02em; margin: 2px 0 4px; color: var(--v2-ink); }
  .lg-sub { font: 500 13px var(--v2-font); color: var(--v2-ink-3); }
  .lg-or { display: flex; align-items: center; gap: 12px; margin: 16px 0 12px; font: 600 13px var(--v2-font); color: var(--v2-ink-3); }
  .lg-or::before, .lg-or::after { content: ""; flex: 1; height: 1px; background: var(--v2-border); }
  .lg-root .v2-field { margin: 0; }
  .lg-root .v2-field-label { display: none; }
  .lg-root .v2-input-wrap { height: 54px; border: 1.5px solid var(--v2-border); border-radius: 12px; }
  .lg-root .v2-input-wrap:focus-within { border-color: var(--v2-brand); box-shadow: 0 0 0 3px var(--v2-brand-l); }
  .lg-root .v2-input-prefix { font: 700 16px var(--v2-font); color: var(--v2-ink); background: none; border-right: 1.5px solid var(--v2-border); padding: 0 12px 0 14px; display: flex; align-items: center; }
  .lg-root .v2-input { font: 600 17px var(--v2-font); letter-spacing: .04em; }
  .lg-cta { margin-top: 12px; height: 54px; border-radius: 12px; font-size: 16px; font-weight: 800; }
  .lg-cta:disabled { background: var(--v2-bg-3); color: var(--v2-ink-4); opacity: 1; }
  .lg-wa { display: flex; gap: 10px; align-items: flex-start; text-align: left; margin-top: 12px; font: 500 12px/1.45 var(--v2-font); color: var(--v2-ink-2); cursor: pointer; }
  .lg-wa input { flex: none; width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--v2-brand); }
  .lg-terms { margin: 12px 0 0; font: 500 11px/1.5 var(--v2-font); color: var(--v2-ink-3); }
  .lg-terms a { color: var(--v2-ink-2); text-decoration: underline; }
  .otp-head { display: flex; align-items: center; justify-content: center; position: relative; margin-bottom: 6px; }
  .otp-head b { font: 800 19px var(--v2-font); color: var(--v2-ink); }
  .otp-back { position: absolute; left: 0; top: -4px; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--v2-bg-3); color: var(--v2-ink); border: 0; cursor: pointer; }
  .otp-sent { font: 500 14px/1.5 var(--v2-font); color: var(--v2-ink-3); }
  .otp-sent b { color: var(--v2-ink); font-weight: 800; }
  .otp-change { font: 700 14px var(--v2-font); color: var(--v2-link); background: none; border: 0; padding: 0; cursor: pointer; }
  .lg-root .v2-otp { justify-content: center; gap: 9px; margin: 20px 0 14px; }
  .lg-root .v2-otp-cell { width: 46px; height: 54px; border-radius: 12px; border: 1.5px solid var(--v2-border); font: 800 22px var(--v2-font); text-align: center; }
  .lg-root .v2-otp-cell:focus { border-color: var(--v2-brand); box-shadow: 0 0 0 3px var(--v2-brand-l); outline: none; }
  .otp-auto { font: 600 12px var(--v2-font); color: var(--v2-green); display: inline-flex; align-items: center; gap: 6px; }
  .otp-auto[hidden] { display: none; }
  .otp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--v2-green); box-shadow: 0 0 0 3px var(--v2-green-l); }
  .otp-hint { font: 500 12px var(--v2-font); color: var(--v2-orange); min-height: 16px; margin: 6px 0 0; }
  .otp-resend { display: block; width: 100%; margin-top: 12px; font: 500 14px var(--v2-font); color: var(--v2-ink-3); background: none; border: 0; cursor: pointer; }
  .otp-resend:not(:disabled) { color: var(--v2-link); font-weight: 700; }
  .otp-resend b { color: var(--v2-ink); }
  .otp-help { display: block; margin-top: 10px; font: 600 13px var(--v2-font); color: var(--v2-ink-2); text-decoration: underline; }
</style>

<script define:vars={{ id, role, redirectTo, dismissible, SESSION_KEY, RESEND_COOLDOWN, MAX_ATTEMPTS }}>
  let currentPhone = "";
  let otpAttempts = 0;
  let countdownTimer = null;

  function getEl(suffix) { return document.getElementById(`${id}-${suffix}`); }
  let otpSentOnce = false; // second send = resend (funnel)
  // Funnel step to our DB; queued if the tracker (FunnelTrack, end of page) hasn't loaded yet.
  const rft = (e, d) => (window.rfTrack ? window.rfTrack(e, d) : (window.rfq = window.rfq || []).push([e, d]));

  // GA: every time this login sheet opens, to measure who sees it but never enters a phone.
  document.addEventListener("v2-sheet-opened", (e) => {
    if (e.detail?.id !== id) return;
    try { if (typeof gtag === "function") gtag("event", "login_shown", { role, page: location.pathname }); } catch {}
    if (role !== "seller") rft("login_shown");
  });
  // Buyers tapped the title "Log in with your phone…" expecting it to act (Clarity dead clicks,
  // 24 Oct): a tap on the title or the step-1 text puts the cursor in the phone box.
  // Clarity still saw these as dead taps (3 Nov: 12): focus alone shows nothing, so the box also
  // scrolls into view and flashes a blue ring (founder, 5 Nov).
  const focusPhone = (e) => {
    if (e.target.closest("input,button,a,label,select,textarea")) return;
    const ph = getEl("phone"); if (!ph) return;
    ph.focus(); ph.scrollIntoView({ block: "center", behavior: "smooth" });
    ph.style.boxShadow = "0 0 0 3px var(--v2-brand)";
    setTimeout(() => { ph.style.boxShadow = ""; }, 1200);
  };
  getEl("title")?.addEventListener("click", focusPhone);
  if (getEl("title")) getEl("title").style.cursor = "pointer";
  getEl("step1")?.addEventListener("click", focusPhone);

  // Continue stays grey until a valid 10-digit Indian mobile is in (autofilled "+91 …" counts).
  const phoneEl = document.getElementById(`${id}-phone`);
  const sendBtn = getEl("send-otp");
  if (phoneEl) {
    phoneEl.placeholder = "Enter mobile number";
    const valid = () => { if (sendBtn) sendBtn.disabled = !/^[6-9]\d{9}$/.test(String(phoneEl.value).replace(/\D/g, "").slice(-10)); };
    phoneEl.addEventListener("input", valid);
    valid();
  }

  function showStep(n) {
    getEl("step1").style.display = n === 1 ? "block" : "none";
    getEl("step2").style.display = n === 2 ? "block" : "none";
    if (n === 2) {
      // auto-focus first OTP cell
      setTimeout(() => {
        document.querySelector(`#${id}-step2 .v2-otp-cell`)?.focus();
      }, 120);
    }
  }

  function saveSession(phone, sentAt) {
    try {
      sessionStorage.setItem(SESSION_KEY, JSON.stringify({ phone, sentAt }));
    } catch {}
  }
  function loadSession() {
    try { return JSON.parse(sessionStorage.getItem(SESSION_KEY) || "null"); } catch { return null; }
  }
  function clearSession() {
    try { sessionStorage.removeItem(SESSION_KEY); } catch {}
  }

  function clearOTPCells() {
    const hidden = document.getElementById(`${id}-otp`);
    if (hidden) hidden.value = "";
    document.querySelectorAll(`#${id}-step2 .v2-otp-cell`).forEach((c) => {
      c.value = "";
      c.classList.remove("v2-input-error");
    });
    getEl("hint").textContent = "";
  }

  function startCountdown(fromSeconds) {
    const btn = getEl("resend");
    const label = getEl("resend-label");
    btn.disabled = true;
    let secs = Math.max(0, Math.ceil(fromSeconds));
    if (secs <= 0) {
      btn.disabled = false;
      label.textContent = "Resend SMS";
      return;
    }
    const fmt = (n) => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, "0")}`;
    label.innerHTML = `Didn't get it? Resend SMS in <b>${fmt(secs)}</b>`;
    clearInterval(countdownTimer);
    countdownTimer = setInterval(() => {
      secs--;
      if (secs <= 0) {
        clearInterval(countdownTimer);
        btn.disabled = false;
        label.textContent = "Resend SMS";
      } else {
        label.innerHTML = `Didn't get it? Resend SMS in <b>${fmt(secs)}</b>`;
      }
    }, 1000);
  }

  function enterStep2(phone, sentAtMs) {
    currentPhone = phone;
    otpAttempts = 0;
    getEl("phone-display").textContent = phone;
    getEl("verify-otp").textContent = "Verify & continue";
    getEl("verify-otp").disabled = false;
    clearOTPCells();
    showStep(2);
    if ("OTPCredential" in window) getEl("auto")?.removeAttribute("hidden");
    const elapsed = (Date.now() - sentAtMs) / 1000;
    startCountdown(RESEND_COOLDOWN - elapsed);
  }

  // Back out without a ✕: swipe the sheet down from its top, or press the browser/phone back
  // button (opening adds a history entry; back closes the sheet instead of leaving the page).
  // Not dismissible: no history entry (Back leaves the page as normal) and no drag.
  const backdrop = document.getElementById(`${id}-backdrop`);
  const panel = dismissible ? backdrop?.querySelector(".v2-sheet") : null;
  const isOpen = () => !!backdrop?.classList.contains("v2-sheet-open");
  const closeSheet = () => window.v2CloseSheet ? window.v2CloseSheet(id) : backdrop?.classList.remove("v2-sheet-open");
  let wasOpen = false;
  if (backdrop) new MutationObserver(() => {
    const open = isOpen();
    if (open === wasOpen) return;
    wasOpen = open;
    if (open) {
      if (panel) panel.style.transform = "";
      if (dismissible) try { history.pushState({ ...(history.state || {}), rlfSheet: id }, ""); } catch {}
    } else {
      window.v2AfterLogin = null; // closed without logging in: the pending action is dropped
      if (history.state?.rlfSheet === id) history.back();
    }
  }).observe(backdrop, { attributes: true, attributeFilter: ["class"] });
  if (dismissible) window.addEventListener("popstate", () => { if (isOpen()) closeSheet(); });
  let dragY = null;
  panel?.addEventListener("touchstart", (e) => {
    // Only from the handle/title row, so typing and scrolling inside the form still work.
    dragY = e.target.closest?.(".v2-sheet-handle, .v2-sheet-head") ? e.touches[0].clientY : null;
  }, { passive: true });
  panel?.addEventListener("touchmove", (e) => {
    if (dragY == null) return;
    panel.style.transform = `translateY(${Math.max(0, e.touches[0].clientY - dragY)}px)`;
  }, { passive: true });
  panel?.addEventListener("touchend", (e) => {
    if (dragY == null) return;
    const dy = e.changedTouches[0].clientY - dragY;
    dragY = null;
    panel.style.transform = "";
    if (dy > 80) closeSheet();
  });

  // On sheet open: restore session if OTP was sent recently
  const sheet = document.getElementById(id);
  sheet?.addEventListener("v2-sheet-opened", () => {
    // Already logged in?
    try {
      const alreadyIn = role === "seller"
        ? localStorage.getItem("rlf_seller_id")
        : localStorage.getItem("rlf_buyer_id");
      if (alreadyIn) {
        window.location.href = window.v2LoginRedirect || redirectTo;
        return;
      }
    } catch {}

    const sess = loadSession();
    if (sess?.phone && sess?.sentAt) {
      const age = (Date.now() - sess.sentAt) / 1000;
      if (age < 600) {
        // OTP still potentially valid (< 10 min) — restore step 2
        const phoneInput = document.getElementById(`${id}-phone`);
        if (phoneInput) phoneInput.value = sess.phone.replace("+91", "");
        enterStep2(sess.phone, sess.sentAt);
        return;
      }
    }
    showStep(1);
  });

  // Step 1: send OTP
  getEl("phone-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const input = document.getElementById(`${id}-phone`);
    const raw = (input?.value || "").replace(/\D/g, "");
    if (raw.length !== 10) {
      window.v2Toast?.("error", "Invalid number", "Enter a 10-digit Indian mobile number");
      return;
    }
    const phone = "+91" + raw;
    const btn = getEl("send-otp");
    btn.disabled = true;
    btn.textContent = "Sending…";
    try {
      const res = await fetch("/api/auth/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to send OTP");
      try { if (typeof gtag === "function") gtag("event", "otp_sent", { role }); } catch {}
      if (role !== "seller") { rft(otpSentOnce ? "otp_resend" : "otp_sent"); otpSentOnce = true; }
      const sentAt = Date.now();
      saveSession(phone, sentAt);
      enterStep2(phone, sentAt);
    } catch (err) {
      try { if (typeof gtag === "function") gtag("event", "otp_failed", { role, step: "send" }); } catch {}
      window.v2Toast?.("error", "Failed to send OTP", err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = "Continue";
    }
  });

  // Step 2: verify OTP
  getEl("otp-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const code = document.getElementById(`${id}-otp`)?.value || "";
    if (code.length !== 6) {
      window.v2Toast?.("error", "Incomplete OTP", "Enter all 6 digits");
      return;
    }
    if (otpAttempts >= MAX_ATTEMPTS) {
      getEl("hint").textContent = "Too many attempts, tap Resend for a new code.";
      return;
    }
    const btn = getEl("verify-otp");
    btn.disabled = true;
    btn.textContent = "Verifying…";
    try {
      const res = await fetch("/api/auth/verify-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        // Unticked by default (consent must be a choice); sent only when ticked.
        body: JSON.stringify({ phone: currentPhone, code, role, whatsapp_opt_in: !!document.getElementById(`${id}-wa-optin`)?.checked }),
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        try { if (typeof gtag === "function") gtag("event", "otp_failed", { role, step: "verify" }); } catch {}
        if (role !== "seller") rft("otp_failed");
        otpAttempts++;
        const left = MAX_ATTEMPTS - otpAttempts;
        const hint = getEl("hint");
        // Plain server text only (lib/friendly-error via Toast.astro); technical text falls back to the attempts line.
        hint.textContent = (window.v2FriendlyError ? window.v2FriendlyError(data.error, "") : data.error) || (left > 0
          ? `Wrong code, ${left} ${left === 1 ? "try" : "tries"} left`
          : "No tries left, tap Resend for a new code");
        document.querySelectorAll(`#${id}-step2 .v2-otp-cell`).forEach((c) => {
          c.value = "";
          c.classList.add("v2-input-error");
        });
        document.getElementById(`${id}-otp`).value = "";
        document.querySelector(`#${id}-step2 .v2-otp-cell`)?.focus();
        btn.disabled = false;
        btn.textContent = left > 0 ? "Verify & continue" : "Resend OTP first";
        return;
      }

      // Verified
      try { if (typeof gtag === "function") { gtag("set", "user_properties", { user_type: role === "seller" ? "seller" : "buyer" }); gtag("event", "otp_verified", { role }); } } catch {}
      // Analytics: first-time account (GA4 recommended sign_up; seller_signup for the supply side).
      try { if (data.is_new && typeof gtag === "function") gtag("event", role === "seller" ? "seller_signup" : "sign_up", { method: "otp" }); } catch {}
      if (role !== "seller") rft("otp_verified", { is_new: !!data.is_new });
      clearSession();
      clearInterval(countdownTimer);

      try {
        if (role === "seller") {
          localStorage.setItem("rlf_seller_id", data.seller_id);
          localStorage.setItem("rlf_seller_phone", currentPhone);
          if (data.session) localStorage.setItem("rlf_session_seller", data.session);
        } else {
          localStorage.setItem("rlf_buyer_id", data.buyer_id);
          localStorage.setItem("rlf_phone", currentPhone);
          if (data.session) localStorage.setItem("rlf_session_buyer", data.session);
        }
      } catch {}
      try { window.relifishClarityTag && window.relifishClarityTag(); } catch {}

      if (role === "buyer" && window.RelifishCart) {
        try { await window.RelifishCart.pushLocalToServer(); } catch {}
      }

      if (role === "buyer") {
        try {
          // v2_buyer_location is never written, so this asked after every login, even with a saved
          // pin. Ask only when nothing is saved on this device (the sheet also checks the account).
          if (!window.RelifishLocation?.peek?.()) {
            localStorage.setItem("v2_prompt_location", "1");
          }
        } catch {}
      }

      btn.textContent = "Signed in";
      window.v2Toast?.("success", "Signed in", "Welcome to Relifish");
      // The page asked to finish something here (e.g. the "+" that opened login): do it, no reload.
      const after = typeof window.v2AfterLogin === "function" ? window.v2AfterLogin : null;
      if (after) {
        window.v2AfterLogin = null;
        window.v2CloseSheet?.(id);
        try { after(); } catch (err) { console.error("after-login action failed", err); }
        return;
      }
      setTimeout(() => { window.location.href = window.v2LoginRedirect || redirectTo; }, 500);
    } catch (err) {
      otpAttempts++;
      window.v2Toast?.("error", "Network error", err.message || "Try again");
      btn.disabled = false;
      btn.textContent = "Verify & continue";
    }
  });

  // Resend
  getEl("resend")?.addEventListener("click", async () => {
    if (!currentPhone) { showStep(1); return; }
    const btn = getEl("resend");
    btn.disabled = true;
    getEl("resend-label").textContent = "Sending…";
    try {
      const res = await fetch("/api/auth/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone: currentPhone }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed");
      const sentAt = Date.now();
      saveSession(currentPhone, sentAt);
      otpAttempts = 0;
      getEl("hint").textContent = "";
      getEl("verify-otp").textContent = "Verify & continue";
      getEl("verify-otp").disabled = false;
      clearOTPCells();
      startCountdown(RESEND_COOLDOWN);
      window.v2Toast?.("info", "OTP resent", "Check your SMS");
    } catch (err) {
      window.v2Toast?.("error", "Resend failed", err.message || "Try again");
      btn.disabled = false;
      getEl("resend-label").textContent = "Resend SMS";
    }
  });

  // Change number — back to step 1, clear session
  getEl("change-phone")?.addEventListener("click", () => {
    clearInterval(countdownTimer);
    clearSession();
    otpAttempts = 0;
    showStep(1);
    document.getElementById(`${id}-phone`)?.focus();
  });
</script>
