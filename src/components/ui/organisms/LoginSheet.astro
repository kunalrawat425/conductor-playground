---
import BottomSheet from "./BottomSheet.astro";
import PhoneInput from "../atoms/PhoneInput.astro";
import OTPInput from "../atoms/OTPInput.astro";
interface Props {
  id?: string;
  role?: "buyer" | "seller";
  redirectTo?: string;
}
const { id = "v2-login", role = "buyer", redirectTo = "/v2" } = Astro.props;
const title = role === "seller" ? "Seller sign in" : "Sign in";
const SESSION_KEY = `otp_session_${role}`;
const RESEND_COOLDOWN = 30;
const MAX_ATTEMPTS = 3;
---
<BottomSheet id={id} title={title} showClose={true}>
  <!-- Step 1: phone entry -->
  <div id={`${id}-step1`}>
    <p style="font:400 13px Inter;color:var(--v2-ink-2);margin:0 0 16px;line-height:1.5;">
      Enter your mobile number. We'll send a one-time code — no password needed.
    </p>
    <form id={`${id}-phone-form`} autocomplete="off">
      <PhoneInput id={`${id}-phone`} required={true} />
      <button type="submit" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full" id={`${id}-send-otp`}>
        Send OTP
      </button>
    </form>
  </div>

  <!-- Step 2: OTP entry -->
  <div id={`${id}-step2`} style="display:none;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
      <span style="font:600 14px Inter;color:var(--v2-ink);" id={`${id}-phone-display`}></span>
      <button type="button" id={`${id}-change-phone`}
        style="font:400 12px Inter;color:var(--v2-ink-3);background:none;border:none;cursor:pointer;padding:0;text-decoration:underline;">
        Change
      </button>
    </div>
    <p style="font:400 12px Inter;color:var(--v2-ink-3);margin:0 0 16px;line-height:1.5;">
      6-digit code sent via SMS · expires in 10 min
    </p>
    <form id={`${id}-otp-form`} autocomplete="off">
      <OTPInput id={`${id}-otp`} length={6} autoSubmitFormId={`${id}-otp-form`} />
      <!-- inline error/hint row -->
      <p id={`${id}-hint`}
        style="font:400 12px Inter;color:var(--v2-orange);min-height:16px;margin:6px 0 0;text-align:center;"></p>
      <button type="submit" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full" id={`${id}-verify-otp`}
        style="margin-top:10px;">
        Verify &amp; continue
      </button>
      <!-- resend: disabled with countdown, enabled when ready -->
      <button type="button" class="v2-btn v2-btn-ghost v2-btn-sm v2-btn-full" id={`${id}-resend`}
        style="margin-top:8px;" disabled>
        <span id={`${id}-resend-label`}>Resend code (30s)</span>
      </button>
    </form>
  </div>
</BottomSheet>

<script define:vars={{ id, role, redirectTo, SESSION_KEY, RESEND_COOLDOWN, MAX_ATTEMPTS }}>
  let currentPhone = "";
  let otpAttempts = 0;
  let countdownTimer = null;

  function getEl(suffix) { return document.getElementById(`${id}-${suffix}`); }

  function showStep(n) {
    getEl("step1").style.display = n === 1 ? "block" : "none";
    getEl("step2").style.display = n === 2 ? "block" : "none";
    if (n === 2) {
      // auto-focus first OTP cell
      setTimeout(() => {
        document.querySelector(`#${id}-step2 .v2-otp-cell`)?.focus();
      }, 120);
    }
  }

  function saveSession(phone, sentAt) {
    try {
      sessionStorage.setItem(SESSION_KEY, JSON.stringify({ phone, sentAt }));
    } catch {}
  }
  function loadSession() {
    try { return JSON.parse(sessionStorage.getItem(SESSION_KEY) || "null"); } catch { return null; }
  }
  function clearSession() {
    try { sessionStorage.removeItem(SESSION_KEY); } catch {}
  }

  function clearOTPCells() {
    const hidden = document.getElementById(`${id}-otp`);
    if (hidden) hidden.value = "";
    document.querySelectorAll(`#${id}-step2 .v2-otp-cell`).forEach((c) => {
      c.value = "";
      c.classList.remove("v2-input-error");
    });
    getEl("hint").textContent = "";
  }

  function startCountdown(fromSeconds) {
    const btn = getEl("resend");
    const label = getEl("resend-label");
    btn.disabled = true;
    let secs = Math.max(0, Math.ceil(fromSeconds));
    if (secs <= 0) {
      btn.disabled = false;
      label.textContent = "Resend code";
      return;
    }
    label.textContent = `Resend code (${secs}s)`;
    clearInterval(countdownTimer);
    countdownTimer = setInterval(() => {
      secs--;
      if (secs <= 0) {
        clearInterval(countdownTimer);
        btn.disabled = false;
        label.textContent = "Resend code";
      } else {
        label.textContent = `Resend code (${secs}s)`;
      }
    }, 1000);
  }

  function enterStep2(phone, sentAtMs) {
    currentPhone = phone;
    otpAttempts = 0;
    getEl("phone-display").textContent = phone;
    getEl("verify-otp").textContent = "Verify & continue";
    getEl("verify-otp").disabled = false;
    clearOTPCells();
    showStep(2);
    const elapsed = (Date.now() - sentAtMs) / 1000;
    startCountdown(RESEND_COOLDOWN - elapsed);
  }

  // On sheet open: restore session if OTP was sent recently
  const sheet = document.getElementById(id);
  sheet?.addEventListener("v2-sheet-opened", () => {
    // Already logged in?
    try {
      const alreadyIn = role === "seller"
        ? localStorage.getItem("rlf_seller_id")
        : localStorage.getItem("rlf_buyer_id");
      if (alreadyIn) {
        window.location.href = redirectTo;
        return;
      }
    } catch {}

    const sess = loadSession();
    if (sess?.phone && sess?.sentAt) {
      const age = (Date.now() - sess.sentAt) / 1000;
      if (age < 600) {
        // OTP still potentially valid (< 10 min) — restore step 2
        const phoneInput = document.getElementById(`${id}-phone`);
        if (phoneInput) phoneInput.value = sess.phone.replace("+91", "");
        enterStep2(sess.phone, sess.sentAt);
        return;
      }
    }
    showStep(1);
  });

  // Step 1: send OTP
  getEl("phone-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const input = document.getElementById(`${id}-phone`);
    const raw = (input?.value || "").replace(/\D/g, "");
    if (raw.length !== 10) {
      window.v2Toast?.("error", "Invalid number", "Enter a 10-digit Indian mobile number");
      return;
    }
    const phone = "+91" + raw;
    const btn = getEl("send-otp");
    btn.disabled = true;
    btn.textContent = "Sending…";
    try {
      const res = await fetch("/api/auth/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to send OTP");
      const sentAt = Date.now();
      saveSession(phone, sentAt);
      enterStep2(phone, sentAt);
    } catch (err) {
      window.v2Toast?.("error", "Failed to send OTP", err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = "Send OTP";
    }
  });

  // Step 2: verify OTP
  getEl("otp-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const code = document.getElementById(`${id}-otp`)?.value || "";
    if (code.length !== 6) {
      window.v2Toast?.("error", "Incomplete OTP", "Enter all 6 digits");
      return;
    }
    if (otpAttempts >= MAX_ATTEMPTS) {
      getEl("hint").textContent = "Too many attempts — tap Resend for a new code.";
      return;
    }
    const btn = getEl("verify-otp");
    btn.disabled = true;
    btn.textContent = "Verifying…";
    try {
      const res = await fetch("/api/auth/verify-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone: currentPhone, code, role }),
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        otpAttempts++;
        const left = MAX_ATTEMPTS - otpAttempts;
        const hint = getEl("hint");
        hint.textContent = data.error || (left > 0
          ? `Wrong code — ${left} ${left === 1 ? "try" : "tries"} left`
          : "No tries left — tap Resend for a new code");
        document.querySelectorAll(`#${id}-step2 .v2-otp-cell`).forEach((c) => {
          c.value = "";
          c.classList.add("v2-input-error");
        });
        document.getElementById(`${id}-otp`).value = "";
        document.querySelector(`#${id}-step2 .v2-otp-cell`)?.focus();
        btn.disabled = false;
        btn.textContent = left > 0 ? "Try again" : "Resend OTP first";
        return;
      }

      // Verified
      clearSession();
      clearInterval(countdownTimer);

      try {
        if (role === "seller") {
          localStorage.setItem("rlf_seller_id", data.seller_id);
          localStorage.setItem("rlf_seller_phone", currentPhone);
          if (data.seller_token) localStorage.setItem("rlf_seller_token", data.seller_token);
        } else {
          localStorage.setItem("rlf_buyer_id", data.buyer_id);
          localStorage.setItem("rlf_phone", currentPhone);
          if (data.buyer_token) localStorage.setItem("rlf_buyer_token", data.buyer_token);
        }
      } catch {}

      if (role === "buyer" && window.RelifishCart) {
        try { await window.RelifishCart.pushLocalToServer(); } catch {}
      }

      if (role === "buyer") {
        try {
          if (!localStorage.getItem("v2_buyer_location")) {
            localStorage.setItem("v2_prompt_location", "1");
          }
        } catch {}
      }

      btn.textContent = "✓ Signed in!";
      window.v2Toast?.("success", "Signed in", "Welcome to Relifish");
      setTimeout(() => { window.location.href = redirectTo; }, 500);
    } catch (err) {
      otpAttempts++;
      window.v2Toast?.("error", "Network error", err.message || "Try again");
      btn.disabled = false;
      btn.textContent = "Try again";
    }
  });

  // Resend
  getEl("resend")?.addEventListener("click", async () => {
    if (!currentPhone) { showStep(1); return; }
    const btn = getEl("resend");
    btn.disabled = true;
    getEl("resend-label").textContent = "Sending…";
    try {
      const res = await fetch("/api/auth/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone: currentPhone }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed");
      const sentAt = Date.now();
      saveSession(currentPhone, sentAt);
      otpAttempts = 0;
      getEl("hint").textContent = "";
      getEl("verify-otp").textContent = "Verify & continue";
      getEl("verify-otp").disabled = false;
      clearOTPCells();
      startCountdown(RESEND_COOLDOWN);
      window.v2Toast?.("info", "OTP resent", "Check your SMS");
    } catch (err) {
      window.v2Toast?.("error", "Resend failed", err.message || "Try again");
      btn.disabled = false;
      getEl("resend-label").textContent = "Resend code";
    }
  });

  // Change number — back to step 1, clear session
  getEl("change-phone")?.addEventListener("click", () => {
    clearInterval(countdownTimer);
    clearSession();
    otpAttempts = 0;
    showStep(1);
    document.getElementById(`${id}-phone`)?.focus();
  });
</script>
