---
import type { BottomNavProps } from "../../../types/components";
interface Props extends BottomNavProps {}
const { active, ordersCount = 0, mode = "buyer" } = Astro.props;

const buyerItems = [
  { id: "home", label: "Home", icon: "🏠", href: "/shop" },
  { id: "orders", label: "Orders", icon: "📋", href: "/track" },
  { id: "account", label: "Account", icon: "👤", href: "/me" },
];

const sellerItems = [
  { id: "orders", label: "Orders", icon: "📋", href: "/dashboard/orders" },
  { id: "listings", label: "Inventory", icon: "📦", href: "/dashboard/listings" },
  { id: "account", label: "Profile", icon: "👤", href: "/dashboard/profile" },
];

const items = mode === "seller" ? sellerItems : buyerItems;
---
<nav class="v2-bottom-nav" role="navigation" aria-label="Main navigation">
  {items.map((item) => (
    <a
      href={item.href}
      class:list={["v2-nav-item", active === item.id && "v2-nav-active"]}
      aria-current={active === item.id ? "page" : undefined}
    >
      <span class="v2-nav-icon" aria-hidden="true">{item.icon}</span>
      <span class="v2-nav-label">{item.label}</span>
      {item.id === "orders" && ordersCount > 0 && (
        <span class="v2-nav-badge">{ordersCount}</span>
      )}
    </a>
  ))}
</nav>

<!-- All styles in s../styles/components.css -->
<script>
  // Seller logged in on a buyer page → swap account link to dashboard/profile
  try {
    if (localStorage.getItem("rlf_seller_id")) {
      const accountLink = document.querySelector('.v2-nav-item[href="/me"]') as HTMLAnchorElement | null;
      if (accountLink) accountLink.href = "/dashboard/profile";
    }
  } catch {}
</script>
