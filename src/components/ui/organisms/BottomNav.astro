---
import type { BottomNavProps } from "../../../types/components";
interface Props extends BottomNavProps {}
const { active, ordersCount = 0, mode = "buyer" } = Astro.props;

// Outline + filled pair per icon
const SVG_HOME_OUT = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`;
const SVG_HOME_FILL = `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M10.707 2.293a1 1 0 0 0-1.414 0l-7 7A1 1 0 0 0 3 11h1v9a1 1 0 0 0 1 1h5v-5h4v5h5a1 1 0 0 0 1-1v-9h1a1 1 0 0 0 .707-1.707l-11-11z"/></svg>`;

const SVG_ORDERS_OUT = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="15" y2="16"/></svg>`;
const SVG_ORDERS_FILL = `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M9 2a3 3 0 0 0-3 3H5a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3h-1a3 3 0 0 0-3-3H9zm0 2h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1zM8 12h8a1 1 0 0 1 0 2H8a1 1 0 0 1 0-2zm0 4h6a1 1 0 0 1 0 2H8a1 1 0 0 1 0-2z"/></svg>`;

const SVG_ACCOUNT_OUT = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`;
const SVG_ACCOUNT_FILL = `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm-7 9a7 7 0 0 1 14 0H5z"/></svg>`;

const SVG_INVENTORY_OUT = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`;
const SVG_INVENTORY_FILL = `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="none"><rect x="1" y="2" width="22" height="15" rx="3"/><path d="M7 21h10M12 17v4"/></svg>`;

const buyerItems = [
  { id: "home",    label: "Home",    svgOut: SVG_HOME_OUT,      svgFill: SVG_HOME_FILL,      href: "/shop" },
  { id: "orders",  label: "Orders",  svgOut: SVG_ORDERS_OUT,    svgFill: SVG_ORDERS_FILL,    href: "/track" },
  { id: "account", label: "Account", svgOut: SVG_ACCOUNT_OUT,   svgFill: SVG_ACCOUNT_FILL,   href: "/me" },
];

const sellerItems = [
  { id: "orders",   label: "Orders",    svgOut: SVG_ORDERS_OUT,    svgFill: SVG_ORDERS_FILL,    href: "/dashboard/orders" },
  { id: "listings", label: "Inventory", svgOut: SVG_INVENTORY_OUT, svgFill: SVG_INVENTORY_FILL, href: "/dashboard/listings" },
  { id: "account",  label: "Profile",   svgOut: SVG_ACCOUNT_OUT,   svgFill: SVG_ACCOUNT_FILL,   href: "/dashboard/profile" },
];

const items = mode === "seller" ? sellerItems : buyerItems;
---
<nav class="v2-bottom-nav" role="navigation" aria-label="Main navigation">
  {items.map((item) => {
    const isActive = active === item.id;
    return (
      <a
        href={item.href}
        class:list={["v2-nav-item", isActive && "v2-nav-active"]}
        aria-current={isActive ? "page" : undefined}
      >
        <span class="v2-nav-icon-wrap">
          <span class="v2-nav-icon" aria-hidden="true" set:html={isActive ? item.svgFill : item.svgOut} />
        </span>
        <span class="v2-nav-label">{item.label}</span>
        {item.id === "orders" && ordersCount > 0 && (
          <span class="v2-nav-badge">{ordersCount}</span>
        )}
      </a>
    );
  })}
</nav>

<style>
  .v2-nav-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 28px;
    border-radius: 14px;
    transition: background var(--v2-dur-fast) var(--v2-ease);
  }
  .v2-nav-active .v2-nav-icon-wrap {
    background: var(--v2-brand-l);
  }
  .v2-nav-item::before { display: none; }
</style>

<script>
  try {
    if (localStorage.getItem("rlf_seller_id")) {
      const accountLink = document.querySelector('.v2-nav-item[href="/me"]') as HTMLAnchorElement | null;
      if (accountLink) accountLink.href = "/dashboard/profile";
    }
  } catch {}
</script>
