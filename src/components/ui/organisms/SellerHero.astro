---
import type { SellerHeroProps } from "../../../types/components";
interface Props extends SellerHeroProps {}
const {
  name,
  location,
  distanceKm,
  deliveryEtaMin,
  rating,
  status,
  closesAt: closesAtRaw,
  opensAt: opensAtRaw,
  totalOrders,
  itemCount,
  catchTime,
  tags = [],
  phone,
  storeImageUrl,
} = Astro.props;

function fmtTime(t: string | undefined | null): string {
  if (!t) return "";
  const [h, m] = String(t).split(":").map(Number);
  if (Number.isNaN(h)) return String(t).slice(0, 5);
  const period = h >= 12 ? "PM" : "AM";
  const h12 = h === 0 ? 12 : h > 12 ? h - 12 : h;
  return m && m > 0 ? `${h12}:${String(m).padStart(2,"0")} ${period}` : `${h12} ${period}`;
}
const opensAt = fmtTime(opensAtRaw) || "5 AM";
const closesAt = fmtTime(closesAtRaw) || "11 AM";

const subParts = [
  location,
  distanceKm != null ? `${distanceKm.toFixed(1)} km` : null,
  deliveryEtaMin != null ? `${deliveryEtaMin} min delivery` : null,
].filter(Boolean).join(" · ");
---
<section class="v2-sh-hero">
  {storeImageUrl && (
    <div style="position:relative;margin:-16px -16px 0 -16px;height:160px;overflow:hidden;">
      <img src={storeImageUrl} alt={name} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
      <div style="position:absolute;inset:0;background:linear-gradient(to bottom,transparent 30%,var(--v2-bg-2,#f8fafc) 100%);"></div>
    </div>
  )}
  <a href="/shop" class="v2-sh-back" aria-label="Back to sellers">← Back</a>

  <div class="v2-sh-top">
    <div class="v2-sh-avatar" aria-hidden="true">
      {storeImageUrl
        ? <img src={storeImageUrl} alt={name} style="width:100%;height:100%;object-fit:cover;border-radius:14px;" loading="lazy" />
        : <span style="font-size:40px;line-height:1;">🐟</span>}
    </div>
    <div class="v2-sh-info">
      <h1 class="v2-sh-name">{name}</h1>
      {subParts && <div class="v2-sh-sub">{subParts}</div>}
    </div>
    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
      {rating > 0 && (
        <span class="v2-badge v2-badge-rating v2-badge-green v2-badge-size-md">{rating.toFixed(1)} ★</span>
      )}
      {phone && status === "open" && (
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:3px;">
          <a href={`tel:${phone}`} aria-label="Call seller" style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--v2-green);color:#fff;text-decoration:none;box-shadow:var(--v2-shadow-sm);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </a>
          <span class="v2-badge v2-badge-tag v2-badge-green v2-badge-size-md" style="text-align:right;line-height:1.4;white-space:normal;max-width:80px;">
            For enquiries {opensAt}–{closesAt}
          </span>
        </div>
      )}
      {phone && status === "closed" && (
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;">
          <span aria-label="Call unavailable" style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--v2-bg-3);color:var(--v2-ink-4);cursor:not-allowed;box-shadow:var(--v2-shadow-sm);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </span>
          <span class="v2-badge v2-badge-tag v2-badge-size-md" style="text-align:right;line-height:1.4;white-space:normal;max-width:80px;">
            Call {opensAt}–{closesAt}
          </span>
        </div>
      )}
    </div>
  </div>

  {tags.length > 0 && (
    <div class="v2-sh-tags">
      {tags.map((t) => (
        <span class="v2-badge v2-badge-tag v2-badge-size-md">{t}</span>
      ))}
    </div>
  )}

  <div class="v2-sh-stats">
    {totalOrders != null && (
      <div class="v2-sh-stat">
        <div class="v2-sh-v">{totalOrders}</div>
        <div class="v2-sh-l">Orders</div>
      </div>
    )}
    {itemCount != null && (
      <div class="v2-sh-stat">
        <div class="v2-sh-v">{itemCount}</div>
        <div class="v2-sh-l">Items</div>
      </div>
    )}
    {catchTime && (
      <div class="v2-sh-stat">
        <div class="v2-sh-v">{catchTime}</div>
        <div class="v2-sh-l">Catch</div>
      </div>
    )}
    <div class="v2-sh-stat">
      <div class:list={["v2-sh-v", status === "open" && "v2-sh-live"]}>
        {status === "open" ? "Open" : "Closed"}
      </div>
      <div class="v2-sh-l">{status === "open" ? `Until ${closesAt}` : `Opens ${opensAt}`}</div>
    </div>
  </div>

</section>

<!-- styles in s../styles/components.css -->
