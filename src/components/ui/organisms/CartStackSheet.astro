---
import BottomSheet from "./BottomSheet.astro";
interface Props {
  id?: string;
}
const { id = "v2-cart-stack" } = Astro.props;
---
<BottomSheet id={id} title="Your Carts" showClose={true}>
  <div id={`${id}-body`}>
    <div style="text-align:center;padding:16px;color:var(--v2-ink-3);font:500 12px Inter;">
      <span class="v2-spinner v2-spinner-md"></span>
      <div style="margin-top:8px;">Loading carts…</div>
    </div>
  </div>
</BottomSheet>

<style is:global>
  .v2-cs-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--v2-border);
  }
  .v2-cs-row:last-child { border-bottom: none; }
  .v2-cs-avatar {
    width: 44px; height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--v2-brand-l), #DBEAFE);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    overflow: hidden;
  }
  .v2-cs-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .v2-cs-info { flex: 1; min-width: 0; }
  .v2-cs-seller { font: 700 14px Inter; color: var(--v2-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .v2-cs-meta { font: 400 11px Inter; color: var(--v2-ink-3); margin-top: 2px; }
  .v2-cs-meta a { color: var(--v2-brand); text-decoration: none; font-weight: 600; }
  .v2-cs-price-badge {
    background: var(--v2-brand);
    color: #fff;
    font: 800 13px Inter;
    padding: 6px 12px;
    border-radius: var(--v2-radius-sm);
    white-space: nowrap;
    text-align: center;
    flex-shrink: 0;
    cursor: pointer;
    border: none;
  }
  .v2-cs-price-label {
    display: block;
    font: 600 9px Inter;
    opacity: .85;
    margin-top: 1px;
  }
  .v2-cs-del {
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    background: none;
    border: none;
    color: var(--v2-ink-4);
    font-size: 18px;
    cursor: pointer;
    flex-shrink: 0;
    border-radius: 50%;
    transition: background var(--v2-dur-fast) var(--v2-ease), color var(--v2-dur-fast) var(--v2-ease);
  }
  .v2-cs-del:hover { background: var(--v2-red-l); color: var(--v2-red); }
  .v2-cs-empty {
    text-align: center;
    padding: 24px;
    color: var(--v2-ink-3);
    font: 500 13px Inter;
  }
</style>

<script define:vars={{ id }}>
  function escape(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  }

  function sellerImageForGroup(g) {
    if (g.seller_image_url) return g.seller_image_url;
    // Shop page seller grid data
    const allGroups = window.__v2allGroups;
    if (Array.isArray(allGroups)) {
      const match = allGroups.find((row) => row?.seller?.id === g.seller_id);
      if (match?.seller?.store_image_url) return match.seller.store_image_url;
    }
    // Current seller page fresh DB value (covers stale localStorage)
    const pageData = window.__sellerPageData;
    if (pageData?.id === g.seller_id && pageData?.imageUrl) return pageData.imageUrl;
    return null;
  }

  function avatarHtml(g) {
    const img = sellerImageForGroup(g);
    const alt = escape(g.seller_name || "Seller");
    if (img) {
      return `<div class="v2-cs-avatar"><img src="${escape(img)}" alt="${alt}" loading="lazy" /></div>`;
    }
    return `<div class="v2-cs-avatar" aria-hidden="true">🐟</div>`;
  }

  function render() {
    const body = document.getElementById(`${id}-body`);
    const header = document.getElementById(`${id}-header`);
    if (!body) return;
    const Cart = window.RelifishCart;
    if (!Cart) {
      body.innerHTML = `<div class="v2-cs-empty">Cart not ready — try again.</div>`;
      if (header) header.style.display = "none";
      return;
    }
    const groups = Cart.groupBySeller();
    if (groups.length === 0) {
      if (header) header.style.display = "none";
      window.v2CloseSheet?.(id);
      return;
    }

    if (header) header.style.display = "block";

    body.innerHTML = groups.map((g) => {
      const itemCount = g.items.length;
      const itemLabel = `${itemCount} item${itemCount !== 1 ? "s" : ""}`;
      
      const itemsHtml = g.items.map(item => {
        const itemKey = item.pricing_option_id && item.pricing_option_id !== "default" ? item.listing_id + ":" + item.pricing_option_id : item.listing_id;
        let qtyDisplay = `${Math.round(item.qty * 100) / 100} ${escape(item.pricing_label || item.qty_unit)}`;
        if ((item.qty_unit || "").toLowerCase() === "kg" && item.qty > 0 && item.qty < 1) {
          qtyDisplay = `${Math.round(item.qty * 1000)} grams`;
        }
        return `<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--v2-bg-3);margin-left:56px;">
          <div style="flex:1;">
            <div style="font:600 13px Inter;color:var(--v2-ink);">${escape(item.name)}</div>
            <div style="font:500 11px Inter;color:var(--v2-ink-3);">${qtyDisplay} · ₹${Math.round(item.qty * item.price).toLocaleString("en-IN")}</div>
          </div>
          <button class="v2-cs-remove-item" data-item-key="${escape(itemKey)}" style="background:none;border:1px solid var(--v2-border);border-radius:4px;color:var(--v2-ink-3);font:500 11px Inter;padding:4px 8px;cursor:pointer;">Remove</button>
        </div>`;
      }).join("");

      return `<div style="margin-bottom:16px;background:var(--v2-bg);border:1px solid var(--v2-border);border-radius:12px;padding:8px 12px;">
        <div class="v2-cs-row" data-seller-id="${escape(g.seller_id)}" style="border-bottom:none;padding-bottom:4px;padding-top:4px;">
          ${avatarHtml(g)}
          <div class="v2-cs-info">
            <div class="v2-cs-seller">${escape(g.seller_name || "Seller")}</div>
            <div class="v2-cs-meta">${itemLabel} · <a href="/s/${(g.seller_name||"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"")}">View Menu ›</a></div>
          </div>
          <button class="v2-cs-price-badge" data-cs-checkout="${escape(g.seller_id)}" style="padding:6px 16px;">
            ₹${g.subtotal.toLocaleString("en-IN")}
            <span class="v2-cs-price-label">Checkout</span>
          </button>
          <button class="v2-cs-del" data-cs-remove="${escape(g.seller_id)}" aria-label="Remove seller cart" title="Remove seller">✕</button>
        </div>
        <div style="padding-bottom:4px;">
          ${itemsHtml}
        </div>
      </div>`;
    }).join("");

    // Checkout per seller
    body.querySelectorAll("[data-cs-checkout]").forEach((b) => {
      b.addEventListener("click", () => {
        const sellerId = b.getAttribute("data-cs-checkout");
        window.v2CloseSheet?.(id);
        document.dispatchEvent(new CustomEvent("v2-cs-checkout", { detail: { sellerId } }));
      });
    });

    // Remove per seller
    body.querySelectorAll("[data-cs-remove]").forEach((b) => {
      b.addEventListener("click", () => {
        const sellerId = b.getAttribute("data-cs-remove");
        window.RelifishCart?.clearCart({ sellerId });
        render();
        window.v2Toast?.("success", "Cart removed");
      });
    });

    // Remove individual item
    body.querySelectorAll(".v2-cs-remove-item").forEach((b) => {
      b.addEventListener("click", () => {
        const itemKey = b.getAttribute("data-item-key");
        window.RelifishCart?.removeItem(itemKey);
        render();
      });
    });
  }

  // Clear all
  document.getElementById(`${id}-clear-all`)?.addEventListener("click", () => {
    const Cart = window.RelifishCart;
    if (!Cart) return;
    const groups = Cart.groupBySeller();
    if (groups.length === 0) return;
    groups.forEach(g => Cart.clearCart({ sellerId: g.seller_id }));
    render();
    window.v2Toast?.("success", "All carts cleared");
  });

  // Re-render when cart changes
  window.addEventListener("v2-cart-changed", () => {
    if (document.getElementById(`${id}-backdrop`)?.classList.contains("v2-sheet-open")) render();
  });

  // Render when sheet opens
  document.addEventListener("v2-sheet-opened", async (e) => {
    if (e.detail?.id === id) {
      if (window.RelifishCart && typeof window.RelifishCart.validateCartLive === "function") {
        const { oosMessages, priceChangedCount } = await window.RelifishCart.validateCartLive();
        if (oosMessages.length > 0 || priceChangedCount > 0) {
          let msg = [];
          if (oosMessages.length) msg.push(oosMessages.join("\\n"));
          if (priceChangedCount) msg.push(`Prices updated for ${priceChangedCount} item(s)`);
          window.v2Toast?.("info", "Cart updated", msg.join(" · "));
        }
      }
      render();
    }
  });

  if (document.getElementById(`${id}-backdrop`)?.classList.contains("v2-sheet-open")) render();
</script>
