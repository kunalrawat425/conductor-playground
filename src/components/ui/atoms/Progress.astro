---
interface Props {
  value?: number; // 0-100
  indeterminate?: boolean;
  color?: "brand" | "green" | "orange";
  height?: number;
}
const { value = 0, indeterminate = false, color = "brand", height = 6 } = Astro.props;
const pct = Math.max(0, Math.min(100, value));
---
<div
  class:list={["v2-progress", `v2-progress-${color}`]}
  style={`height:${height}px;`}
  role="progressbar"
  aria-valuenow={indeterminate ? undefined : pct}
  aria-valuemin={0}
  aria-valuemax={100}
>
  <div
    class={indeterminate ? "v2-progress-indeterminate" : "v2-progress-fill"}
    style={!indeterminate ? `width:${pct}%;` : undefined}
  ></div>
</div>
