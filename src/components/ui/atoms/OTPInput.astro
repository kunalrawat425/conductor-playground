---
interface Props {
  id?: string;
  length?: number;
  error?: string;
  helper?: string;
  autoSubmitFormId?: string;
}
const { id = "otp", length = 6, error, helper, autoSubmitFormId } = Astro.props;
---
<div class="v2-field">
  <div class="v2-otp" data-otp-id={id} data-length={length} data-form-id={autoSubmitFormId || ""}>
    {Array.from({ length }).map((_, i) => (
      <input
        type="text"
        inputmode="numeric"
        pattern="[0-9]"
        maxlength={i === 0 ? length : 1}
        autocomplete={i === 0 ? "one-time-code" : "off"}
        class:list={["v2-otp-cell", error && "v2-input-error"]}
        aria-label={`OTP digit ${i + 1}`}
        data-index={i}
      />
    ))}
  </div>
  <input type="hidden" id={id} name={id} value="" />
  {(error || helper) && (
    <div class:list={["v2-field-helper", error && "v2-helper-error"]}>
      {error || helper}
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLDivElement>(".v2-otp").forEach((wrap) => {
    const cells = wrap.querySelectorAll<HTMLInputElement>(".v2-otp-cell");
    const hidden = document.getElementById(wrap.dataset.otpId!) as HTMLInputElement | null;
    const formId = wrap.dataset.formId;
    const len = cells.length;

    function syncHidden() {
      if (!hidden) return;
      hidden.value = Array.from(cells).map((c) => c.value).join("");
      if (hidden.value.length === len && formId) {
        const form = document.getElementById(formId) as HTMLFormElement | null;
        form?.requestSubmit();
      }
    }

    // Several digits at once (keyboard SMS autofill, WebOTP, paste): spread them over the cells from `from`.
    function fill(text: string, from = 0) {
      const d = text.replace(/\D/g, "").slice(0, len - from);
      d.split("").forEach((ch, i) => { if (cells[from + i]) cells[from + i].value = ch; });
      cells[Math.min(from + d.length, len - 1)]?.focus();
      syncHidden();
    }
    // WebOTP (Android Chrome): reads the code from the SMS when it ends with "@www.relifish.com #123456".
    let asked = false;
    cells[0]?.addEventListener("focus", () => {
      if (asked || !("OTPCredential" in window)) return;
      asked = true;
      (navigator.credentials as any).get({ otp: { transport: ["sms"] } }).then((c: any) => c?.code && fill(c.code)).catch(() => {});
    });

    cells.forEach((cell, idx) => {
      cell.addEventListener("input", (e) => {
        const raw = cell.value.replace(/\D/g, "");
        if (raw.length > 1) { fill(raw, idx); return; }
        cell.value = raw;
        if (raw && idx < len - 1) cells[idx + 1].focus();
        syncHidden();
      });
      cell.addEventListener("keydown", (e) => {
        if (e.key === "Backspace" && !cell.value && idx > 0) {
          cells[idx - 1].focus();
        }
        if (e.key === "ArrowLeft" && idx > 0) cells[idx - 1].focus();
        if (e.key === "ArrowRight" && idx < len - 1) cells[idx + 1].focus();
      });
      cell.addEventListener("paste", (e) => {
        e.preventDefault();
        fill(e.clipboardData?.getData("text") || "");
      });
    });
  });
</script>
