---
interface Props {
  width?: string;
  height?: string;
  radius?: string;
  shape?: 'card' | 'line' | 'circle';
}
const { width = "100%", height = "16px", radius = "6px", shape = "line" } = Astro.props;
const styleStr = shape === 'circle'
  ? `width:${width};height:${width};border-radius:50%;`
  : `width:${width};height:${height};border-radius:${shape === 'card' ? '12px' : radius};`;
---
<div class="v2-skeleton" style={styleStr} aria-hidden="true"></div>

