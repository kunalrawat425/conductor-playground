---
import type { CategoryStripItem } from "../../../types/components";
interface Props {
  items: CategoryStripItem[];
  paramKey?: string;
}
const { items, paramKey = "cat" } = Astro.props;
---
<div class="v2-cat-strip" role="tablist">
  {items.map((item) => {
    const url = item.id === "all" ? "/shop" : `/shop?${paramKey}=${item.id}`;
    return (
      <a
        href={url}
        class:list={["v2-cat-item", item.active && "v2-cat-active"]}
        role="tab"
        aria-selected={item.active}
      >
        <div class="v2-cat-tile">
          {item.photo ? <img src={item.photo} alt="" width="64" height="64" decoding="async" /> : <span aria-hidden="true">{item.emoji}</span>}
        </div>
        <div class="v2-cat-name">{item.name}</div>
      </a>
    );
  })}
</div>

<!-- styles in s../styles/components.css -->
