---
/**
 * Real buyer ratings (from delivered, non-test orders). Renders nothing until
 * at least one exists — no placeholder or sample reviews, ever.
 * Buyer name / phone are never shown (the summary does not carry them).
 * Shows the latest 3. With `allHref` (a seller's store page), more than 3 ratings link to the
 * full reviews page; without it (area pages) the other loaded ones sit behind a toggle.
 */
import type { ReviewSummary } from "../../../lib/server/seller-reviews";
import ReviewCard from "./ReviewCard.astro";
import ReviewSummaryCard from "./ReviewSummaryCard.astro";

interface Props { summary: ReviewSummary; title: string; sellerNames?: Record<string, string>; allHref?: string }
const { summary, title, sellerNames = {}, allHref } = Astro.props;
const VISIBLE = 3;
const shown = summary.reviews.slice(0, VISIBLE);
const more = allHref ? [] : summary.reviews.slice(VISIBLE);
const moreLabel = summary.reviews.length === summary.count
  ? `Show all ${summary.count} reviews`
  : `Show ${more.length} more ${more.length === 1 ? "review" : "reviews"}`;
---
{summary.count > 0 && (
  <section class="rv">
    <h2 class="rv-title">{title}</h2>
    <ReviewSummaryCard summary={summary} />
    {shown.map((r) => <ReviewCard review={r} sellerName={sellerNames[r.sellerId]} />)}
    {allHref && summary.count > VISIBLE && (
      <a class="rv-more-btn" href={allHref}>See all {summary.count} reviews →</a>
    )}
    {more.length > 0 && (
      <details class="rv-more">
        <summary class="rv-more-btn"><span class="rv-more-show">{moreLabel}</span><span class="rv-more-hide">Show fewer reviews</span></summary>
        {more.map((r) => <ReviewCard review={r} sellerName={sellerNames[r.sellerId]} />)}
      </details>
    )}
  </section>
)}

<style>
  .rv { padding: 20px 16px; border-top: 1px solid var(--v2-border); font-family: var(--v2-font); }
  .rv-title { font: 700 16px/1.3 var(--v2-font); color: var(--v2-ink); margin: 0 0 12px; }
  .rv-more-btn {
    display: block; list-style: none; cursor: pointer; margin-top: 12px; padding: 10px; text-align: center;
    font: 700 13px var(--v2-font); color: var(--v2-brand); text-decoration: none;
    border: 1px solid var(--v2-border); border-radius: var(--v2-radius-sm); background: var(--v2-bg);
  }
  .rv-more-btn::-webkit-details-marker { display: none; }
  .rv-more-hide, .rv-more[open] .rv-more-show { display: none; }
  .rv-more[open] .rv-more-hide { display: inline; }
</style>
