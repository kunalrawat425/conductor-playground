---
import type { PreorderBannerProps } from "../../../types/v2-components";
interface Props extends PreorderBannerProps {}
const {
  variant = "inline",
  title = "Pre-order tomorrow's catch",
  description = "Order tonight, reserved at dock by 5am",
  ctaText = "Browse",
  href = "/preorder",
} = Astro.props;
---
{variant === "hero" ? (
  <a href={href} class="v2-pb-hero">
    <h3 class="v2-pb-hero-title">{title}</h3>
    <p class="v2-pb-hero-desc">{description}</p>
    <span class="v2-pb-hero-btn">{ctaText} →</span>
  </a>
) : variant === "empty" ? (
  <div class="v2-pb-empty">
    <div class="v2-pb-icon">💡</div>
    <div>
      <div class="v2-pb-empty-title">{title}</div>
      <div class="v2-pb-empty-desc">{description}</div>
    </div>
  </div>
) : (
  <a href={href} class="v2-pb-inline">
    <div class="v2-pb-icon">🌙</div>
    <div class="v2-pb-text">
      <h4>{title}</h4>
      <p>{description}</p>
    </div>
    <span class="v2-pb-btn">{ctaText}</span>
  </a>
)}

<style is:global>
  .v2-pb-inline {
    display: flex; align-items: center; gap: 12px;
    background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
    border: 1px solid #C7D2FE;
    border-radius: var(--v2-radius);
    padding: 14px 16px;
    text-decoration: none;
    transition: transform var(--v2-dur-fast) var(--v2-ease);
  }
  .v2-pb-inline:hover { transform: translateY(-1px); }
  .v2-pb-icon { font-size: 32px; flex-shrink: 0; }
  .v2-pb-text { flex: 1; min-width: 0; }
  .v2-pb-text h4 {
    font-family: var(--v2-font); font-weight: 700; font-size: 14px;
    color: var(--v2-indigo-d); margin: 0;
  }
  .v2-pb-text p {
    font-family: var(--v2-font); font-weight: 400; font-size: 11px;
    color: var(--v2-indigo); margin-top: 2px;
  }
  .v2-pb-btn {
    background: var(--v2-indigo); color: #fff;
    font-family: var(--v2-font); font-weight: 700; font-size: 11px;
    padding: 8px 14px;
    border-radius: var(--v2-radius-sm);
    flex-shrink: 0;
  }

  .v2-pb-hero {
    display: block;
    background: linear-gradient(135deg, var(--v2-indigo), #7C3AED);
    border-radius: var(--v2-radius-lg);
    padding: 20px;
    color: #fff;
    text-decoration: none;
    position: relative; overflow: hidden;
  }
  .v2-pb-hero::before {
    content: '🌙';
    position: absolute; right: -10px; top: -10px;
    font-size: 120px; opacity: .15;
  }
  .v2-pb-hero-title {
    font-family: var(--v2-font); font-weight: 800; font-size: 20px;
    line-height: 1.2; position: relative;
  }
  .v2-pb-hero-desc {
    font-family: var(--v2-font); font-weight: 400; font-size: 13px;
    opacity: .9; margin-top: 6px; position: relative;
  }
  .v2-pb-hero-btn {
    display: inline-block; margin-top: 14px;
    background: #fff; color: var(--v2-indigo);
    font-family: var(--v2-font); font-weight: 700; font-size: 13px;
    padding: 10px 20px;
    border-radius: var(--v2-radius-sm);
    position: relative;
  }

  .v2-pb-empty {
    display: flex; gap: 12px; align-items: flex-start;
    background: linear-gradient(135deg, #FFF7ED, #FEF3C7);
    border-radius: var(--v2-radius);
    padding: 16px;
  }
  .v2-pb-empty-title {
    font-family: var(--v2-font); font-weight: 700; font-size: 13px;
    color: #92400E;
  }
  .v2-pb-empty-desc {
    font-family: var(--v2-font); font-weight: 400; font-size: 11px;
    color: #B45309; margin-top: 2px; line-height: 1.5;
  }
</style>
