---
import type { SellerCardProps } from "../../../types/v2-components";
import Badge from "../atoms/Badge.astro";
interface Props extends SellerCardProps {}
const {
  id,
  name,
  location,
  distanceKm,
  deliveryEtaMin,
  rating,
  status,
  acceptsPreorder,
  hasDelivery,
  deliveryFreeAbove,
  itemCount,
  topItems = [],
  imageHue = "sky",
  offerLabel,
} = Astro.props;

const distance = distanceKm != null ? `${distanceKm.toFixed(1)} km` : null;
const eta = deliveryEtaMin != null ? `${deliveryEtaMin} min` : null;
const subParts = [location, distance, eta].filter(Boolean).join(" · ");

const hueColors: Record<string, string> = {
  sky: "linear-gradient(135deg,#E0F2FE,#BAE6FD)",
  green: "linear-gradient(135deg,#ECFDF5,#D1FAE5)",
  orange: "linear-gradient(135deg,#FFF7ED,#FED7AA)",
  indigo: "linear-gradient(135deg,#EEF2FF,#E0E7FF)",
};
const cardImgBg = hueColors[imageHue] || hueColors.sky;
const offerColor = imageHue === "green" ? "green" : imageHue === "indigo" ? "indigo" : "brand";
---
<a href={`/seller/${id}`} class:list={["v2-seller-card", status === "closed" && "v2-seller-closed"]}>
  <div class="v2-sc-img" style={`background:${cardImgBg};`}>
    {offerLabel && <Badge variant="offer" color={offerColor}>{offerLabel}</Badge>}
    <span class="v2-sc-emoji" aria-hidden="true">🐟</span>
  </div>

  <div class="v2-sc-body">
    <div class="v2-sc-top">
      <div class="v2-sc-info">
        <div class="v2-sc-name">{name}</div>
        {subParts && <div class="v2-sc-loc">{subParts}</div>}
      </div>
      {rating > 0 && <Badge variant="rating" color="green">{rating.toFixed(1)} ★</Badge>}
    </div>

    <div class="v2-sc-tags">
      {status === "open" && <Badge variant="tag" color="green">Open now</Badge>}
      {status === "closed" && <Badge variant="tag" color="red">Closed</Badge>}
      {status === "pre-order-only" && <Badge variant="tag" color="indigo">Pre-order only</Badge>}
      {acceptsPreorder && status !== "pre-order-only" && <Badge variant="tag" color="brand">Pre-order</Badge>}
      {!hasDelivery && <Badge variant="tag">Pickup only</Badge>}
    </div>
  </div>

  {topItems.length > 0 && (
    <div class="v2-sc-menu">
      {topItems.slice(0, 4).map((it) => (
        <div class="v2-sc-chip">
          <span class="v2-sc-m-emoji" aria-hidden="true">{it.emoji}</span>
          <div>
            <div class="v2-sc-m-name">{it.name}</div>
            <div class="v2-sc-m-price">₹{it.price}/{it.unit}</div>
          </div>
        </div>
      ))}
    </div>
  )}

  {hasDelivery && (
    <div class="v2-sc-delivery">
      🚲 Delivery available{deliveryFreeAbove ? ` · Free above ₹${deliveryFreeAbove}` : ''}
    </div>
  )}
</a>

