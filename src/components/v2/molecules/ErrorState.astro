---
interface Props {
  variant: "sold-out" | "seller-closed" | "payment-failed" | "otp-wrong" | "preorder-price-up" | "seller-declined" | "min-order" | "multi-seller" | "out-of-range";
  title?: string;
  description?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}
const presets: Record<string, { icon: string; color: "warning" | "danger"; title: string; desc: string; primary: string; secondary: string }> = {
  "sold-out": {
    icon: "!", color: "warning",
    title: "Items unavailable",
    desc: "Some items in your cart sold out before checkout.",
    primary: "Update cart", secondary: "Remove all"
  },
  "seller-closed": {
    icon: "🌙", color: "warning",
    title: "Seller just closed for the day",
    desc: "You can pre-order tomorrow's catch (ready by 7am) or pick a different seller.",
    primary: "Pre-order tomorrow", secondary: "Other sellers"
  },
  "payment-failed": {
    icon: "✕", color: "danger",
    title: "Payment failed",
    desc: "Bank declined the transaction. Order held for 5 min — try again or continue later.",
    primary: "Retry payment", secondary: "Try again later"
  },
  "otp-wrong": {
    icon: "✕", color: "danger",
    title: "OTP doesn't match",
    desc: "Check the code in your SMS or request a new one. Code expires in 10 min.",
    primary: "Try again", secondary: "Resend OTP"
  },
  "preorder-price-up": {
    icon: "⚡", color: "warning",
    title: "Morning price update",
    desc: "Today's price differs from your pre-order estimate. Confirm to proceed.",
    primary: "Confirm new price", secondary: "Cancel order"
  },
  "seller-declined": {
    icon: "✕", color: "danger",
    title: "Seller couldn't fulfill",
    desc: "Full refund processed. We've found alternative sellers nearby.",
    primary: "See alternatives", secondary: "View refund"
  },
  "min-order": {
    icon: "!", color: "warning",
    title: "Below minimum order",
    desc: "This seller's minimum is higher. Add more items or switch to pickup (no min).",
    primary: "Add more items", secondary: "Switch to pickup"
  },
  "multi-seller": {
    icon: "🐟", color: "warning",
    title: "One seller per order",
    desc: "Adding from this seller will replace items currently in your cart.",
    primary: "Replace cart", secondary: "Cancel"
  },
  "out-of-range": {
    icon: "📍", color: "warning",
    title: "Out of delivery range",
    desc: "This address is outside the seller's delivery radius. Switch to pickup or pick a closer address.",
    primary: "Switch to pickup", secondary: "Change address"
  },
};
const {
  variant,
  title: titleProp,
  description: descProp,
  primaryText: ptProp,
  primaryHref,
  secondaryText: stProp,
  secondaryHref,
} = Astro.props;
const p = presets[variant];
const title = titleProp || p?.title;
const description = descProp || p?.desc;
const primaryText = ptProp || p?.primary;
const secondaryText = stProp || p?.secondary;
const isWarning = (p?.color || "warning") === "warning";
---
<div class:list={["v2-err-card", isWarning ? "v2-err-warning" : "v2-err-danger"]}>
  <div class="v2-err-head">
    <div class="v2-err-icon" aria-hidden="true">{p?.icon || "!"}</div>
    <div class="v2-err-body">
      <h4 class="v2-err-title">{title}</h4>
      <p class="v2-err-desc">{description}</p>
    </div>
  </div>
  <slot />
  <div class="v2-err-actions">
    {secondaryText && (
      secondaryHref
        ? <a href={secondaryHref} class="v2-btn v2-btn-ghost v2-btn-sm" style="flex:1;">{secondaryText}</a>
        : <button class="v2-btn v2-btn-ghost v2-btn-sm" style="flex:1;" data-err-action="secondary">{secondaryText}</button>
    )}
    {primaryText && (
      primaryHref
        ? <a href={primaryHref} class="v2-btn v2-btn-primary v2-btn-sm" style="flex:1;">{primaryText}</a>
        : <button class="v2-btn v2-btn-primary v2-btn-sm" style="flex:1;" data-err-action="primary">{primaryText}</button>
    )}
  </div>
</div>
