---
import type { AppHeaderProps } from "../../../types/v2-components";
interface Props extends AppHeaderProps {}
const {
  variant = "default",
  locationLabel = "Set location",
  locationSub = "Tap to choose your area",
  showSearch = false,
  showCart = false,
  cartCount = 0,
  backHref,
  title,
} = Astro.props;
const isPreorder = variant === "preorder";
const isPage = variant === "page";
---
<header class:list={["v2-header", isPreorder && "v2-header-preorder", showSearch && "v2-header-tall"]}>
  <div class="v2-header-row">
    {isPage && backHref ? (
      <a href={backHref} class="v2-back" aria-label="Back">←</a>
    ) : (
      <a href="/" class="v2-logo">{isPreorder ? "🌙 relifish" : "relifish"}</a>
    )}

    <div class="v2-loc-wrap" id="v2-location-trigger">
      <div class="v2-loc-main">
        {isPage && title ? title : locationLabel}
        {!isPage && <span class="v2-loc-arrow">▼</span>}
      </div>
      {locationSub && <div class="v2-loc-sub">{locationSub}</div>}
    </div>

    {showCart ? (
      <a href="/cart" class="v2-icon-btn v2-cart-icon" aria-label={`Cart with ${cartCount} items`}>
        🛒
        {cartCount > 0 && <span class="v2-cart-dot">{cartCount}</span>}
      </a>
    ) : (
      <a href="/me" class="v2-icon-btn v2-profile" aria-label="Account">👤</a>
    )}
  </div>

  {showSearch && (
    <a href="/search" class="v2-search-card" aria-label="Search">
      <span class="v2-s-icon" aria-hidden="true">🔍</span>
      <span>Search "Surmai", "Pomfret", sellers...</span>
    </a>
  )}
</header>

<style is:global>
  .v2-header {
    position: sticky; top: 0; z-index: var(--v2-z-header);
    background: var(--v2-brand);
    padding: 12px 16px 8px;
  }
  .v2-header-tall { padding-bottom: 24px; }
  .v2-header-preorder { background: var(--v2-indigo); }

  .v2-header-row {
    display: flex; align-items: center; gap: 12px;
    max-width: var(--app-max-width); margin: 0 auto;
  }

  .v2-logo {
    font-family: var(--v2-font); font-weight: 800; font-size: 18px;
    color: #fff; letter-spacing: -.02em; text-decoration: none;
    flex-shrink: 0;
  }
  .v2-back {
    font-size: 22px; color: #fff; text-decoration: none;
    width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
  }

  .v2-loc-wrap {
    flex: 1; min-width: 0; cursor: pointer;
  }
  .v2-loc-main {
    font-family: var(--v2-font); font-weight: 700; font-size: 14px;
    color: #fff;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .v2-loc-arrow { font-size: 10px; margin-left: 4px; }
  .v2-loc-sub {
    font-family: var(--v2-font); font-weight: 400; font-size: 11px;
    color: rgba(255, 255, 255, .75);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .v2-icon-btn {
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255, 255, 255, .2);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; color: #fff;
    text-decoration: none; flex-shrink: 0;
    position: relative;
    transition: background var(--v2-dur-fast) var(--v2-ease);
  }
  .v2-icon-btn:hover { background: rgba(255, 255, 255, .3); }

  .v2-cart-dot {
    position: absolute; top: -2px; right: -2px;
    background: var(--v2-orange); color: #fff;
    font-family: var(--v2-font); font-weight: 700; font-size: 9px;
    min-width: 18px; height: 18px; border-radius: 9999px;
    display: flex; align-items: center; justify-content: center;
    padding: 0 4px;
    border: 2px solid var(--v2-brand);
  }

  .v2-search-card {
    display: flex; align-items: center; gap: 8px;
    margin: -12px 16px 0; max-width: calc(var(--app-max-width) - 32px);
    margin-left: auto; margin-right: auto;
    padding: 14px 16px;
    background: #fff; border-radius: var(--v2-radius);
    font-family: var(--v2-font); font-weight: 400; font-size: 13px;
    color: var(--v2-ink-4);
    box-shadow: var(--v2-shadow-md);
    text-decoration: none;
    position: relative; z-index: 5;
  }
  .v2-search-card .v2-s-icon { font-size: 14px; }
</style>

<script>
  // Wire up location trigger
  const trigger = document.getElementById('v2-location-trigger');
  trigger?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('relifish:open-location-picker'));
  });
</script>
