---
import BottomSheet from "./BottomSheet.astro";
import PhoneInput from "../atoms/PhoneInput.astro";
import OTPInput from "../atoms/OTPInput.astro";
interface Props {
  id?: string;
  role?: "buyer" | "seller";
  redirectTo?: string;
}
const { id = "v2-login", role = "buyer", redirectTo = "/v2" } = Astro.props;
const title = role === "seller" ? "Seller sign in" : "Sign in";
---
<BottomSheet id={id} title={title} showClose={true}>
  <div id={`${id}-step1`}>
    <p style="font:400 13px Inter;color:var(--v2-ink-2);margin:0 0 16px;line-height:1.5;">
      We'll send a one-time code to your phone. No password needed.
    </p>
    <form id={`${id}-phone-form`}>
      <PhoneInput id={`${id}-phone`} required={true} />
      <button type="submit" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full" id={`${id}-send-otp`}>
        Send OTP
      </button>
    </form>
  </div>

  <div id={`${id}-step2`} style="display:none;">
    <p style="font:400 13px Inter;color:var(--v2-ink-2);margin:0 0 4px;line-height:1.5;">
      Enter the 6-digit code sent to <strong id={`${id}-phone-display`}>your phone</strong>.
    </p>
    <p style="font:400 11px Inter;color:var(--v2-ink-3);margin:0 0 16px;">
      Code expires in 10 minutes · Max 3 attempts
    </p>
    <form id={`${id}-otp-form`}>
      <OTPInput id={`${id}-otp`} length={6} autoSubmitFormId={`${id}-otp-form`} />
      <p id={`${id}-tries-msg`} style="font:400 12px Inter;color:var(--v2-orange);min-height:18px;margin:6px 0 0;text-align:center;"></p>
      <button type="submit" class="v2-btn v2-btn-primary v2-btn-md v2-btn-full" id={`${id}-verify-otp`} style="margin-top:8px;">
        Verify &amp; continue
      </button>
      <button type="button" class="v2-btn v2-btn-ghost v2-btn-sm v2-btn-full" id={`${id}-resend`} style="margin-top:8px;" disabled>
        Resend code (<span id={`${id}-countdown`}>30</span>s)
      </button>
      <button type="button" class="v2-btn v2-btn-ghost v2-btn-sm v2-btn-full" id={`${id}-change-phone`} style="margin-top:4px;font-size:12px;opacity:0.7;">
        Change number
      </button>
    </form>
  </div>
</BottomSheet>

<script define:vars={{ id, role, redirectTo }}>
  const RESEND_COOLDOWN = 30;
  let currentPhone = "";
  let countdownTimer = null;

  function getEl(suffix) { return document.getElementById(`${id}-${suffix}`); }

  function showStep(n) {
    getEl("step1").style.display = n === 1 ? "block" : "none";
    getEl("step2").style.display = n === 2 ? "block" : "none";
  }

  function startCountdown() {
    const btn = getEl("resend");
    const cd = getEl("countdown");
    btn.disabled = true;
    let secs = RESEND_COOLDOWN;
    cd.textContent = secs;
    btn.textContent = "";
    btn.appendChild(document.createTextNode("Resend code ("));
    btn.appendChild(cd);
    btn.appendChild(document.createTextNode("s)"));

    clearInterval(countdownTimer);
    countdownTimer = setInterval(() => {
      secs--;
      cd.textContent = secs;
      if (secs <= 0) {
        clearInterval(countdownTimer);
        btn.disabled = false;
        btn.textContent = "Resend code";
      }
    }, 1000);
  }

  function clearOTPCells() {
    const otpInput = document.getElementById(`${id}-otp`);
    if (otpInput) otpInput.value = "";
    document.querySelectorAll(`#${id}-step2 .v2-otp-cell`).forEach((c) => {
      c.value = "";
      c.classList.remove("v2-input-error");
    });
    document.querySelector(`#${id}-step2 .v2-otp-cell`)?.focus();
  }

  // Step 1: send OTP
  getEl("phone-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const input = document.getElementById(`${id}-phone`);
    const phone = input.value.replace(/\D/g, "");
    if (phone.length !== 10) {
      window.v2Toast?.("error", "Invalid phone", "Enter a 10-digit Indian mobile number");
      return;
    }
    currentPhone = "+91" + phone;
    const btn = getEl("send-otp");
    btn.disabled = true;
    btn.textContent = "Sending…";
    try {
      const res = await fetch("/api/auth/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone: currentPhone }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to send OTP");
      getEl("phone-display").textContent = currentPhone;
      getEl("tries-msg").textContent = "";
      clearOTPCells();
      showStep(2);
      startCountdown();
    } catch (err) {
      window.v2Toast?.("error", "Failed to send OTP", err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = "Send OTP";
    }
  });

  // Step 2: verify OTP
  let otpAttempts = 0;
  const MAX_OTP_ATTEMPTS = 3;

  getEl("otp-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const code = document.getElementById(`${id}-otp`)?.value || "";
    if (code.length !== 6) {
      window.v2Toast?.("error", "Incomplete OTP", "Enter all 6 digits");
      return;
    }
    if (otpAttempts >= MAX_OTP_ATTEMPTS) {
      window.v2Toast?.("error", "Too many attempts", "Tap Resend to get a new code");
      return;
    }
    const btn = getEl("verify-otp");
    btn.disabled = true;
    btn.textContent = "Verifying…";
    try {
      const res = await fetch("/api/auth/verify-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone: currentPhone, code, role }),
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        otpAttempts++;
        const left = MAX_OTP_ATTEMPTS - otpAttempts;
        const triesEl = getEl("tries-msg");
        if (triesEl) triesEl.textContent = data.error || (left > 0 ? `Wrong code. ${left} ${left === 1 ? "try" : "tries"} left.` : "No tries left. Tap Resend.");
        document.querySelectorAll(`#${id}-step2 .v2-otp-cell`).forEach((c) => c.classList.add("v2-input-error"));
        clearOTPCells();
        btn.disabled = false;
        btn.textContent = left > 0 ? "Try again" : "Resend OTP first";
        return;
      }

      // Success
      try {
        if (role === "seller") {
          localStorage.setItem("zepto_seller_id", data.seller_id);
          localStorage.setItem("zepto_seller_phone", currentPhone);
        } else {
          localStorage.setItem("zepto_buyer_id", data.buyer_id);
          localStorage.setItem("zepto_phone", currentPhone);
        }
      } catch {}

      if (role === "buyer" && window.RelifishCart) {
        try { await window.RelifishCart.pushLocalToServer(); } catch {}
      }

      window.v2Toast?.("success", "Signed in", "Welcome to Relifish");

      if (role === "buyer") {
        try {
          if (!localStorage.getItem("v2_buyer_location")) {
            localStorage.setItem("v2_prompt_location", "1");
          }
        } catch {}
      }

      setTimeout(() => { window.location.href = redirectTo; }, 600);
    } catch (err) {
      otpAttempts++;
      window.v2Toast?.("error", "Network error", err.message || "Try again");
      btn.disabled = false;
      btn.textContent = "Verify & continue";
    }
  });

  // Resend
  getEl("resend")?.addEventListener("click", async () => {
    if (!currentPhone) { showStep(1); return; }
    const btn = getEl("resend");
    btn.disabled = true;
    try {
      const res = await fetch("/api/auth/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone: currentPhone }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed");
      otpAttempts = 0;
      getEl("tries-msg").textContent = "";
      getEl("verify-otp").textContent = "Verify & continue";
      clearOTPCells();
      startCountdown();
      window.v2Toast?.("info", "OTP resent", "Check your SMS");
    } catch (err) {
      window.v2Toast?.("error", "Failed", err.message || "Try again");
      btn.disabled = false;
    }
  });

  // Change number
  getEl("change-phone")?.addEventListener("click", () => {
    clearInterval(countdownTimer);
    otpAttempts = 0;
    showStep(1);
  });
</script>
