---
import BottomSheet from "./BottomSheet.astro";
interface Props {
  id?: string;
  title?: string;
}
const { id = "v2-slot-picker", title = "Pickup time" } = Astro.props;
---
<BottomSheet id={id} title={title} ctaText="Confirm slot" ctaAction="v2ConfirmSlot">
  <div id={`${id}-day-picker`} class="v2-day-picker"></div>
  <div id={`${id}-slots`}></div>
</BottomSheet>

<script define:vars={{ id }}>
  // Build day picker (next 4 days)
  const dayWrap = document.getElementById(`${id}-day-picker`);
  const slotsWrap = document.getElementById(`${id}-slots`);
  if (dayWrap && slotsWrap) {
    const today = new Date();
    const days = Array.from({ length: 4 }).map((_, i) => {
      const d = new Date(today);
      d.setDate(today.getDate() + i + 1); // start tomorrow
      return d;
    });
    let selectedDay = days[0].toISOString().slice(0, 10);
    let selectedSlot = null;

    function fmtDay(d, i) {
      const tz = { timeZone: "Asia/Kolkata" };
      const label = i === 0 ? "Tomorrow" : d.toLocaleDateString("en-IN", { ...tz, weekday: "short" });
      return `${label}<br><span style="font-weight:400;font-size:10px;">${d.toLocaleDateString("en-IN", { ...tz, day: "numeric", month: "short" })}</span>`;
    }

    function render() {
      dayWrap.innerHTML = days.map((d, i) => {
        const iso = d.toISOString().slice(0, 10);
        const sel = iso === selectedDay;
        return `<button type="button" class="v2-day-pill${sel ? " v2-day-selected" : ""}" data-day="${iso}">${fmtDay(d, i)}</button>`;
      }).join("");

      // Morning + evening slots
      const morningSlots = [
        { id: "5-7am", time: "5-7am", label: "Dawn", fee: 0 },
        { id: "7-9am", time: "7-9am", label: "Morning", fee: 0 },
        { id: "9-11am", time: "9-11am", label: "Late morning", fee: 20 },
      ];
      const eveningSlots = [
        { id: "4-6pm", time: "4-6pm", label: "Evening", fee: 40 },
        { id: "6-8pm", time: "6-8pm", label: "Night", fee: 40 },
        { id: "8-10pm", time: "8-10pm", label: "Sold out", disabled: true },
      ];

      function slotHtml(s) {
        const sel = s.id === selectedSlot;
        return `<button type="button" class="v2-slot${sel ? " v2-slot-selected" : ""}${s.disabled ? " v2-slot-disabled" : ""}" data-slot="${s.id}" data-fee="${s.fee||0}" ${s.disabled ? "disabled" : ""}>
          <div class="v2-slot-time">${s.time}</div>
          <div class="v2-slot-label">${s.disabled ? "Sold out" : s.label}</div>
          ${s.fee > 0 && !s.disabled ? `<div class="v2-slot-fee">+₹${s.fee}</div>` : (s.fee === 0 && !s.disabled ? '<div class="v2-slot-fee">No fee</div>' : '')}
        </button>`;
      }

      slotsWrap.innerHTML = `
        <h4 class="v2-slot-group-title">Morning</h4>
        <div class="v2-slot-grid">${morningSlots.map(slotHtml).join("")}</div>
        <h4 class="v2-slot-group-title">Evening</h4>
        <div class="v2-slot-grid">${eveningSlots.map(slotHtml).join("")}</div>
      `;

      dayWrap.querySelectorAll(".v2-day-pill").forEach(b => {
        b.addEventListener("click", () => { selectedDay = b.dataset.day; render(); });
      });
      slotsWrap.querySelectorAll(".v2-slot:not(.v2-slot-disabled)").forEach(b => {
        b.addEventListener("click", () => { selectedSlot = b.dataset.slot; render(); });
      });
    }
    render();

    window.v2ConfirmSlot = function() {
      if (!selectedSlot) return;
      document.dispatchEvent(new CustomEvent("v2-slot-confirmed", {
        detail: { day: selectedDay, slot: selectedSlot }
      }));
      window.v2CloseSheet?.(id);
    };
  }
</script>

<style is:global>
  .v2-day-picker {
    display: flex; gap: 6px;
    padding: 0 0 16px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .v2-day-picker::-webkit-scrollbar { display: none; }
  .v2-day-pill {
    flex-shrink: 0;
    padding: 10px 14px;
    border-radius: 20px;
    border: 1.5px solid var(--v2-border);
    background: var(--v2-bg);
    font: 600 12px Inter;
    color: var(--v2-ink-2);
    cursor: pointer;
    line-height: 1.3;
  }
  .v2-day-selected {
    background: var(--v2-brand);
    color: #fff;
    border-color: var(--v2-brand);
  }
</style>
