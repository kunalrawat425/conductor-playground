---
import type { BottomNavProps } from "../../../types/v2-components";
interface Props extends BottomNavProps {}
const { active, ordersCount = 0, mode = "buyer" } = Astro.props;

const buyerItems = [
  { id: "home", label: "Home", icon: "🏠", href: "/v2" },
  { id: "preorder", label: "Pre-order", icon: "🌙", href: "/v2/preorder" },
  { id: "orders", label: "Orders", icon: "📋", href: "/v2/track" },
  { id: "account", label: "Account", icon: "👤", href: "/v2/me" },
];

const sellerItems = [
  { id: "orders", label: "Orders", icon: "📋", href: "/v2/dashboard/orders" },
  { id: "listings", label: "Listings", icon: "🐟", href: "/v2/dashboard/listings" },
  { id: "preorders", label: "Pre-orders", icon: "🌙", href: "/v2/dashboard/orders" },
  { id: "account", label: "Profile", icon: "👤", href: "/v2/dashboard/profile" },
];

const items = mode === "seller" ? sellerItems : buyerItems;
---
<nav class="v2-bottom-nav" role="navigation" aria-label="Main navigation">
  {items.map((item) => (
    <a
      href={item.href}
      class:list={["v2-nav-item", active === item.id && "v2-nav-active"]}
      aria-current={active === item.id ? "page" : undefined}
    >
      <span class="v2-nav-icon" aria-hidden="true">{item.icon}</span>
      <span class="v2-nav-label">{item.label}</span>
      {item.id === "orders" && ordersCount > 0 && (
        <span class="v2-nav-badge">{ordersCount}</span>
      )}
    </a>
  ))}
</nav>

<!-- All styles in src/styles/v2-components.css -->
