---
import "../../styles/tokens.css";
import "../../styles/v2-components.css";
import AppHeader from "./organisms/AppHeader.astro";
import BottomNav from "./organisms/BottomNav.astro";
import type { AppHeaderProps, BottomNavProps } from "../../types/v2-components";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  needsMap?: boolean;
  jsonLd?: Record<string, unknown>;
  header?: AppHeaderProps;
  nav?: BottomNavProps;
  hideHeader?: boolean;
  hideNav?: boolean;
}

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Relifish";
const siteUrl = "https://www.relifish.store";
const defaultDescription = "Order fresh fish from local Goa sellers. Pre-order tonight, pick up tomorrow morning.";
const {
  title = brandName,
  description = defaultDescription,
  ogImage = "/og-image.png",
  needsMap = false,
  jsonLd,
  header,
  nav,
  hideHeader = false,
  hideNav = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0066FF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F172A" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- Apply theme before paint to prevent FOUC -->
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem("v2_theme");
          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch(e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    {needsMap && <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class:list={[!hideNav && "v2-has-bottom-nav"]}>
    <div class="v2-app">
      {!hideHeader && header && <AppHeader {...header} />}
      <main class="v2-main">
        <slot />
      </main>
      {!hideNav && nav && <BottomNav {...nav} />}
    </div>
    <style is:global>
      body.v2-has-bottom-nav { padding-bottom: calc(64px + env(safe-area-inset-bottom, 0)); }
    </style>

    <style is:global>
      html, body {
        margin: 0; padding: 0;
        font-family: var(--v2-font);
        background: var(--v2-bg-2);
        color: var(--v2-ink);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
        width: 100%;
      }
      *, *::before, *::after { box-sizing: border-box; }
      .v2-app { min-height: 100vh; }
      .v2-main {
        max-width: var(--app-max-width, 800px);
        margin: 0 auto;
        padding-bottom: 16px;
      }
      a { color: inherit; }
      :root { --app-max-width: 800px; }
    </style>

    <!-- Global cart module — exposed on window for inline scripts (define:vars) -->
    <script>
      import * as Cart from "../../lib/cart";
      (window as any).RelifishCart = Cart;
      document.dispatchEvent(new CustomEvent("v2-cart-ready"));
    </script>
  </body>
</html>
