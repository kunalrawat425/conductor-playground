---
/**
 * After DashboardGate: inactive sellers may only use /dashboard/pending and /dashboard/listings/*.
 * Active sellers hitting /dashboard/pending are sent to orders.
 */
---

<script type="module">
  import { getSession } from "../lib/seller-auth";
  import { getSellerById } from "../lib/supabase";

  const path = window.location.pathname;
  const session = getSession();
  if (!session) return;

  try {
    const seller = await getSellerById(session.seller_id);
    const active = seller.is_active !== false;

    if (!active) {
      const allowed =
        path === "/dashboard/pending" ||
        path.startsWith("/dashboard/listings") ||
        path === "/v2/dashboard/pending" ||
        path.startsWith("/v2/dashboard/listings");
      if (!allowed) {
        window.location.replace("/v2/dashboard/pending");
      }
    } else if (path === "/dashboard/pending" || path === "/v2/dashboard/pending") {
      window.location.replace("/v2/dashboard/orders");
    }
  } catch {
    /* allow page load if profile fetch fails */
  }
</script>
