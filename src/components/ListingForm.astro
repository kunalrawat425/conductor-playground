---
import { SPECIES_LIST, PRICE_UNITS } from "../lib/species";
import type { FishListing } from "../lib/supabase";

interface Props {
  listing?: FishListing;
  sellerId: string;
}

const { listing, sellerId } = Astro.props;
const isEdit = !!listing;
---

<form id="listing-form" class="listing-form" data-seller-id={sellerId} data-listing-id={listing?.id || ""}>
  <div class="form-group">
    <label for="species">Species</label>
    <select id="species" name="species" required>
      <option value="">Select species</option>
      {SPECIES_LIST.map((s) => (
        <option value={s.id} selected={listing?.species === s.id} data-unit={s.defaultUnit}>
          {s.english} ({s.marathi})
        </option>
      ))}
    </select>
  </div>

  <div class="form-group">
    <label for="weight_avail" id="stock-label">Stock available</label>
    <input
      type="number"
      id="weight_avail"
      name="weight_avail"
      min="0"
      step="1"
      value={listing?.weight_avail || ""}
      required
      placeholder="e.g. 10"
    />
    <div class="form-hint" id="stock-hint">Buyers won't see this number. It only drives inventory and the "Out of stock" label when it reaches zero.</div>
    <div class="form-hint" id="stock-info" style="color:var(--blue);font-weight:600;"></div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="price_unit">Sell by</label>
      <select id="price_unit" name="price_unit" required>
        {PRICE_UNITS.map((u) => (
          <option value={u.value} selected={listing?.price_unit === u.value}>
            {u.label}
          </option>
        ))}
      </select>
      <div class="form-hint">How this fish is sold — per piece or per dozen</div>
    </div>
    <div class="form-group">
      <label for="price" id="price-label">Price</label>
      <input
        type="number"
        id="price"
        name="price"
        min="1"
        step="0.01"
        value={listing?.price || ""}
        required
        placeholder="e.g. 500"
      />
      <div class="form-hint" id="price-hint">₹ per unit. Buyer sees this on the menu.</div>
    </div>
  </div>

  <div class="form-group">
    <label for="photo">Photo</label>
    <input type="file" id="photo" name="photo" accept="image/*" />
    {listing?.photo_url && (
      <img src={listing.photo_url} alt="Current photo" class="current-photo" loading="lazy" />
    )}
  </div>

  <div class="form-group">
    <label for="oos_threshold">"Stock clearing soon" threshold (optional)</label>
    <input
      type="number"
      id="oos_threshold"
      name="oos_threshold"
      min="0"
      step="1"
      value={listing?.oos_threshold || ""}
      placeholder="e.g. 3 — leave empty for no tag"
    />
    <div class="form-hint">
      Cosmetic only: when stock is above zero but at or below this number, buyers see "Stock clearing soon". It does not change add, pre-order, or stock rules.
    </div>
  </div>

  <div class="form-group">
    <label for="buyer_daily_qty_limit">Per-buyer daily limit (optional)</label>
    <input
      type="number"
      id="buyer_daily_qty_limit"
      name="buyer_daily_qty_limit"
      min="1"
      step="1"
      value={listing?.buyer_daily_qty_limit || ""}
      placeholder="e.g. 10 pieces/dozens per buyer per day — leave empty for no cap"
    />
    <div class="form-hint">
      Max total pieces or dozens one phone number can order from this line item per calendar day (resets at midnight). Must be high enough that someone can still meet your shop minimum order at this price, if you set a minimum in profile.
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">
      {isEdit ? "Update Listing" : "Add Listing"}
    </button>
  </div>
</form>

<script>
  const speciesSelect = document.getElementById("species") as HTMLSelectElement;
  const unitSelect = document.getElementById("price_unit") as HTMLSelectElement;
  const priceLabel = document.getElementById("price-label");
  const priceHint = document.getElementById("price-hint");
  const stockLabel = document.getElementById("stock-label");
  const stockHint = document.getElementById("stock-hint");
  const stockInfo = document.getElementById("stock-info");
  const stockInput = document.getElementById("weight_avail") as HTMLInputElement;
  const dailyLimitInput = document.getElementById("buyer_daily_qty_limit") as HTMLInputElement;
  const priceInput = document.getElementById("price") as HTMLInputElement;

  const unitMap: Record<string, { price: string; priceHint: string; stock: string; stockHint: string; stockPlaceholder: string }> = {
    piece: {
      price: "Price per piece (₹)",
      priceHint: "How much for 1 piece. Buyer sees: ₹150/piece",
      stock: "Stock (pieces)",
      stockHint: "How many pieces you have. Buyers won't see this.",
      stockPlaceholder: "e.g. 20",
    },
    dozen: {
      price: "Price per dozen (₹)",
      priceHint: "How much for 12 units. Buyer sees: ₹300/dozen",
      stock: "Stock (dozens)",
      stockHint: "How many dozens you have. Buyers won't see this.",
      stockPlaceholder: "e.g. 5",
    },
  };

  function updateUnitLabels() {
    const unit = unitSelect?.value || "piece";
    const u = unitMap[unit] || unitMap.piece;
    if (priceLabel) priceLabel.textContent = u.price;
    if (priceHint) priceHint.textContent = u.priceHint;
    if (stockLabel) stockLabel.textContent = u.stock;
    if (stockHint) stockHint.textContent = u.stockHint;
    if (stockInput) stockInput.placeholder = u.stockPlaceholder;
    updateStockInfo();
  }

  function updateStockInfo() {
    if (!stockInfo || !stockInput) return;
    const stock = parseFloat(stockInput.value) || 0;
    const cap = parseFloat(dailyLimitInput?.value || "0") || 0;
    const unit = unitSelect?.value || "piece";
    if (stock > 0 && cap > 0) {
      const orders = Math.floor(stock / cap);
      stockInfo.textContent = `With ${stock} ${unit} and max ${cap}/${unit} per buyer per day → ~${orders} buyers could fully use stock`;
    } else if (stock > 0) {
      stockInfo.textContent = `${stock} ${unit} available for orders`;
    } else {
      stockInfo.textContent = "";
    }
  }

  speciesSelect?.addEventListener("change", () => {
    const option = speciesSelect.selectedOptions[0];
    const defaultUnit = option?.dataset.unit;
    if (defaultUnit && unitSelect) {
      unitSelect.value = defaultUnit;
      updateUnitLabels();
    }
  });

  unitSelect?.addEventListener("change", updateUnitLabels);
  stockInput?.addEventListener("input", updateStockInfo);
  dailyLimitInput?.addEventListener("input", updateStockInfo);
  priceInput?.addEventListener("input", updateStockInfo);

  updateUnitLabels();
</script>

<style>
  .listing-form {
    max-width: 500px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 12px;
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }

  .form-hint {
    font-size: 11px;
    color: var(--gray-500);
    margin-top: 4px;
  }

  .current-photo {
    width: 120px;
    height: 90px;
    object-fit: cover;
    border-radius: var(--radius);
    margin-top: 8px;
  }

</style>
