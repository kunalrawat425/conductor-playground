---
import { SPECIES_LIST } from "../lib/species";
import type { FishListing } from "../lib/supabase";
import { getListingPriceOptions } from "../lib/listing-pricing";

interface Props {
  listing?: FishListing;
  sellerId: string;
}

const { listing, sellerId } = Astro.props;
const isEdit = !!listing;

/** JSON string so define:vars always ships a serializable payload to the client bundle. */
const initialPricingJson = JSON.stringify(
  listing ? getListingPriceOptions(listing) : [{ id: "default", label: "Per piece", price: 0, unit: "piece" as const }]
);
---

<form id="listing-form" class="listing-form" data-seller-id={sellerId} data-listing-id={listing?.id || ""}>
  <div class="form-group">
    <label for="species">Species</label>
    <select id="species" name="species" required>
      <option value="">Select species</option>
      {SPECIES_LIST.map((s) => (
        <option value={s.id} selected={listing?.species === s.id} data-unit={s.defaultUnit}>
          {s.english} ({s.marathi})
        </option>
      ))}
    </select>
  </div>

  <div class="form-group">
    <label for="fish_size">Size</label>
    <select id="fish_size" name="fish_size">
      <option value="" selected={!listing?.fish_size}>Not specified</option>
      <option value="small" selected={listing?.fish_size === "small"}>Small</option>
      <option value="medium" selected={listing?.fish_size === "medium"}>Medium</option>
      <option value="large" selected={listing?.fish_size === "large"}>Large</option>
    </select>
    <div class="form-hint">Shown to buyers on the menu (optional).</div>
  </div>

  <div class="form-group">
    <label for="weight_avail" id="stock-label">Stock available</label>
    <input
      type="number"
      id="weight_avail"
      name="weight_avail"
      min="0"
      step="1"
      value={listing?.weight_avail || ""}
      required
      placeholder="e.g. 10"
    />
    <div class="form-hint" id="stock-hint">Buyers won't see this number. It only drives inventory and the "Out of stock" label when it reaches zero.</div>
    <div class="form-hint" id="stock-info" style="color:var(--blue);font-weight:600;"></div>
  </div>

  <div class="form-group">
    <label>Pricing options</label>
    <p class="form-hint" style="margin-bottom:8px;">
      Add one or more prices. <strong>Label</strong> is what buyers see (e.g. "Large piece", "Per dozen"). <strong>Unit</strong> sets how stock is counted (piece vs dozen).
    </p>
    <div id="pricing-rows" class="pricing-rows"></div>
    <button type="button" class="btn-add-price" id="add-price-row">+ Add another price</button>
    <input type="hidden" name="pricing_options_json" id="pricing_options_json" value="" />
  </div>

  <div class="form-group">
    <label for="photo">Photo</label>
    <input type="file" id="photo" name="photo" accept="image/*" />
    {listing?.photo_url && (
      <img src={listing.photo_url} alt="Current photo" class="current-photo" loading="lazy" />
    )}
  </div>

  <div class="form-group">
    <label for="oos_threshold">"Stock clearing soon" threshold (optional)</label>
    <input
      type="number"
      id="oos_threshold"
      name="oos_threshold"
      min="0"
      step="1"
      value={listing?.oos_threshold || ""}
      placeholder="e.g. 3 — leave empty for no tag"
    />
    <div class="form-hint">
      Cosmetic only: when stock is above zero but at or below this number, buyers see "Stock clearing soon". It does not change add, pre-order, or stock rules.
    </div>
  </div>

  <div class="form-group">
    <label for="buyer_daily_qty_limit">Per-buyer daily limit (optional)</label>
    <input
      type="number"
      id="buyer_daily_qty_limit"
      name="buyer_daily_qty_limit"
      min="1"
      step="1"
      value={listing?.buyer_daily_qty_limit || ""}
      placeholder="e.g. 10 pieces/dozens per buyer per day — leave empty for no cap"
    />
    <div class="form-hint">
      Max total units (piece or dozen, matching the option the buyer picks) per phone number per day. Must allow your shop minimum order at the prices you set.
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">
      {isEdit ? "Update Listing" : "Add Listing"}
    </button>
  </div>
</form>

<script define:vars={{ initialPricingJson }}>
  import { setupListingPricingEditor } from "../lib/listing-pricing-setup";
  import type { ListingPriceOption } from "../lib/listing-pricing";

  function runWhenDomReady(fn: () => void) {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", fn, { once: true });
    } else {
      fn();
    }
  }

  runWhenDomReady(() => {
    const speciesSelect = document.getElementById("species") as HTMLSelectElement | null;
    const stockLabel = document.getElementById("stock-label");
    const stockHint = document.getElementById("stock-hint");
    const stockInfo = document.getElementById("stock-info");
    const stockInput = document.getElementById("weight_avail") as HTMLInputElement | null;
    const dailyLimitInput = document.getElementById("buyer_daily_qty_limit") as HTMLInputElement | null;
    const pricingRowsEl = document.getElementById("pricing-rows");
    const pricingJsonInput = document.getElementById("pricing_options_json") as HTMLInputElement | null;
    const addPriceBtn = document.getElementById("add-price-row");
    const form = document.getElementById("listing-form");

    if (!pricingRowsEl || !pricingJsonInput || !addPriceBtn || !form) return;

    const unitMap: Record<string, { stock: string; stockHint: string; stockPlaceholder: string }> = {
      piece: {
        stock: "Stock (pieces)",
        stockHint: "How many pieces you have. Buyers won't see this.",
        stockPlaceholder: "e.g. 20",
      },
      dozen: {
        stock: "Stock (dozens)",
        stockHint: "How many dozens you have. Buyers won't see this.",
        stockPlaceholder: "e.g. 5",
      },
    };

    let parsed: { id?: string; label: string; price: number; unit: string }[] = [];
    try {
      parsed = JSON.parse(initialPricingJson) as typeof parsed;
      if (!Array.isArray(parsed)) parsed = [];
    } catch {
      parsed = [];
    }
    if (parsed.length === 0) {
      parsed = [{ id: "default", label: "Per piece", price: 0, unit: "piece" }];
    }

    const initial = parsed.map((r, i) => ({
      ...r,
      id: r.id || `opt_${i}`,
      unit: r.unit === "dozen" ? "dozen" : "piece",
    })) as ListingPriceOption[];

    function syncStockLabelsFromFirstUnit() {
      const firstUnit = pricingRowsEl.querySelector(".price-unit-select") as HTMLSelectElement | null;
      const unit = firstUnit?.value || "piece";
      const u = unitMap[unit] || unitMap.piece;
      if (stockLabel) stockLabel.textContent = u.stock;
      if (stockHint) stockHint.textContent = u.stockHint;
      if (stockInput) stockInput.placeholder = u.stockPlaceholder;
      updateStockInfo();
    }

    function updateStockInfo() {
      if (!stockInfo || !stockInput) return;
      const stock = parseFloat(stockInput.value) || 0;
      const cap = parseFloat(dailyLimitInput?.value || "0") || 0;
      const firstUnit = pricingRowsEl.querySelector(".price-unit-select") as HTMLSelectElement | null;
      const unit = firstUnit?.value || "piece";
      if (stock > 0 && cap > 0) {
        const orders = Math.floor(stock / cap);
        stockInfo.textContent = `With ${stock} ${unit} and max ${cap}/${unit} per buyer per day → ~${orders} buyers could fully use stock`;
      } else if (stock > 0) {
        stockInfo.textContent = `${stock} ${unit} available for orders`;
      } else {
        stockInfo.textContent = "";
      }
    }

    const pricingEditor = setupListingPricingEditor({
      container: pricingRowsEl,
      hiddenInput: pricingJsonInput,
      addButton: addPriceBtn,
      initial,
      onUnitChange: syncStockLabelsFromFirstUnit,
    });
    syncStockLabelsFromFirstUnit();

    speciesSelect?.addEventListener("change", () => {
      const option = speciesSelect.selectedOptions[0];
      const defaultUnit = option?.dataset.unit;
      const firstSel = pricingRowsEl.querySelector(".price-unit-select") as HTMLSelectElement | null;
      if (defaultUnit && firstSel && (defaultUnit === "piece" || defaultUnit === "dozen")) {
        firstSel.value = defaultUnit;
        pricingEditor.sync();
        syncStockLabelsFromFirstUnit();
      }
    });

    stockInput?.addEventListener("input", updateStockInfo);
    dailyLimitInput?.addEventListener("input", updateStockInfo);

    form.addEventListener("submit", () => pricingEditor.sync());
  });
</script>

<style>
  .listing-form {
    max-width: 500px;
  }

  .pricing-rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pricing-row-grid {
    display: grid;
    grid-template-columns: 1fr 100px 110px 36px;
    gap: 8px;
    align-items: end;
  }

  @media (max-width: 520px) {
    .pricing-row-grid {
      grid-template-columns: 1fr 1fr;
    }
    .pricing-row-grid .btn-remove-price {
      grid-column: 2;
      justify-self: end;
    }
  }

  .btn-add-price {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px dashed var(--gray-300);
    background: var(--gray-50);
    color: var(--blue);
    cursor: pointer;
    width: 100%;
  }

  .btn-remove-price {
    height: 40px;
    border: none;
    background: var(--gray-100);
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
    color: var(--gray-600);
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }

  .form-hint {
    font-size: 11px;
    color: var(--gray-500);
    margin-top: 4px;
  }

  .current-photo {
    width: 120px;
    height: 90px;
    object-fit: cover;
    border-radius: var(--radius);
    margin-top: 8px;
  }

  .listing-form .profile-input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px;
    font-size: 14px;
    border: 1px solid var(--gray-200);
    border-radius: 8px;
  }
</style>
