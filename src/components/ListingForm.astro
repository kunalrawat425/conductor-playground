---
import { SPECIES_LIST, PRICE_UNITS } from "../lib/species";
import type { FishListing } from "../lib/supabase";

interface Props {
  listing?: FishListing;
  sellerId: string;
}

const { listing, sellerId } = Astro.props;
const isEdit = !!listing;
---

<form id="listing-form" class="listing-form" data-seller-id={sellerId} data-listing-id={listing?.id || ""}>
  <div class="form-group">
    <label for="species">Species</label>
    <select id="species" name="species" required>
      <option value="">Select species</option>
      {SPECIES_LIST.map((s) => (
        <option value={s.id} selected={listing?.species === s.id} data-unit={s.defaultUnit}>
          {s.english} ({s.marathi})
        </option>
      ))}
    </select>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="price_unit">Sell by</label>
      <select id="price_unit" name="price_unit" required>
        {PRICE_UNITS.map((u) => (
          <option value={u.value} selected={listing?.price_unit === u.value}>
            {u.label}
          </option>
        ))}
      </select>
      <div class="form-hint">How this fish is sold — per kg, per piece, or per dozen</div>
    </div>
    <div class="form-group">
      <label for="price" id="price-label">Price</label>
      <input
        type="number"
        id="price"
        name="price"
        min="1"
        step="0.01"
        value={listing?.price || ""}
        required
        placeholder="e.g. 500"
      />
      <div class="form-hint" id="price-hint">₹ per unit. Buyer sees this on the menu.</div>
    </div>
  </div>

  <div class="form-group">
    <label for="weight_avail" id="stock-label">Stock available</label>
    <input
      type="number"
      id="weight_avail"
      name="weight_avail"
      min="0"
      step="0.1"
      value={listing?.weight_avail || ""}
      required
      placeholder="e.g. 10"
    />
    <div class="form-hint" id="stock-hint">Buyers won't see this number. Used to track inventory and trigger "Out of stock".</div>
    <div class="form-hint" id="stock-info" style="color:var(--blue);font-weight:600;"></div>
  </div>

  <div class="form-group">
    <label for="photo">Photo</label>
    <input type="file" id="photo" name="photo" accept="image/*" />
    {listing?.photo_url && (
      <img src={listing.photo_url} alt="Current photo" class="current-photo" loading="lazy" />
    )}
  </div>


  <div class="form-group">
    <label for="max_qty_per_order">Max quantity per user (optional)</label>
    <input
      type="number"
      id="max_qty_per_order"
      name="max_qty_per_order"
      min="0.5"
      step="0.5"
      value={listing?.max_qty_per_order || ""}
      placeholder="e.g. 5 — leave empty for no limit"
    />
    <div class="form-hint">Limits how much one buyer can order. Buyer sees: "Max 5 per order".</div>
  </div>

  <div class="form-group">
    <label for="oos_threshold">Show "Out of stock" when stock falls below (optional)</label>
    <input
      type="number"
      id="oos_threshold"
      name="oos_threshold"
      min="0"
      step="0.5"
      value={listing?.oos_threshold || ""}
      placeholder="Default: 10% of stock — or set a number"
    />
    <div class="form-hint">Buyer sees: "📦 Out of stock" + PRE-ORDER button. Orders still come in as pre-orders. Default: 10% of stock.</div>
  </div>

  <div class="form-group">
    <label for="max_orders_per_day">Max orders per day (optional)</label>
    <input
      type="number"
      id="max_orders_per_day"
      name="max_orders_per_day"
      min="1"
      step="1"
      value={listing?.max_orders_per_day || ""}
      placeholder="e.g. 20 — leave empty for no limit"
    />
    <div class="form-hint">Buyer sees: error message when daily limit reached. Protects you from being overwhelmed. Resets at midnight.</div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">
      {isEdit ? "Update Listing" : "Add Listing"}
    </button>
  </div>
</form>

<script>
  const speciesSelect = document.getElementById("species") as HTMLSelectElement;
  const unitSelect = document.getElementById("price_unit") as HTMLSelectElement;
  const priceLabel = document.getElementById("price-label");
  const priceHint = document.getElementById("price-hint");
  const stockLabel = document.getElementById("stock-label");
  const stockHint = document.getElementById("stock-hint");
  const stockInfo = document.getElementById("stock-info");
  const stockInput = document.getElementById("weight_avail") as HTMLInputElement;
  const maxQtyInput = document.getElementById("max_qty_per_order") as HTMLInputElement;

  function updateUnitLabels() {
    const unit = unitSelect?.value || "kg";
    const unitMap: Record<string, { price: string; priceHint: string; stock: string; stockHint: string; stockPlaceholder: string }> = {
      kg: { price: "Price per kg (₹)", priceHint: "How much for 1 kg. Buyer sees: ₹500/kg", stock: "Stock (kg)", stockHint: "How many kg you have today. Buyers won't see this.", stockPlaceholder: "e.g. 10" },
      piece: { price: "Price per piece (₹)", priceHint: "How much for 1 piece. Buyer sees: ₹150/piece", stock: "Stock (pieces)", stockHint: "How many pieces you have. Buyers won't see this.", stockPlaceholder: "e.g. 20" },
      dozen: { price: "Price per dozen (₹)", priceHint: "How much for 12 units. Buyer sees: ₹300/dozen", stock: "Stock (dozens)", stockHint: "How many dozens you have. Buyers won't see this.", stockPlaceholder: "e.g. 5" },
    };
    const u = unitMap[unit] || unitMap.kg;
    if (priceLabel) priceLabel.textContent = u.price;
    if (priceHint) priceHint.textContent = u.priceHint;
    if (stockLabel) stockLabel.textContent = u.stock;
    if (stockHint) stockHint.textContent = u.stockHint;
    if (stockInput) stockInput.placeholder = u.stockPlaceholder;
    updateStockInfo();
  }

  function updateStockInfo() {
    if (!stockInfo || !stockInput) return;
    const stock = parseFloat(stockInput.value) || 0;
    const maxQty = parseFloat(maxQtyInput?.value || "0") || 0;
    const unit = unitSelect?.value || "kg";
    if (stock > 0 && maxQty > 0) {
      const orders = Math.floor(stock / maxQty);
      stockInfo.textContent = `With ${stock} ${unit} and max ${maxQty}/${unit} per user → ~${orders} orders possible`;
    } else if (stock > 0) {
      stockInfo.textContent = `${stock} ${unit} available for orders`;
    } else {
      stockInfo.textContent = "";
    }
  }

  // Auto-set price unit when species changes
  speciesSelect?.addEventListener("change", () => {
    const option = speciesSelect.selectedOptions[0];
    const defaultUnit = option?.dataset.unit;
    if (defaultUnit && unitSelect) {
      unitSelect.value = defaultUnit;
      updateUnitLabels();
    }
  });

  unitSelect?.addEventListener("change", updateUnitLabels);
  stockInput?.addEventListener("input", updateStockInfo);
  maxQtyInput?.addEventListener("input", updateStockInfo);

  // Initial update
  updateUnitLabels();
</script>

<style>
  .listing-form {
    max-width: 500px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 12px;
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }

  .form-hint {
    font-size: 11px;
    color: var(--gray-500);
    margin-top: 4px;
  }

  .current-photo {
    width: 120px;
    height: 90px;
    object-fit: cover;
    border-radius: var(--radius);
    margin-top: 8px;
  }

</style>
