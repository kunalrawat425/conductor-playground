---
import { LOGO_URL } from "../lib/brand";
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: "website" | "article";
  pubDate?: string;
  author?: string;
  tags?: string[];
}
const {
  title,
  description = "Relifish — Fresh fish from verified hyperlocal sellers in Mumbai. Same-day catch, no middlemen, no markup.",
  image = "/og-relifish.png",
  canonicalURL,
  type = "website",
  pubDate,
  author,
  tags = [],
} = Astro.props;
const siteUrl = "https://relifish.store";
const ogImage = image?.startsWith("http") ? image : `${siteUrl}${image}`;
const canonical = canonicalURL ?? Astro.url.href;

const articleSchema = type === "article" ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": ogImage,
  "datePublished": pubDate,
  "author": { "@type": "Organization", "name": author ?? "Relifish Team", "url": siteUrl },
  "publisher": { "@type": "Organization", "name": "Relifish", "logo": { "@type": "ImageObject", "url": `${siteUrl}/favicon.png` } },
  "url": canonical,
  "keywords": tags.join(", "),
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical }
}) : null;

const orgSchema = type === "website" ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Relifish",
  "url": siteUrl,
  "description": "Fresh fish marketplace in Mumbai. Same-day catch from verified hyperlocal sellers, no middlemen.",
  "logo": `${siteUrl}/favicon.png`,
  "address": { "@type": "PostalAddress", "addressLocality": "Thane", "addressRegion": "Maharashtra", "addressCountry": "IN" },
  "areaServed": ["Thane", "Hiranandani Estate", "Lodha Splendora", "Ghodbunder Road"],
  "sameAs": ["https://www.instagram.com/relifish.store/"]
}) : null;
import Footer from "../components/Footer.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Relifish" />
  <meta property="og:locale" content="en_IN" />
  {type === "article" && pubDate && <meta property="article:published_time" content={pubDate} />}
  {type === "article" && author && <meta property="article:author" content={author} />}
  {type === "article" && tags.map(tag => <meta property="article:tag" content={tag} />)}
  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <!-- Schema.org JSON-LD -->
  {articleSchema && <script type="application/ld+json" set:html={articleSchema} />}
  {orgSchema && <script type="application/ld+json" set:html={orgSchema} />}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-JG2ZTX3F');</script>
  <!-- Google Analytics (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DGS7557PZ6"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DGS7557PZ6');
    (function() {
      var p = new URLSearchParams(location.search);
      var src = p.get('utm_source'), med = p.get('utm_medium'), cam = p.get('utm_campaign');
      if (src) {
        sessionStorage.setItem('rf_utm_source', src);
        sessionStorage.setItem('rf_utm_medium', med || '');
        sessionStorage.setItem('rf_utm_campaign', cam || '');
        gtag('event', 'utm_landing', { utm_source: src, utm_medium: med, utm_campaign: cam });
      }
    })();
  </script>
  <!-- Microsoft Clarity -->
  <script is:inline type="text/javascript">
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wryvhcf3k8");
  </script>
  <!-- Facebook Pixel -->
  <script is:inline>
    !function(f,b,e,v,n,t,s){
      if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1197248829088195');
    fbq('track','PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1197248829088195&ev=PageView&noscript=1"/></noscript>
  <!-- Firebase Analytics -->
  <script type="module" is:inline>
    import { initializeApp } from "https://www.gstatic.com/firebasejs/12.14.0/firebase-app.js";
    import { getAnalytics } from "https://www.gstatic.com/firebasejs/12.14.0/firebase-analytics.js";
    const firebaseConfig = {
      apiKey: "AIzaSyDYlmH764DU2ZJQJIfmnX-WpGBJ5hwV520",
      authDomain: "relifish.firebaseapp.com",
      projectId: "relifish",
      storageBucket: "relifish.firebasestorage.app",
      messagingSenderId: "881437398033",
      appId: "1:881437398033:web:982edeaf6e723a8ab04db0",
      measurementId: "G-7MXZDZ1S4N"
    };
    const app = initializeApp(firebaseConfig);
    getAnalytics(app);
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #ffffff;
      color: #0f172a;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }

    /* ── NAV ── */
    .lp-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid #e2e8f0;
      padding: 0 24px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .lp-nav-logo img {
      height: 36px;
      width: auto;
      display: block;
    }
    .lp-nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .lp-nav-links a {
      font-size: 14px;
      font-weight: 500;
      color: #475569;
      text-decoration: none;
      transition: color 0.15s;
    }
    .lp-nav-links a:hover { color: #0f172a; }
    .lp-nav-cta {
      background: #0066ff;
      color: #fff !important;
      font-weight: 700 !important;
      padding: 8px 18px !important;
      border-radius: 8px;
      font-size: 13px !important;
    }
    .lp-nav-cta:hover { background: #0052cc !important; color: #fff !important; }
    @media (max-width: 600px) {
      .lp-nav-links { gap: 12px; }
      .lp-nav-links a:not(.lp-nav-cta) { display: none; }
    }

    /* ── MAIN CONTENT ── */
    .lp-content {
      min-height: calc(100vh - 60px - 120px);
    }

  </style>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-JG2ZTX3F"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<!-- ── NAV ── -->
<nav class="lp-nav">
  <a href="/" class="lp-nav-logo">
    <img src={LOGO_URL} alt="Relifish" />
  </a>
  <div class="lp-nav-links">
    <a href="/blog">Blog</a>
    <a href="/shop" class="lp-nav-cta">Browse Fish</a>
  </div>
</nav>

<!-- ── CONTENT ── -->
<main class="lp-content">
  <slot />
</main>

<Footer />

</body>
</html>
