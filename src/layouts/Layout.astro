---
import LandingLayout from "./LandingLayout.astro";
const { frontmatter } = Astro.props;
---
<LandingLayout
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  type="article"
  pubDate={frontmatter.pubDate}
  author={frontmatter.author}
  tags={frontmatter.tags ?? []}
>
  <article style="max-width:780px;margin:0 auto;padding:48px 24px 80px;">
    <!-- Hero image -->
    {frontmatter.image && (
      <img
        src={frontmatter.image}
        alt={frontmatter.title}
        style="width:100%;height:360px;object-fit:cover;border-radius:16px;margin-bottom:32px;display:block;"
      />
    )}

    <!-- Meta -->
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px;">
      <a href="/blog" style="font-size:13px;font-weight:600;color:#0066ff;text-decoration:none;">← All articles</a>
      {frontmatter.pubDate && (
        <span style="font-size:13px;color:#94a3b8;">{new Date(frontmatter.pubDate).toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' })}</span>
      )}
      {frontmatter.author && (
        <span style="font-size:13px;color:#94a3b8;">by {frontmatter.author}</span>
      )}
    </div>

    <!-- Tags -->
    {frontmatter.tags && frontmatter.tags.length > 0 && (
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px;">
        {frontmatter.tags.map((tag: string) => (
          <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;background:#eff6ff;color:#0066ff;border-radius:100px;padding:3px 10px;">{tag}</span>
        ))}
      </div>
    )}

    <!-- Article body -->
    <div class="prose">
      <slot />
    </div>

    <!-- Social share -->
    <div style="margin-top:48px;padding:24px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;">
      <p style="font:700 15px Inter;color:#0f172a;margin:0 0 14px;">Share this article:</p>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px;">
        <button id="share-wa" style="display:inline-flex;align-items:center;gap:8px;background:#25D366;color:#fff;border:none;border-radius:8px;padding:10px 18px;font:600 13px Inter;cursor:pointer;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          Share on WhatsApp
        </button>
        <button id="share-fb" style="display:inline-flex;align-items:center;gap:8px;background:#1877F2;color:#fff;border:none;border-radius:8px;padding:10px 18px;font:600 13px Inter;cursor:pointer;">
          Share on Facebook
        </button>
        <button id="share-copy" style="display:inline-flex;align-items:center;gap:8px;background:#fff;color:#0f172a;border:1px solid #e2e8f0;border-radius:8px;padding:10px 18px;font:600 13px Inter;cursor:pointer;">
          <span id="copy-text">🔗 Copy Link</span>
        </button>
      </div>
      <div style="display:flex;align-items:center;gap:12px;padding:14px;background:rgba(0,102,255,0.05);border:1px solid rgba(0,102,255,0.12);border-radius:8px;">
        <span style="font-size:24px;">🐟</span>
        <div>
          <div style="font:700 13px Inter;color:#0a2472;margin-bottom:2px;">Order fresh fish in Thane</div>
          <div style="font:400 12px Inter;color:#475569;line-height:1.4;">Same-day catch from local koli sellers. No middlemen. No cold storage. <a href="/shop" style="color:#0066ff;font-weight:600;text-decoration:none;">Browse sellers →</a></div>
        </div>
      </div>
    </div>

    <!-- More articles CTA -->
    <div style="margin-top:32px;text-align:center;">
      <a href="/blog" style="display:inline-flex;align-items:center;gap:8px;color:#0066ff;font:600 14px Inter;text-decoration:none;">
        ← Read more from the Relifish blog
      </a>
    </div>
  </article>
</LandingLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const url = window.location.href;
    const title = document.title;
    document.getElementById('share-wa')?.addEventListener('click', () => {
      window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(title + '\n' + url)}`, '_blank');
    });
    document.getElementById('share-fb')?.addEventListener('click', () => {
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank');
    });
    document.getElementById('share-copy')?.addEventListener('click', () => {
      navigator.clipboard.writeText(url).then(() => {
        const el = document.getElementById('copy-text');
        if (el) { el.innerText = '✅ Copied!'; setTimeout(() => { el.innerText = '🔗 Copy Link'; }, 2000); }
      });
    });
  });
</script>

<style is:global>
  .prose { font: 400 16px/1.75 Inter, sans-serif; color: #334155; }
  .prose h1 { font-size: 32px; font-weight: 900; line-height: 1.2; color: #0f172a; margin: 0 0 20px; letter-spacing: -0.5px; }
  .prose h2 { font-size: 22px; font-weight: 800; color: #0f172a; margin: 40px 0 12px; border-bottom: 2px solid #eff6ff; padding-bottom: 8px; }
  .prose h3 { font-size: 18px; font-weight: 700; color: #0f172a; margin: 28px 0 8px; }
  .prose p { margin: 0 0 18px; }
  .prose ul, .prose ol { padding-left: 24px; margin: 0 0 18px; }
  .prose li { margin-bottom: 8px; }
  .prose blockquote { border-left: 4px solid #0066ff; background: #eff6ff; padding: 14px 18px; border-radius: 0 8px 8px 0; margin: 24px 0; font-style: italic; color: #0a2472; }
  .prose blockquote p { margin: 0; }
  .prose a { color: #0066ff; text-decoration: underline; font-weight: 500; }
  .prose strong { color: #0f172a; font-weight: 700; }
  .prose hr { border: none; border-top: 2px solid #e2e8f0; margin: 40px 0; }
  .prose img { width: 100%; border-radius: 10px; margin: 24px 0; }
  @media (max-width: 600px) {
    article { padding: 32px 16px 60px !important; }
    .prose h1 { font-size: 26px !important; }
    .prose h2 { font-size: 19px !important; }
  }
</style>
