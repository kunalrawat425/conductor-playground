---
import AppShell from "../components/ui/AppShell.astro";
const { frontmatter } = Astro.props;
---
<AppShell
  title={frontmatter.title}
  description={frontmatter.description}
>
  <div style="padding: 24px 16px; max-width: var(--app-max-width); margin: 0 auto; background: var(--v2-bg);">
    <a href="/shop" style="display: inline-flex; align-items: center; gap: 6px; color: var(--v2-brand); font-weight: 600; text-decoration: none; margin-bottom: 24px; font-size: 14px;">
      ← Go to Shop
    </a>
    <article class="prose" style="line-height: 1.6; font-size: 15px; color: var(--v2-ink);">
      <slot />
    </article>
  </div>
</AppShell>

<style is:global>
  .prose h1 {
    font-size: 26px;
    font-weight: 800;
    margin-top: 0;
    margin-bottom: 16px;
    line-height: 1.25;
    color: var(--v2-ink);
  }
  .prose h2 {
    font-size: 20px;
    font-weight: 700;
    margin-top: 32px;
    margin-bottom: 12px;
    line-height: 1.3;
    color: var(--v2-ink);
    border-bottom: 1px solid var(--v2-border);
    padding-bottom: 6px;
  }
  .prose h3 {
    font-size: 17px;
    font-weight: 700;
    margin-top: 24px;
    margin-bottom: 8px;
    color: var(--v2-ink);
  }
  .prose p {
    margin-top: 0;
    margin-bottom: 16px;
    color: var(--v2-ink-2);
  }
  .prose ul, .prose ol {
    margin-top: 0;
    margin-bottom: 16px;
    padding-left: 24px;
    color: var(--v2-ink-2);
  }
  .prose li {
    margin-bottom: 6px;
  }
  .prose hr {
    margin: 32px 0;
    border: 0;
    border-top: 1px solid var(--v2-border);
  }
  .prose blockquote {
    margin: 24px 0;
    padding: 12px 16px;
    background: var(--v2-bg-2);
    border-left: 4px solid var(--v2-brand);
    border-radius: 4px;
    font-style: italic;
  }
  .prose blockquote p {
    margin: 0;
    color: var(--v2-ink);
  }
</style>
