{
  "name": "relifish",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node --import tsx scripts/migrate-safe.ts && astro build",
    "build:only": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "bun run scripts/run-migrations.ts",
    "db:migrate:safe": "bun run scripts/migrate-safe.ts",
    "deploy": "npx vercel deploy --prod"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/bun": "latest",
    "@types/leaflet": "^1.9.21",
    "happy-dom": "^20.8.9",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^10.0.7",
    "@google/genai": "^2.9.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "3.6.2",
    "ai": "^6.0.177",
    "astro": "^6.3.5",
    "cropperjs": "^1.6.2",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "node-cron": "^4.4.1",
    "pg": "^8.21.0",
    "postgres": "^3.4.8",
    "web-push": "^3.6.7"
  },
  "version": "0.2.2.0"
}
